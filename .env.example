# Local development only. Replace placeholders with your own environment values.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-public-anon-key
SUPABASE_INTERNAL_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-server-only-service-role-key
# Generate a private random value, for example: openssl rand -hex 32
EDUSET_TOKEN_SECRET=replace-with-a-private-random-secret

# 개발 전용: 로컬에는 DB 컨테이너가 없으므로 ssh로 서버의 세션 확인을 대신 호출한다(운영에서는 무시된다).
# CBGPU_DB_SSH=cbgpu@서버주소
# 서비스 키는 서버 환경 파일에서 가져와 .env.local에만 둔다(절대 커밋하지 않는다).
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_INTERNAL_URL=https://cbgpu.com/backend
