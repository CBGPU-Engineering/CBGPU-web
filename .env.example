# Local development only. Replace placeholders with your own environment values.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-public-anon-key
SUPABASE_INTERNAL_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-server-only-service-role-key
# Generate a private random value, for example: openssl rand -hex 32
EDUSET_TOKEN_SECRET=replace-with-a-private-random-secret

# Optional platform-admin official AdFit reporting. Disabled until native service is provisioned.
# The public flag is compiled into the frontend; the server flag independently gates its BFF.
NEXT_PUBLIC_CBGPU_AD_REVENUE_V1=0
CBGPU_AD_REVENUE_ENABLED=0
CBGPU_AD_REVENUE_API_URL=http://127.0.0.1:3549

# Optional separately approved central CPU allocations; default off (not school GPU rights).
CBGPU_CENTRAL_CPU_V1=0
NEXT_PUBLIC_CBGPU_CENTRAL_CPU_V1=0
