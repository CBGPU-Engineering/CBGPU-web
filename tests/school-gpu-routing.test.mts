import test from'node:test';import assert from'node:assert/strict';
import{schoolGpuBookingTarget,schoolGpuBookingHref}from'../src/lib/schoolGpuRouting.ts';
const selected=(id:string)=>({status:'ready',current:{school_id:id,school:{id}}});
test('Chungbuk selects its existing booking page without an empty node-registry screen',()=>{assert.equal(schoolGpuBookingTarget('/compute',selected('cbsh')),'/dashboard');assert.equal(schoolGpuBookingTarget('/dashboard',selected('cbsh')),null)});
test('another school opens only its own school-scoped compute page, including old bookmarks',()=>{assert.equal(schoolGpuBookingTarget('/dashboard',selected('school-b')),'/compute');assert.equal(schoolGpuBookingTarget('/compute',selected('school-b')),null)});
test('unresolved or inconsistent school scope never falls back to Chungbuk',()=>{for(const status of['loading','unavailable','none'])assert.equal(schoolGpuBookingTarget('/compute',{status,current:null}),null);assert.equal(schoolGpuBookingTarget('/compute',{status:'ready',current:{school_id:'cbsh',school:{id:'other'}}}),null);assert.equal(schoolGpuBookingTarget('/compute',{status:'ready',current:null}),null)});
test('explicit legacy single-school mode preserves old bookmarks, not modern unknown school scope',()=>{assert.equal(schoolGpuBookingTarget('/compute',{status:'legacy',current:null},true),'/dashboard');assert.equal(schoolGpuBookingTarget('/compute',{status:'none',current:null},true),null);assert.equal(schoolGpuBookingTarget('/compute',{status:'legacy',current:null},false),null)});
test('school switching does not redirect SSH guides or other feature pages',()=>{for(const path of['/dashboard/ssh-guide','/server','/notes'])assert.equal(schoolGpuBookingTarget(path,selected('school-b')),null)});
test('GPU transitions retain app mode on the same origin but never forward redirect targets or credentials',()=>{assert.equal(schoolGpuBookingHref('/dashboard','?mode=student&native=1&from=app&next=https://evil.invalid&school=other&access_token=secret'),'/dashboard?mode=student&native=1&from=app');assert.equal(schoolGpuBookingHref('/compute','?mode=developer&native=1'),'/compute?mode=researcher&native=1');assert.equal(schoolGpuBookingHref('/compute','?mode=admin&native=0&next=//evil.invalid'),'/compute');assert.throws(()=>schoolGpuBookingHref('//evil.invalid' as '/compute',''))});
