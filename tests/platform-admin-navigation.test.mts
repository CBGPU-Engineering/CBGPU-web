import test from'node:test';import assert from'node:assert/strict';import{platformAdminSchool,platformSchoolAdminHref}from'../src/lib/platformAdminNavigation.ts';
test('management context follows exact school routes and preserves valid sections',()=>{assert.deepEqual(platformAdminSchool('/schools/cbsh/admin','members'),{schoolId:'cbsh',section:'members'});assert.deepEqual(platformAdminSchool('/schools/neis-8000550/admin','features'),{schoolId:'neis-8000550',section:'features'});assert.deepEqual(platformAdminSchool('/admin/schools/cbsh',null),{schoolId:'cbsh',section:'overview'});assert.deepEqual(platformAdminSchool('/admin/schools/cbsh/life-sources',null),{schoolId:'cbsh',section:'overview'});assert.deepEqual(platformAdminSchool('/schools/cbsh/admin','not-a-section'),{schoolId:'cbsh',section:'overview'})});
test('global tools and malformed paths cannot silently inherit a school',()=>{for(const path of['/admin','/admin/schools','/admin/accounts','/admin/school-applications','/schools/cbsh/admin/extra','/schools/%2e%2e/admin','/admin/schools/cbsh/members','/schools/'+ 'x'.repeat(101)+'/admin'])assert.equal(platformAdminSchool(path,'members'),null,path)});

test('platform school links remain inside the same admin shell',()=>{assert.equal(platformSchoolAdminHref('cbsh','members'),'/admin/schools/cbsh/manage?section=members');assert.deepEqual(platformAdminSchool('/admin/schools/cbsh/manage','members'),{schoolId:'cbsh',section:'members'});assert.throws(()=>platformSchoolAdminHref('../other','members'));assert.equal(platformSchoolAdminHref('cbsh','unknown'),'/admin/schools/cbsh/manage?section=overview')});
