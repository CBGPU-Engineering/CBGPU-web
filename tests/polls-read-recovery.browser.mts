  await page.screenshot({path:`${out}/${scenario}-${config.width}-${config.dark?'dark':'light'}-${config.app?'app':'web'}.png`,fullPage:true});await page.getByRole('button',{name:'확인',exact:true}).click();await page.evaluate(()=>{(window as any).__readMode='ok'});await page.getByRole('heading',{name:'합성 투표',exact:true}).click();await page.getByLabel('선택 답변',{exact:true}).waitFor();await page.getByLabel('선택 답변',{exact:true}).fill('복구 후 작성한 답변');assert.equal(await page.getByRole('button',{name:'제출하기',exact:true}).isEnabled(),true);
