import test from 'node:test';
import assert from 'node:assert/strict';
import {readNoteRecovery,writeNoteRecovery,clearNoteRecovery,type NoteRecovery} from '../src/lib/noteDraftRecovery.ts';
const draft:NoteRecovery={id:'note-A',owner:'owner-A',base:null,draft:{title:'Private draft',content:'Last input',tags:[],is_shared:false},at:1000};
const storage=()=>{const data=new Map<string,string>();return{getItem:(key:string)=>data.get(key)??null,setItem:(key:string,value:string)=>{data.set(key,value)},removeItem:(key:string)=>{data.delete(key)}}};
test('route changes can recover the exact unsaved draft only in its owner namespace',()=>{const store=storage();assert.equal(writeNoteRecovery(store,draft),true);assert.deepEqual(readNoteRecovery(store,'owner-A',2000),draft);assert.equal(readNoteRecovery(store,'owner-B',2000),null);clearNoteRecovery(store,'owner-B',draft.id);assert.deepEqual(readNoteRecovery(store,'owner-A',2000),draft)});
test('stale or mismatched records are rejected, while clearing a different note preserves recovery',()=>{const store=storage();writeNoteRecovery(store,{...draft,at:Date.now()});clearNoteRecovery(store,'owner-A','different');assert.ok(readNoteRecovery(store,'owner-A'));clearNoteRecovery(store,'owner-A',draft.id);assert.equal(readNoteRecovery(store,'owner-A'),null);writeNoteRecovery(store,draft);assert.equal(readNoteRecovery(store,'owner-A',86401001),null);store.setItem('cbgpu-note-recovery:owner-A',JSON.stringify({...draft,base:{...draft.draft,id:draft.id,user_id:'owner-B',updated_at:'v1'}}));assert.equal(readNoteRecovery(store,'owner-A',2000),null)});
test('blocked or unavailable browser storage never throws into the editor',()=>{const store={getItem:()=>{throw Error('blocked')},setItem:()=>{throw Error('full')},removeItem:()=>{throw Error('blocked')}};assert.equal(writeNoteRecovery(store,{...draft,at:Date.now()}),false);assert.equal(readNoteRecovery(store,'owner-A')?.draft.content,'Last input');assert.doesNotThrow(()=>clearNoteRecovery(store,'owner-A',draft.id));assert.equal(writeNoteRecovery(null,draft),false)});
