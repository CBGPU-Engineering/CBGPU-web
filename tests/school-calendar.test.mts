import{test}from'node:test';import assert from'node:assert/strict';import{parseCbeSchoolCalendar}from'../src/lib/schoolCalendar.ts';
test('official calendar dates come from HTML events rather than an empty RSS channel',()=>{const html='<ul class="tch-sch-lst"><li><dl><dt>26.11.19</dt><dd class="tch-tit"><div>- 대학수학능력시험</div></dd></dl></li><li><dt>26.11.13</dt><dd class="tch-tit">- 재량휴업 &amp; 휴식</dd></li></ul>';const items=parseCbeSchoolCalendar(html,'https://school.cbe.go.kr/cbs-h/M010407');assert.equal(items.length,2);assert.equal(items[0].title,'재량휴업 & 휴식');assert.equal(items[1].pubDate,'2026-11-19T00:00:00+09:00');assert.ok(items.every(i=>i.author===''));});
test('empty calendar and invalid upstream formats are distinguished',()=>{assert.deepEqual(parseCbeSchoolCalendar('<ul class="tch-sch-lst"></ul>','https://example.invalid'),[]);assert.throws(()=>parseCbeSchoolCalendar('<html>maintenance</html>','https://example.invalid'));assert.throws(()=>parseCbeSchoolCalendar('<ul class="tch-sch-lst"><li><dt>26.02.31</dt><dd class="tch-tit">invalid</dd></li></ul>','https://example.invalid'));});
