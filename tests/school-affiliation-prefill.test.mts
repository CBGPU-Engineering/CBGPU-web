import test from 'node:test';import assert from 'node:assert/strict';import fs from 'node:fs';import vm from 'node:vm';import ts from 'typescript';
const exports:any={};vm.runInNewContext(ts.transpileModule(fs.readFileSync(new URL('../src/components/schools/SchoolAffiliation.tsx',import.meta.url),'utf8'),{compilerOptions:{module:ts.ModuleKind.CommonJS,jsx:ts.JsxEmit.ReactJSX,target:ts.ScriptTarget.ES2022}}).outputText,{exports,require:()=>({})});
const initial=exports.schoolAffiliationInitialValues;
test('current students start with their own school student number instead of a teacher request',()=>{const value=initial({membership_type:'STUDENT',student_number:'AB-2026-007'},null);assert.equal(value.type,'STUDENT');assert.equal(value.student,'AB-2026-007')});
test('explicit student-number action opens student request for external school organizers',()=>{const value=initial({membership_type:'EXTERNAL',student_number:null},'STUDENT');assert.equal(value.type,'STUDENT');assert.equal(value.student,'')});
test('ordinary teacher/external requests keep current membership type and unknown query values do not invent roles',()=>{assert.equal(initial({membership_type:'TEACHER'},null).type,'TEACHER');assert.equal(initial({membership_type:'EXTERNAL'},'ADMIN').type,'EXTERNAL');assert.equal(initial({membership_type:'STUDENT',student_number:'2309'},'STUDENT').student,'2309')});
