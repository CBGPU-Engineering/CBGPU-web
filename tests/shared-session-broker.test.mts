import test from 'node:test';import assert from 'node:assert/strict';import fs from 'node:fs';import ts from 'typescript';
const compile=(p:string)=>ts.transpileModule(fs.readFileSync(new URL(p,import.meta.url),'utf8'),{compilerOptions:{module:ts.ModuleKind.ES2022,target:ts.ScriptTarget.ES2022}}).outputText;
const storage='data:text/javascript;base64,'+Buffer.from(compile('../src/lib/sharedSessionStorage.ts')).toString('base64');
const source=compile('../src/lib/sharedSessionBroker.ts').replace("'./sharedSessionStorage'",JSON.stringify(storage));
const {handleSharedSession,readSharedCookies,sessionCookieHeaders,trustedSharedRequest}=await import('data:text/javascript;base64,'+Buffer.from(source).toString('base64'));
const K='sb-cbgpu-auth-token',value=JSON.stringify({access_token:'verified-token',refresh_token:'private-refresh',user:{id:'owner'}});
const verify=async(v:string)=>{assert.equal(v,value);return{value:v,expiresAt:9999999999}};
function request(host='app.cbgpu.com',method='GET',origin?:string,body?:unknown,cookie=''){return new Request('https://'+host+'/api/auth/shared-session',{method,headers:{host,...(origin?{origin}:{}),...(body!==undefined?{'content-type':'application/json'}:{}),...(cookie?{cookie}:{})},body:body===undefined?undefined:JSON.stringify(body)});}
test('legacy cookie upgrades to same-name HttpOnly parent cookie without logout',async()=>{const r=await handleSharedSession(request('app.cbgpu.com','GET',undefined,undefined,K+'.0='+encodeURIComponent(value)),verify);assert.equal(r.status,200);assert.equal((await r.json()).value,value);const cookies=r.headers.getSetCookie();assert.ok(cookies.some(c=>c.startsWith(K+'.0=')&&c.includes('HttpOnly')&&c.includes('Domain=.cbgpu.com')&&c.includes('Secure')));assert.equal(r.headers.get('access-control-allow-origin'),null);assert.equal(r.headers.get('x-content-type-options'),'nosniff');assert.match(r.headers.get('cache-control'),/no-store/);});
test('tenant, unrelated host and privileged portal cannot read or set shared sessions',async()=>{for(const host of ['tenant.front.cbgpu.com','tenant.server.cbgpu.com','unknown.cbgpu.com','admin.cbgpu.com','developers.cbgpu.com','cbgpu.com.evil.com']){const r=await handleSharedSession(request(host,'POST','https://'+host,{value}),verify);assert.equal(r.status,404,host);assert.equal(r.headers.get('set-cookie'),null);}});
test('same-site tenant origin cannot CSRF trusted broker',async()=>{for(const origin of ['https://tenant.front.cbgpu.com','null','https://app.cbgpu.com.evil.test']){const r=await handleSharedSession(request('app.cbgpu.com','POST',origin,{value}),verify);assert.equal(r.status,404);}});
test('mutations require exact Origin and JSON; cross-site scripts are denied',async()=>{assert.equal((await handleSharedSession(request('app.cbgpu.com','POST',undefined,{value}),verify)).status,404);const script=request();script.headers.set('sec-fetch-dest','script');assert.equal((await handleSharedSession(script,verify)).status,404);});
test('forwarded public host cannot override untrusted raw tenant host',()=>{const r=request('tenant.front.cbgpu.com');r.headers.set('x-cbgpu-public-host','app.cbgpu.com');assert.equal(trustedSharedRequest(r),null);});
test('accepted session requires server verification; validation outage preserves cookies',async()=>{const r=await handleSharedSession(request('app.cbgpu.com','POST','https://app.cbgpu.com',{value}),async()=>{throw Error('invalid session or Auth outage')});assert.equal(r.status,503);assert.equal(r.headers.get('set-cookie'),null);});
test('logout expires chunks and writes an HttpOnly tombstone',async()=>{const r=await handleSharedSession(request('app.cbgpu.com','POST','https://app.cbgpu.com',{value:null},K+'.0=old; '+K+'.1=stale'),verify);assert.equal(r.status,200);assert.equal((await r.json()).state,'signed-out');const cookies=r.headers.getSetCookie();assert.ok(cookies.some(c=>c.startsWith(K+'.1=;')&&c.includes('Max-Age=0')));assert.ok(cookies.some(c=>c.includes('cbgpu-shared-session-state=signed-out')&&c.includes('HttpOnly')));});
test('UTF-8 sessions use bounded chunks compatible with legacy per-chunk decoding',()=>{const unicode=JSON.stringify({token:'x'.repeat(3200),name:'연구실🙂'.repeat(400)});const cookies=sessionCookieHeaders(unicode,'cbgpu.com',[]);assert.ok(cookies.every(c=>c.length<4096));const raw=cookies.filter(c=>c.startsWith(K+'.')).map(c=>c.split(';')[0]).join('; ');assert.equal(readSharedCookies(raw).value,unicode);});
test('duplicate, noncontiguous and malformed cookies are rejected',()=>{for(const raw of [K+'.0=a; '+K+'.0=b',K+'.1=b',K+'.0=%GG'])assert.throws(()=>readSharedCookies(raw));});
test('empty shared state does not force signout or set cookies',async()=>{const r=await handleSharedSession(request(),verify);assert.equal((await r.json()).state,'empty');assert.equal(r.headers.get('set-cookie'),null);});
test('background refresh cannot undo a shared signout but explicit login may',async()=>{const cookie='cbgpu-shared-session-state=signed-out';const refresh=request('app.cbgpu.com','POST','https://app.cbgpu.com',{value,intent:'sync'},cookie);const denied=await handleSharedSession(refresh,async()=>{throw Error('must not validate rejected background refresh')});assert.equal((await denied.json()).state,'signed-out');assert.equal(denied.headers.get('set-cookie'),null);const login=await handleSharedSession(request('app.cbgpu.com','POST','https://app.cbgpu.com',{value,intent:'login'},cookie),verify);assert.equal((await login.json()).state,'active');});
test('delayed refresh cannot replace a newer shared login',async()=>{const make=(id:string,sid:string,exp:number)=>JSON.stringify({access_token:'a.'+Buffer.from(JSON.stringify({sub:id,session_id:sid,exp})).toString('base64url')+'.b',refresh_token:'fixture-refresh',user:{id}});const incoming=make('old-user','old-session',100),current=make('new-user','new-session',200);const r=await handleSharedSession(request('app.cbgpu.com','POST','https://app.cbgpu.com',{value:incoming,intent:'sync'},K+'.0='+encodeURIComponent(current)),async(v:string)=>({value:v,expiresAt:200}));assert.equal((await r.json()).value,current);});
test('global API CORS headers exclude only the shared-session broker',async()=>{const {createRequire}=await import('node:module');const {pathToRegexp}=createRequire(import.meta.url)('next/dist/compiled/path-to-regexp');const source=compile('../next.config.ts');const {default:config}=await import('data:text/javascript;base64,'+Buffer.from(source).toString('base64'));const rules=await config.headers();const cors=rules.filter((r:any)=>r.headers.some((h:any)=>h.key.toLowerCase()==='access-control-allow-origin'));assert.ok(cors.length>0);for(const r of cors){const regex=pathToRegexp(r.source);assert.equal(regex.test('/api/auth/shared-session'),false);assert.equal(regex.test('/api/auth/shared-session/'),false);}assert(cors.some((r:any)=>pathToRegexp(r.source).test('/api/study/student')));assert(cors.some((r:any)=>pathToRegexp(r.source).test('/api/ai/v1/contests')));});
test('signed-out marker overrides any residual session chunks',async()=>{const r=await handleSharedSession(request('app.cbgpu.com','GET',undefined,undefined,'cbgpu-shared-session-state=signed-out; '+K+'.0='+encodeURIComponent(value)),async()=>{throw Error('residual session must not be restored')});assert.equal(r.status,200);assert.equal((await r.json()).state,'signed-out');});
test('local reverse proxy self-host header remains valid for development',()=>{const r=new Request('http://127.0.0.1:13760/api/auth/shared-session',{headers:{host:'127.0.0.1:13760','x-cbgpu-public-host':'127.0.0.1'}});assert.equal(trustedSharedRequest(r)?.host,'127.0.0.1');});
