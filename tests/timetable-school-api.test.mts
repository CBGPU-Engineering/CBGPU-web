import test from'node:test';import assert from'node:assert/strict';import fs from'node:fs';import vm from'node:vm';import ts from'typescript';import *as school from'../src/lib/comciganSchool.ts';
import*as neis from'../src/lib/neisSheetTimetable.ts';
import{schoolLifeAuthorityJson}from'../src/lib/schoolLifeAuthority.ts';
import{trustedInternalServiceUrl}from'../src/lib/internalServiceUrl.ts';
const code=ts.transpileModule(fs.readFileSync(new URL('../src/app/api/timetable/route.ts',import.meta.url),'utf8'),{compilerOptions:{module:ts.ModuleKind.CommonJS,target:ts.ScriptTarget.ES2022}}).outputText;
function api(enabled=true){let nativeCalls=0,providerCalls=0,nativeStatus=200,nativeMode='json',lastTarget:any=null,sheetCalls=0,comciFails=false,validNeis=false,missingComci=false,sheetFails=false,schoolType='HIGH_SCHOOL',lastSheetTarget:any=null;const exports:any={};vm.runInNewContext(code,{exports,URL,AbortSignal,TextDecoder,process:{env:{CBGPU_MULTISCHOOL_V1:enabled?'1':'0'}},fetch:async(url:URL,options:any)=>{nativeCalls++;assert.equal(options.headers.Authorization,'Bearer synthetic');const id=url.pathname.split('/')[3];if(nativeMode==='html')return new Response('<!DOCTYPE html>',{headers:{'Content-Type':'text/html'}});if(nativeMode==='large')return new Response(' '.repeat(65537),{headers:{'Content-Type':'application/json'}});return Response.json({school_id:id,status:'READY',...(validNeis?{school_type:schoolType,official_id:'8750731',education_office_code:'R10',school_name:'동일고등학교'}:{}),comcigan:{status:missingComci?'NOT_CONFIGURED':'LOOKUP_REQUIRED',school_code:null,school_name:'동일고등학교',region:id==='school-a'?'서울':'충북'}},{status:nativeStatus})},require(name:string){if(name==='@/lib/neisSheetTimetable')return{...neis,getNeisSheetTimetable:async(target:any,_g:number,_c:number,department:any)=>{sheetCalls++;lastSheetTarget=target;if(sheetFails)throw Error('provider unavailable');return{school_id:target.id,provider:'neis-sheet',grid:department?{2:{7:{subject:'선택 학과 수업',teacher:''}}}:{},selectionRequired:!department,departments:[{id:'a'.repeat(20),label:'학과 A'},{id:'b'.repeat(20),label:'학과 B'}]}}};if(name==='@/lib/schoolLifeAuthority')return{schoolLifeAuthorityJson};if(name==='@/lib/internalServiceUrl')return{trustedInternalServiceUrl};if(name==='next/server')return{NextResponse:{json:(body:any,opts:any)=>new Response(JSON.stringify(body),opts)}};if(name==='@/lib/comciganSchool')return school;if(name==='@/lib/comcigan')return{getTimetable:async(_g:number,_c:number,opts:any)=>{providerCalls++;lastTarget=opts.school;if(comciFails)throw Error('provider unavailable');return{grid:{},classTimes:[],grades:[1],classes:[1],schoolName:opts.school?.name||'충북과학고등학교',stale:false,fetchedAt:'now',weekStart:null}}};throw Error(name)}});return{get:(query:string,auth=true)=>exports.GET({nextUrl:new URL('https://app.cbgpu.com/api/timetable?'+query),headers:new Headers(auth?{Authorization:'Bearer synthetic'}:{})}),calls:()=>({nativeCalls,providerCalls,lastTarget}),deny:(status:number)=>nativeStatus=status,mode:(value:string)=>nativeMode=value,neis:()=>{validNeis=true;comciFails=true},comciRecovers:()=>{validNeis=true;comciFails=false},sheetCalls:()=>sheetCalls,middle:()=>{schoolType='MIDDLE_SCHOOL';validNeis=true},lastSheetTarget:()=>lastSheetTarget,sheetFailure:()=>{validNeis=true;missingComci=true;sheetFails=true}}}
test('fresh target membership checked before every timetable/cache access',async()=>{const app=api();let response=await app.get('school_id=school-a&grade=1&class=25');assert.equal(response.status,200);assert.equal(app.calls().lastTarget.id,'school-a');assert.equal(response.headers.get('cache-control'),'no-store');app.deny(403);response=await app.get('school_id=school-b');assert.equal(response.status,403);assert.equal(app.calls().nativeCalls,2);assert.equal(app.calls().providerCalls,1);app.deny(401);assert.equal((await app.get('school_id=school-a')).status,401);assert.equal(app.calls().providerCalls,1)});
test('no unsigned source overrides, implicit CBsh, or flag mismatch fallback',async()=>{const app=api();assert.equal((await app.get('school_id=school-a',false)).status,401);assert.equal((await app.get('school_id=school-a&school_code=71507')).status,400);assert.equal((await app.get('')).status,400);assert.equal((await app.get('school_id=school-a&grade=1abc')).status,400);assert.equal(app.calls().providerCalls,0);const legacy=api(false);assert.equal((await legacy.get('grade=1&class=1',false)).status,200);assert.equal(legacy.calls().lastTarget,undefined);assert.equal(legacy.calls().nativeCalls,0);assert.equal((await legacy.get('school_id=school-other',false)).status,503);assert.equal(legacy.calls().providerCalls,1)});

test('timetable rejects authority proxy HTML and oversized configuration before provider/cache access',async()=>{for(const mode of['html','large']){const app=api();app.mode(mode);assert.equal((await app.get('school_id=school-a')).status,503);assert.equal(app.calls().providerCalls,0)}});

test('only independently authorized matching school sources allow keyless Sheet fallback; departments stay explicit',async()=>{const f=api();f.neis();let response=await f.get('school_id=school-a');assert.equal(response.status,200);let value=await response.json();assert.equal(value.provider,'neis-sheet');assert.equal(value.selectionRequired,true);assert.deepEqual(value.grid,{});response=await f.get('school_id=school-a&department='+ 'a'.repeat(20));assert.equal((await response.json()).grid[2][7].subject,'선택 학과 수업');assert.equal(f.sheetCalls(),2);f.deny(403);assert.equal((await f.get('school_id=school-a')).status,403);assert.equal(f.sheetCalls(),2);assert.equal((await f.get('school_id=school-a&department=untrusted')).status,400);assert.equal(f.sheetCalls(),2)});

test('a direct Sheet provider failure is not retried or mislabeled as another school',async()=>{const f=api();f.sheetFailure();const response=await f.get('school_id=school-a');assert.equal(response.status,502);assert.equal((await response.json()).school_id,'school-a');assert.equal(f.sheetCalls(),1);assert.equal(f.calls().providerCalls,0)});

test('a chosen NEIS department cannot be silently replaced by a recovered Comcigan timetable',async()=>{const f=api();f.comciRecovers();const response=await f.get('school_id=school-a&department='+ 'b'.repeat(20));assert.equal(response.status,200);const data=await response.json();assert.equal(data.provider,'neis-sheet');assert.equal(data.grid[2][7].subject,'선택 학과 수업');assert.equal(f.sheetCalls(),1);assert.equal(f.calls().providerCalls,0);f.deny(403);assert.equal((await f.get('school_id=school-a&department='+ 'b'.repeat(20))).status,403);assert.equal(f.sheetCalls(),1)});

test('middle schools prefer healthy Comcigan and fall back to the authorized middle-school NEIS dataset',async()=>{const f=api();f.middle();let response=await f.get('school_id=school-a');assert.equal(response.status,200);assert.equal((await response.json()).school_id,'school-a');assert.equal(f.calls().providerCalls,1);assert.equal(f.sheetCalls(),0);f.neis();response=await f.get('school_id=school-a');assert.equal(response.status,200);assert.equal((await response.json()).provider,'neis-sheet');assert.equal(f.lastSheetTarget().schoolType,'MIDDLE_SCHOOL');assert.equal(neis.neisSheetDataset(f.lastSheetTarget()),'OPEN15120190408165334348844');f.deny(403);assert.equal((await f.get('school_id=school-b')).status,403);assert.equal(f.sheetCalls(),1)});
