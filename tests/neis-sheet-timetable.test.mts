import test from'node:test';import assert from'node:assert/strict';
import{neisSheetTargetFromSources,readNeisSheetPage,presentNeisSheet,getNeisSheetTimetable,neisSheetWeek,neisSheetForm,neisSheetPublicPage}from'../src/lib/neisSheetTimetable.ts';
const target={id:'school-test',name:'경북드론고등학교',office:'R10',code:'8750731'},week={start:'2026-11-16',end:'2026-11-20'},now=Date.parse('2026-11-18T03:00:00Z');
const row=(dept='드론전기과',period='1',date='20261118')=>({ATPT_OFCDC_SC_CODE:'R10',SD_SCHUL_CODE:'8750731',SCHUL_NM:'경북드론고등학교',ALL_TI_YMD:date,AY:'2026',SEM:'2',GRADE:'1',CLASS_NM:'1',PERIO:period,DDDEP_NM:dept,DGHT_CRSE_SC_NM:'주간',ORD_SC_NM:'공업계',CLRM_NM:'1',ITRT_CNTNT:dept+' 수업',LOAD_DTM:'20261118'});
test('NEIS targets require matching authorized READY source and official school/office identifiers',()=>{const dto={school_id:target.id,status:'READY',official_id:target.code,education_office_code:target.office,school_name:target.name};assert.deepEqual(neisSheetTargetFromSources(target.id,dto),target);for(const change of[{school_id:'other'},{status:'DISABLED'},{official_id:null},{education_office_code:'http://127.0.0.1'},{school_name:''}])assert.equal(neisSheetTargetFromSources(target.id,{...dto,...change}),null);assert.deepEqual(neisSheetWeek(now),week);const form=new URLSearchParams(neisSheetForm(target,week.start,week.end));assert.deepEqual(form.getAll('ALL_TI_YMD'),['20261116','20261120']);assert.equal(form.get('KEY'),null);assert.equal(form.get('AY'),'')});
test('complete Sheet payloads accept both public formats and reject wrong school, dates or partial totals',()=>{assert.equal(readNeisSheetPage({Data:[row()],Total:1},target,week.start,week.end).rows.length,1);assert.equal(readNeisSheetPage({data:[row()],total:1},target,week.start,week.end).total,1);for(const value of[{data:[{...row(),SD_SCHUL_CODE:'9999999'}],total:1},{data:[row('x','1','20261018')],total:1},{data:[{...row(),GRADE:'99'}],total:1},{data:[],total:99999},{error:{message:'bad'}}])assert.throws(()=>readNeisSheetPage(value,target,week.start,week.end))});
test('parallel departments never overwrite subjects or silently choose a department',()=>{const rows=[row(),row('드론전자과')];const result=presentNeisSheet(rows,target,1,1,null,week,new Date(now).toISOString());assert.equal(result.selectionRequired,true);assert.deepEqual(result.grid,{});assert.equal(result.departments.length,2);const choice=result.departments.find(d=>d.label.startsWith('드론전기과'))!.id,selected=presentNeisSheet(rows,target,1,1,choice,week,'now');assert.equal(selected.grid[2][1].subject,'드론전기과 수업');assert.equal(selected.grid[2][1].teacher,'');assert.deepEqual(selected.times,[]);assert.throws(()=>presentNeisSheet(rows,target,1,1,'unknown',week,'now'));assert.throws(()=>presentNeisSheet([row(),{...row(),ITRT_CNTNT:'conflict'}],target,1,1,choice,week,'now'),/여러 시간표/)});
test('bounded official pagination requires complete nonduplicated rows and deduplicates concurrent reads',async()=>{const rows=Array.from({length:112},(_,i)=>({...row(),GRADE:String(Math.floor(i/56)+1),CLASS_NM:String(Math.floor(i%56/7)+1),PERIO:String(i%7+1)}));let reads=0;const readPage=async(_form:string,page:number)=>{reads++;return{data:rows.slice((page-1)*100,page*100),total:rows.length}};const t={...target,id:'pagination'};const[a,b]=await Promise.all([getNeisSheetTimetable(t,1,1,null,{now,readPage}),getNeisSheetTimetable(t,1,1,null,{now,readPage})]);assert.equal(reads,2);assert.equal(Object.keys(a.grid[2]).length,7);assert.equal(b.school_id,'pagination');await assert.rejects(getNeisSheetTimetable({...target,id:'partial'},1,1,null,{now,readPage:async()=>({data:[row()],total:120})}),/전체 시간표/);await assert.rejects(getNeisSheetTimetable({...target,id:'repeated'},1,1,null,{now,readPage:async()=>({data:rows.slice(0,100),total:200})}),/중복/)});
test('fixed-provider transport rejects private DNS before opening any connection',async()=>{let requests=0;await assert.rejects(neisSheetPublicPage('rows=100',1,Date.now()+1000,{lookup:async()=>[{address:'127.0.0.1',family:4}]as any,request:()=>{requests++;throw Error('must not request')}}as any),/DNS_DENIED/);assert.equal(requests,0)});
test('KST Monday rollover uses a new week snapshot without reusing the previous school-week cache',async()=>{const sunday=Date.parse('2026-11-15T14:59:00Z'),monday=Date.parse('2026-11-15T15:01:00Z');assert.equal(neisSheetWeek(sunday).start,'2026-11-09');assert.equal(neisSheetWeek(monday).start,'2026-11-16');let reads=0;const readPage=async(form:string)=>{reads++;const date=new URLSearchParams(form).getAll('ALL_TI_YMD')[0];return{data:[row('일반과정','1',date)],total:1}};const school={...target,id:'rollover-audit'};const old=await getNeisSheetTimetable(school,1,1,null,{now:sunday,readPage});const fresh=await getNeisSheetTimetable(school,1,1,null,{now:monday,readPage});assert.equal(old.weekStart,'2026-11-09');assert.equal(fresh.weekStart,'2026-11-16');assert.equal(fresh.school_id,school.id);await getNeisSheetTimetable(school,1,1,null,{now:monday+1000,readPage});assert.equal(reads,2)});
