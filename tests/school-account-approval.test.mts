import test from'node:test';import assert from'node:assert/strict';import{build}from'esbuild';import vm from'node:vm';import{createRequire}from'node:module';import{schoolAccountApprovalScope,schoolAccountApprovalState}from'../src/lib/adminAccountSchools.ts';
const member='10000000-0000-4000-8000-000000000001',actor='20000000-0000-4000-8000-000000000001',target='30000000-0000-4000-8000-000000000001';
const school={membership_id:member,school_id:'school-b',school_name:'Synthetic school',status:'PENDING_VERIFICATION',membership_type:'STUDENT',student_number:'B007',verified:false};
const code=(await build({entryPoints:[new URL('../src/components/admin/SchoolAccountApproval.tsx',import.meta.url).pathname],bundle:true,platform:'node',format:'cjs',write:false,external:['react','react/jsx-runtime'],plugins:[{name:'synthetic-school-approval',setup(b){b.onResolve({filter:/^next\/link$|^@\/components\/ui\/button$|^@\/lib\/(useAuth|useAppFrame|alert|schoolsClient)$/},a=>({path:a.path,namespace:'fixture'}));b.onLoad({filter:/.*/,namespace:'fixture'},a=>({loader:'js',contents:a.path==='next/link'?'export default function Link(){return null}':a.path.endsWith('/button')?'export const Button=()=>null;':a.path.endsWith('/schoolsClient')?'export const schoolsRequest=()=>{throw Error("Real network forbidden")};':a.path.endsWith('/useAuth')?'export const useAuth=()=>({user:null});':a.path.endsWith('/useAppFrame')?'export const useAppFrame=()=>false;':'export const useAlert=()=>({});'}))}}]})).outputFiles[0].text;
const module={exports:{}}as{exports:any};vm.runInNewContext(code,{module,exports:module.exports,require:createRequire(import.meta.url)});const approve=module.exports.approveSchoolAccountMembership;
test('new school approval scope/status follows actual membership rather than legacy global approval',()=>{const account={is_approved:false,school_affiliations:[school]};assert.equal(schoolAccountApprovalScope(account).kind,'school');assert.equal(schoolAccountApprovalState(account),'unreviewed');assert.equal(schoolAccountApprovalState({...account,school_affiliations:[{...school,status:'ACTIVE',verified:true}]}),'approved');assert.equal(schoolAccountApprovalState({...account,account_status:'SUSPENDED'}),'restricted');assert.equal(schoolAccountApprovalScope({...account,school_affiliations:[school,{...school,school_id:'cbsh'}]}).kind,'select-school');assert.equal(schoolAccountApprovalScope({...account,school_affiliations:[school,{...school,school_id:'cbsh'}]},'school-b').school?.school_id,'school-b');assert.equal(schoolAccountApprovalScope({...account,school_affiliations:[{...school,school_id:'cbsh'}]}).kind,'legacy');assert.equal(schoolAccountApprovalScope({school_id:'school-b'}).kind,'unavailable')});
test('actual approval uses caller-bound native school membership PATCH and confirms all response identities',async()=>{let calls=0;const result=await approve(school,target,actor,async(path:string,method:string,body:any,publicRead:boolean,owner:string)=>{calls++;assert.equal(path,`schools/school-b/members/${member}`);assert.equal(method,'PATCH');assert.equal(body.action,'APPROVE');assert.equal(owner,actor);assert.equal(publicRead,false);return{membership:{id:member,user_id:target,school_id:'school-b',status:'ACTIVE',verified:true}}});assert.equal(result.status,'ACTIVE');assert.equal(calls,1)});
test('self approval, absent membership IDs, wrong scopes and stale approved rows never send writes',async()=>{for(const [s,user]of[[school,target],[{...school,membership_id:undefined},actor],[{...school,school_id:'cbsh'},actor],[{...school,status:'ACTIVE'},actor]]as const){let calls=0;await assert.rejects(()=>approve(s,target,user,async()=>{calls++;return{}}));assert.equal(calls,0)}});
test('revoked/nonadmin/cross-school denials and mismatched result never claim success',async()=>{for(const request of[async()=>{throw Error('403 denied')},async()=>({membership:{id:member,user_id:target,school_id:'foreign',status:'ACTIVE',verified:true}}),async()=>({membership:{id:member,user_id:actor,school_id:'school-b',status:'ACTIVE',verified:true}}),async()=>({membership:{id:member,user_id:target,school_id:'school-b',status:'PENDING_VERIFICATION',verified:false}})])await assert.rejects(()=>approve(school,target,actor,request))});
