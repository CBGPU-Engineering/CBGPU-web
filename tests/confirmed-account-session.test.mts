import test from 'node:test';import assert from 'node:assert/strict';import{confirmedAccountSession}from'../src/lib/confirmedAccountSession.ts';import{createAccountReadFence}from'../src/lib/accountReadFence.ts';
test('a delayed session for B cannot execute the destructive action confirmed as A',async()=>{const fence=createAccountReadFence();fence.setOwner('A');const lease=fence.lease('A');let resolve!:(value:any)=>void,deleted=0;const read=()=>new Promise<any>(r=>{resolve=r});const action=(async()=>{await confirmedAccountSession('A',lease,read);deleted++})();fence.setOwner('B');resolve({data:{session:{user:{id:'B'},access_token:'fixture-B'}}});await assert.rejects(action,/계정/);assert.equal(deleted,0)});
test('A to B to A does not revive a pending confirmation or an unmounted operation',async()=>{const fence=createAccountReadFence();fence.setOwner('A');const lease=fence.lease('A');fence.setOwner('B');fence.setOwner('A');let reads=0;await assert.rejects(confirmedAccountSession('A',lease,async()=>{reads++;return{data:{session:{user:{id:'A'},access_token:'fixture-A'}}}}));assert.equal(reads,0)});
test('same-account confirmation preserves its original bearer for the explicit action',async()=>{const fence=createAccountReadFence();fence.setOwner('A');const session=await confirmedAccountSession('A',fence.lease('A'),async()=>({data:{session:{user:{id:'A'},access_token:'fixture-A'}}}));assert.equal(session.access_token,'fixture-A')});
