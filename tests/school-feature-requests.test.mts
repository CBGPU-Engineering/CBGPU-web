import test from'node:test';import assert from'node:assert/strict';import{readFileSync}from'node:fs';import vm from'node:vm';import ts from'typescript';
const exports:Record<string,any>={};vm.runInNewContext(ts.transpileModule(readFileSync(new URL('../src/lib/schoolFeatureRequests.ts',import.meta.url),'utf8'),{compilerOptions:{module:ts.ModuleKind.CommonJS}}).outputText,{exports,Error});
test('feature review exposes only real server transitions and closed records have no mutation',()=>{for(const [state,allowed]of Object.entries({PENDING:['REVIEWING','ACCEPTED','REJECTED'],REVIEWING:['ACCEPTED','REJECTED'],ACCEPTED:['DELIVERED','REJECTED'],DELIVERED:[],REJECTED:[]}))assert.equal(JSON.stringify(exports.featureReviewDecisions(state)),JSON.stringify(allowed));});
test('provider acceptance is never labeled inbox delivery and failed email retains request',()=>{assert.match(exports.notificationMeaning('SENT'),/inbox delivery is not confirmed/);assert.match(exports.notificationMeaning('FAILED'),/saved request remains/);assert.match(exports.notificationMeaning('PENDING'),/queued/);assert.match(exports.notificationMeaning(null),/unavailable/);});
test('operator uses scoped revision contract and no automatic module grant endpoint',()=>{const s=readFileSync(new URL('../src/components/schools/PlatformFeatureRequests.tsx',import.meta.url),'utf8');assert.match(s,/revision:review\.revision,decision,operator_message/);assert.match(s,/false,user\.id/);assert.doesNotMatch(s,/\/configuration|setInterval|localStorage|service_role/);assert.match(s,/Platform access required/);});

test('operator fallback chrome stays English while retaining safe server diagnostics',()=>{assert.equal(exports.featureOperatorError(new Error('계정이 바뀌었어요.'),'Check current platform access.'),'Check current platform access.');assert.equal(exports.featureOperatorError(new Error('Revision conflict'),'Fallback'),'Revision conflict');});
