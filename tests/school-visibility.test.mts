import test from'node:test';import assert from'node:assert/strict';import{schoolServiceVisible,type SchoolMenuScope}from'../src/lib/schoolVisibility.ts';
const scope=(id:string,features:string[],nodes=0):SchoolMenuScope=>({status:'ready',school:{id,features,gpu:{nodes}}});
test('legacy disabled rollout leaves every existing menu unchanged',()=>{for(const path of ['/study','/wakeup','/dashboard','/notes','/server'])assert.equal(schoolServiceVisible({status:'legacy',school:null},path),true)});
test('loading or lost membership hides school readers while personal projects remain accessible',()=>{for(const status of ['loading','unavailable','none']as const){for(const path of ['/study','/timetable','/manufacturing/laser','/dashboard'])assert.equal(schoolServiceVisible({status,school:null},path),false);for(const path of ['/notes','/latex','/server','/deploy','/ai'])assert.equal(schoolServiceVisible({status,school:null},path),true)}});
test('other-school metadata cannot opt into CBsh-only connections; no GPU means unconfigured not error',()=>{const value=scope('other',['school_life','gpu_compute','projects']);assert.equal(schoolServiceVisible(value,'/study'),false);assert.equal(schoolServiceVisible(value,'/meal'),false);assert.equal(schoolServiceVisible(value,'/dashboard'),false);assert.equal(schoolServiceVisible(value,'/server/owned-project'),true)});
test('verified server scope still needs enabled module and configured node',()=>{assert.equal(schoolServiceVisible(scope('cbsh',['school_life']),'/study/contribute'),true);assert.equal(schoolServiceVisible(scope('cbsh',[]),'/study'),false);assert.equal(schoolServiceVisible(scope('other',['gpu_compute'],1),'/dashboard'),true);assert.equal(schoolServiceVisible(scope('other',[],1),'/dashboard'),false)});
