import test from'node:test';import assert from'node:assert/strict';import{schoolServiceVisible,type SchoolMenuScope}from'../src/lib/schoolVisibility.ts';
const scope=(id:string,features:string[],nodes=0):SchoolMenuScope=>({status:'ready',school:{id,features,gpu:{nodes}}});
test('legacy disabled rollout leaves every existing menu unchanged',()=>{for(const path of ['/study','/wakeup','/dashboard','/notes','/server'])assert.equal(schoolServiceVisible({status:'legacy',school:null},path),true)});
test('loading or lost membership hides school readers while personal projects remain accessible',()=>{for(const status of ['loading','unavailable','none']as const){for(const path of ['/study','/timetable','/manufacturing/laser','/dashboard'])assert.equal(schoolServiceVisible({status,school:null},path),false);for(const path of ['/notes','/latex','/server','/deploy','/ai'])assert.equal(schoolServiceVisible({status,school:null},path),true)}});
test('other-school metadata cannot opt into CBsh-only connections; no GPU means unconfigured not error',()=>{const value=scope('other',['school_life','gpu_compute','projects']);assert.equal(schoolServiceVisible(value,'/study'),false);assert.equal(schoolServiceVisible(value,'/meal'),false);assert.equal(schoolServiceVisible(value,'/dashboard'),false);assert.equal(schoolServiceVisible(value,'/server/owned-project'),true)});
test('verified server scope still needs enabled module and configured node',()=>{assert.equal(schoolServiceVisible(scope('cbsh',['school_life']),'/study/contribute'),true);assert.equal(schoolServiceVisible(scope('cbsh',[]),'/study'),false);assert.equal(schoolServiceVisible(scope('other',['gpu_compute'],1),'/dashboard'),true);assert.equal(schoolServiceVisible(scope('other',[],1),'/dashboard'),false)});
test('configured other-school timetable/meal work while CBsh-only integrations stay exclusive',()=>{const configured:SchoolMenuScope={status:'ready',school:{id:'other',features:['school_life','cbsh_eduset','cbsh_wakeup'],life_capabilities:{timetable:true,meal:true,news:true}}};assert.equal(schoolServiceVisible(configured,'/timetable'),true);assert.equal(schoolServiceVisible(configured,'/meal'),true);assert.equal(schoolServiceVisible(configured,'/study'),false);assert.equal(schoolServiceVisible(configured,'/wakeup'),false);assert.equal(schoolServiceVisible(configured,'/dashboard'),false);const cbsh:SchoolMenuScope={status:'ready',school:{id:'cbsh',features:['school_life'],life_capabilities:{timetable:true,meal:false,news:false}}};assert.equal(schoolServiceVisible(cbsh,'/study'),false);assert.equal(schoolServiceVisible(cbsh,'/meal'),false)});
test('messenger entry follows fresh effective community membership without granting guest or legacy access',()=>{const member:SchoolMenuScope={status:'ready',school:{id:'school-b',features:['community']},resource:{status:'ready',serverNow:Date.now(),access:null,current:{school_id:'school-b',school:{id:'school-b',official_name:'Synthetic',display_name:'Synthetic',type:'HIGH_SCHOOL',region:'Synthetic',features:['community']},type:'MEMBERSHIP',membership_id:'own',resources:[],expires_at:null,can_administer:false}}};assert.equal(schoolServiceVisible(member,'/messages'),true);assert.equal(schoolServiceVisible({...member,resource:{...member.resource!,current:{...member.resource!.current!,school:{...member.resource!.current!.school,features:[]}}}},'/messages'),false);assert.equal(schoolServiceVisible({...member,resource:{...member.resource!,current:{...member.resource!.current!,type:'GUEST'}}},'/messages'),false);assert.equal(schoolServiceVisible({...member,resource:{...member.resource!,status:'loading'}},'/messages'),false);assert.equal(schoolServiceVisible({...member,resource:{...member.resource!,current:{...member.resource!.current!,school_id:'other'}}},'/messages'),false);assert.equal(schoolServiceVisible({status:'legacy',school:null},'/messages'),false);assert.equal(schoolServiceVisible({status:'none',school:null},'/messages'),false)});
