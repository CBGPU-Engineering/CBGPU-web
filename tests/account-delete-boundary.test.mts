import test from 'node:test';import assert from 'node:assert/strict';import fs from 'node:fs';import vm from 'node:vm';import ts from 'typescript';
import {boundedSchoolBody} from '../src/lib/schoolsProxySecurity.ts';
import {trustedInternalServiceUrl} from '../src/lib/internalServiceUrl.ts';
const A='00000000-0000-4000-8000-000000000101',B='00000000-0000-4000-8000-000000000102';
const code=ts.transpileModule(fs.readFileSync(new URL('../src/app/api/account/delete/route.ts',import.meta.url),'utf8'),{compilerOptions:{module:ts.ModuleKind.CommonJS,target:ts.ScriptTarget.ES2022}}).outputText;
function fixture(){const state={actor:A,active:true,unavailable:false},calls={scrub:[]as string[],deleted:[]as string[],sessions:0};const exports:any={};
 const admin={from:()=>({update:()=>({eq:async(_key:string,id:string)=>{calls.scrub.push(id);return{error:null}}})}),auth:{admin:{deleteUser:async(id:string)=>{calls.deleted.push(id);return{error:null}}}}};
 vm.runInNewContext(code,{exports,URL,Response,AbortSignal,process:{env:{SUPABASE_INTERNAL_URL:'http://127.0.0.1:54321',NEXT_PUBLIC_SUPABASE_ANON_KEY:'fixture-anon',SUPABASE_SERVICE_ROLE_KEY:'fixture-service'}},fetch:async()=>{throw Error('No external calls')},require(name:string){if(name==='next/server')return{NextResponse:{json:(body:unknown,init?:ResponseInit)=>Response.json(body,init)}};if(name==='@supabase/supabase-js')return{createClient:(_url:string,key:string)=>key==='fixture-service'?admin:{auth:{getUser:async()=>({data:{user:{id:state.actor}},error:null})}}};if(name==='@/lib/deployAuth')return{activeDeploymentSession:async()=>{calls.sessions++;if(state.unavailable)throw Error('private-provider-error');return state.active}};if(name==='@/lib/internalServiceUrl')return{trustedInternalServiceUrl};if(name==='@/lib/schoolsProxySecurity')return{boundedSchoolBody};throw Error('Unexpected dependency '+name)}});
 const post=(expected?:string,emptyBody=false)=>exports.POST(new Request('https://cbgpu.com/api/account/delete',{method:'POST',headers:{Authorization:'Bearer fixture-caller',...(expected?{'Content-Type':'application/json'}:{})},body:expected?JSON.stringify({expected_user_id:expected}):emptyBody?'':undefined}));return{state,calls,post};}
test('intent for A cannot delete the newly authenticated B account',async()=>{const f=fixture();f.state.actor=B;assert.equal((await f.post(A)).status,409);assert.deepEqual(f.calls.deleted,[]);assert.deepEqual(f.calls.scrub,[])});
test('revoked and unavailable sessions perform zero privileged mutations',async()=>{const f=fixture();f.state.active=false;assert.equal((await f.post(A)).status,401);f.state.unavailable=true;const r=await f.post(A);assert.equal(r.status,503);assert.doesNotMatch(await r.text(),/private-provider/);assert.deepEqual(f.calls.deleted,[]);assert.deepEqual(f.calls.scrub,[])});
test('an active confirmed caller and an active legacy no-body caller can only delete themselves',async()=>{const f=fixture();assert.equal((await f.post(A)).status,200);assert.equal((await f.post()).status,200);assert.equal((await f.post(undefined,true)).status,200);assert.deepEqual(f.calls.deleted,[A,A,A]);assert.deepEqual(f.calls.scrub,[A,A,A]);assert.equal(f.calls.sessions,3)});
