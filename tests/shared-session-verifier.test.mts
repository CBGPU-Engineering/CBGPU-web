import test from 'node:test';import assert from 'node:assert/strict';import fs from 'node:fs';import ts from 'typescript';
const js=ts.transpileModule(fs.readFileSync(new URL('../src/lib/sharedSessionVerifier.ts',import.meta.url),'utf8'),{compilerOptions:{module:ts.ModuleKind.ES2022,target:ts.ScriptTarget.ES2022}}).outputText;
const {createSharedSessionVerifier}=await import('data:text/javascript;base64,'+Buffer.from(js).toString('base64'));
const enc=(v:unknown)=>Buffer.from(JSON.stringify(v)).toString('base64url');const token=(sub='owner',exp=Math.floor(Date.now()/1000)+3600)=>enc({alg:'fixture'})+'.'+enc({sub,exp})+'.fixture';
const value=(access=token())=>JSON.stringify({access_token:access,refresh_token:'fixture-refresh-token',user:{id:'attacker-chosen',is_admin:true}});
test('session user is replaced with Auth-verified identity, never client metadata',async()=>{const verify=createSharedSessionVerifier(()=>({auth:{getUser:async()=>({data:{user:{id:'owner',email:'verified@example.invalid'}},error:null})}}));const r=JSON.parse((await verify(value())).value);assert.equal(r.user.id,'owner');assert.equal(r.user.is_admin,undefined);});
test('expired shared session refreshes once across concurrent broker requests',async()=>{let calls=0;const verify=createSharedSessionVerifier(()=>({auth:{getUser:async()=>({data:{user:{id:'owner'}},error:null}),refreshSession:async()=>{calls++;await new Promise(r=>setTimeout(r,10));return{data:{session:{access_token:token(),refresh_token:'rotated-fixture-refresh',user:{id:'owner'},expires_at:Math.floor(Date.now()/1000)+3600}},error:null}}}}));const results=await Promise.all(Array.from({length:10},()=>verify(value(token('owner',Math.floor(Date.now()/1000)-60)))));assert.equal(calls,1);assert.ok(results.every(r=>JSON.parse(r.value).refresh_token==='rotated-fixture-refresh'));});
test('near-expiry refresh occurs before SDK margin without waiting for expiry',async()=>{let calls=0;const verify=createSharedSessionVerifier(()=>({auth:{getUser:async()=>({data:{user:{id:'owner'}},error:null}),refreshSession:async()=>{calls++;return{data:{session:{access_token:token(),refresh_token:'rotated-fixture-refresh',user:{id:'owner'},expires_at:Math.floor(Date.now()/1000)+3600}},error:null}}}}));await verify(value(token('owner',Math.floor(Date.now()/1000)+100)));assert.equal(calls,1);});
test('forged/revoked access token never becomes a shared cookie session',async()=>{const verify=createSharedSessionVerifier(()=>({auth:{getUser:async()=>({data:{user:null},error:Error('revoked')})}}));await assert.rejects(verify(value()));});
test('refresh identity mismatch is rejected and failed refresh can retry',async()=>{let calls=0;const verify=createSharedSessionVerifier(()=>({auth:{refreshSession:async()=>{calls++;return{data:{session:{access_token:token('other'),refresh_token:'other-refresh-token',user:{id:'other'},expires_at:9999999999}},error:null}}}}));const expired=value(token('owner',1));await assert.rejects(verify(expired));await assert.rejects(verify(expired));assert.equal(calls,2);});
test('verification cache is bound to both credentials and never mixes sessions',async()=>{let calls=0;const verify=createSharedSessionVerifier(()=>({auth:{getUser:async()=>{calls++;return{data:{user:{id:'owner'}},error:null}}}}));await Promise.all([verify(value()),verify(value())]);assert.equal(calls,1);await verify(JSON.stringify({...JSON.parse(value()),refresh_token:'second-fixture-refresh'}));assert.equal(calls,2);});
