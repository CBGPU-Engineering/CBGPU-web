import test from 'node:test';import assert from 'node:assert/strict';import fs from 'node:fs/promises';import os from 'node:os';import path from 'node:path';import vm from 'node:vm';import ts from 'typescript';import {timetableWarmAuthorized,timetableWarmInput,timetableWarmTarget} from '../src/lib/timetableWarm.ts';import {trustedInternalServiceUrl} from '../src/lib/internalServiceUrl.ts';
test('private warm secret is dedicated, bounded, mode600, no symlink, constant-time hash equality',async()=>{const dir=await fs.mkdtemp(path.join(os.tmpdir(),'cbgpu-warm-')),file=path.join(dir,'secret'),secret='a'.repeat(64);try{await fs.writeFile(file,secret,{mode:0o600});assert.equal(await timetableWarmAuthorized(secret,file),true);assert.equal(await timetableWarmAuthorized('wrong',file),false);assert.equal(await timetableWarmAuthorized(null,file),false);await fs.symlink(file,path.join(dir,'alias'));await assert.rejects(timetableWarmAuthorized(secret,path.join(dir,'alias')));await fs.chmod(file,0o644);await assert.rejects(timetableWarmAuthorized(secret,file))}finally{await fs.rm(dir,{recursive:true,force:true})}});
test('only explicit canonical approved configured identity constructs warm target',()=>{const summary={id:'cbsh',official_name:'충북과학고등학교',region:'충청북도',status:'APPROVED',features:['school_life'],life_capabilities:{timetable:true}};assert.equal(timetableWarmTarget('cbsh',{school:summary}).region,'충북');assert.throws(()=>timetableWarmTarget('school-b',{school:{...summary,id:'school-b'}}));for(const bad of [{...summary,official_name:'Other school'},{...summary,region:'서울'},{...summary,official_id:'8000000'},{...summary,id:'school-b'},{...summary,status:'LISTED'},{...summary,features:[]},{...summary,life_capabilities:{timetable:'true'}}])assert.throws(()=>timetableWarmTarget('cbsh',{school:bad}));assert.deepEqual(timetableWarmInput({school_id:'cbsh',grade:1,class:1}),{school_id:'cbsh',grade:1,class:1});for(const bad of [{grade:1,class:1},{school_id:'b',grade:0,class:1},{school_id:'b',grade:1,class:1,url:'https://evil.invalid'}])assert.throws(()=>timetableWarmInput(bad))});
const code=ts.transpileModule(await fs.readFile(new URL('../src/app/api/cron/timetable-warm/route.ts',import.meta.url),'utf8'),{compilerOptions:{module:ts.ModuleKind.CommonJS,target:ts.ScriptTarget.ES2022}}).outputText;
test('actual POST handler authenticates before reads, canonical source only, no secret/provider payload returned or forwarded',async()=>{let authorized=false,sourceStatus=200,stale=false,fetches=0,provider=0;const exports:any={};vm.runInNewContext(code,{exports,process:{env:{CBGPU_TIMETABLE_WARM_SECRET_FILE:'/private/key'}},AbortSignal,URL,fetch:async(url:URL,opts:any)=>{fetches++;assert.equal(url.href,'http://127.0.0.1:3546/v1/schools/cbsh');assert.deepEqual(Object.keys(opts.headers),['Accept']);assert.equal(opts.redirect,'error');assert.equal(opts.cache,'no-store');return Response.json({school:{id:'cbsh',official_name:'충북과학고등학교',region:'충북',status:'APPROVED',features:['school_life'],life_capabilities:{timetable:true}}},{status:sourceStatus})},require(name:string){if(name==='next/server')return{NextResponse:{json:(body:any,opts:any)=>Response.json(body,opts)}};if(name==='@/lib/timetableWarm')return{timetableWarmAuthorized:async()=>authorized,timetableWarmInput,timetableWarmTarget};if(name==='@/lib/internalServiceUrl')return{trustedInternalServiceUrl};if(name==='@/lib/schoolsProxySecurity')return{boundedSchoolBody:async(body:ReadableStream)=>new Response(body).text()};if(name==='@/lib/comcigan')return{getTimetable:async(_g:number,_c:number,opts:any)=>{provider++;assert.equal(opts.school.id,'cbsh');assert.equal(opts.forceRefresh,true);return{grid:{0:{1:{subject:'PRIVATE SUBJECT',teacher:'PRIVATE TEACHER'}}},stale}}};throw Error(name)}});const request=(id='cbsh')=>({headers:new Headers({'x-cbgpu-timetable-warm':'secret-not-forwarded'}),nextUrl:new URL('https://cbgpu.com/api/cron/timetable-warm'),body:new Response(JSON.stringify({school_id:id,grade:1,class:1})).body});let r=await exports.POST(request());assert.equal(r.status,401);assert.equal(fetches,0);authorized=true;r=await exports.POST(request('school-b'));assert.equal(r.status,409);assert.equal((await r.json()).code,'UNREVIEWED_WARM_TARGET');assert.equal(fetches,0);r=await exports.POST(request());assert.equal(r.status,200);assert.deepEqual(await r.json(),{ok:true,school_id:'cbsh',days:1,cells:1,stale:false});assert.equal(r.headers.get('cache-control'),'private, no-store');sourceStatus=403;r=await exports.POST(request());assert.equal(r.status,503);assert.equal(provider,1);sourceStatus=200;stale=true;r=await exports.POST(request());assert.equal(r.status,503);assert.equal(JSON.stringify(await r.json()).includes('PRIVATE'),false)});
