import test from 'node:test';import assert from 'node:assert/strict';import {schoolLifeRead} from '../src/lib/schoolLifeRead.ts';
const original=globalThis.fetch;
test('school reads preserve JSON denials and enforce read-only requests',async()=>{let calls=0;globalThis.fetch=async(_url,init)=>{calls++;assert.equal(init?.cache,'no-store');assert.equal(init?.redirect,'error');return Response.json({error:'Denied',school_id:'cbsh'},{status:403})};try{const result=await schoolLifeRead('/api/meal?date=20261118');assert.equal(result.response.status,403);assert.equal(result.value.error,'Denied');await assert.rejects(schoolLifeRead('/api/meal',{method:'POST'}));await assert.rejects(schoolLifeRead('https://example.invalid/api/meal'));assert.equal(calls,1)}finally{globalThis.fetch=original}});
test('HTML, invalid JSON and missing objects never surface proxy contents',async()=>{try{for(const body of ['<!DOCTYPE html>secret proxy page','{','null','[]']){globalThis.fetch=async()=>new Response(body,{headers:{'content-type':body.startsWith('<')?'text/html':'application/json'}});await assert.rejects(schoolLifeRead('/api/timetable'),error=>error instanceof Error&&!error.message.includes('Unexpected')&&!error.message.includes('secret')&&error.message.includes('다시'))}}finally{globalThis.fetch=original}});
test('deadline covers stalled headers without issuing a retry',async()=>{let calls=0;globalThis.fetch=()=>{calls++;return new Promise(()=>{})};try{await assert.rejects(schoolLifeRead('/api/timetable',{},20),/지연/);assert.equal(calls,1)}finally{globalThis.fetch=original}});
test('deadline covers stalled response bodies and respects caller cancellation',async()=>{let calls=0;globalThis.fetch=async()=>{calls++;return new Response(new ReadableStream({start(c){c.enqueue(new TextEncoder().encode('{"grid":'))}}),{headers:{'content-type':'application/json'}})};try{await assert.rejects(schoolLifeRead('/api/timetable',{},20),/지연/);const abort=new AbortController();const request=schoolLifeRead('/api/meal',{signal:abort.signal},1000);abort.abort();await assert.rejects(request,/다시/);assert.equal(calls,2)}finally{globalThis.fetch=original}});
