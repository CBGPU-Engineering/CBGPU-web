import test from'node:test';import assert from'node:assert/strict';import{clubCampaignPayload,clubError}from'../src/lib/clubsModel.ts';
// Client helper validation does not decide current availability; server flags remain authoritative.
const draft={title:'두 번째 수시 모집',registration_starts_at:'2027-04-01T09:00',registration_ends_at:'2027-04-10T18:00',promotion_starts_at:'2027-04-05T09:00',promotion_ends_at:'2027-04-20T18:00',application_starts_at:'2027-04-07T09:00',application_ends_at:'2027-04-18T18:00'};
test('club campaign permits arbitrary rounds and overlapping registration/promotion periods',()=>{const value=clubCampaignPayload(draft);assert.equal(value.title,draft.title);assert.equal(value.confirmed,true);assert.equal('school_year'in value,false);assert.match(value.registration_starts_at,/Z$/)});
test('club period constraints keep application within promotion without inventing annual order',()=>{assert.throws(()=>clubCampaignPayload({...draft,application_ends_at:'2027-04-21T18:00'}),/홍보 공개 기간 안/);assert.throws(()=>clubCampaignPayload({...draft,registration_ends_at:draft.registration_starts_at}),/시작 시각보다/);assert.throws(()=>clubCampaignPayload({...draft,promotion_starts_at:''}),/모든 시작/)});
test('unknown club errors do not reveal raw SQL/provider detail',()=>{assert.doesNotMatch(clubError(Error('SELECT private.applicant')),/SELECT|applicant/)})
test('KST dates have fixed UTC conversion and reject normalized invalid calendar dates',async()=>{const{clubKstInstant,clubLocalDate}=await import('../src/lib/clubsModel.ts');assert.equal(clubKstInstant('2026-11-24T09:00'),'2026-11-24T00:00:00.000Z');assert.equal(clubLocalDate('2026-11-24T00:00:00Z'),'2026-11-24T09:00');assert.throws(()=>clubKstInstant('2027-02-30T09:00'),/날짜와 시각/)});
test('club page refuses foreign school, dangling campaign and untyped authorization flags',async()=>{const{readClubsPage}=await import('../src/lib/clubsModel.ts');const campaign={...clubCampaignPayload(draft),id:'round-one',status:'ACTIVE',revision:1,registration_open:false,promotion_open:false,application_open:false,next_at:null};const club={id:'club-one',school_id:'school-a',campaign_id:'round-one',owner_id:'actor-a',title:'Test',description:'Draft',application_prompt:'Why?',capacity:null,status:'DRAFT',revision:1,published:false,can_manage:true,can_submit_ready:false,can_edit:true,can_withdraw:true,can_apply:false,my_application:null};const value={school_id:'school-a',server_now:'2026-11-24T00:00:00Z',can_manage_campaigns:false,campaigns:[campaign],items:[club],total:1};assert.equal(readClubsPage(value,'school-a').items.length,1);for(const modified of[{...club,school_id:'school-b'},{...club,campaign_id:'unknown'},{...club,can_apply:'true'}])assert.throws(()=>readClubsPage({...value,items:[modified]},'school-a'),/응답/);assert.throws(()=>readClubsPage({...value,items:Array(51).fill(club)},'school-a'),/응답/)});
