import test from'node:test';import assert from'node:assert/strict';import{trustedInternalServiceUrl}from'../src/lib/internalServiceUrl.ts';
test('loopback is default and operator-only private container DNS needs explicit opt-in',()=>{assert.equal(trustedInternalServiceUrl('http://127.0.0.1:3547').port,'3547');assert.equal(trustedInternalServiceUrl('http://[::1]:3546').hostname,'[::1]');assert.throws(()=>trustedInternalServiceUrl('http://cbgpu-schools:3546'));assert.equal(trustedInternalServiceUrl('http://cbgpu-schools:3546','private-container').hostname,'cbgpu-schools');for(const url of ['http://example.com','http://169.254.169.254','http://10.0.0.2','https://cbgpu-schools','http://user:secret@cbgpu-schools'])assert.throws(()=>trustedInternalServiceUrl(url,'private-container'))});
