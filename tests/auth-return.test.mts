import test from'node:test';import assert from'node:assert/strict';import{safeAuthReturn}from'../src/lib/authReturn.ts';
test('retains a safe internal page and explicit UI anchor only',()=>{assert.equal(safeAuthReturn('/contests/11111111-1111-4111-8111-111111111111#participation'),'/contests/11111111-1111-4111-8111-111111111111#participation');assert.equal(safeAuthReturn('/services?query=school'),' /services?query=school'.trim());assert.equal(safeAuthReturn('/?mode=researcher&native=1'),'/?mode=researcher&native=1')});
test('rejects external, scheme-relative, controls and repeatedly encoded redirect forms',()=>{for(const value of ['https://evil.invalid','javascript:alert(1)','//evil.invalid','/\\evil.invalid','/%2fevil.invalid','/%252fevil.invalid','/%255cevil.invalid','/%0aevil','/%250aevil','/\u0000evil','/api/account/delete','/backend/auth/v1/token','/auth/transfer?code=secret','/#access_token=secret','/?refresh_token=secret','/?answers[question]=private','/%zz'])assert.equal(safeAuthReturn(value),'/',value)});

test("encoded protected endpoints and dot segments cannot become login return pages",()=>{for(const value of ["/%2561pi/account/delete","/%2562ackend/auth/v1/token","/contests/%252e%252e/auth/transfer","/%255fauth/../api/delete","/%2561uth/callback","/?%2563ode=private","/?%2574oken=private"])assert.equal(safeAuthReturn(value),"/",value)});
