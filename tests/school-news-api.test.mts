import test from'node:test';import assert from'node:assert/strict';import fs from'node:fs';import vm from'node:vm';import ts from'typescript';
import*as source from'../src/lib/schoolNewsSource.ts';import*as calendar from'../src/lib/schoolCalendar.ts';import{trustedInternalServiceUrl}from'../src/lib/internalServiceUrl.ts';
const code=ts.transpileModule(fs.readFileSync(new URL('../src/app/api/school-news/route.ts',import.meta.url),'utf8'),{compilerOptions:{module:ts.ModuleKind.CommonJS,target:ts.ScriptTarget.ES2022}}).outputText;
function fixture(multi=true){let status=200,providerCalls=0,nativeCalls=0,invalid=false;const exports:any={};vm.runInNewContext(code,{exports,URL,AbortSignal,Date,process:{env:{CBGPU_MULTISCHOOL_V1:multi?'1':'0'}},fetch:async(url:URL,options:any)=>{nativeCalls++;assert.equal(options.headers.Authorization,'Bearer fixture');const id=url.pathname.split('/')[3];return Response.json({school_id:id,status:'READY',school_name:'학교 B',news_url:'https://school.example.org/notice.rss',allowed_hosts:['school.example.org']},{status})},require(name:string){if(name==='next/server')return{NextResponse:{json:(body:any,opts:any)=>Response.json(body,opts)}};if(name==='@/lib/schoolNewsSource')return source;if(name==='@/lib/schoolCalendar')return calendar;if(name==='@/lib/internalServiceUrl')return{trustedInternalServiceUrl};if(name==='@/lib/schoolsProxySecurity')return{boundedSchoolBody:async(body:ReadableStream)=>new Response(body).text()};if(name==='@/lib/publicSchoolFetch')return{publicSchoolText:async(url:string,hosts:string[])=>{providerCalls++;if(multi){assert.equal(url,'https://school.example.org/notice.rss');assert.deepEqual(Array.from(hosts),['school.example.org'])}return invalid?'<html>maintenance</html>':'<rss><channel><item><title>안내</title><link>https://school.example.org/notice/1</link></item></channel></rss>'}};throw Error(name)}});return{get:(query:string,auth=true)=>exports.GET({nextUrl:new URL('https://app.cbgpu.com/api/school-news?'+query),headers:new Headers(auth?{Authorization:'Bearer fixture'}:{})}),deny:(value:number)=>status=value,invalid:()=>invalid=true,calls:()=>({nativeCalls,providerCalls})}}
test('school news authenticates every read and never falls back after membership revocation',async()=>{const f=fixture();let res=await f.get('school_id=school-b');assert.equal(res.status,200);assert.equal((await res.json()).school.id,'school-b');assert.equal(res.headers.get('cache-control'),'no-store');f.deny(403);assert.equal((await f.get('school_id=school-b')).status,403);f.deny(401);assert.equal((await f.get('school_id=school-b')).status,401);assert.deepEqual(f.calls(),{nativeCalls:3,providerCalls:1})});
test('unsigned, absent, unconfigured sources and invalid formats do not expose other school data',async()=>{const f=fixture();assert.equal((await f.get('school_id=school-b',false)).status,401);assert.equal((await f.get('')).status,400);assert.equal((await f.get('school_id=school-b&type=schedule')).status,409);assert.equal(f.calls().providerCalls,0);f.invalid();assert.equal((await f.get('school_id=school-b')).status,502);const legacy=fixture(false);assert.equal((await legacy.get('school_id=school-b',false)).status,409);assert.equal(legacy.calls().providerCalls,0)});
