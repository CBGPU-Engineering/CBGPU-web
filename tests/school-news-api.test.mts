import test from'node:test';import assert from'node:assert/strict';import fs from'node:fs';import vm from'node:vm';import ts from'typescript';
import*as feed from'../src/lib/schoolNewsFeed.ts';import*as gyo6 from'../src/lib/schoolCalendarGyo6.ts';
import*as source from'../src/lib/schoolNewsSource.ts';import*as calendar from'../src/lib/schoolCalendar.ts';import{trustedInternalServiceUrl}from'../src/lib/internalServiceUrl.ts';
const code=ts.transpileModule(fs.readFileSync(new URL('../src/app/api/school-news/route.ts',import.meta.url),'utf8'),{compilerOptions:{module:ts.ModuleKind.CommonJS,target:ts.ScriptTarget.ES2022}}).outputText;
function fixture(multi=true){let status=200,providerCalls=0,nativeCalls=0,invalid=false,nativeMode='json',sourceOverride:any=null,providerOverride:string|null=null;const exports:any={};vm.runInNewContext(code,{exports,URL,AbortSignal,Date,process:{env:{CBGPU_MULTISCHOOL_V1:multi?'1':'0'}},fetch:async(url:URL,options:any)=>{nativeCalls++;assert.equal(options.headers.Authorization,'Bearer fixture');assert.equal(options.headers.Accept,'application/json');assert.equal(options.redirect,'error');if(nativeMode==='html')return new Response('<!DOCTYPE html>',{headers:{'Content-Type':'text/html'}});if(nativeMode==='malformed')return new Response('{broken',{headers:{'Content-Type':'application/json'}});if(nativeMode==='redirect')throw Error('redirect');const id=url.pathname.split('/')[3];return Response.json({school_id:id,status:'READY',school_name:'학교 B',news_url:'https://school.example.org/notice.rss',allowed_hosts:['school.example.org'],...sourceOverride},{status})},require(name:string){if(name==='next/server')return{NextResponse:{json:(body:any,opts:any)=>Response.json(body,opts)}};if(name==='@/lib/schoolNewsFeed')return feed;if(name==='@/lib/schoolCalendarGyo6')return gyo6;if(name==='@/lib/schoolNewsSource')return source;if(name==='@/lib/schoolCalendar')return calendar;if(name==='@/lib/internalServiceUrl')return{trustedInternalServiceUrl};if(name==='@/lib/schoolsProxySecurity')return{boundedSchoolBody:async(body:ReadableStream)=>new Response(body).text()};if(name==='@/lib/publicSchoolFetch')return{publicSchoolText:async(url:string,hosts:string[])=>{providerCalls++;if(multi&&!sourceOverride){assert.equal(url,'https://school.example.org/notice.rss');assert.deepEqual(Array.from(hosts),['school.example.org'])}return providerOverride??(invalid?'<html>maintenance</html>':'<rss><channel><item><title>안내</title><link>https://school.example.org/notice/1</link></item></channel></rss>')}};throw Error(name)}});return{get:(query:string,auth=true)=>exports.GET({nextUrl:new URL('https://app.cbgpu.com/api/school-news?'+query),headers:new Headers(auth?{Authorization:'Bearer fixture'}:{})}),provider:(fields:any,body:string)=>{sourceOverride=fields;providerOverride=body},deny:(value:number)=>status=value,invalid:()=>invalid=true,nativeMode:(value:string)=>nativeMode=value,calls:()=>({nativeCalls,providerCalls})}}
test('school news authenticates every read and never falls back after membership revocation',async()=>{const f=fixture();let res=await f.get('school_id=school-b');assert.equal(res.status,200);assert.equal((await res.json()).school.id,'school-b');assert.equal(res.headers.get('cache-control'),'no-store');f.deny(403);assert.equal((await f.get('school_id=school-b')).status,403);f.deny(401);assert.equal((await f.get('school_id=school-b')).status,401);assert.deepEqual(f.calls(),{nativeCalls:3,providerCalls:1})});
test('unsigned, absent, unconfigured sources and invalid formats do not expose other school data',async()=>{const f=fixture();assert.equal((await f.get('school_id=school-b',false)).status,401);assert.equal((await f.get('')).status,400);assert.equal((await f.get('school_id=school-b&type=schedule')).status,409);assert.equal(f.calls().providerCalls,0);f.invalid();assert.equal((await f.get('school_id=school-b')).status,502);const legacy=fixture(false);assert.equal((await legacy.get('school_id=school-b',false)).status,409);assert.equal(legacy.calls().providerCalls,0)});

test('authority HTML/malformedJSON/redirect fail503 rather than inventing absent provider or exposing HTML',async()=>{for(const mode of['html','malformed','redirect']){const f=fixture();f.nativeMode(mode);const r=await f.get('school_id=school-b');assert.equal(r.status,503);const value=await r.json();assert.equal(value.code,'SCHOOL_AUTHORITY_UNAVAILABLE');assert.equal(JSON.stringify(value).includes('<'),false);assert.equal(f.calls().providerCalls,0)}});
test('valid real-shaped RSS returns actual titles rather than false successful empty news',async()=>{const f=fixture();const r=await f.get('school_id=school-b&month=2026-11');const v=await r.json();assert.equal(v.items.length,1);assert.equal(v.items[0].title,'안내');assert.equal(v.month,'2026-11');assert.equal(v.school.id,'school-b')});

test('authenticated Gyo6 calendar route selects exact month and returns parsed dates',async()=>{const f=fixture();f.provider({calendar_url:'https://school.gyo6.net/gbdhs/schl/sv/schdulView/schdulCalendarView.do?mi=108774',allowed_hosts:['school.gyo6.net']},'<input name="selectYearMonth" value="202610"><td class="selectDay" id="20261007"><p data-schdulTitle="학교 일정"></p></td>');const r=await f.get('school_id=school-b&type=schedule&month=2026-10');assert.equal(r.status,200);const v=await r.json();assert.equal(new URL(v.sourceUrl).searchParams.get('selectYearMonth'),'202610');assert.equal(v.items[0].pubDate,'2026-10-07T00:00:00+09:00');assert.equal(v.school.id,'school-b');assert.equal(v.items[0].title,'학교 일정')});
