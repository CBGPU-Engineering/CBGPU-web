import test from'node:test';import assert from'node:assert/strict';import{publicItem,publicPath,publicQuery,publicCollection,publicAdsAllowed}from'../src/lib/publicContentModel.ts';
test('public DTOs exclude credentials, owner UUIDs, asset owner-prefix keys and nested data',()=>{const item=publicItem('projects',{id:'public-id',title:'Public',owner_id:'secret-owner',email:'private@example.invalid',student_number:'2309',environment:{KEY:'secret'},banner_path:'owner-uuid/file.png',cover_path:'owner-uuid/file.png',private_files:['secret'],body_markdown:'Published text'});assert.deepEqual(item,{id:'public-id',title:'Public',body_markdown:'Published text'})});
test('only bounded public list/detail routes are accepted',()=>{assert.equal(publicPath(['community','anything']),null);for(const id of ['../secret','a/b','a%2fb',''])assert.equal(publicPath(['schools',id]),null);assert.equal(publicPath(['projects','11111111-1111-4111-8111-111111111111'])?.kind,'projects');assert.equal(publicPath(['schools','cbsh'])?.id,'cbsh');assert.equal(publicPath(['accounts']),null)});
test('public queries cannot select raw fields or exceed limits',()=>{for(const query of ['select=*','limit=101','offset=10001','query=a&query=b','limit=1e2','query='+encodeURIComponent('한'.repeat(67))])assert.equal(publicQuery(new URLSearchParams(query)),null);assert.equal(publicQuery(new URLSearchParams('limit=24&offset=0&query=school'))?.get('query'),'school')});
test('malformed and oversized collections fail closed rather than using private fallback',()=>{assert.equal(publicCollection('schools',{items:[{email:'hidden'}],total:1}),null);assert.equal(publicCollection('projects',{items:[],total:'1'}),null);assert.equal(publicCollection('projects',{items:Array(101).fill({id:'test'}),total:101}),null);assert.deepEqual(publicCollection('community',{items:[],total:0}),{items:[],total:0})});
test('server-generated owner-prefix storage image paths cannot leak through Markdown text',()=>{const owner='aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa',url='https://cbgpu.com/backend/storage/v1/object/public/contest-presentation/'+owner+'/image.png';const item=publicItem('contests',{id:'public',description:'Text ![Caption]('+url+') '+url});assert.equal(String(item?.description).includes(owner),false);assert.equal(String(item?.description).includes('storage/v1'),false)});
test('public ad consent is explicit Boolean only; unknown and forged scalar values cannot opt a school in',()=>{const id='11111111-1111-4111-8111-111111111111';for(const kind of ['projects','contests','schools','community']as const){assert.equal(publicItem(kind,{id,ads_enabled:true})?.ads_enabled,true);assert.equal(publicItem(kind,{id,ads_enabled:false})?.ads_enabled,false);for(const ads_enabled of ['true',1,{},null])assert.equal(publicItem(kind,{id,ads_enabled})?.ads_enabled,undefined)}});

test('mixed missing and empty public collections never infer school ad permission',()=>{assert.equal(publicAdsAllowed([]),false);assert.equal(publicAdsAllowed([{id:'one',ads_enabled:true}]),true);assert.equal(publicAdsAllowed([{id:'one',ads_enabled:true},{id:'two',ads_enabled:false}]),false);assert.equal(publicAdsAllowed([{id:'one'}]),false);assert.equal(publicCollection('contests',{items:[{id:'one',ads_enabled:true},{id:'two',ads_enabled:false}],total:2,ads_enabled:true})?.ads_enabled,false)});
