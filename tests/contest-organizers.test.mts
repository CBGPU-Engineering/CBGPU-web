import{test}from'node:test';import assert from'node:assert/strict';import{publicItem}from'../src/lib/publicContentModel.ts';
test('public contest projection includes only curated accepted school names, never invitation actors',()=>{const item=publicItem('contests',{id:'fixture',organizer_school_names:'Synthetic School B',invited_by:'private-user-id',reviewed_by:'private-admin',invitations:[{status:'INVITED'}]});assert.equal(item?.organizer_school_names,'Synthetic School B');assert.equal(item?.invited_by,undefined);assert.equal(item?.reviewed_by,undefined);assert.equal(item?.invitations,undefined)});
test('malformed or active-control organizer metadata is omitted without affecting public content',()=>{for(const value of[{private_actor:'secret'},['school-b'],'School\nInjected','x'.repeat(20001)]){const item=publicItem('contests',{id:'fixture',title:'Public title',organizer_school_names:value});assert.equal(item?.organizer_school_names,undefined);assert.equal(item?.title,'Public title')}assert.equal(publicItem('contests',{id:'fixture',organizer_school_names:null})?.organizer_school_names,null)});
