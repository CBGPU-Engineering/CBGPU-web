await page.getByRole('button',{name:'성공 알림',exact:true}).click();const notifications=page.getByRole('region',{name:app?'알림':'Notifications',exact:true});await notifications.getByText(app?'합성 저장을 완료했어요.':'Synthetic save complete.',{exact:true}).waitFor();await notifications.getByRole('button',{name:app?'알림 닫기':'Dismiss notification',exact:true}).click();assert.ok(await page.evaluate(()=>document.documentElement.scrollWidth<=innerWidth+1));assert.deepEqual(errors,[]);assert.equal(writes,0);assert.equal(remote,0);results.push({frame,blockedStorage:blocked,theme,width,errorLocale:true,confirmationDefaults:true,promptDefaults:true,userInputPreserved:true,notificationLocale:true,privateWrites:0,remoteRequests:0,pageErrors:errors});await context.close();}await fs.writeFile(out+'/PASSED.json',JSON.stringify(results,null,2));console.log(JSON.stringify(results));}finally{await browser.close()}
