/** Canonical local demo only. Signs in through the real synthetic login UI. */
import assert from'node:assert/strict';import fs from'node:fs/promises';import{chromium}from'playwright';
const origin=process.env.CBGPU_OIL_NAV_ORIGIN||'http://localhost:13980',baseline=process.env.CBGPU_OIL_BASELINE==='1',out=process.env.CBGPU_OIL_NAV_OUTPUT||'/tmp/cbgpu-oil-navigation/after';assert.match(origin,/^http:\/\/localhost:\d+$/);await fs.mkdir(out,{recursive:true});const browser=await chromium.launch({headless:true,args:['--no-sandbox']});let external=0;const results=[];
try{for(const theme of['light','dark']){const context=await browser.newContext({viewport:{width:390,height:900},reducedMotion:'reduce',colorScheme:theme as'light'|'dark'});await context.addInitScript(theme=>localStorage.setItem('theme',theme),theme);await context.route('**/*',route=>{const url=new URL(route.request().url());if(['http:','https:','ws:','wss:'].includes(url.protocol)&&!['localhost','127.0.0.1'].includes(url.hostname)){external++;return route.abort()}return route.fallback()});const page=await context.newPage(),errors:string[]=[];page.on('pageerror',e=>errors.push(e.message));await page.goto(origin+'/auth/login?demo-frame=web&next=%2Fcontests%3Fdemo-frame%3Dweb',{waitUntil:'networkidle'});await page.locator('#login-email').fill('student@example.invalid');await page.locator('#login-password').fill('demo-only');await page.locator('form button[type=submit]').click();await page.waitForURL(url=>url.pathname!=='/auth/login',{timeout:30000,waitUntil:'domcontentloaded'});
for(const width of[320,360,390,768,1024,1280,1440,1536,1920]){await page.setViewportSize({width,height:900});await page.goto(origin+'/contests?demo-frame=web',{waitUntil:'networkidle'});const nav=page.locator('.cb-main-navbar');try{await nav.waitFor({timeout:20000})}catch(error){await page.screenshot({path:out+'/missing-navbar.png'});await fs.writeFile(out+'/missing-navbar.txt',await page.locator('body').innerText());throw error}await page.waitForTimeout(150);const overflow=await page.evaluate(()=>document.documentElement.scrollWidth>innerWidth+1);const wraps=await nav.evaluate(root=>{const bad:string[]=[];const labels=['앱 다운로드','문의하기','기능 찾기','전체 서비스'];const walker=document.createTreeWalker(root,NodeFilter.SHOW_TEXT);while(walker.nextNode()){const node=walker.currentNode,el=node.parentElement;if(!el||!labels.includes(node.textContent?.trim()||'')||!el.getBoundingClientRect().width||!el.getBoundingClientRect().height)continue;const range=document.createRange();range.selectNodeContents(node);if(range.getBoundingClientRect().height>29)bad.push(node.textContent!.trim())}return bad});if(!baseline){if(overflow){await page.screenshot({path:out+'/overflow-'+width+'.png',fullPage:true});await fs.writeFile(out+'/overflow-'+width+'.json',JSON.stringify(await page.evaluate(()=>[...document.querySelectorAll('body *')].filter(e=>{const b=e.getBoundingClientRect();return b.width&&b.right>innerWidth+1}).map(e=>({tag:e.tagName,class:e.className,label:e.textContent?.slice(0,50),box:JSON.stringify(e.getBoundingClientRect())})).slice(0,30)),null,2))}assert.equal(overflow,false,'No document overflow at '+width);assert.deepEqual(wraps,[],'Navigation text stays horizontal at '+width)}const toggle=page.getByRole('button',{name:'메뉴 열기',exact:true});if(await toggle.isVisible()){await toggle.click();if(!baseline){const menu=page.locator('#cb-main-mobile-menu');await menu.waitFor();const bounds=await menu.boundingBox();assert.ok(bounds&&bounds.y>=0&&bounds.y+bounds.height<=901);await page.keyboard.press('Escape');await page.waitForFunction(()=>document.activeElement?.getAttribute('aria-label')==='메뉴 열기');}else await page.keyboard.press('Escape')}await page.screenshot({path:out+'/'+width+'-'+theme+'.png'});results.push({width,theme,overflow,wraps});}assert.deepEqual(errors,[]);await context.close()}await fs.writeFile(out+'/PASSED.json',JSON.stringify({baseline,results,blockedExternal:external},null,2));console.log(JSON.stringify({baseline,results,blockedExternal:external}));}finally{await browser.close()}
