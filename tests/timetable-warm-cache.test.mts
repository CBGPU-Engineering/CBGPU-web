 const provider=async(url:string)=>{if(url==='http://컴시간학생.kr')return new Response('<frame src="http://comci.net:4082/st">');if(url.endsWith('/st'))return new Response(new Uint8Array(iconv.encode(renderer,'euc-kr')));if(url.includes('?456l'))return new Response(seal({학교검색:[[10000,'충북','충북과학고등학교',999,222]]},key));rawFetches++;const days=[null,...Array.from({length:5},()=>[0,1001])],table=[null,[null,days]],week=new Date(Date.now()+9*3600000);week.setUTCDate(week.getUTCDate()-((week.getUTCDay()+6)%7));return new Response(seal({자료777:week.toISOString().slice(0,10),자료101:table,자료102:table,자료103:['','Private teacher'],자료104:['','Warm subject'],학급수:[0,1]},key))};
 function client(){const exports:any={};vm.runInNewContext(compiled,{exports,Buffer,URL,AbortSignal,Date,console,fetch:provider,require(n:string){if(n==='iconv-lite')return iconv;if(n==='./comciganSource')return source;if(n==='./comciganPayload')return payload;if(n==='./timetableCache')return cache;if(n==='./comciganSchool')return school;if(n==='./timetableStore')return{fileTimetableStore:()=>stores.fileTimetableStore(path.join(dir,'legacy.json')),schoolTimetableStore:(key:string)=>stores.schoolTimetableStore(key,path.join(dir,'legacy.json'))};throw Error(n)}});return exports}
