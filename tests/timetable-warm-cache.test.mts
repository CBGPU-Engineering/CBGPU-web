function seal(value:unknown,key:string){const iv=Buffer.alloc(16,3),bytes=Buffer.from(key,'hex'),cipher=createCipheriv('aes-256-cbc',bytes,iv),data=Buffer.concat([cipher.update(JSON.stringify(value)),cipher.final()]);const prefix='enc2:'+iv.toString('base64')+':'+data.toString('base64');return prefix+':'+createHmac('sha256',createHash('sha256').update(bytes).digest()).update(prefix).digest('base64')}
