 deny=true;await page.goto(origin);await page.getByRole('button',{name:'Select this school and open meals',exact:true}).click();await page.getByRole('alert').waitFor();assert.equal(new URL(page.url()).pathname,'/');assert.equal(navigations.length,1);assert.equal(await page.getByRole('button',{name:'Select this school and open meals'}).isEnabled(),true);
 await page.evaluate(()=>{(window as any).__member=false;(window as any).__render()});assert.equal(await page.getByRole('button',{name:/Select this school and open/}).count(),0);await page.getByText('Verified school membership is required to open this workspace.',{exact:true}).first().waitFor();const count=selected.length;
 await page.evaluate(()=>{(window as any).__source={...(window as any).__source,official_id:null,education_office_code:null};(window as any).__render()});await page.getByRole('heading',{name:/Meal source not configured/}).waitFor();assert.equal(await page.getByRole('link',{name:'Request integration review'}).getAttribute('href'),'/schools/school-b/features');assert.equal(selected.length,count);assert.deepEqual(errors,[]);console.log('PASS actual React first-school readiness: no false provider-ready claim, verified account-school selection before fixed workspace navigation, denied selection retains page, no membership no action, missing catalog metadata routes to review; no provider requests.');await context.close();}finally{await browser.close();server.close()}
