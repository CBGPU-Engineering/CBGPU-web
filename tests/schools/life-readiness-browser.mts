const server=createServer(async(req,res)=>{if(req.url==='/mock/current-school'){let body='';for await(const chunk of req)body+=chunk;selected.push(JSON.parse(body));res.writeHead(deny?403:200,{'content-type':'application/json'});return res.end(JSON.stringify({current_school_id:'school-b'}))}if(req.url==='/timetable'||req.url==='/meal'){navigations.push(req.url);res.writeHead(200,{'content-type':'text/html'});return res.end('<h1>Selected school workspace fixture</h1>')}res.writeHead(200,{'content-type':req.url==='/fixture.js'?'application/javascript':'text/html'});res.end(req.url==='/fixture.js'?js:'<!doctype html><div id="root"></div><script src="/fixture.js"></script>')});server.listen(0,'127.0.0.1');await once(server,'listening');const origin='http://127.0.0.1:'+(server.address()as{port:number}).port,browser=await chromium.launch({headless:true,executablePath:process.env.CBGPU_CHROMIUM||'/tmp/chromium',args:['--no-sandbox','--disable-dev-shm-usage','--disable-gpu']});
