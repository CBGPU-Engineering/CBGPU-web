/** Local synthetic fixtures only: no hosted accounts, resource grants or external requests. */
import{chromium}from'playwright';import assert from'node:assert/strict';
const origin=process.env.CBGPU_SCHOOLS_TEST_ORIGIN||'http://localhost:3241';assert.match(origin,/^http:\/\/(localhost|127\.0\.0\.1):\d+$/);
const browser=await chromium.launch({headless:true,executablePath:process.env.CBGPU_CHROMIUM||'/tmp/chromium',args:['--no-sandbox','--disable-dev-shm-usage']});
try{
const context=await browser.newContext({viewport:{width:390,height:844}}),page=await context.newPage(),errors:string[]=[];page.on('pageerror',e=>errors.push(e.message));
const session=await fetch(origin+'/backend/auth/v1/token?grant_type=password',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({email:'researcher@example.invalid',password:'demo-only'})}).then(r=>r.json());
await context.addInitScript(s=>localStorage.setItem('sb-localhost-auth-token',JSON.stringify(s)),session);await page.route('**/api/auth/shared-session',r=>r.fulfill({contentType:'application/json',body:JSON.stringify({state:'active',value:JSON.stringify(session)})}));
const school={id:'fixture-school',official_name:'Synthetic Academy',display_name:'Synthetic Academy',region:'Synthetic',type:'HIGH_SCHOOL',brand_color:'#17634d',logo_path:null,status:'APPROVED',features:['projects','contests']};
const membership={id:'member',school_id:school.id,user_id:session.user.id,membership_type:'STUDENT',status:'ACTIVE',verified:true,school_roles:['SCHOOL_ADMIN'],school};
const begin=new Date(Date.now()+3_600_000).toISOString(),end=new Date(Date.now()+7_200_000).toISOString();
const base={id:'independent',school_id:school.id,external_user_id:'external-fixture',requester_id:'sponsor-fixture',project_name:'Independent project',purpose:'Synthetic collaboration only',resources:['contests'],starts_at:begin,ends_at:end,created_at:new Date().toISOString(),status:'PENDING'};
let rows:any[]=[base,{...base,id:'own',project_name:'My own request',requester_id:session.user.id},{...base,id:'expired',project_name:'Expired project',status:'APPROVED',ends_at:new Date(Date.now()-1000).toISOString()}];const writes:any[]=[];
await page.route('**/api/schools/**',async route=>{const request=route.request(),path=new URL(request.url()).pathname.slice('/api/schools/'.length);let value:any={},status=200;
if(path==='memberships')value={items:[membership],current_school_id:school.id};
else if(path===`schools/${school.id}/configuration`)value={school,configuration:{display_name:school.display_name,brand_color:'#17634d'},features:school.features,available_features:school.features,revision:1,can_manage_roles:false};
else if(path===`schools/${school.id}/members`)value={items:[membership]};
else if(path===`schools/${school.id}/guest-requests`){if(request.method()==='POST'){const body=request.postDataJSON();writes.push({path,body});assert.deepEqual(body.resources,['contests']);assert.equal(body.external_email,'collaborator@example.invalid');assert.ok(body.starts_at.endsWith('Z'));const created={...base,...body,id:'submitted',requester_id:session.user.id,status:'PENDING'};rows=[created,...rows];value={request:created}}else value={items:rows};}
else if(path===`schools/${school.id}/guest-requests/independent/review`){const body=request.postDataJSON();writes.push({path,body});assert.deepEqual(Object.keys(body),['decision']);base.status=body.decision==='APPROVE'?'APPROVED':'REVOKED';value={request:base};}
else{status=403;value={error:'Synthetic school permission denied'}}await route.fulfill({status,contentType:'application/json',body:JSON.stringify(value)});
});
await page.goto(origin+'/schools/fixture-school/access',{waitUntil:'networkidle'});await page.getByRole('heading',{name:'외부 협업자 이용 요청하기'}).waitFor();await page.getByLabel('협업자 CBGPU 이메일').fill('collaborator@example.invalid');await page.getByLabel('프로젝트 또는 대회 이름',{exact:true}).fill('My collaboration');await page.getByLabel('이용 목적',{exact:true}).fill('Synthetic participant project');await page.getByLabel('대회',{exact:true}).check();await page.getByLabel('이용 시작 (현재 기기 시간 기준)').fill('2030-01-01T10:00');await page.getByLabel('이용 종료 (현재 기기 시간 기준)').fill('2030-01-01T12:00');await page.getByRole('button',{name:'이용 승인 요청하기',exact:true}).click();await page.getByText('이용 요청을 보냈어요.',{exact:false}).waitFor();assert.equal(writes.length,1);assert.equal(await page.getByRole('button',{name:'Approve',exact:true}).count(),0);
await page.goto(origin+'/schools/fixture-school/admin?section=access',{waitUntil:'networkidle'});await page.getByRole('heading',{name:'Temporary guest access',exact:true}).waitFor();const independent=page.locator('article').filter({has:page.getByRole('heading',{name:'Independent project',exact:true})});await independent.getByRole('button',{name:'Approve',exact:true}).click();assert.equal(writes.length,1);await page.getByRole('dialog').getByRole('button',{name:'Confirm decision',exact:true}).click();await independent.getByText('SCHEDULED',{exact:true}).waitFor();assert.equal(writes.length,2);assert.equal(await page.locator('article').filter({has:page.getByRole('heading',{name:'My own request',exact:true})}).getByRole('button',{name:'Approve',exact:true}).count(),0);await independent.getByRole('button',{name:'Revoke access',exact:true}).click();await page.getByRole('dialog').getByRole('button',{name:'Confirm decision',exact:true}).click();await independent.getByText('REVOKED',{exact:true}).waitFor();assert.equal(writes.length,3);await page.getByLabel('Filter access requests').selectOption('EXPIRED');await page.getByRole('heading',{name:'Expired project',exact:true}).waitFor();assert.equal(await independent.count(),0);
await page.setViewportSize({width:320,height:740});assert.equal(await page.evaluate(()=>document.documentElement.scrollWidth>innerWidth+1),false);await page.screenshot({path:'/tmp/cbgpu-school-guests-mobile.png',fullPage:true});
await page.goto(origin+'/schools/denied-school/access',{waitUntil:'networkidle'});await page.getByText('Synthetic school permission denied',{exact:true}).waitFor();assert.equal(await page.getByRole('button',{name:'이용 승인 요청하기',exact:true}).count(),0);assert.equal(writes.length,3);assert.deepEqual(errors,[]);
console.log(JSON.stringify({sponsorExactScope:true,independentConfirmation:true,selfReviewHidden:true,scheduledAndExpired:true,revokeConfirmed:true,deniedSchoolNoWrite:true,mobile320:true,errors}));
}finally{await browser.close()}
