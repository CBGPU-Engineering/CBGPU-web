import{chromium}from'playwright';import assert from'node:assert/strict';
const origin=process.env.CBGPU_SCHOOLS_TEST_ORIGIN||'http://localhost:3217';assert.match(origin,/^http:\/\/(localhost|127\.0\.0\.1):\d+$/);const browser=await chromium.launch({headless:true,executablePath:process.env.CBGPU_CHROMIUM||'/tmp/chromium',args:['--no-sandbox','--disable-dev-shm-usage']});
try{const context=await browser.newContext({viewport:{width:390,height:844}}),page=await context.newPage(),errors:string[]=[];page.on('pageerror',e=>errors.push(e.message));const session=await fetch(origin+'/backend/auth/v1/token?grant_type=password',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({email:'researcher@example.invalid',password:'demo-only'})}).then(r=>r.json());await context.addInitScript(s=>localStorage.setItem('sb-localhost-auth-token',JSON.stringify(s)),session);await page.route('**/api/auth/shared-session',r=>r.fulfill({contentType:'application/json',body:JSON.stringify({state:'active',value:JSON.stringify(session)})}));
 const school=(id:string)=>({id,official_name:id==='cbsh'?'충북과학고등학교':'Synthetic Other School',display_name:id==='cbsh'?'충북과학고등학교':'Synthetic Other School',region:'Synthetic',type:'HIGH_SCHOOL',brand_color:'#3182f6',logo_path:null,status:'APPROVED',features:id==='cbsh'?['school_life','gpu_compute','projects','contests']:['projects','contests'],gpu:{status:id==='cbsh'?'ONLINE':'NOT_CONFIGURED',nodes:id==='cbsh'?1:0,sharing_enabled:false}});let current='other-school',requests:any[]=[],protectedReads=0;const memberships=['other-school','cbsh'].map(id=>({id:'membership-'+id,user_id:session.user.id,school_id:id,membership_type:'STUDENT',status:'ACTIVE',verified:true,school_roles:[],school:school(id)}));
 await page.route('**/api/schools/**',async route=>{const request=route.request(),path=new URL(request.url()).pathname.slice('/api/schools/'.length);let data:any={},status=200;if(path==='memberships')data={items:memberships,current_school_id:current};else if(path==='current-school'){current=request.postDataJSON().school_id;data={ok:true,current_school_id:current}}else if(path==='schools/other-school/feature-requests'){if(request.method()==='POST'){const body=request.postDataJSON();assert.equal(body.feature_key,'custom');requests.unshift({id:'fixture-request',school_id:'other-school',requester_id:session.user.id,...body,status:'PENDING',created_at:new Date().toISOString()});data={request:requests[0],notification_status:'PENDING'}}else data={items:requests};}else{status=404;data={error:'Synthetic endpoint not configured'}}await route.fulfill({status,contentType:'application/json',body:JSON.stringify(data)})});
 await page.route('**/api/**',async(route)=>{const path=new URL(route.request().url()).pathname;if(/^\/api\/(study|timetable|meal|wakeup|gpu-status)/.test(path)){if(current==='other-school')protectedReads++;await route.fulfill({contentType:'application/json',body:'{}'})}else await route.fallback()});await page.route('**/api/deploy/**',route=>route.fulfill({contentType:'application/json',body:'{"projects":[]}'}));
 await page.goto(origin+'/workspace?mode=student',{waitUntil:'networkidle'});const trigger=page.getByRole('button',{name:/학교 바꾸기 · Synthetic Other School/});await trigger.waitFor();assert.equal(await page.getByRole('link',{name:'자습 신청',exact:true}).count(),0);assert.equal(await page.getByRole('link',{name:'GPU 예약',exact:true}).count(),0);assert.equal(protectedReads,0);await page.goto(origin+'/dashboard?mode=researcher',{waitUntil:'networkidle'});await page.getByRole('heading',{name:'아직 GPU 서버를 연결하지 않았어요'}).waitFor();assert.equal(protectedReads,0);await page.getByRole('button',{name:/학교 바꾸기/}).click();await page.getByRole('dialog').getByRole('button',{name:/충북과학고등학교/}).click();await page.getByRole('dialog').waitFor({state:'hidden'});assert.equal(current,'cbsh');await page.getByRole('button',{name:/학교 바꾸기 · 충북과학고등학교/}).waitFor();await page.getByRole('button',{name:/학교 바꾸기/}).click();await page.keyboard.press('Escape');await page.waitForTimeout(300);assert.equal(await page.getByRole('button',{name:/학교 바꾸기/}).evaluate(e=>e===document.activeElement),true);
 current='other-school';await page.goto(origin+'/schools/other-school/features?mode=student',{waitUntil:'networkidle'});await page.getByLabel('어떤 기능이 필요한가요?',{exact:true}).fill('Synthetic school equipment booking');await page.getByLabel(/현재 방식과 원하는 흐름/).fill('Synthetic feature request describing an existing manual school process.');await page.getByRole('button',{name:'기능 추가 요청 보내기'}).click();await page.getByText(/운영팀 알림은 발송 대기 중/).waitFor();assert.equal(requests.length,1);assert.equal(requests[0].feature_key,'custom');assert.equal(requests[0].status,'PENDING');await page.setViewportSize({width:320,height:740});assert.equal(await page.evaluate(()=>document.documentElement.scrollWidth>innerWidth+1),false);await page.emulateMedia({reducedMotion:'reduce'});await page.goto(origin+'/workspace?mode=student',{waitUntil:'networkidle'});assert.equal(await page.evaluate(()=>document.documentElement.scrollWidth>innerWidth+1),false);assert.equal(protectedReads,0);assert.deepEqual(errors,[]);console.log(JSON.stringify({serverBoundSchoolSwitch:true,unknownStateConservative:true,otherSchoolNoCBshReaders:true,noGpuIsUnconfigured:true,keyboardFocus:true,manualFeatureRequest:true,emailQueuedNotDelivered:true,mobile320:true,errors}));}finally{await browser.close()}
