 await page.getByRole('searchbox',{name:'학교 이름 또는 지역 검색'}).fill('충북과학고');await page.getByRole('status').filter({hasText:'1개 학교 · 1개 표시'}).waitFor();assert.equal(await page.locator('.cb-school-directory-grid article').count(),1);assert.equal(await page.getByRole('heading',{name:approved.display_name,exact:true}).count(),1,'Server canonical result is displayed once');assert.equal(posts.length,0);
 await page.goto(origin+'/catalog');await page.getByText('이미 도입됐어요',{exact:true}).waitFor();assert.equal(await page.getByRole('button',{name:new RegExp(approved.official_name)}).count(),0,'Already registered schools cannot be selected for another introduction');await page.getByRole('searchbox',{name:'학교 이름 또는 지역 검색'}).fill('충북과학고');await page.getByRole('status').filter({hasText:'검색 결과 1개 학교 · 1개 표시'}).waitFor();assert.equal(await page.locator('.cb-school-options > li').count(),1);assert.equal(await page.evaluate(()=>document.documentElement.scrollWidth>innerWidth+1),false);await page.screenshot({path:`${output}/catalog-${width}-${mode}.png`});
 await page.goto(origin+'/?signedin');await page.getByRole('button',{name:'학교 소속 요청',exact:true}).click();const dialog=page.getByRole('dialog');await dialog.waitFor();await dialog.getByLabel(/^학번/).fill('2101');await dialog.getByRole('button',{name:'소속 확인 요청',exact:true}).click();await dialog.getByText('소속 확인을 요청했어요',{exact:true}).waitFor();assert.deepEqual(posts,[{membership_type:'STUDENT',student_number:'2101'}]);assert.equal(await page.getByText('인증된 학교 구성원',{exact:true}).count(),0,'Pending request never invents verified membership');results.push({width,mode,anonymousInformational:true,guideRetainsSchoolId:true,canonicalOneResult:true,catalogNoDuplicateApplication:true,signedInJoinPending:true,noOverflow:true});await context.close();
