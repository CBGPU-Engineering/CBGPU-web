 await page.getByRole('textbox',{name:'Search schools',exact:true}).fill('Synthetic');await page.getByRole('button',{name:'Search',exact:true}).click();await page.getByText('Page 1',{exact:true}).waitFor();assert.ok(reads.some(u=>u.searchParams.get('q')==='Synthetic'));
 await page.locator('.cb-admin-school-grid').getByRole('link',{name:/Synthetic school-b/}).click();await page.getByRole('heading',{name:'Synthetic school-b',exact:true}).waitFor();assert.equal(await page.locator('.cb-admin-school-tools').count(),0);assert.ok(await page.getByText('Read only',{exact:true}).isVisible());assert.equal(await page.locator('a[href*="section=members"],a[href*="section=gpu"],a[href="/admin/gpu"]').count(),0);assert.equal(await page.evaluate(()=>document.documentElement.scrollWidth>innerWidth+1),false);await page.screenshot({path:`${screenshots}/${width}-${dark?'dark':'light'}-inspection.png`});
 denied=true;await page.getByRole('button',{name:'Refresh school inspection',exact:true}).click();await page.getByRole('heading',{name:'School inspection unavailable',exact:true}).waitFor();assert.equal(await page.getByRole('heading',{name:'Synthetic school-b',exact:true}).count(),0);
