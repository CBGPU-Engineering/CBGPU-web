/** Real Radix/React controls. Only the unmount-focus timer is held to reproduce late cleanup deterministically. */
import assert from'node:assert/strict';import{build}from'esbuild';import{chromium}from'playwright';import puppeteer from'puppeteer-core';
const bundle=await build({stdin:{contents:`import React,{useState}from'react';import{createRoot}from'react-dom/client';import Effort from'./src/components/ai/EffortControl';function Fixture(){const[value,setValue]=useState('medium'),[draft,setDraft]=useState('');return <form onSubmit={event=>{event.preventDefault();window.__effortSubmitted=draft}}><label>Question<textarea aria-label="Question" value={draft} onChange={event=>{window.__effortDraft=event.target.value;setDraft(event.target.value)}}/></label><button type="submit" aria-label="Send question">Send</button><Effort value={value} onChange={setValue}/></form>}createRoot(document.getElementById('root')).render(<Fixture/>);`,resolveDir:process.cwd(),loader:'tsx'},bundle:true,write:false,platform:'browser',jsx:'automatic',define:{'process.env.NODE_ENV':'"production"'}});
const browser=await puppeteer.launch({executablePath:process.env.CBGPU_CHROMIUM||chromium.executablePath(),headless:true,args:['--no-sandbox','--disable-dev-shm-usage']});try{for(const width of[390,1280]){const page=await browser.newPage();const errors:string[]=[];page.on('pageerror',e=>errors.push(e instanceof Error?e.message:String(e)));await page.setViewport({width,height:844,isMobile:width===390,hasTouch:width===390});await(await page.createCDPSession()).send('Emulation.setCPUThrottlingRate',{rate:6});await page.setRequestInterception(true);page.on('request',request=>{throw Error('The isolated control must not make network requests: '+new URL(request.url()).pathname)});await page.setContent('<main id="root"></main>');await page.evaluate(()=>{const original=window.setTimeout;window.setTimeout=((fn:TimerHandler,delay?:number,...args:unknown[])=>{if(typeof fn==='function'&&String(fn).includes('AUTOFOCUS_ON_UNMOUNT')){window.__effortUnmountFocus=()=>fn(...args);return 1000000}return original(fn,delay,...args)})as typeof window.setTimeout});await page.addScriptTag({content:bundle.outputFiles[0].text});await page.waitForSelector('[aria-label="답변 검토 수준: 균형"]');const close=async()=>{await page.click('[aria-label^="답변 검토 수준:"]');await page.waitForSelector('input[type=range]');await page.focus('input[type=range]');await page.keyboard.press('End');await page.keyboard.press('Escape');await page.waitForFunction(()=>!!window.__effortUnmountFocus)};const release=()=>page.evaluate(()=>{const callback=window.__effortUnmountFocus;window.__effortUnmountFocus=undefined;callback!()});await close();await release();assert.equal(await page.evaluate(()=>document.activeElement?.getAttribute('aria-label')),'답변 검토 수준: 깊게','ordinary Escape must restore trigger focus');await close();await page.type('textarea','Synthetic chat ques');await release();await page.keyboard.type('tion');assert.equal(await page.$eval('textarea',e=>e.value),'Synthetic chat question','late popover cleanup must not steal focus during outside typing');assert.equal(await page.evaluate(()=>window.__effortDraft),'Synthetic chat question','controlled React state must retain every character');assert.equal(await page.evaluate(()=>document.activeElement?.getAttribute('aria-label')),'Question');await page.click('[aria-label="Send question"]');assert.equal(await page.evaluate(()=>window.__effortSubmitted),'Synthetic chat question');assert.deepEqual(errors,[]);await page.close()}console.log(JSON.stringify({realRadixAndReact:true,widths:[390,1280],cpuThrottle:6,escapeRestoresTrigger:true,lateCleanupPreservesExplicitInputFocus:true,fullDOMStateAndSubmittedBody:true,noNetwork:true}))}finally{await browser.close()}
declare global{interface Window{__effortUnmountFocus?:()=>void;__effortDraft?:string;__effortSubmitted?:string}}
