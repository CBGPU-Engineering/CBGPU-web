/** Real production Next home/catalog/navigation; every identity/API is synthetic. */
import assert from'node:assert/strict';import{chromium}from'playwright';
const origin=process.env.CBGPU_MESSENGER_TEST_ORIGIN||'http://localhost:13831';assert.match(origin,/^http:\/\/(localhost|127\.0\.0\.1):\d+$/);
const fixture=process.env.CBGPU_SCHOOLS_FIXTURE_API_ORIGIN||'http://127.0.0.1:54831';assert.match(fixture,/^http:\/\/(localhost|127\.0\.0\.1):\d+$/);
const session=await fetch(fixture+'/auth/v1/token?grant_type=password',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({email:'researcher@example.invalid',password:'demo-only'})}).then(response=>response.json());assert.ok(session.user?.id);
const browser=await chromium.launch({headless:true,executablePath:process.env.CBGPU_CHROMIUM||'/tmp/chromium',args:['--no-sandbox','--disable-dev-shm-usage']});let external=0,writes=0;const externalPaths=new Set<string>();const errors:string[]=[];
try{for(const mode of['student','researcher']){const context=await browser.newContext({viewport:{width:1280,height:900},reducedMotion:'reduce',serviceWorkers:'block',extraHTTPHeaders:{'x-cbgpu-public-host':'cbgpu.com'}}),page=await context.newPage();let enabled=true,guest=false;page.on('pageerror',error=>errors.push(error.message));await context.route('**/*',route=>{const url=new URL(route.request().url());if(url.origin===origin)return route.continue();if(url.href==='https://cdn.jsdelivr.net/gh/toss/tossface/dist/tossface.css')return route.fulfill({contentType:'text/css',body:'/* Synthetic font fixture: no external download. */'});if(url.origin==='https://api.open-meteo.com'&&url.pathname==='/v1/forecast')return route.fulfill({contentType:'application/json',headers:{'Access-Control-Allow-Origin':'*'},body:'{"current_weather":{"weathercode":0,"temperature":17}}'});external++;externalPaths.add(url.origin+url.pathname);return route.abort()});await context.addInitScript(value=>localStorage.setItem('sb-localhost-auth-token',JSON.stringify(value)),session);await page.route('**/api/auth/shared-session',route=>route.fulfill({contentType:'application/json',body:JSON.stringify({state:'active',value:JSON.stringify(session)})}));const school=()=>({id:'school-b',official_name:'Synthetic Community School',display_name:'Synthetic Community School',type:'HIGH_SCHOOL',region:'Synthetic',status:'APPROVED',features:enabled?['community','contests','projects']:['contests','projects'],ads_enabled:false,brand_color:'#3182f6',logo_path:null});await page.route('**/api/schools/**',route=>{assert.equal(route.request().method(),'GET');const path=new URL(route.request().url()).pathname;let value:unknown;if(path.endsWith('/memberships'))value={items:guest?[]:[{id:'member',user_id:session.user.id,school_id:'school-b',membership_type:'STUDENT',status:'ACTIVE',verified:true,school_roles:[],school:school()}],current_school_id:'school-b'};else if(path.endsWith('/resource-contexts'))value={items:[{school_id:'school-b',school:school(),type:guest?'GUEST':'MEMBERSHIP',...(guest?{}:{membership_id:'member'}),resources:['contests'],expires_at:guest?new Date(Date.now()+3600000).toISOString():null,can_administer:false}],current_school_id:'school-b',server_time:new Date().toISOString()};else if(path.endsWith('/resource-access'))value={school_id:'school-b',legacy_cbsh_access:false,context_type:guest?'GUEST':'MEMBERSHIP',expires_at:guest?new Date(Date.now()+3600000).toISOString():null,server_time:new Date().toISOString(),resources:{gpu:false,ai:false,study:false,school_storage:false,fabrication:false,school_compute:false,contests:true},reasons:{ai:'NOT_CONFIGURED'}};else value={items:[]};return route.fulfill({contentType:'application/json',body:JSON.stringify(value)})});await page.route('**/api/deploy/**',route=>{if(route.request().method()!=='GET')writes++;return route.fulfill({contentType:'application/json',body:'{"projects":[]}'})});await page.route('**/backend/rest/v1/profiles?**',route=>route.fulfill({contentType:'application/json',body:JSON.stringify({id:session.user.id,full_name:'Synthetic User',is_approved:false,is_admin:false})}));await page.goto(origin+'/workspace?mode='+mode,{waitUntil:'networkidle'});const hero=page.locator('[data-messenger-entry]');await hero.waitFor();assert.equal(await hero.getAttribute('href'),'/messages');const nav=page.getByRole('navigation',{name:'주 메뉴',exact:true});assert.equal(await nav.getByRole('link',{name:'학교·전국 대화',exact:true}).count(),1,'one primary messenger link');assert.equal(await nav.getByRole('link',{name:'CBGPU AI',exact:true}).count(),1,'AI remains one distinct entry');for(const width of[320,390,768]){await page.setViewportSize({width,height:740});assert.equal(await hero.isVisible(),true);if(!await page.evaluate(()=>document.documentElement.scrollWidth<=innerWidth+1))await page.screenshot({path:'/tmp/cbgpu-messenger-discovery-overflow.png',fullPage:true});assert.equal(await page.evaluate(()=>document.documentElement.scrollWidth<=innerWidth+1),true,JSON.stringify(await page.evaluate(()=>({width:innerWidth,total:document.documentElement.scrollWidth,nodes:[...document.querySelectorAll('body *')].filter(element=>element.getBoundingClientRect().right>innerWidth+1).map(element=>({tag:element.tagName,class:element.className,right:element.getBoundingClientRect().right,text:element.textContent?.slice(0,70)})).slice(0,16)}))));}await page.setViewportSize({width:320,height:740});await page.screenshot({path:'/tmp/cbgpu-messenger-home-fixed-'+mode+'.png',fullPage:false});await hero.focus();assert.equal(await hero.evaluate(element=>element===document.activeElement),true);await page.keyboard.press('Enter');await page.getByRole('heading',{name:'공개 범위를 먼저 확인해주세요'}).waitFor();assert.equal(await page.locator('ins.kakao_ad_area,iframe[src*="ad"],script[src*="kas/static"]').count(),0,'private messenger renders no advertising slot or SDK');await page.goto(origin+'/services?mode='+mode,{waitUntil:'networkidle'});await page.locator('.cb-directory').getByLabel('기능 검색').fill('메신저');await page.getByRole('link',{name:/학교·전국 대화/}).last().waitFor();enabled=false;await page.evaluate(()=>window.dispatchEvent(new Event('focus')));await page.getByRole('link',{name:/학교·전국 대화/}).last().waitFor({state:'hidden'});enabled=true;guest=true;await page.goto(origin+'/workspace?mode='+mode,{waitUntil:'networkidle'});await page.getByRole('button',{name:/학교 바꾸기 · Synthetic Community School · 임시 자원 이용/}).waitFor();assert.equal(await page.locator('[data-messenger-entry]').count(),0,'guest resource scope does not imply community membership');await context.close();}
