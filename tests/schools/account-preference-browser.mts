/** Actual SchoolScope React + client requests; two synthetic devices share one server account preference. */
import assert from'node:assert/strict';import{build}from'esbuild';import{chromium}from'playwright';
const result=await build({stdin:{contents:`import React from'react';import{createRoot}from'react-dom/client';import{SchoolScopeProvider,useSchoolScope}from'./src/components/schools/SchoolScope';window.preferenceFixture={owner:'owner'};window.preferenceEvents=[];window.addEventListener('cbgpu-school-changed',e=>window.preferenceEvents.push(e.detail));function Probe(){const s=useSchoolScope();window.selectPreference=s.switchSchool;return React.createElement('div',{id:'scope','data-status':s.status},s.school?.id||'-')}const root=createRoot(document.getElementById('root'));window.renderAccount=owner=>{window.preferenceFixture.owner=owner;root.render(React.createElement(SchoolScopeProvider,null,React.createElement(Probe)))};window.renderAccount('owner');`,resolveDir:process.cwd(),loader:'tsx'},bundle:true,write:false,platform:'browser',jsx:'automatic',define:{'process.env.NODE_ENV':'"production"','process.env.NEXT_PUBLIC_CBGPU_MULTISCHOOL_V1':'"1"'},plugins:[{name:'synthetic-owner-and-resource-only',setup(b){b.onResolve({filter:/^(?:@\/lib\/(?:useAuth|supabase)|\.\/SchoolResourceScope)$/},args=>({path:args.path,namespace:'fixture'}));b.onLoad({filter:/.*/,namespace:'fixture'},args=>({loader:'js',contents:args.path.includes('useAuth')?`export const useAuth=()=>({user:window.preferenceFixture.owner?{id:window.preferenceFixture.owner}:null,isLoading:false});`:args.path.includes('supabase')?`export const supabase={auth:{getSession:async()=>({data:{session:window.preferenceFixture.owner?{user:{id:window.preferenceFixture.owner},access_token:'token-'+window.preferenceFixture.owner}:null}})}};`:`export const SchoolResourceScopeProvider=({children})=>children;export const useSchoolResourceScope=()=>({status:'legacy'});`}));}}]});const js=result.outputFiles![0].text;
const browser=await chromium.launch({headless:true,executablePath:process.env.CBGPU_CHROMIUM||'/tmp/chromium',args:['--no-sandbox','--disable-dev-shm-usage']});const preferences=new Map([['owner','school-a']]);let hold=false,unblock=()=>{},seen=()=>{};const pending=new Promise<void>(r=>seen=r),gate=new Promise<void>(r=>unblock=r);let requests=0;const errors:string[]=[];
async function device(){const context=await browser.newContext({serviceWorkers:'block'}),page=await context.newPage();page.on('pageerror',e=>errors.push(e.message));await page.route('**/*',async route=>{const req=route.request(),url=new URL(req.url());assert.equal(url.origin,'https://app.cbgpu.com');if(url.pathname.startsWith('/api/schools/')){requests++;const owner=req.headers().authorization?.slice('Bearer token-'.length)||'';if(url.pathname.endsWith('/current-school')){const target=req.postDataJSON().school_id;assert.ok(['school-a','school-b'].includes(target));preferences.set(owner,target);return route.fulfill({contentType:'application/json',body:JSON.stringify({ok:true,current_school_id:target})})}const current=preferences.get(owner)||null;if(hold&&owner==='owner'){seen();await gate}const items=['school-a','school-b'].map(id=>({id:'member-'+owner+'-'+id,user_id:owner,school_id:id,status:'ACTIVE',verified:true,membership_type:'STUDENT',school_roles:[],school:{id,display_name:id,official_name:id,status:'APPROVED',features:[]}}));return route.fulfill({contentType:'application/json',body:JSON.stringify({items,current_school_id:current})})}return route.fulfill(url.pathname==='/fixture.js'?{contentType:'application/javascript',body:js}:{contentType:'text/html',body:'<!doctype html><div id="root"></div><script src="/fixture.js"></script>'})});await page.goto('https://app.cbgpu.com/workspace');await page.locator('#scope[data-status=ready]').waitFor();return{context,page}}
try{const a=await device(),b=await device();assert.equal(await a.page.locator('#scope').textContent(),'school-a');await b.page.evaluate(()=>window.selectPreference('school-b'));await b.page.waitForFunction(()=>document.querySelector('#scope')?.textContent==='school-b');assert.equal(preferences.get('owner'),'school-b');await a.page.evaluate(()=>{localStorage.setItem('cbgpu-school','school-a');window.dispatchEvent(new Event('focus'))});await a.page.waitForFunction(()=>document.querySelector('#scope')?.textContent==='school-b');assert.equal(await a.page.evaluate(()=>window.preferenceEvents.at(-1).school_id),'school-b');const settled=requests;await a.page.waitForTimeout(80);assert.equal(requests,settled,'authoritative school event must not create a refresh loop');hold=true;await a.page.evaluate(()=>window.dispatchEvent(new Event('focus')));await pending;await a.page.evaluate(()=>window.renderAccount('other'));await a.page.waitForFunction(()=>document.querySelector('#scope')?.getAttribute('data-status')==='none');unblock();await a.page.waitForTimeout(80);assert.equal(await a.page.locator('#scope').textContent(),'-');assert.equal(preferences.has('other'),false);assert.deepEqual(errors,[]);await a.context.close();await b.context.close();console.log(JSON.stringify({actualReactScope:true,twoDevicesOneAccount:true,serverSelectionWinsLocalStorage:true,remoteSelectionEventForWidgets:true,staleOtherAccountDenied:true,noAutoDefault:true,refreshLoop:false,errors:0}))}finally{unblock();await browser.close()}
declare global{interface Window{preferenceFixture:any;preferenceEvents:any[];selectPreference:(school:string)=>Promise<void>;renderAccount:(owner:string)=>void}}
