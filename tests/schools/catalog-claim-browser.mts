mode='duplicate';await page.reload();await page.getByRole('button',{name:'선택한 공식 학교로 초안 만들기',exact:true}).tap();await page.getByText('이미 운영 중인 학교예요. 학교 목록에서 소속을 요청해 주세요.',{exact:true}).waitFor();assert.equal(await page.getByTestId('wizard').count(),0);mode='mismatch';await page.reload();await page.getByRole('button',{name:'선택한 공식 학교로 초안 만들기',exact:true}).tap();await page.getByText('공식 학교 연결을 확인하지 못했어요. 초안 목록을 다시 확인해 주세요.',{exact:true}).waitFor();assert.equal(await page.getByTestId('wizard').count(),0);assert.deepEqual(errors,[]);console.log('PASS actual mobile catalog claim: no create on selection, exact server catalog ID only, server identity locked, duplicate and mismatched binding never enter wizard; no provider/membership writes.');await context.close()}finally{await browser.close();server.close()}
