const bundled=await build({stdin:{contents:entry,resolveDir:repo,loader:'tsx'},bundle:true,write:false,platform:'browser',jsx:'automatic',define:{'process.env.NODE_ENV':'"production"','process.env':'{}'},plugins:[{name:'synthetic-api-and-auth',setup(b){b.onResolve({filter:/^(?:@\/lib\/(?:useAuth|schoolsClient)|next\/navigation|\.\/SchoolSetupWizard)$/},a=>({path:a.path,namespace:'fixture'}));b.onLoad({filter:/.*/,namespace:'fixture'},a=>({contents:a.path.includes('useAuth')?'export const useAuth=()=>({user:{id:window.__user},isLoading:false})':a.path==='next/navigation'?'export const useRouter=()=>({push:()=>{}})':a.path.includes('SchoolSetupWizard')?`import React from'react';export const SchoolSetupWizard=p=>React.createElement('section',{'data-testid':'wizard','data-locked':String(p.identityLocked)},p.initialData.school.official_name)`:`export class SchoolsApiError extends Error{};export async function selectAccountSchool(){throw Error('No membership mutation allowed')};export async function schoolsRequest(path,method='GET',body,publicRead,owner){const r=await fetch('/mock/'+path,{method,headers:{'content-type':'application/json'},body:body===undefined?undefined:JSON.stringify(body)});const value=await r.json();if(!r.ok){const e=new SchoolsApiError(value.error);e.existing_school_id=value.existing_school_id;throw e}return value}`,loader:'js',resolveDir:repo}))}}]});
const server=createServer(async(req,res)=>{res.setHeader('content-type',req.url==='/fixture.js'?'application/javascript':'text/html');if(req.url?.startsWith('/mock/')){res.setHeader('content-type','application/json');const path=req.url.slice(6);if(path.startsWith('schools'))return res.end(JSON.stringify(path.includes('?')?{items:[school,{...school,id:'operating',status:'APPROVED'}]}:{school}));if(req.method==='POST'){let raw='';for await(const chunk of req)raw+=chunk;posts.push(JSON.parse(raw));if(mode==='duplicate'){res.statusCode=409;return res.end(JSON.stringify({error:'School already operating',existing_school_id:'operating'}))}return res.end(JSON.stringify({application:{id:'draft-one',catalog_school_id:mode==='mismatch'?'wrong':school.id,status:'DRAFT',step:1,revision:0,data:{school:{official_name:school.official_name}}}}))}return res.end(JSON.stringify({items:[]}))}res.end(req.url==='/fixture.js'?bundled.outputFiles![0].text:'<!doctype html><div id="root"></div><script src="/fixture.js"></script>')});server.listen(0,'127.0.0.1');await once(server,'listening');const origin='http://127.0.0.1:'+(server.address()as{port:number}).port;const browser=await chromium.launch({headless:true,executablePath:process.env.CBGPU_CHROMIUM||'/tmp/chromium',args:['--no-sandbox','--disable-dev-shm-usage','--disable-gpu']});
