/** Installed build13 bridge compatibility; synthetic accounts/providers only. No APK or provider writes. */
import {chromium} from 'playwright';
import assert from 'node:assert/strict';
const origin=process.env.CBGPU_LEGACY_NATIVE_TEST_ORIGIN||'http://localhost:13831';
assert.match(origin,/^http:\/\/(localhost|127\.0\.0\.1):\d+$/);
const browser=await chromium.launch({headless:true,executablePath:process.env.CBGPU_CHROMIUM||'/tmp/chromium',args:['--no-sandbox','--disable-dev-shm-usage']});
try{
 const context=await browser.newContext({viewport:{width:390,height:844},isMobile:true,hasTouch:true,extraHTTPHeaders:{'x-cbgpu-public-host':'app.cbgpu.com'}}),page=await context.newPage();
 await page.route('**/*',r=>new URL(r.request().url()).origin===origin?r.continue():r.abort());
 const session=await fetch(origin+'/backend/auth/v1/token?grant_type=password',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({email:'researcher@example.invalid',password:'demo-only'})}).then(r=>r.json());assert.ok(session.access_token);
 await context.addInitScript(s=>{localStorage.setItem('sb-localhost-auth-token',JSON.stringify(s));(window as any).CBGPUNative={isNative:true,platform:'android',getAppInfo:async()=>({version:'1.0.12',buildNumber:13,platform:'android'}),getPersistedSession:async()=>({session:{accessToken:s.access_token,refreshToken:s.refresh_token}}),syncSession:async()=>({ok:true}),setNavigation:async()=>({ok:true}),listAlarms:async()=>[],requestNotificationPermission:async()=>({granted:false})};},session);
 await page.route('**/api/auth/shared-session',r=>r.fulfill({json:{state:'active',value:JSON.stringify(session)}}));
 await page.route('**/backend/rest/v1/profiles?**',r=>r.fulfill({json:{id:session.user.id,full_name:'Synthetic old app',student_id:'2101',is_approved:false,is_admin:false}}));
 let current='cbsh',revoked=false,sessionExpired=false;const reads:{path:string;school:string}[]=[],errors:string[]=[];page.on('pageerror',e=>errors.push(e.message));
 const school=(id:string)=>({id,official_name:'Synthetic '+id,display_name:'Synthetic '+id,type:'HIGH_SCHOOL',region:'Synthetic',status:'APPROVED',features:['school_life','projects'],ads_enabled:false,life_capabilities:{meal:true,timetable:true,news:true}});
 await page.route('**/api/schools/**',r=>{const path=new URL(r.request().url()).pathname.slice('/api/schools/'.length);if(r.request().method()!=='GET')throw Error('Unexpected school write');if(sessionExpired)return r.fulfill({status:401,json:{error:'Session revoked'}});if(path==='memberships')return r.fulfill({json:{items:revoked?[]:['cbsh','school-b'].map(id=>({id:'member-'+id,user_id:session.user.id,school_id:id,membership_type:'STUDENT',status:'ACTIVE',verified:true,student_number:id==='cbsh'?'2101':null,school_roles:['STUDENT'],school:school(id)})),current_school_id:revoked?null:current}});if(path==='resource-contexts')return r.fulfill({json:{items:[],current_school_id:null,server_time:new Date().toISOString()}});return r.fulfill({status:403,json:{error:'No permission'}})});
 for(const path of ['meal','timetable','school-news'])await page.route('**/api/'+path+'?**',r=>{const u=new URL(r.request().url()),id=u.searchParams.get('school_id');assert.equal(r.request().headers().authorization,'Bearer '+session.access_token);assert.equal(id,current);assert.equal(revoked,false);reads.push({path,school:id!});return r.fulfill({json:path==='meal'?{school_id:id,date:u.searchParams.get('date'),today:u.searchParams.get('date'),meals:[{type:'중식',items:['MEAL-'+id],calories:''}]}:path==='timetable'?{school_id:id,school:'Synthetic '+id,grid:{0:{1:{subject:'SUBJECT-'+id,teacher:'',changed:false,group:''}}},grades:[1,2,3],classes:[1],times:[],stale:false}:{school:{id},items:[{title:'NEWS-'+id}]}})});
 // Old bridge has no new school/widget methods; web widgets must still fetch selected school.
 for(const id of ['cbsh','school-b']){current=id;await page.goto(origin+'/meal?native=1',{waitUntil:'networkidle'});await page.getByText('MEAL-'+id,{exact:false}).waitFor({timeout:12000}).catch(async e=>{console.error((await page.locator('body').innerText()).slice(0,3500),JSON.stringify(reads),JSON.stringify(errors));throw e});assert.equal(await page.getByText('MEAL-'+(id==='cbsh'?'school-b':'cbsh'),{exact:false}).count(),0);await page.goto(origin+'/timetable?native=1',{waitUntil:'networkidle'});await page.getByText('SUBJECT-'+id,{exact:true}).first().waitFor();}
 revoked=true;const before=reads.length;await page.goto(origin+'/meal?native=1',{waitUntil:'networkidle'});assert.equal(await page.getByText('MEAL-school-b',{exact:false}).count(),0);assert.equal(reads.length,before,'Revoked account must not issue provider/cache reads');revoked=false;sessionExpired=true;await page.goto(origin+'/timetable?native=1',{waitUntil:'networkidle'});assert.equal(await page.getByText('SUBJECT-school-b',{exact:true}).count(),0);assert.equal(reads.length,before,'Revoked session must not issue provider/cache reads');assert.deepEqual(errors,[]);assert.ok(reads.some(r=>r.path==='meal'&&r.school==='cbsh'));assert.ok(reads.some(r=>r.path==='meal'&&r.school==='school-b'));console.log('PASS installed1.0.12 bridge: selected CBsh/SchoolB web meal+timetable; no stale cross-school data; revoked membership/session no reads; zero native widget calls/provider writes');
}finally{await browser.close()}
