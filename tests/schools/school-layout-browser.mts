import{createRequire}from'node:module';import fs from'node:fs/promises';import path from'node:path';import assert from'node:assert/strict';const require=createRequire(process.cwd()+'/package.json'),{build}=require('esbuild'),postcss=require('postcss'),tailwind=require('@tailwindcss/postcss'),{chromium}=require('playwright');const global=(await postcss([tailwind()]).process(await fs.readFile('src/app/globals.css','utf8'),{from:path.resolve('src/app/globals.css')})).css;const entry=`import React from'react';import{createRoot}from'react-dom/client';import{SchoolSetupWizard}from'./src/components/schools/SchoolSetupWizard';import{emptySchoolDraft}from'./src/lib/schoolOnboarding';import{Button}from'./src/components/ui/button';const data=emptySchoolDraft();data.school.official_name='InternationalScienceAndEngineeringAlternativeHighSchoolWithoutWhitespace'.repeat(2).slice(0,100);data.school.region='충청북도 청주시 상당구 가덕면';data.configuration.display_name=data.school.official_name;data.administrator.name='학교 운영 담당자';data.administrator.relationship='교내 정보화 운영 담당 교사';window.renderStep=step=>root.render(<main className="cb-main-content"><div className="cb-school-page"><SchoolSetupWizard key={step} initialStep={step} initialData={data} onSave={async()=>{}} onSubmit={async()=>{}}/><h2>구성원 관리</h2><ul className="cb-school-member-list"><li><div><strong>{data.school.official_name}</strong><span>학교 학생 번호 2026-INTERNATIONAL-SCIENCE-12345678</span><small>SCHOOL_OWNER, SCHOOL_ADMIN, COMMUNITY_MODERATOR</small></div><Button>구성원 소속과 권한 검토</Button></li></ul><div className="cb-school-request-heading"><h2>학교 전용 기능 요청 처리 현황</h2><Button>학교 기능 요청 다시 불러오기</Button></div></div></main>);const root=createRoot(document.getElementById('root'));window.renderStep('review');`;const bundle=await build({stdin:{contents:entry,resolveDir:process.cwd(),loader:'tsx'},bundle:true,write:false,outfile:'layout.js',platform:'browser',jsx:'automatic',define:{'process.env.NODE_ENV':'"production"'},plugins:[{name:'synthetic-wizard-navigation-only',setup(b:any){b.onResolve({filter:/@\/lib\/useProductFunnel$/},(a:any)=>({path:a.path,namespace:'fixture'}));b.onLoad({filter:/.*/,namespace:'fixture'},()=>({loader:'js',contents:`export const useProductFunnel=opts=>({step:opts.initial.step,history:{push:async()=>{}}});`}))}}]});const js=bundle.outputFiles.find((f:any)=>f.path.endsWith('.js')).text,css=global+'\n'+bundle.outputFiles.filter((f:any)=>f.path.endsWith('.css')).map((f:any)=>f.text).join('\n');const browser=await chromium.launch({headless:true,executablePath:'/tmp/chromium',args:['--no-sandbox']});const out=[];try{for(const[width,height]of[[320,844],[360,844],[568,320],[768,844]]){const p=await browser.newPage({viewport:{width,height},reducedMotion:'reduce'});await p.route('**/*',(r:any)=>r.fulfill({contentType:'text/html',body:'<style>'+css+'</style><div id="root"></div><script>'+js+'</script>'}));p.on('pageerror',(e:any)=>console.error('BROWSER',e.message));await p.goto('https://layout.invalid/');await p.locator('.cb-school-review').waitFor();for(const step of['review','features','gpu']){await p.evaluate((v:string)=>(window as any).renderStep(v),step);await p.waitForTimeout(30);const result=await p.evaluate(()=>{const targets=[...document.querySelectorAll('.cb-school-review,.cb-school-member-list,.cb-school-request-heading,.cb-school-wizard-actions,.cb-school-feature,.cb-school-policy')];return{overflow:document.documentElement.scrollWidth-innerWidth,targets:targets.map(el=>({className:el.className,overflow:el.scrollWidth-el.clientWidth,width:el.getBoundingClientRect().width})),buttons:[...document.querySelectorAll('.cb-school-member-list button,.cb-school-request-heading button,.cb-school-wizard-actions button')].map(el=>({text:el.textContent,rect:el.getBoundingClientRect().toJSON(),whiteSpace:getComputedStyle(el).whiteSpace}))}});out.push({width,height,step,...result});await p.screenshot({path:'/tmp/cbgpu-school-layout-'+width+'-'+step+'.png',fullPage:true});}await p.close();}console.log(JSON.stringify(out));for(const row of out){assert.ok(row.overflow<=1,JSON.stringify(row));for(const t of row.targets)assert.ok(t.overflow<=1,JSON.stringify({width:row.width,step:row.step,target:t}));for(const b of row.buttons){assert.ok(b.rect.x>=0&&b.rect.x+b.rect.width<=row.width+1);assert.ok(b.rect.height>=44)}}}finally{await browser.close()}
