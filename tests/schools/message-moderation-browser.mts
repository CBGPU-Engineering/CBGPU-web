const bundle=await build({stdin:{contents:`import React from'react';import{createRoot}from'react-dom/client';import View from'./src/components/admin/MessageReportManagement';createRoot(document.getElementById('root')).render(React.createElement(View,{schoolId:'school-b'}));`,resolveDir:process.cwd(),loader:'tsx'},bundle:true,write:false,outfile:'fixture.js',platform:'browser',jsx:'automatic',define:{'process.env.NODE_ENV':'"production"','process.env':'{}'},plugins:[{name:'isolated-auth-rpc',setup(b){b.onResolve({filter:/^@\/lib\/(useAuth|supabase)$|^@\/components\/schools\/SchoolScope$/},a=>({path:a.path,namespace:'fixture'}));b.onLoad({filter:/.*/,namespace:'fixture'},a=>({loader:'js',contents:a.path.includes('useAuth')?`export const useAuth=()=>({user:{id:'moderator'},isLoading:false});`:a.path.includes('SchoolScope')?`export const useSchoolScope=()=>({school:{id:'school-b'}});`:`export const supabase={auth:{getSession:async()=>({data:{session:{user:{id:'moderator'}}}})},rpc:async(name,args)=>{const r=await fetch('/fixture-rpc',{method:'POST',body:JSON.stringify({name,...args})});return r.json()}};`}));}}]});
const js=bundle.outputFiles!.find(f=>f.path.endsWith('.js'))!.text,css=bundle.outputFiles!.find(f=>f.path.endsWith('.css'))!.text;const browser=await chromium.launch({headless:true,executablePath:process.env.CBGPU_CHROMIUM||'/tmp/chromium',args:['--no-sandbox','--disable-dev-shm-usage']});let providers=0;const errors:string[]=[];
try{for(const width of[390,1280]){const context=await browser.newContext({viewport:{width,height:900},reducedMotion:'reduce',serviceWorkers:'block'}),page=await context.newPage();let denied=false,reviews=0,hidden=false;let row={id:'report',kind:'GROUP',message_id:'message',scope:'SCHOOL',school_id:'school-b',body_snippet:'Private reported excerpt',reason:'Synthetic reason',created_at:'2026-11-17T10:00:00Z',status:'PENDING',revision:1,review_note:'',reviewed_at:null,hidden:false};page.on('pageerror',e=>errors.push(e.message));await page.route('**/*',async route=>{const req=route.request(),url=new URL(req.url());if(url.origin!=='https://app.cbgpu.com'){providers++;return route.abort()}if(url.pathname==='/fixture-rpc'){const p=req.postDataJSON();assert.equal(p.name,'cbgpu_message_moderation');const reply=(data:unknown,error:unknown=null)=>route.fulfill({contentType:'application/json',body:JSON.stringify({data,error})});if(denied)return reply(null,{code:'42501',message:'denied'});if(p.action==='list'){assert.equal(p.payload.school_id,'school-b');return reply({items:[row],total:1})}assert.equal(p.action,'review');reviews++;if(p.payload.expected_revision!==row.revision)return reply(null,{code:'40001',message:'REPORT_REVISION_CONFLICT'});assert.equal(p.payload.confirmed,true);assert.equal(p.payload.hide,true);hidden=true;row={...row,revision:row.revision+1,status:'RESOLVED',hidden:true};return reply({ok:true,report:row})}return route.fulfill(url.pathname==='/fixture.js'?{contentType:'application/javascript',body:js}:url.pathname==='/fixture.css'?{contentType:'text/css',body:css}:{contentType:'text/html',body:'<!doctype html><meta name="viewport" content="width=device-width"><style>*,::before,::after{box-sizing:border-box}body{margin:0}</style><link rel="stylesheet" href="/fixture.css"><main id="root"></main><script src="/fixture.js"></script>'})});await page.goto('https://app.cbgpu.com/schools/school-b/admin?section=moderation',{waitUntil:'networkidle'});await page.getByText('Private reported excerpt',{exact:true}).waitFor({timeout:5000}).catch(async e=>{console.error(await page.locator('body').innerText(),errors);throw e});await page.getByRole('button',{name:'Review report',exact:true}).focus();await page.keyboard.press('Enter');await page.getByLabel('Review note').fill('Preserved independent review note');row.revision=2;await page.getByRole('button',{name:'Save review',exact:true}).click();await page.getByRole('dialog').getByText('This report changed.',{exact:false}).waitFor();assert.equal(await page.getByLabel('Review note').inputValue(),'Preserved independent review note');assert.equal(hidden,false);await page.getByRole('button',{name:'Close review',exact:true}).click();await page.getByRole('button',{name:'Refresh reports',exact:true}).click();await page.getByRole('button',{name:'Review report',exact:true}).click();assert.equal(await page.getByLabel('Review note').inputValue(),'Preserved independent review note');await page.getByRole('button',{name:'Hide message and resolve',exact:true}).click();await page.getByRole('dialog',{name:'Hide this reported message?'}).waitFor();assert.equal(hidden,false);await page.getByRole('dialog',{name:'Hide this reported message?'}).getByRole('button',{name:'Cancel',exact:true}).click();assert.equal(hidden,false);await page.getByRole('button',{name:'Hide message and resolve',exact:true}).click();await page.getByRole('dialog',{name:'Hide this reported message?'}).getByRole('button',{name:'Hide message and resolve',exact:true}).focus();await page.keyboard.press('Enter');await page.getByText('The reported message is hidden and the report is resolved.').waitFor();assert.equal(hidden,true);assert.equal(reviews,2);denied=true;await page.getByRole('button',{name:'Refresh reports',exact:true}).click();await page.getByText('You no longer have permission to review these reports.').waitFor();assert.equal(await page.getByText('Private reported excerpt',{exact:true}).count(),0);assert.equal(await page.getByRole('dialog').count(),0);assert.equal(await page.evaluate(()=>document.documentElement.scrollWidth<=innerWidth+1),true);await context.close()}assert.equal(providers,0);assert.deepEqual(errors,[]);console.log(JSON.stringify({realModerationReact:true,widths:[390,1280],stale409DraftPreserved:true,hideExplicitConfirmation:true,deniedRefreshClearsPrivateContent:true,keyboardReducedMotion:true,providerRequests:0,errors:0}))}finally{await browser.close()}
