// Run against an isolated multis-school demo; requests use synthetic fixtures only.
import{chromium}from'playwright';import fs from'node:fs';import assert from'node:assert/strict';
const out=process.env.CBGPU_GPU_ROUTING_SCREENSHOTS||'artifacts/gpu-school-routing';fs.mkdirSync(out,{recursive:true,mode:0o700});const origin=process.env.CBGPU_DEMO_ORIGIN||'http://localhost:13921';if(!['localhost','127.0.0.1'].includes(new URL(origin).hostname))throw Error('Synthetic routing tests require a loopback demo');const owner='00000000-0000-4000-8000-000000000101',b=await chromium.launch({headless:true,args:['--no-sandbox']});const results=[];try{
for(const [width,theme,app]of[[390,'light',true],[390,'dark',true],[1280,'light',false],[1280,'dark',false]] as const){
let selected='cbsh',fail=false,none=false;const counters={legacy:0,resources:[]},errors=[];
const c=await b.newContext({viewport:{width,height:900},colorScheme:theme,reducedMotion:'reduce',userAgent:app?'Mozilla/5.0 (Linux; Android 14; wv) AppleWebKit/537.36 Version/4.0 Chrome/130.0 Mobile Safari/537.36':undefined});await c.route('**/*',async route=>{const u=new URL(route.request().url());if(!['localhost','127.0.0.1'].includes(u.hostname))return route.abort();const school={id:selected,official_name:selected==='cbsh'?'충북과학고등학교':'테스트고등학교',display_name:selected==='cbsh'?'충북과학고등학교':'테스트고등학교',type:'HIGH',region:'test',brand_color:'#4678ed',logo_path:null,status:'APPROVED',features:['gpu_compute','school_life','projects','community','ai'],life_capabilities:{timetable:true,meal:true,news:true}};const member={id:'synthetic-member',user_id:owner,school_id:selected,membership_type:'STUDENT',status:'ACTIVE',verified:true,school_roles:[],school};const context={school_id:selected,school,type:'MEMBERSHIP',membership_id:member.id,resources:['gpu','study','school_storage','fabrication','school_compute','contests','ai','central_cpu'],expires_at:null,can_administer:false};const json=(body,status=200)=>route.fulfill({status,contentType:'application/json',body:JSON.stringify(body)});
if(u.pathname==='/api/schools/memberships')return json({items:[member],current_school_id:selected});
if(u.pathname==='/api/schools/resource-contexts')return fail?json({error:'Synthetic unavailable'},503):json({items:none?[]:[context],current_school_id:none?null:selected,server_time:new Date().toISOString()});
if(/^\/api\/schools\/schools\/[^/]+\/resource-access$/.test(u.pathname))return json({school_id:selected,legacy_cbsh_access:selected==='cbsh',context_type:'MEMBERSHIP',expires_at:null,server_time:new Date().toISOString(),resources:{gpu:true,study:true,school_storage:true,fabrication:true,school_compute:true,contests:true,ai:true,central_cpu:true},reasons:{}});
if(u.pathname.startsWith('/api/compute/schools/')){counters.resources.push(u.pathname);return json({items:[]})}
if(u.pathname==='/backend/rest/v1/reservations')counters.legacy++;
return route.continue()});const p=await c.newPage();p.on('pageerror',e=>errors.push(e.message));const suffix='?mode=researcher'+(app?'&native=1':'&demo-frame=web');await p.goto(origin+'/auth/login?next='+encodeURIComponent('/compute'+suffix));await p.getByLabel('이메일',{exact:true}).fill('student@example.invalid');await p.getByLabel('비밀번호',{exact:true}).fill('demo-only');await p.getByRole('button',{name:'로그인하기',exact:true}).click();await p.waitForURL('**/dashboard*',{timeout:25000});await p.getByRole('heading',{name:'GPU',exact:true}).waitFor();assert.equal(counters.resources.length,0,'CBsh must never fetch an empty new-node registry');assert.equal(await p.getByText('기존 충북과고 GPU 예약으로 이동',{exact:true}).count(),0);if(app){assert.equal(new URL(p.url()).searchParams.get('native'),'1');assert.equal(new URL(p.url()).searchParams.get('mode'),'researcher')}
await p.screenshot({path:`${out}/cbsh-${theme}-${width}.png`,fullPage:true,caret:'initial'});assert.ok(await p.evaluate(()=>document.documentElement.scrollWidth<=innerWidth+1));
selected='school-b';counters.legacy=0;counters.resources=[];await p.goto(origin+'/dashboard'+suffix);await p.waitForURL('**/compute*',{timeout:15000});await p.getByRole('heading',{name:'학교 GPU',exact:true}).waitFor();await p.getByText('테스트고등학교 · GPU 예약',{exact:true}).waitFor();assert.equal(counters.legacy,0,'another school must never mount the CBsh legacy reader');assert.ok(counters.resources.length>0);assert.ok(counters.resources.every(path=>path.includes('/school-b/')));await p.screenshot({path:`${out}/school-b-${theme}-${width}.png`,fullPage:true,caret:'initial'});assert.ok(await p.evaluate(()=>document.documentElement.scrollWidth<=innerWidth+1));
selected='cbsh';fail=true;counters.legacy=0;counters.resources=[];await p.goto(origin+'/compute'+suffix);await p.getByRole('heading',{name:/학교 연결을 확인하지 못|학교의 GPU 이용 정보를 확인하지 못/}).waitFor();assert.equal(new URL(p.url()).pathname,'/compute');assert.equal(counters.legacy,0);assert.equal(counters.resources.length,0);
fail=false;none=true;await p.goto(origin+'/compute'+suffix);await p.getByRole('heading',{name:'GPU를 이용할 학교를 선택해 주세요',exact:true}).waitFor();assert.equal(new URL(p.url()).pathname,'/compute');assert.equal(counters.resources.length,0);
assert.deepEqual(errors,[]);results.push({width,theme,app,cbshAutomatic:true,otherSchoolAutomatic:true,noLegacyDataForOtherSchool:true,unavailableNeverFallsBack:true,noContextNeverFallsBack:true,appOriginAndModePreserved:true,overflow:false,errors});await c.close();}
fs.writeFileSync(out+'/PASSED.json',JSON.stringify({actualNextRouting:true,syntheticAccountsOnly:true,realSchoolRequestsOrMutations:false,results},null,2),{mode:0o600});console.log(JSON.stringify({passed:true,environments:results.length,scenarios:results.length*4}));}finally{await b.close()}
