/** Actual production Next guide; all external providers and mutations blocked. */
import assert from 'node:assert/strict';
import fs from 'node:fs/promises';
import {chromium} from 'playwright';
const port=Number(process.env.CBGPU_GUIDE_PREVIEW_PORT||14002), output=process.env.CBGPU_GUIDE_PROOF_DIR||'/home/cbgpu/.local/share/cbgpu-rust/school-integration-guide-browser';
await fs.mkdir(output,{recursive:true});
const browser=await chromium.launch({executablePath:process.env.CBGPU_CHROMIUM||'/tmp/chromium',headless:true,args:['--no-sandbox','--disable-dev-shm-usage']});
const rows:unknown[]=[], errors:string[]=[];
try {for(const [width,mode] of [[1280,'light'],[1280,'dark'],[390,'light'],[390,'dark'],[320,'light']] as const){
 const context=await browser.newContext({viewport:{width,height:900},colorScheme:mode,isMobile:width<600,hasTouch:width<600,serviceWorkers:'block',reducedMotion:'reduce'}),page=await context.newPage();page.on('pageerror',e=>errors.push(e.message));
 await context.route('**/*',async route=>{const req=route.request(),url=new URL(req.url());if(!['GET','HEAD'].includes(req.method()))return route.abort();if(!['docs.cbgpu.com','cbgpu.com','app.cbgpu.com'].includes(url.hostname))return route.abort();if(url.pathname.startsWith('/api/')||url.pathname.startsWith('/backend/'))return route.fulfill({status:200,contentType:'application/json',body:url.pathname.includes('shared-session')?' {"state":"signed-out","value":null}':'{"schools":[],"items":[]}'});if(req.headers()['next-router-prefetch']==='1')return route.fulfill({status:204,body:''});const headers:Record<string,string>={host:url.hostname+':'+port,'x-cbgpu-public-host':url.hostname,'x-forwarded-proto':'https'};for(const k of ['accept','rsc','next-router-state-tree','next-url'])if(req.headers()[k])headers[k]=req.headers()[k];const res=await fetch('http://127.0.0.1:'+port+url.pathname+url.search,{headers,redirect:'manual'}),out:Record<string,string>={};res.headers.forEach((v,k)=>{if(!['content-length','content-encoding','transfer-encoding','set-cookie'].includes(k))out[k]=v});return route.fulfill({status:res.status,headers:out,body:Buffer.from(await res.arrayBuffer())});});
 const response=await page.goto('https://docs.cbgpu.com:'+port+'/school-integration'+(width<600?'?from=app':''),{waitUntil:'networkidle'});assert.equal(response?.status(),200);const html=await response!.text();assert.match(html,/우리 학교에 CBGPU 도입하기/);assert.match(html,/section-16/);await page.getByRole('heading',{level:1}).waitFor();
 const value=await page.evaluate(()=>{const links=[...document.querySelectorAll<HTMLAnchorElement>('.portal-doc-toc a')];const discord=[...document.querySelectorAll<HTMLAnchorElement>('a')].filter(a=>a.href.includes('discord'));return{title:document.querySelector('h1')?.textContent,canonical:document.querySelector<HTMLLinkElement>('link[rel=canonical]')?.href,sections:document.querySelectorAll('article section[id]').length,anchors:links.every(a=>!!document.querySelector(a.hash)),overflow:document.documentElement.scrollWidth>innerWidth+1,discord:discord.map(a=>({label:a.textContent,href:a.href,target:a.target,rel:a.rel,y:a.getBoundingClientRect().top})),forms:document.querySelectorAll('article form,article input').length,text:document.querySelector('article')?.textContent}});
 assert.equal(value.canonical,'https://docs.cbgpu.com/school-integration');assert.equal(value.anchors,true);assert.equal(value.overflow,false);assert.equal(value.forms,0);assert.ok(value.sections>=16);assert.ok(value.discord.length>=1);assert.ok(value.discord[0].y<700,'Quickstart must be reachable in first viewport');for(const a of value.discord){assert.equal(a.target,'_blank');assert.match(a.rel,/noopener/);}assert.match(value.text||'',/이미/);rows.push({width,mode,...value,text:undefined});await page.screenshot({path:output+'/'+width+'-'+mode+'.png',fullPage:false});await context.close();
}assert.deepEqual(errors,[]);await fs.writeFile(output+'/PASSED.json',JSON.stringify({rows,errors,actualProductionPreview:true,forwardedMutations:0,externalProvidersBlocked:true},null,2));console.log(JSON.stringify(rows));}finally{await browser.close();}
