/** Actual SchoolScope + ResourceScope providers, synthetic auth/authority; no network or real accounts. */
import assert from'node:assert/strict';import fs from'node:fs/promises';import path from'node:path';import os from'node:os';import{build}from'esbuild';import{chromium}from'playwright';
declare global{interface Window{fixture:any;scope:any;setAuth:(id:string|null,loading:boolean)=>void;selectionPromise:Promise<void>; }}
const root=path.resolve(process.env.CBGPU_SCOPE_SOURCE||'.'),baseline=process.env.CBGPU_SCOPE_BASELINE==='1',folder=await fs.mkdtemp(path.join(os.tmpdir(),'cbgpu-scope-proof-'));
const auth=`import {useSyncExternalStore} from 'react';export function useAuth(){return useSyncExternalStore(cb=>{window.fixture.listeners.add(cb);return()=>window.fixture.listeners.delete(cb)},()=>window.fixture.auth)};`;
const client=`export const multiSchoolEnabled=true;export async function schoolsRequest(route,method,body,flag,owner){const f=window.fixture,school=f.school,revoked=f.revoked,started=performance.now();f.calls.push({route,owner,school,started});await new Promise(r=>setTimeout(r,f.delay));const s={id:school,official_name:school,display_name:school,type:'HIGH',region:'test',features:['study'],status:'APPROVED'};if(route==='memberships')return {items:revoked?[]:[{user_id:owner,school_id:school,school:s,status:'ACTIVE',verified:true}],current_school_id:school};if(route==='resource-contexts')return {items:revoked?[]:[{school_id:school,school:s,type:'MEMBERSHIP',membership_id:'fixture',resources:['study'],expires_at:null,can_administer:false}],current_school_id:school,server_time:new Date().toISOString()};return {school_id:school,context_type:'MEMBERSHIP',expires_at:null,server_time:new Date().toISOString(),resources:{gpu:false,study:!revoked,school_storage:false,fabrication:false,school_compute:false,contests:false},reasons:{}}};export async function selectAccountSchool(id){await new Promise(r=>setTimeout(r,window.fixture.selectDelay||0));window.fixture.school=id;return id};`;
const entry=`import React from 'react';import{createRoot}from'react-dom/client';import{SchoolScopeProvider,useSchoolScope}from'./src/components/schools/SchoolScope';window.fixture={auth:{user:{id:'owner-a'},isLoading:true},listeners:new Set(),calls:[],school:'school-a',revoked:false,delay:80};window.setAuth=(id,loading)=>{window.fixture.auth={user:id?{id}:null,isLoading:loading};window.fixture.listeners.forEach(cb=>cb())};function Probe(){const s=useSchoolScope();window.scope=s;if(s.status==='ready'&&s.resource.status==='ready'&&!window.fixture.readyAt)window.fixture.readyAt=performance.now();return <main><h1>School scope fixture</h1><output>{JSON.stringify({status:s.status,school:s.school?.id,resourceStatus:s.resource.status,resourceSchool:s.resource.current?.school_id})}</output></main>}createRoot(document.getElementById('root')).render(<SchoolScopeProvider><Probe/></SchoolScopeProvider>);`;
await build({stdin:{contents:entry,resolveDir:root,loader:'tsx'},bundle:true,write:true,outfile:path.join(folder,'fixture.js'),jsx:'automatic',plugins:[{name:'synthetic-boundaries',setup(b){b.onResolve({filter:/^@\/lib\/(useAuth|schoolsClient)$/},a=>({path:a.path,namespace:'fixture'}));b.onLoad({filter:/.*/,namespace:'fixture'},a=>({contents:a.path.endsWith('useAuth')?auth:client,loader:'js',resolveDir:root}));b.onResolve({filter:/^@\//},a=>({path:path.join(root,'src',a.path.slice(2)+'.ts')}));}}]});
const js=await fs.readFile(path.join(folder,'fixture.js'),'utf8'),browser=await chromium.launch({executablePath:process.env.CBGPU_CHROMIUM||'/tmp/chromium',headless:true,args:['--no-sandbox','--disable-dev-shm-usage']});const rows:unknown[]=[];
try{for(const [width,mode]of [[1280,'light'],[1280,'dark'],[390,'light'],[390,'dark']]as const){const context=await browser.newContext({viewport:{width,height:800},colorScheme:mode,serviceWorkers:'block'});const page=await context.newPage(),errors:string[]=[];page.on('pageerror',e=>errors.push(e.message));await page.route('**/*',r=>r.fulfill({contentType:'text/html',body:'<html><body><div id="root"></div></body></html>'}));await page.goto('http://scope.fixture');await page.addScriptTag({content:js});await page.waitForFunction(()=>window.scope?.status==='ready'&&window.scope?.resource.status==='ready');await page.waitForTimeout(200);const initial=await page.evaluate(()=>({calls:window.fixture.calls.length,readyMs:window.fixture.readyAt-window.fixture.calls[0].started}));await page.evaluate(()=>window.setAuth('owner-a',false));await page.waitForTimeout(250);const afterAuth=await page.evaluate(()=>({calls:window.fixture.calls.length,status:window.scope.status,resource:window.scope.resource.status}));const beforeFocus=afterAuth.calls;await page.evaluate(()=>{for(let i=0;i<8;i++)window.dispatchEvent(new Event('focus'))});await page.waitForTimeout(250);const afterFocus=await page.evaluate(()=>window.fixture.calls.length);if(!baseline){assert.equal(afterAuth.calls,initial.calls,'Stable owner auth loading must not refetch/reset');assert.ok(afterFocus-beforeFocus<=3,'Focus burst must coalesce one membership/context/access read');assert.equal(initial.calls,3,'Initial membership must not restart resource discovery');}
 await page.evaluate(()=>{window.fixture.delay=160;window.dispatchEvent(new Event('focus'))});await page.waitForTimeout(20);await page.evaluate(()=>{window.fixture.school='school-b';window.dispatchEvent(new CustomEvent('cbgpu-school-changed',{detail:{school_id:'school-b'}}))});await page.waitForTimeout(10);const invalidated=await page.evaluate(()=>window.scope.resource.current===null);if(!baseline)assert.equal(invalidated,true,'Explicit school switch clears old authority immediately');await page.waitForFunction(()=>window.scope.resource.current?.school_id==='school-b');await page.waitForTimeout(200);assert.equal(await page.evaluate(()=>window.scope.resource.current?.school_id),'school-b');
 if(!baseline){for(const method of ['membership','resource']){await page.evaluate(method=>{window.fixture.delay=80;window.fixture.selectDelay=240;window.selectionPromise=method==='membership'?window.scope.switchSchool('school-c'):window.scope.resource.select('school-d')},method);await page.waitForTimeout(15);await page.evaluate(()=>{for(let i=0;i<4;i++)window.dispatchEvent(new Event('focus'))});await page.waitForTimeout(170);assert.equal(await page.evaluate(()=>window.scope.resource.current===null),true,'Slow selection POST must remain failclosed despite focus');await page.evaluate(()=>window.selectionPromise);await page.waitForFunction(id=>window.scope.resource.current?.school_id===id,method==='membership'?'school-c':'school-d');}}
 await page.evaluate(()=>window.setAuth('owner-b',false));await page.waitForTimeout(10);assert.equal(await page.evaluate(()=>window.scope.resource.current===null),true,'Account switch fails closed');await page.waitForFunction(()=>window.scope.resource.status==='ready');await page.evaluate(()=>{window.fixture.revoked=true});const allowed=await page.evaluate(()=>window.scope.resource.verify('study'));assert.equal(allowed,false,'Fresh verify must reject revocation');assert.equal(await page.evaluate(()=>window.scope.resource.current===null),true);assert.deepEqual(errors,[]);rows.push({width,mode,initial,afterAuth,focusRequests:afterFocus-beforeFocus,explicitSchoolInvalidated:invalidated,freshRevocationBlocked:true});await context.close();}console.log(JSON.stringify({baseline,latencyMs:80,rows,actualProviders:true,realNetwork:false}));}finally{await browser.close();await fs.rm(folder,{recursive:true,force:true})}
