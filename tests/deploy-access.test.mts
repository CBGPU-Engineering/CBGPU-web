import test from'node:test';import assert from'node:assert/strict';
import{scopedAccountMode,deploymentProfileAllowed,serverCreationState,canUseDeploymentCompute}from'../src/lib/deployAccess.ts';
const owner='11111111-1111-4111-8111-111111111111',editor='22222222-2222-4222-8222-222222222222';
test('V1 ownership survives graduation, pending verification and legacy approval false; suspension does not',()=>{for(const status of['ACTIVE','PENDING_VERIFICATION','REVERIFICATION_REQUIRED'])assert.equal(deploymentProfileAllowed({id:owner,account_status:status,is_approved:false},owner,true),true);for(const status of['SUSPENDED','UNKNOWN',undefined])assert.equal(deploymentProfileAllowed({id:owner,account_status:status,is_approved:true},owner,true),false);assert.equal(deploymentProfileAllowed({id:editor,account_status:'ACTIVE'},owner,true),false);assert.equal(deploymentProfileAllowed({id:owner,is_approved:false},owner,false),false)});
test('a V1 draft preserves project settings without creating an execution request',()=>{assert.deepEqual(serverCreationState(true,true,'now'),{status:'pending',deploy_requested_at:null});assert.deepEqual(serverCreationState(false,true,'now'),{status:'approved',deploy_requested_at:'now'});assert.deepEqual(serverCreationState(true,false,'now'),{status:'approved',deploy_requested_at:'now'})});
test('service-side scoped oracle checks fresh actor AND owner, never trusts client school',async()=>{const calls:unknown[]=[],client={rpc:async(name:string,args:Record<string,string>)=>{calls.push({name,args});return{data:args.user_id!==owner,error:null}}};assert.equal(await canUseDeploymentCompute(client,editor,owner),false);assert.deepEqual(calls,[{name:'cbgpu_service_can_use_resource',args:{user_id:editor,resource:'school_compute',target_school:'cbsh'}},{name:'cbgpu_service_can_use_resource',args:{user_id:owner,resource:'school_compute',target_school:'cbsh'}}])});
test('revoked permission, malformed oracle replies and oracle outage all fail closed',async()=>{for(const value of[false,null,'true',[],{}])assert.equal(await canUseDeploymentCompute({rpc:async()=>({data:value,error:null})},owner),false);await assert.rejects(canUseDeploymentCompute({rpc:async()=>({data:null,error:{message:'offline'}})},owner),/AUTHORITY_UNAVAILABLE/);let calls=0;assert.equal(await canUseDeploymentCompute({rpc:async()=>{calls++;return{data:true,error:null}}},owner,owner),true);assert.equal(calls,1)});
test('only actual frontend allocation actions require compute; reads, settings and drafts survive expiry',async()=>{const{frontendExecutionRequested}=await import('../src/lib/deployAccess.ts');assert.equal(frontendExecutionRequested(['projects'],'POST',{draft:true}),false);assert.equal(frontendExecutionRequested(['projects'],'POST',{draft:'true'}),true);assert.equal(frontendExecutionRequested(['projects'],'POST',{}),true);assert.equal(frontendExecutionRequested(['projects',owner,'deploy'],'POST',{}),true);assert.equal(frontendExecutionRequested(['projects',owner],'PATCH',{name:'Owned retained project'}),false);assert.equal(frontendExecutionRequested(['projects',owner],'GET',undefined),false);assert.equal(frontendExecutionRequested(['projects',owner],'DELETE',{}),false)});

test("authorization flags accept canonical enabled forms and refuse silent legacy downgrade",()=>{for(const key of ["CBGPU_MULTISCHOOL_V1","CBGPU_ACCOUNT_V2"]){for(const value of ["1","true"])assert.equal(scopedAccountMode({[key]:value}),true);for(const value of ["0","false",""])assert.equal(scopedAccountMode({[key]:value}),false);for(const value of ["TRUE","on"," 1","invalid"])assert.throws(()=>scopedAccountMode({[key]:value}),/배포 권한 설정/)}assert.equal(scopedAccountMode({}),false);assert.throws(()=>scopedAccountMode({CBGPU_MULTISCHOOL_V1:"1",CBGPU_ACCOUNT_V2:"typo"}),/배포 권한 설정/)});
