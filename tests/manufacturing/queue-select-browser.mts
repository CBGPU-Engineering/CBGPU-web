/** Real shared Dialog/Select + actual printer queue policy, synthetic jobs only. */
import {build} from 'esbuild';
import postcss from 'postcss';
import tailwind from '@tailwindcss/postcss';
import fs from 'node:fs/promises';
import path from 'node:path';
import {fileURLToPath} from 'node:url';
import {createServer} from 'node:http';
import {once} from 'node:events';
import {chromium} from 'playwright';
import assert from 'node:assert/strict';
const baseline=process.env.CBGPU_QUEUE_BASELINE==='1';
const repo=fileURLToPath(new URL('../../',import.meta.url)),out=path.resolve(process.env.CBGPU_QUEUE_PROOF_DIR||'artifacts/queue-select');await fs.mkdir(out,{recursive:true});
const source=`import React from 'react';import{createRoot}from'react-dom/client';import{Dialog,DialogContent,DialogTitle,DialogDescription}from'@/components/ui/dialog';import{Select,SelectContent,SelectItem,SelectTrigger,SelectValue}from'@/components/ui/select';import{queuedPrintJobsForPrinter}from'@/lib/manufacturing/printerQueue';
const jobs=[{id:'correct',status:'accepted',preferred_printer_id:1,file_name:'Printer 1 model with a long descriptive project name and Korean 학생 작품 출력 최종 제출 버전.3mf'},{id:'wrong',status:'accepted',preferred_printer_id:2,file_name:'Printer 2 model.3mf'},{id:'pending',status:'pending',preferred_printer_id:1,file_name:'Pending model.3mf'}];
function App(){const[open,setOpen]=React.useState(false),[value,setValue]=React.useState('');return <main className="admin-developer-shell cb-school-scoped-shell min-h-screen bg-background text-foreground p-6"><Select><SelectTrigger aria-label="Outside selection"><SelectValue placeholder="Outside selection"/></SelectTrigger><SelectContent><SelectItem value="outside">Outside option</SelectItem></SelectContent></Select><button onClick={()=>setOpen(true)}>Start print</button><Dialog open={open} onOpenChange={setOpen}><DialogContent><DialogTitle>Printer 1 Start print</DialogTitle><DialogDescription>Select a queued job.</DialogDescription><Select value={value} onValueChange={setValue}><SelectTrigger aria-label="Queued print job"><SelectValue placeholder="Select job"/></SelectTrigger><SelectContent>{queuedPrintJobsForPrinter(jobs,1).map(j=><SelectItem key={j.id} value={j.id}>{j.file_name}</SelectItem>)}</SelectContent></Select><p data-selected>{value}</p></DialogContent></Dialog></main>}createRoot(document.getElementById('root')).render(<App/>);`;
const bundle=await build({stdin:{contents:source,resolveDir:repo,loader:'tsx'},bundle:true,write:false,platform:'browser',jsx:'automatic',define:{'process.env.NODE_ENV':'"production"'},plugins:[{name:'original-select-baseline',setup(b){if(baseline)b.onLoad({filter:/components\/ui\/select\.tsx$/},async args=>({contents:(await fs.readFile(args.path,'utf8')).replace('container={managementPortalContainer()}','').replace('z-[202]','z-50'),loader:'tsx',resolveDir:path.dirname(args.path)}))}}]});
const css=await postcss([tailwind({base:repo})]).process(await fs.readFile(path.join(repo,'src/app/globals.css'),'utf8'),{from:path.join(repo,'src/app/globals.css')});
const server=createServer((req,res)=>{res.setHeader('content-type',req.url==='/fixture.js'?'application/javascript':req.url==='/style.css'?'text/css':'text/html');res.end(req.url==='/fixture.js'?bundle.outputFiles![0].text:req.url==='/style.css'?css.css:'<!doctype html><link rel="stylesheet" href="/style.css"><div id="root"></div><script src="/fixture.js"></script>')});server.listen(0,'127.0.0.1');await once(server,'listening');const origin='http://127.0.0.1:'+(server.address()as{port:number}).port;
const browser=await chromium.launch({headless:true,executablePath:process.env.CBGPU_CHROMIUM||(await fs.access('/tmp/chromium').then(()=>true,()=>false)?'/tmp/chromium':undefined),args:['--no-sandbox','--disable-dev-shm-usage']});
try{for(const width of [1280,390,320])for(const theme of ['light','dark']){const context=await browser.newContext({viewport:{width,height:844},reducedMotion:'reduce'});await context.route('**/*',route=>new URL(route.request().url()).origin===origin?route.continue():route.abort());const page=await context.newPage();const errors:string[]=[];page.on('pageerror',e=>errors.push(e.message));await page.goto(origin);await page.evaluate(t=>document.documentElement.classList.toggle('dark',t==='dark'),theme);await page.getByRole('combobox',{name:'Outside selection'}).click();await page.getByRole('option',{name:'Outside option'}).click();await page.getByRole('combobox',{name:'Outside selection'}).focus();await page.keyboard.press('Enter');await page.getByRole('option',{name:'Outside option'}).waitFor();await page.keyboard.press('Escape');await page.getByRole('option',{name:'Outside option'}).waitFor({state:'hidden'});await page.waitForFunction(()=>document.activeElement?.getAttribute('aria-label')==='Outside selection');assert.equal(await page.getByRole('combobox',{name:'Outside selection'}).evaluate(e=>document.activeElement===e),true);await page.getByRole('button',{name:'Start print',exact:true}).click();await page.getByRole('combobox',{name:'Queued print job'}).click();const option=page.getByRole('option',{name:/^Printer 1 model with a long/});await option.waitFor();assert.equal(await page.getByRole('option').count(),1,'other-printer and unapproved jobs stay excluded');await page.screenshot({path:path.join(out,`${width}-${theme}.png`)});const hit=await option.evaluate(element=>{const rect=element.getBoundingClientRect(),target=document.elementFromPoint(rect.x+rect.width/2,rect.y+rect.height/2);return{left:rect.left,right:rect.right,top:!!target&&element.contains(target),portal:!!element.closest('.cb-school-scoped-shell'),z:getComputedStyle(element.closest('[data-slot="select-content"]')!).zIndex}});if(baseline){assert.equal(hit.top,false,'original menu is covered by the dialog');await context.close();continue;}assert.ok(hit.left>=0&&hit.right<=width,`option fits viewport: ${JSON.stringify(hit)}`);assert.equal(hit.top,true,`queued job must be above dialog backdrop: ${JSON.stringify(hit)}`);assert.equal(hit.portal,true,'menu inherits the management portal theme');await option.click();await page.locator('[data-selected]').filter({hasText:'correct'}).waitFor();assert.equal(await page.getByRole('dialog').count(),1);const trigger=page.getByRole('combobox',{name:'Queued print job'});await trigger.focus();await page.keyboard.press('Enter');await page.getByRole('option',{name:/^Printer 1 model with a long/}).waitFor();await page.keyboard.press('Escape');await page.waitForFunction(()=>document.activeElement?.getAttribute('aria-label')==='Queued print job');assert.equal(await page.getByRole('dialog').count(),1);await page.keyboard.press('Enter');await page.keyboard.press('ArrowDown');await page.keyboard.press('Enter');assert.equal(await page.getByRole('dialog').count(),1);assert.equal(await page.evaluate(()=>document.documentElement.scrollWidth<=innerWidth),true);assert.deepEqual(errors,[]);await context.close();}console.log(baseline?'PASS six original frames reproduce menu behind modal.':'PASS six frames: queued option clickable above modal, correct printer only, management theme inherited, selection works, no overflow/page errors.');}finally{await browser.close();await new Promise<void>(resolve=>server.close(()=>resolve()));}
