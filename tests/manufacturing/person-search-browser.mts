/** Actual person picker: keyboard search, selection and clear; synthetic candidates only. */
import{build}from'esbuild';import postcss from'postcss';import tailwind from'@tailwindcss/postcss';import fs from'node:fs/promises';import path from'node:path';import{chromium}from'playwright';import assert from'node:assert/strict';
const repo=process.cwd(),output=process.env.CBGPU_PERSON_PROOF_DIR||'/tmp/cbgpu-oil-operations/person-search';await fs.mkdir(output,{recursive:true});
const bundle=await build({stdin:{contents:`import React from'react';import{createRoot}from'react-dom/client';import{PersonSearchSelect}from'./src/components/manufacturing/PersonSearchSelect';const candidates=[{id:'a',full_name:'가상 담당자',student_id:'1101'},{id:'b',full_name:'아주 긴 이름을 사용하는 가상 제작 장비 담당자',student_id:'2202'}];function App(){const[value,setValue]=React.useState('');return <main className="p-4 max-w-xl"><h1 className="text-xl mb-4">담당자 지정</h1><PersonSearchSelect candidates={candidates} value={value} onChange={setValue}/><p role="status">{value?'선택: '+value:'담당자를 선택해 주세요'}</p></main>}createRoot(document.getElementById('root')).render(<App/>);`,resolveDir:repo,loader:'tsx'},bundle:true,write:false,outfile:'fixture.js',platform:'browser',jsx:'automatic',define:{'process.env.NODE_ENV':'"production"'}});
const css=(await postcss([tailwind({base:repo})]).process(await fs.readFile('src/app/globals.css','utf8'),{from:path.join(repo,'src/app/globals.css')})).css,script=bundle.outputFiles.find(f=>f.path.endsWith('.js'))!.text;
const browser=await chromium.launch({headless:true,args:['--no-sandbox']});try{for(const width of[360,1280])for(const dark of[false,true]){const context=await browser.newContext({viewport:{width,height:800},reducedMotion:'reduce',...(width===360?{userAgent:'Mozilla/5.0 (Linux; Android 14; wv) AppleWebKit/537.36 Chrome/130 Mobile Safari/537.36'}:{})});await context.route('**/*',route=>{const url=new URL(route.request().url());assert.equal(url.origin,'https://fixture.invalid');assert.equal(route.request().method(),'GET');return url.pathname==='/fixture.js'?route.fulfill({contentType:'application/javascript',body:script}):route.fulfill({contentType:'text/html',body:`<!doctype html><html class="${dark?'dark':''}"><meta name="viewport" content="width=device-width,initial-scale=1"><style>${css}</style><body><div id="root"></div><script src="/fixture.js"></script></body></html>`})});const page=await context.newPage(),errors:string[]=[];page.on('pageerror',e=>errors.push(e.message));await page.goto('https://fixture.invalid');const input=page.getByRole('combobox');await input.fill('없는 사람');await page.getByText('검색 결과가 없어요. 이름이나 학번을 바꿔 보세요.').waitFor();await input.fill('2202');assert.equal(await page.getByRole('option').count(),1);await page.screenshot({path:path.join(output,`${width}-${dark?'dark':'light'}-results.png`),fullPage:true});await input.press('Enter');await page.getByText('선택: b',{exact:true}).waitFor();await page.getByRole('button',{name:'담당자 선택 해제'}).click();await page.getByRole('combobox').focus();await page.keyboard.press('ArrowDown');await page.keyboard.press('ArrowDown');await page.keyboard.press('Enter');await page.getByText('선택: b',{exact:true}).waitFor();await page.getByRole('button',{name:'담당자 선택 해제'}).click();await page.getByRole('combobox').focus();await page.keyboard.press('Escape');assert.equal(await page.getByRole('listbox').count(),0);assert.equal(await page.getByRole('combobox').getAttribute('aria-expanded'),'false');assert.ok(await page.evaluate(()=>document.documentElement.scrollWidth<=innerWidth+1));assert.deepEqual(errors,[]);await context.close();}console.log('PASS person picker: 360px WebView/1280px, light/dark, no-match/search/keyboard select/clear/Escape, no overflow or page errors, no network writes.')}finally{await browser.close()}
