window.__sdk={auth:{getSession:async()=>({data:{session:window.__state.session?{user:{id:window.__state.session},access_token:'synthetic.operator.token'}:null},error:null})},storage:{from:bucket=>{if(bucket!=='manufacturing')throw Error('Wrong bucket');return{createSignedUrl:()=>{window.__signed++;throw Error('Signed URL mint forbidden')},download:async path=>{const actor=window.__state.session,allowed=path.startsWith(actor+'/')||window.__state.grant;window.__calls.push({path,actor});if(!allowed)return{data:null,error:{statusCode:'403'}};const result={data:new Blob(['synthetic-file:'+path]),error:null};if(window.__delayed[path])return new Promise(resolve=>{(window.__pending[path]||=[]).push(()=>resolve(result))});return result}}}}};
