try{
 const context=await browser.newContext({acceptDownloads:true,serviceWorkers:'block'});await context.route('**/*',r=>new URL(r.request().url()).origin===origin?r.continue():r.abort());const page=await context.newPage(),errors:string[]=[];page.on('pageerror',e=>errors.push(e.message));
 await page.goto(origin,{waitUntil:'networkidle'});await page.waitForFunction(()=>!!(window as any).__file.url);const old=await page.locator('#preview').innerText();
 const pending='owner/print/pending.3mf';await page.evaluate(p=>{(window as any).__delayed[p]=true;(window as any).__render({path:p})},pending);await page.waitForFunction(p=>(window as any).__pending[p]?.length===1,pending);
 const canRead=async(url:string)=>page.evaluate(async u=>{try{await fetch(u);return true}catch{return false}},url);assert.equal(await canRead(old),false,'path change must revoke old preview');
 await page.evaluate(()=>(window as any).__render({viewer:'new-owner',session:'new-owner',path:'new-owner/print/new.3mf',grant:false}));await page.waitForFunction(()=>!!(window as any).__file.url);const next=await page.locator('#preview').innerText();assert.notEqual(next,old);assert.equal(await page.evaluate(async u=>(await fetch(u)).text(),next),'synthetic-file:new-owner/print/new.3mf');const created=await page.evaluate(()=>(window as any).__created.length);
 await page.evaluate(p=>(window as any).__resolve(p),pending);await page.waitForTimeout(100);assert.equal(await page.locator('#preview').innerText(),next);assert.equal(await page.evaluate(()=>(window as any).__created.length),created,'late old-owner result must not create a URL');
 const count=await page.evaluate(()=>(window as any).__calls.length),download=page.waitForEvent('download');await page.locator('#download').click();assert.equal((await download).suggestedFilename(),'fixture.3mf');assert.equal(await page.evaluate(()=>(window as any).__calls.length),count+1,'download must fetch fresh bytes');
 await page.evaluate(()=>(window as any).__render({viewer:'manager',session:'manager',grant:true}));await page.waitForFunction(()=>!!(window as any).__file.url);const manager=await page.locator('#preview').innerText();await page.evaluate(()=>(window as any).__render({grant:false}));await page.locator('#download').click();await page.waitForFunction(()=>!!(window as any).__file.error);assert.equal(await page.locator('#preview').innerText(),'');assert.equal(await canRead(manager),false);
 const deniedCalls=await page.evaluate(()=>(window as any).__calls.length);await page.evaluate(()=>(window as any).__render({session:'cookie-other'}));await page.locator('#reload').click();await page.waitForFunction(()=>(window as any).__file.error.includes('로그인'));assert.equal(await page.evaluate(()=>(window as any).__calls.length),deniedCalls,'different SDK session must not borrow identity');
 const race='new-owner/print/race.3mf';await page.evaluate(p=>{(window as any).__delayed[p]=true;(window as any).__render({viewer:'new-owner',session:'new-owner',path:p,grant:false})},race);await page.waitForFunction(p=>(window as any).__pending[p]?.length===1,race);await page.locator('#reload').click();await page.waitForFunction(p=>(window as any).__pending[p]?.length===2,race);await page.evaluate(p=>(window as any).__resolve(p,1),race);await page.waitForFunction(()=>!!(window as any).__file.url);const latest=await page.locator('#preview').innerText();await page.evaluate(p=>(window as any).__resolve(p,0),race);await page.waitForTimeout(100);assert.equal(await page.locator('#preview').innerText(),latest,'late same-path retry must not erase new preview');
 await page.evaluate(()=>(window as any).__unmount());assert.equal(await canRead(latest),false);assert.equal(await page.evaluate(()=>(window as any).__signed),0);assert.deepEqual(errors,[]);
 console.log('PASS actual React file hook: owner after grant loss, fresh click download, revoked manager denial, SDK identity binding, stale owner/path/retry results ignored, object URL cleanup, zero signed mint.');await context.close();
}finally{await browser.close();server.close();}
