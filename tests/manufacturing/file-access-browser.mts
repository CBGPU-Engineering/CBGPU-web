const result=await build({stdin:{contents:entry,resolveDir:repo,loader:'tsx'},bundle:true,write:false,platform:'browser',define:{'process.env.NODE_ENV':'"production"'},plugins:[{name:'sdk-fixture-only',setup(b){b.onResolve({filter:/^@\/lib\/supabase$/},()=>({path:'sdk',namespace:'fixture'}));b.onLoad({filter:/.*/,namespace:'fixture'},()=>({contents:`export const supabase={auth:{getSession:()=>window.__sdk.auth.getSession()},storage:{from:b=>window.__sdk.storage.from(b)}};const actualFetch=globalThis.fetch.bind(globalThis);globalThis.fetch=async(input,init)=>{if(!String(input).startsWith('/api/manufacturing/file-read?'))return actualFetch(input,init);if(init.headers.Authorization!=='Bearer synthetic.operator.token'||init.credentials!=='omit')throw Error('Wrong private file authority');const path=new URL(String(input),location.origin).searchParams.get('key');const result=await window.__sdk.storage.from('manufacturing').download(path);return result.error?new Response('Denied',{status:403}):new Response(result.data)};`,loader:'js'}));}}]});const js=result.outputFiles![0].text;
const server=createServer((req,res)=>{res.writeHead(200,{'content-type':req.url==='/fixture.js'?'application/javascript':'text/html','cache-control':'no-store'});res.end(req.url==='/fixture.js'?js:'<!doctype html><div id="root"></div><script src="/fixture.js"></script>')});server.listen(0,'127.0.0.1');await once(server,'listening');const origin='http://127.0.0.1:'+(server.address()as{port:number}).port;
