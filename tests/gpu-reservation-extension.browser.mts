/** Actual Next UI; synthetic accounts/records only. No real GPU or school requests. */
import {chromium} from 'playwright';
import fs from 'node:fs';
import assert from 'node:assert/strict';
const origin=process.env.CBGPU_GPU_EXTENSION_ORIGIN||'http://localhost:13900';assert.match(origin,/^http:\/\/(localhost|127\.0\.0\.1):\d+$/);
for(let attempt=0;;attempt++){try{await fetch(origin+'/_next/static/__gpu-extension-readiness__.js',{signal:AbortSignal.timeout(1000)});break}catch{if(attempt>=50)throw Error('Isolated GPU preview did not become ready');await new Promise(resolve=>setTimeout(resolve,200))}}
const output=process.env.CBGPU_GPU_EXTENSION_OUTPUT||'/tmp/cbgpu-gpu-extension';fs.mkdirSync(output,{recursive:true});
const browser=await chromium.launch({headless:true,executablePath:process.env.CBGPU_CHROMIUM||chromium.executablePath(),args:['--no-sandbox','--disable-dev-shm-usage']});
const id='11111111-1111-4111-8111-111111111111',rid='22222222-2222-4222-8222-222222222222',jid='33333333-3333-4333-8333-333333333333';
const local=(value:string)=>new Date(Date.parse(value)+9*3600000).toISOString().slice(0,19); // Contexts use Asia/Seoul, independently of the CI host timezone.
const results=[];
try{for(const [width,theme,app]of[[1280,'light',false],[1280,'dark',false],[390,'light',false],[390,'dark',true],[320,'light',true]]as const){
 const c=await browser.newContext({viewport:{width,height:900},colorScheme:theme,locale:'ko-KR',timezoneId:'Asia/Seoul',reducedMotion:'reduce',userAgent:app?'Mozilla/5.0 (Linux; Android 14; Pixel 8; wv) AppleWebKit/537.36 Version/4.0 Chrome/131.0 Mobile Safari/537.36':undefined});
 const session=await fetch(origin+'/backend/auth/v1/token?grant_type=password',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({email:'student@example.invalid',password:'demo-only'})}).then(r=>r.json());await c.addInitScript(s=>localStorage.setItem('sb-localhost-auth-token',JSON.stringify(s)),session);
 let schoolId='cbsh',conflict=false,posts=0,reads=0;const current=new Date(Date.now()+3600000).toISOString(),limit=new Date(Date.parse(current)+5400000).toISOString();let end=current;
 await c.route('**/*',async route=>{const request=route.request(),u=new URL(request.url());if(!['localhost','127.0.0.1'].includes(u.hostname))return route.abort();const json=(body:unknown,status=200)=>route.fulfill({status,json:body});
 const school={id:schoolId,official_name:'연장 검증 학교',display_name:'연장 검증 학교',type:'HIGH',region:'test',status:'APPROVED',features:['gpu_compute','school_life','projects','community','ai'],life_capabilities:{timetable:true,meal:true,news:true},brand_color:'#3182f6',logo_path:null};const member={id:'synthetic-member',user_id:session.user.id,school_id:schoolId,membership_type:'STUDENT',status:'ACTIVE',verified:true,school_roles:[],school};
 if(u.pathname==='/api/auth/shared-session')return json({state:'active',value:JSON.stringify(session)});
 if(u.pathname==='/api/schools/memberships')return json({items:[member],current_school_id:schoolId});
 if(u.pathname==='/api/schools/resource-contexts')return json({items:[{school_id:schoolId,school,type:'MEMBERSHIP',membership_id:member.id,resources:['gpu','study','school_storage','fabrication','school_compute','contests','ai','central_cpu'],expires_at:null,can_administer:false}],current_school_id:schoolId,server_time:new Date().toISOString()});
 if(/^\/api\/schools\/schools\/[^/]+\/resource-access$/.test(u.pathname))return json({school_id:schoolId,legacy_cbsh_access:schoolId==='cbsh',context_type:'MEMBERSHIP',expires_at:null,server_time:new Date().toISOString(),resources:{gpu:true,study:true,school_storage:true,fabrication:true,school_compute:true,contests:true,ai:true,central_cpu:true},reasons:{}});
 if(u.pathname.endsWith('/extension')){reads++;return json({reservation_id:id,current_end:end,max_end:limit,server_now:new Date().toISOString(),can_extend:schoolId==='cbsh',reason:schoolId==='cbsh'?null:'EXECUTOR_EXTENSION_UNSUPPORTED'})}
 if(u.pathname.endsWith('/extend')){posts++;assert.equal(request.method(),'POST');const body=request.postDataJSON();assert.deepEqual(Object.keys(body).sort(),['ends_at','expected_ends_at']);assert.equal(body.expected_ends_at,end);if(conflict)return json({error:'RESERVATION_CONFLICT'},409);assert.ok(Date.parse(body.ends_at)<=Date.parse(limit));end=body.ends_at;return json({reservation_id:id,current_end:end,max_end:limit,server_now:new Date().toISOString(),can_extend:false,reason:'RESERVATION_CONFLICT',updated:true})}
 if(u.pathname==='/backend/rest/v1/reservations')return request.method()==='GET'?json([{id,user_id:session.user.id,gpu_id:1,start_time:new Date(Date.now()-3600000).toISOString(),end_time:end,status:'approved',created_at:new Date().toISOString(),purpose:'Synthetic extension verification'}]):route.abort();
 if(u.pathname.startsWith('/backend/rest/v1/rpc/get_gpu_'))return json([]);
 if(u.pathname.includes('/rpc/get_active_gpu_password'))return json(null);
 if(u.pathname==='/api/gpu-status')return json({checkedAt:new Date().toISOString(),gpus:[1,2,3,4].map(id=>({id,status:'online'}))});
 if(u.pathname.startsWith('/api/compute/schools/')){if(u.pathname.endsWith('/resources'))return json({items:[{id:rid,node_id:rid,school_id:schoolId,name:'Synthetic school GPU',memory_total_mib:24576,state:'READY',reason:'',execution_enabled:true,execution_ready:true,transport_ready:true,sharing_enabled:false}]});if(u.pathname.endsWith('/reservations'))return json({items:[{id,resource_id:rid,owner_id:session.user.id,starts_at:new Date(Date.now()-3600000).toISOString(),ends_at:end,status:'RESERVED',created_at:new Date().toISOString()}]});if(u.pathname.endsWith('/notebook'))return json({job:{id:jid,reservation_id:id,status:'RUNNING',ends_at:end},notebook_url:null});return route.abort()}
 if(!['GET','HEAD'].includes(request.method())&&!u.pathname.startsWith('/backend/auth/'))return route.abort();return route.continue();
 });
 const p=await c.newPage(),errors:string[]=[];p.on('pageerror',e=>errors.push(e.message));await p.goto(origin+'/dashboard?mode=researcher'+(app?'&native=1':'&demo-frame=web'),{waitUntil:'domcontentloaded'});const trigger=p.getByRole('button',{name:'사용 연장',exact:true});await trigger.waitFor();await trigger.click();const dialog=p.getByRole('dialog');await dialog.waitFor();await p.getByLabel('새 종료 시간',{exact:true}).waitFor();assert.equal(await p.getByRole('button',{name:'3시간 연장',exact:true}).isDisabled(),true);const box=await dialog.boundingBox();assert.ok(box&&box.x>=0&&box.x+box.width<=width+1&&box.y>=0&&box.y+box.height<=900);await p.screenshot({path:`${output}/${width}-${theme}.png`});
 conflict=true;await p.getByRole('button',{name:'사용 시간 연장하기',exact:true}).click();await dialog.getByRole('alert').waitFor();assert.match(await dialog.getByRole('alert').innerText(),/다른 예약/);assert.equal(posts,1);assert.equal(end,current);assert.equal(await p.getByRole('button',{name:'사용 시간 연장하기',exact:true}).count(),0);
 conflict=false;await p.getByRole('button',{name:'다시 확인',exact:true}).click();await p.getByLabel('새 종료 시간',{exact:true}).fill(local(limit));await p.getByRole('button',{name:'사용 시간 연장하기',exact:true}).click();await dialog.waitFor({state:'hidden'});assert.equal(posts,2);assert.equal(Date.parse(end),Math.floor(Date.parse(limit)/1000)*1000);assert.ok(reads>=2);await p.getByRole('button',{name:'사용 연장',exact:true}).waitFor();assert.equal(await p.evaluate(()=>document.documentElement.scrollWidth>innerWidth+1),false);
 schoolId='school-b';await p.goto(origin+'/compute?mode=researcher'+(app?'&native=1':'&demo-frame=web'));await p.getByRole('button',{name:'사용 연장',exact:true}).click();await p.getByText('이 실행 환경은 사용 중 연장을 아직 지원하지 않아요. 현재 예약은 그대로 유지돼요.',{exact:true}).waitFor();assert.equal(await p.getByRole('button',{name:'사용 시간 연장하기',exact:true}).count(),0);assert.equal(posts,2);await p.getByRole('button',{name:'닫기',exact:true}).first().click();await p.getByRole('dialog').waitFor({state:'hidden'});await p.waitForFunction(()=>document.activeElement?.textContent?.includes('사용 연장'));assert.deepEqual(errors,[]);results.push({width,theme,app,conflictRejected:true,noAutomaticRetries:true,adjacentBookingBoundary:true,schoolRunningJobNotFaked:true,overflow:false});await c.close();
 }
 fs.writeFileSync(output+'/PASSED.json',JSON.stringify({results,syntheticOnly:true,realMutations:false},null,2));console.log(JSON.stringify(results));
}finally{await browser.close()}
