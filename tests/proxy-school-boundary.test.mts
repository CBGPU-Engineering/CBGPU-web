import{createRequire}from'node:module';
import test from'node:test';import assert from'node:assert/strict';import fs from'node:fs';import path from'node:path';import vm from'node:vm';import ts from'typescript';import{NextRequest,NextResponse}from'next/server.js';import{schoolRequestOriginAllowed}from'../src/lib/schoolsProxySecurity.ts';
function proxy(env:Record<string,string>={}){const cache=new Map<string,any>();function load(file:string){if(cache.has(file))return cache.get(file);const exports:any={};cache.set(file,exports);vm.runInNewContext(ts.transpileModule(fs.readFileSync(file,'utf8'),{compilerOptions:{module:ts.ModuleKind.CommonJS,target:ts.ScriptTarget.ES2022}}).outputText,{exports,Buffer,URL,Headers,Date,Map,process:{env},require:(name:string)=>{if(name==='next/server')return{NextRequest,NextResponse};if(['node:fs','node:crypto'].includes(name))return createRequire(import.meta.url)(name);assert(name.startsWith('.'));return load(path.resolve(path.dirname(file),name+'.ts'))}});return exports;}return load(path.resolve('src/proxy.ts')).proxy;}
function request(host:string,pathname:string){return new NextRequest('https://'+host+pathname,{headers:{host,Authorization:'Bearer synthetic-boundary'}})}
test('operator hosts can resolve their own fresh school context without exposing unrelated pages',()=>{const run=proxy();for(const host of ['manufacturing.cbgpu.com','print.cbgpu.com','laser.cbgpu.com']){for(const path of ['/api/schools/memberships','/api/schools/current-school','/api/schools/resource-contexts','/api/schools/schools/cbsh/resource-access','/api/schools/schools/cbsh/life-sources']){const result=run(request(host,path));assert.equal(result.status,200);assert.equal(result.headers.get('x-middleware-next'),'1');assert.equal(result.headers.get('x-middleware-request-x-cbgpu-public-host'),host)}assert.equal(run(request(host,'/api/schools/admin/applications')).status,404);assert.equal(schoolRequestOriginAllowed(host,'https://'+host),true);assert.equal(schoolRequestOriginAllowed(host,'https://cbgpu.com'),false)}});
test('runtime backend rewriting preserves trusted host context and refuses malformed configuration',()=>{const run=proxy({CBGPU_BACKEND_PROXY_URL:'http://127.0.0.1:19090'});const response=run(request('app.cbgpu.com','/backend/rest/v1/projects?select=id'));assert.equal(response.headers.get('x-middleware-rewrite'),'http://127.0.0.1:19090/rest/v1/projects?select=id');assert.equal(response.headers.get('x-middleware-request-x-cbgpu-public-host'),'app.cbgpu.com');assert.equal(response.headers.get('cache-control'),'private, no-store');assert.equal(response.headers.get('x-robots-tag'),'noindex, nofollow');const bad=proxy({CBGPU_BACKEND_PROXY_URL:'https://unapproved.example'});assert.equal(bad(request('app.cbgpu.com','/backend/auth/v1/token')).status,503);assert.equal(run(request('cbgpu.com','/admin')).status,404)});

test("public asset aliases stay on public browsing hosts",()=>{const run=proxy();const path="/api/public-assets/contests/11111111-1111-4111-8111-111111111111/banner";for(const host of ["cbgpu.com","www.cbgpu.com","app.cbgpu.com","student.cbgpu.com","researcher.cbgpu.com","developer.cbgpu.com"])assert.equal(run(request(host,path)).headers.get("x-middleware-next"),"1");for(const host of ["admin.cbgpu.com","developers.cbgpu.com","docs.cbgpu.com","arxiv.cbgpu.com","manufacturing.cbgpu.com","print.cbgpu.com","laser.cbgpu.com","gpu.cbgpu.com","unknown.invalid"])assert.equal(run(request(host,path)).status,404)});

test('platform landing is school-first only when enabled and user hosts stay separate',()=>{const scoped=proxy({NEXT_PUBLIC_CBGPU_MULTISCHOOL_V1:'1'}),legacy=proxy();assert.equal(scoped(request('admin.cbgpu.com','/')).headers.get('location'),'https://admin.cbgpu.com/admin/schools');assert.equal(legacy(request('admin.cbgpu.com','/')).headers.get('location'),'https://admin.cbgpu.com/admin/gpu');assert.equal(scoped(request('cbgpu.com','/admin/schools')).status,404);assert.equal(scoped(request('admin.cbgpu.com','/admin/gpu')).headers.get('location'),null)});

test('notebook HTML requires isolated edge proof while node relay forwards no browser identity',()=>{const folder=fs.mkdtempSync('/tmp/cbgpu-edge-proof-');try{const key='e'.repeat(64),file=path.join(folder,'key');fs.writeFileSync(file,key,{mode:0o600});const run=proxy({CBGPU_GPU_NOTEBOOKS_ENABLED:'1',CBGPU_NOTEBOOK_EDGE_KEY_FILE:file});const job='11111111-1111-4111-8111-111111111111',route='/__notebook_gateway/notebooks/'+job+'/lab';assert.equal(run(request('cbgpu.com',route)).status,404);assert.equal(run(request('notebooks.cbgpu.com','/api/auth/shared-session')).status,404);const req=new NextRequest('https://cbgpu.com'+route,{headers:{host:'cbgpu.com','x-cbgpu-note-edge':key,authorization:'Bearer never-forward'}});const result=run(req);assert.equal(result.headers.get('x-middleware-rewrite'),'http://127.0.0.1:3557/notebooks/'+job+'/lab');assert.equal(result.headers.get('x-middleware-request-x-cbgpu-public-host'),'notebooks.cbgpu.com');assert.equal(result.headers.get('x-middleware-request-authorization'),null);assert.equal(result.headers.get('x-middleware-request-x-cbgpu-note-edge'),null);const node=run(new NextRequest('https://cbgpu.com/v1/gpu/relay',{headers:{host:'cbgpu.com',cookie:'private-browser-session',authorization:'Bearer private-browser-token','x-cbgpu-node-id':job}}));assert.equal(node.headers.get('x-middleware-rewrite'),'http://127.0.0.1:3557/v1/gpu/relay');assert.equal(node.headers.get('x-middleware-request-cookie'),null);assert.equal(node.headers.get('x-middleware-request-authorization'),null);assert.equal(run(request('admin.cbgpu.com','/v1/gpu/relay')).status,404)}finally{fs.rmSync(folder,{recursive:true,force:true})}});

test('manufacturing portals serve real public brand variants without widening portal or write access',()=>{
 const run=proxy(),assets=fs.readdirSync(new URL('../public/brand/v1/',import.meta.url));
 for(const host of ['manufacturing.cbgpu.com','print.cbgpu.com','laser.cbgpu.com']){
  for(const name of assets)for(const method of ['GET','HEAD']){const response=run(new NextRequest('https://'+host+'/brand/v1/'+name,{method,headers:{host}}));assert.equal(response.headers.get('x-middleware-next'),'1',host+' '+method+' '+name);assert.equal(response.headers.get('location'),null)}
  for(const name of assets)assert.equal(run(new NextRequest('https://'+host+'/brand/v1/'+name,{method:'POST',headers:{host}})).status,404);
  for(const path of ['/brand/v1/private.json','/brand/v1/unknown.svg','/brand/v2/symbol_black.svg','/api/admin/profiles','/dashboard'])assert.equal(run(request(host,path)).status,404);
 }
});
