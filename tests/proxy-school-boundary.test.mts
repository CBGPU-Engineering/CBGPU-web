import test from'node:test';import assert from'node:assert/strict';import fs from'node:fs';import path from'node:path';import vm from'node:vm';import ts from'typescript';import{NextRequest,NextResponse}from'next/server.js';import{schoolRequestOriginAllowed}from'../src/lib/schoolsProxySecurity.ts';
function proxy(env:Record<string,string>={}){const cache=new Map<string,any>();function load(file:string){if(cache.has(file))return cache.get(file);const exports:any={};cache.set(file,exports);vm.runInNewContext(ts.transpileModule(fs.readFileSync(file,'utf8'),{compilerOptions:{module:ts.ModuleKind.CommonJS,target:ts.ScriptTarget.ES2022}}).outputText,{exports,URL,Headers,Date,Map,process:{env},require:(name:string)=>{if(name==='next/server')return{NextRequest,NextResponse};assert(name.startsWith('.'));return load(path.resolve(path.dirname(file),name+'.ts'))}});return exports;}return load(path.resolve('src/proxy.ts')).proxy;}
function request(host:string,pathname:string){return new NextRequest('https://'+host+pathname,{headers:{host,Authorization:'Bearer synthetic-boundary'}})}
test('operator hosts can resolve their own fresh school context without exposing unrelated pages',()=>{const run=proxy();for(const host of ['manufacturing.cbgpu.com','print.cbgpu.com','laser.cbgpu.com']){for(const path of ['/api/schools/memberships','/api/schools/current-school','/api/schools/resource-contexts','/api/schools/resource-access','/api/schools/schools/cbsh/life-sources']){const result=run(request(host,path));assert.equal(result.status,200);assert.equal(result.headers.get('x-middleware-next'),'1');assert.equal(result.headers.get('x-middleware-request-x-cbgpu-public-host'),host)}assert.equal(run(request(host,'/api/schools/admin/applications')).status,404);assert.equal(schoolRequestOriginAllowed(host,'https://'+host),true);assert.equal(schoolRequestOriginAllowed(host,'https://cbgpu.com'),false)}});
test('runtime backend rewriting preserves trusted host context and refuses malformed configuration',()=>{const run=proxy({CBGPU_BACKEND_PROXY_URL:'http://127.0.0.1:19090'});const response=run(request('app.cbgpu.com','/backend/rest/v1/projects?select=id'));assert.equal(response.headers.get('x-middleware-rewrite'),'http://127.0.0.1:19090/rest/v1/projects?select=id');assert.equal(response.headers.get('x-middleware-request-x-cbgpu-public-host'),'app.cbgpu.com');assert.equal(response.headers.get('cache-control'),'private, no-store');assert.equal(response.headers.get('x-robots-tag'),'noindex, nofollow');const bad=proxy({CBGPU_BACKEND_PROXY_URL:'https://unapproved.example'});assert.equal(bad(request('app.cbgpu.com','/backend/auth/v1/token')).status,503);assert.equal(run(request('cbgpu.com','/admin')).status,404)});
