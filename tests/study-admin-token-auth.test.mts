import test from 'node:test';import assert from 'node:assert/strict';import fs from 'node:fs';import vm from 'node:vm';import ts from 'typescript';import {NextResponse} from 'next/server.js';
const code=ts.transpileModule(fs.readFileSync(new URL('../src/app/api/study/admin-token/route.ts',import.meta.url),'utf8'),{compilerOptions:{module:ts.ModuleKind.CommonJS,target:ts.ScriptTarget.ES2022}}).outputText;
function fixture({scoped=true,admin=true,valid=true}={}){
 let allowed=admin,session=valid,offline=false,revokeOnVerify=false,profileReads=0,settingsReads=0,writes=0,rpcs=0,providers=0;
 const exports:Record<string,any>={};const userId='11111111-1111-4111-8111-111111111111';
 const client={auth:{getUser:async()=>({data:{user:{id:userId}},error:null})},rpc:async(name:string)=>{rpcs++;assert.equal(name,'cbgpu_self_session_status');return{data:{valid:session},error:offline?{code:'unavailable'}:null}},from:(table:string)=>{const query={select(){return this},eq(){return this},single:async()=>{assert.equal(table,'profiles');profileReads++;return{data:{is_admin:allowed,school_roles:['SCHOOL_ADMIN']},error:null}},maybeSingle:async()=>{assert.equal(table,'eduset_settings');settingsReads++;return{data:{access_token_enc:'private-encrypted-fixture',updated_at:'2026-11-17'},error:null}},upsert:async(value:any)=>{writes++;assert.equal(value.updated_by,userId);return{error:null}}};return query}};
 vm.runInNewContext(code,{exports,process:{env:{NEXT_PUBLIC_SUPABASE_URL:'http://fixture-public',NEXT_PUBLIC_SUPABASE_ANON_KEY:'public-anon'}},AbortSignal,fetch:async(_url:string,options:any)=>{providers++;if(scoped){assert.equal(options.cache,'no-store');assert.equal(options.redirect,'error');assert.ok(options.signal)}if(revokeOnVerify)session=false;return Response.json([])},require(name:string){if(name==='next/server')return{NextResponse};if(name==='@/lib/studyAuth')return{studyScopedMode:()=>scoped};if(name==='@/lib/internalServiceUrl')return{trustedInternalServiceUrl:(value:string)=>new URL(value)};if(name==='@supabase/supabase-js')return{createClient:(url:string,key:string,options:any)=>{assert.equal(key,'public-anon');assert.equal(options.global.headers.Authorization,'Bearer caller');assert.equal(url,scoped?'http://127.0.0.1:54321/':'http://fixture-public');return client}};if(name==='@/lib/edusetTokenCrypto')return{decryptToken:()=> 'not-returned-private-token',encryptToken:()=> 'private-encrypted-fixture',getTokenExpiresAt:()=> '2026-12-01'};throw Error(name)}});
 const request=(post=false)=>new Request('https://cbgpu.com/api/study/admin-token',{method:post?'POST':'GET',headers:{authorization:'Bearer caller'},...(post?{body:JSON.stringify({accessToken:'private-provider-token'})}:{})});
 return{get:()=>exports.GET(request()),post:()=>exports.POST(request(true)),deny:()=>allowed=false,expire:()=>session=false,fail:()=>offline=true,revokeDuringVerify:()=>revokeOnVerify=true,counts:()=>({profileReads,settingsReads,writes,rpcs,providers})};
}
test('scoped platform admin uses fresh self-session and exposes no token; school administrator and guest are not platform admin',async()=>{
 const f=fixture();const response=await f.get();assert.equal(response.status,200);assert.deepEqual(await response.json(),{updatedAt:'2026-11-17',expiresAt:'2026-12-01'});assert.equal(response.headers.get('cache-control'),'private, no-store');f.deny();assert.equal((await f.get()).status,403);assert.equal(f.counts().settingsReads,1);
 const schoolAdmin=fixture({admin:false});assert.equal((await schoolAdmin.get()).status,403);assert.equal(schoolAdmin.counts().settingsReads,0);
});
test('revoked session denies403 and missing authority fails503 before settings read; no scoped fallback',async()=>{
 const expired=fixture({valid:false});assert.equal((await expired.get()).status,403);assert.equal(expired.counts().profileReads,0);const offline=fixture();offline.fail();assert.equal((await offline.get()).status,503);assert.equal(offline.counts().settingsReads,0);
});
test('admin token write rechecks session after provider verification and never stores after revocation',async()=>{
 const f=fixture();f.revokeDuringVerify();assert.equal((await f.post()).status,403);assert.equal(f.counts().providers,1);assert.equal(f.counts().writes,0);
 const good=fixture();assert.equal((await good.post()).status,200);assert.equal(good.counts().writes,1);assert.equal(good.counts().rpcs,2);
});
test('legacy flag-off retains original global admin check without new session RPC',async()=>{const f=fixture({scoped:false,valid:false});assert.equal((await f.get()).status,200);assert.equal(f.counts().rpcs,0)});
