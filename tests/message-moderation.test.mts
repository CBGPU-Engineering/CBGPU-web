import test from'node:test';import assert from'node:assert/strict';import{build}from'esbuild';import vm from'node:vm';
const compiled=await build({entryPoints:[new URL('../src/lib/messageModeration.ts',import.meta.url).pathname],bundle:true,platform:'node',format:'cjs',write:false,plugins:[{name:'sdk-boundary',setup(b){b.onResolve({filter:/^@\/lib\/supabase$/},()=>({path:'sdk',namespace:'fixture'}));b.onLoad({filter:/.*/,namespace:'fixture'},()=>({contents:'export const supabase=globalThis.__sdk',loader:'js'}))}}]});
const item={id:'11111111-1111-4111-8111-111111111111',kind:'DM',message_id:'22222222-2222-4222-8222-222222222222',scope:'DM',school_id:null,body_snippet:'🙂'.repeat(500),reason:'Report reason',created_at:'2026-11-17T10:00:00Z',status:'PENDING',revision:1,review_note:'',reviewed_at:null,hidden:false};
function fixture(){let actor='owner',calls:any[]=[];const m={exports:{}}as{exports:Record<string,any>};vm.runInNewContext(compiled.outputFiles[0].text,{module:m,exports:m.exports,__sdk:{auth:{getSession:async()=>({data:{session:{user:{id:actor}}}})},rpc:async(name:string,args:any)=>{calls.push({name,args});return{data:args.action==='list'?{items:[{...item,sender_id:'DO_NOT_RENDER',reporter_email:'PRIVATE'}],total:1}:{ok:true,report:{...item,status:'RESOLVED',revision:2,hidden:true}},error:null}}},Error,Array,Number,String});return{api:m.exports,calls,actor:(value:string)=>{actor=value}}}
 test('reported private excerpts are projected without thread identity or extra private fields',async()=>{const f=fixture(),r=await f.api.listMessageReports('owner','DM',undefined,'PENDING');assert.equal(r.items[0].body_snippet,item.body_snippet);assert.equal(r.items[0].sender_id,undefined);assert.equal(r.items[0].reporter_email,undefined);assert.equal(f.calls[0].args.payload.scope,'DM');assert.equal(f.calls[0].args.payload.limit,30)});
 test('account change stops a privileged request before RPC',async()=>{const f=fixture();f.actor('other');await assert.rejects(f.api.listMessageReports('owner','SCHOOL','school-b',''),/account changed/);assert.equal(f.calls.length,0)});
 test('hide carries exact kind, report revision, meaningful note and explicit confirmation',async()=>{const f=fixture();await assert.rejects(f.api.reviewMessageReport('owner',item,'RESOLVED',' ',true));assert.equal(f.calls.length,0);const r=await f.api.reviewMessageReport('owner',item,'RESOLVED',' Confirmed by review ',true);assert.equal(r.hidden,true);assert.equal(f.calls[0].args.payload.expected_revision,1);assert.equal(f.calls[0].args.payload.confirmed,true);assert.equal(f.calls[0].args.payload.review_note,'Confirmed by review');assert.equal(f.calls[0].args.payload.report_id,item.id)});
