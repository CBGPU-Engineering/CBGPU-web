import test from'node:test';import assert from'node:assert/strict';import{schoolAiMode,validAiAccount,requireAiSchoolAccess}from'../src/lib/aiSchoolAccess.ts';
const owner='10000000-0000-4000-8000-000000000001';
const user={id:owner,email_confirmed_at:'2026-01-01'},profile={id:owner,account_status:'ACTIVE',is_approved:false,account_type:'EXTERNAL'};
const contexts=(type='MEMBERSHIP',resources=['ai'])=>({current_school_id:'school-b',items:[{school_id:'school-b',type,resources}]});
test('verified current membership with authoritative AI policy does not depend on legacy global approval/type',async()=>{assert.equal(validAiAccount(owner,user,profile),true);const seen:string[]=[];assert.equal(await requireAiSchoolAccess({isKey:false,schoolHeader:'other-school'},async()=>contexts(),async school=>{seen.push(school);return true}),'school-b');assert.deepEqual(seen,['school-b'])});
test('approved guests follow the same exact resource policy without being reclassified as members',async()=>{assert.equal(await requireAiSchoolAccess({isKey:false,schoolHeader:null},async()=>contexts('GUEST'),async()=>true),'school-b')});
test('missing, pending, revoked and feature-disabled contexts cannot borrow another school AI grant',async()=>{for(const value of [{items:[]},contexts('PENDING'),contexts('MEMBERSHIP',[]),{current_school_id:'school-b',items:[{school_id:'other-school',type:'MEMBERSHIP',resources:['ai']}]}]){let calls=0;await assert.rejects(()=>requireAiSchoolAccess({isKey:false,schoolHeader:null},async()=>value,async()=>{calls++;return true}));assert.equal(calls,0)}await assert.rejects(()=>requireAiSchoolAccess({isKey:false,schoolHeader:null},async()=>contexts(),async()=>false),e=>(e as any).status===403)});
test('keys use only their explicit school target and a fresh owner-bound resource oracle',async()=>{let called='';assert.equal(await requireAiSchoolAccess({isKey:true,schoolHeader:'school-b'},async()=>{throw Error('no impersonation')},async school=>{called=school;return true}),'school-b');assert.equal(called,'school-b');await assert.rejects(()=>requireAiSchoolAccess({isKey:true,schoolHeader:'foreign'},async()=>null,async()=>false),e=>(e as any).status===403);await assert.rejects(()=>requireAiSchoolAccess({isKey:true,schoolHeader:null},async()=>null,async school=>{assert.equal(school,'cbsh');return false}),/x-cbgpu-school-id/)});
test('bad key school headers never reach resource authority',async()=>{for(const schoolHeader of ['','https://foreign','../cbsh','a b']){let calls=0;await assert.rejects(()=>requireAiSchoolAccess({isKey:true,schoolHeader},async()=>null,async()=>{calls++;return true}));assert.equal(calls,0)}});
test('deleted, banned, suspended, missing and mismatched accounts are denied; no global flag can override',()=>{for(const [u,p]of [[null,profile],[{...user,id:'other'},profile],[{...user,deleted_at:'now'},profile],[{...user,banned_until:'2999-01-01'},profile],[{...user,email_confirmed_at:null},profile],[user,{...profile,account_status:'SUSPENDED',is_approved:true}],[user,null]]as const)assert.equal(validAiAccount(owner,u,p),false);assert.equal(schoolAiMode({CBGPU_MULTISCHOOL_V1:'1'}),true);assert.equal(schoolAiMode({}),false);assert.throws(()=>schoolAiMode({CBGPU_MULTISCHOOL_V1:'typo'}))});
