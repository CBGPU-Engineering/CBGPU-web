// Start the synthetic demo on 13911/13912, then: node tests/ux/discovery-browser.mts
import{chromium}from'playwright';import fs from'node:fs';import os from'node:os';import path from'node:path';import assert from'node:assert/strict';
const root=process.env.CBGPU_UX_SCREENSHOTS||fs.mkdtempSync(path.join(os.tmpdir(),'cbgpu-discovery-ux-')),origin=process.env.CBGPU_UX_ORIGIN||'http://localhost:13911';
if(!['localhost','127.0.0.1'].includes(new URL(origin).hostname))throw Error('Run only against the synthetic loopback demo.');
fs.mkdirSync(root,{recursive:true});
const browser=await chromium.launch({headless:true,args:['--no-sandbox']});const errors:string[]=[];try{
for(const app of [false,true])for(const width of [360,390,430,1280])for(const theme of ['light','dark'] as const){
const c=await browser.newContext({viewport:{width,height:900},userAgent:app?'Mozilla/5.0 (Linux; Android 14; CBGPU; wv) AppleWebKit/537.36 Version/4.0 Chrome/130.0 Mobile Safari/537.36':undefined,colorScheme:theme,reducedMotion:theme==='dark'?'reduce':'no-preference'});await c.route('**/*',r=>{const u=new URL(r.request().url());return u.hostname==='localhost'||u.hostname==='127.0.0.1'?r.continue():r.abort()});const p=await c.newPage();p.on('pageerror',e=>errors.push(e.message));p.on('console',event=>{if(event.type()==='error'&&/hydration|hydrated|Invalid hook|Maximum update/i.test(event.text()))errors.push(event.text())});await p.goto(origin+'/services?mode=student'+(app?'&native=1':'&demo-frame=web'));assert.equal(await p.locator('.cb-workspace.cb-app').count(),app?1:0);const input=p.getByRole('searchbox',{name:'기능 검색'});await input.waitFor();await p.locator('.cb-directory-filters button').filter({hasText:'학교생활'}).click();await input.fill('게임');await p.getByRole('button',{name:/다른 분류의 결과 1개 보기/}).click();await p.locator('.cb-directory-tile').filter({hasText:'게임'}).waitFor();assert.equal(await input.evaluate(e=>e===document.activeElement),true);await p.getByRole('button',{name:'검색어 지우기'}).click();assert.equal(await input.evaluate(e=>e===document.activeElement),true);await input.fill('없는기능xyz');await p.getByRole('button',{name:'전체 기능 다시 보기'}).click();assert.equal(await input.inputValue(),'');await input.fill('급식');await input.press('Escape');assert.equal(await input.inputValue(),'');assert.equal(await input.evaluate(e=>e===document.activeElement),true);
await p.screenshot({path:`${root}/services-${app?'app':'web'}-${theme}-${width}.png`,fullPage:true,caret:'initial'});assert.ok(await p.evaluate(()=>document.documentElement.scrollWidth<=innerWidth+1));const tooSmall=await p.locator('.cb-directory button').evaluateAll(nodes=>nodes.filter(e=>e.getBoundingClientRect().height<44).map(e=>e.textContent));assert.deepEqual(tooSmall,[]);
await p.goto(origin+'/?mode=researcher'+(app?'&native=1':'&demo-frame=web'));await p.getByRole('button',{name:'즐겨찾기 편집'}).waitFor();const firstGroup=await p.locator('.cb-directory-sections>section h3').first().innerText();assert.ok(!firstGroup.startsWith('AI'),'AI must not jump before work tools');const stored=await p.evaluate(()=>localStorage.getItem('cbgpu-favorites:guest:researcher'));await p.getByRole('button',{name:'즐겨찾기 편집'}).click();await p.locator('.cb-favorites-editor>div>button').first().click();assert.equal(await p.evaluate(()=>localStorage.getItem('cbgpu-favorites:guest:researcher')),stored);await p.getByRole('button',{name:'취소',exact:true}).click();assert.equal(await p.getByRole('button',{name:'즐겨찾기 편집',exact:true}).evaluate(e=>e===document.activeElement),true);assert.equal(await p.evaluate(()=>localStorage.getItem('cbgpu-favorites:guest:researcher')),stored);
await p.getByRole('button',{name:'즐겨찾기 편집'}).click();await p.locator('.cb-favorites-editor>div>button').first().click();await p.getByRole('button',{name:'즐겨찾기 저장',exact:true}).click();assert.equal(await p.getByRole('button',{name:'즐겨찾기 편집',exact:true}).evaluate(e=>e===document.activeElement),true);assert.notEqual(await p.evaluate(()=>localStorage.getItem('cbgpu-favorites:guest:researcher')),stored);await p.getByText('즐겨찾기를 저장했어요.',{exact:true}).waitFor();await p.goto(origin+'/?mode=researcher'+(app?'&native=1':'&demo-frame=web'));assert.notEqual(await p.evaluate(()=>localStorage.getItem('cbgpu-favorites:guest:researcher')),stored);
if(!app&&width===360&&theme==='light'){await p.getByRole('button',{name:'즐겨찾기 편집',exact:true}).click();await p.locator('.cb-favorites-editor>div>button').first().click();await p.evaluate(()=>{const original=Storage.prototype.setItem;Object.assign(window,{restoreUxStorage:()=>{Storage.prototype.setItem=original}});Storage.prototype.setItem=function(k,v){if(k.startsWith('cbgpu-favorites:'))throw new DOMException('Synthetic storage failure','QuotaExceededError');return original.call(this,k,v)}});await p.getByRole('button',{name:'즐겨찾기 저장',exact:true}).click();await p.getByText('저장하지 못했어요. 선택한 항목은 유지했으니 다시 저장해 주세요.',{exact:true}).waitFor();await p.getByRole('button',{name:'즐겨찾기 저장',exact:true}).waitFor();await p.evaluate(()=>{(window as unknown as {restoreUxStorage:()=>void}).restoreUxStorage()});await p.getByRole('button',{name:'즐겨찾기 저장',exact:true}).click();}
await p.screenshot({path:`${root}/home-${app?'app':'web'}-${theme}-${width}.png`,fullPage:true,caret:'initial'});assert.ok(await p.evaluate(()=>document.documentElement.scrollWidth<=innerWidth+1));await c.close();}
assert.deepEqual(errors,[]);fs.writeFileSync(root+'/BROWSER-PASSED.json',JSON.stringify({widths:[360,390,430,1280],themes:['light','dark'],webView:true,categoryRecovery:true,searchClearFocus:true,emptyRecoveryFocus:true,filterTouch44:true,favoritesCancelNoWrite:true,favoritesExplicitSavePersist:true,researcherWorkBeforeAI:true,reducedMotion:true,normalMotion:true,storageFailurePreservesDraft:true,keyboardEscape:true,horizontalOverflow:false,pageErrors:errors},null,2));console.log('PASS: 16 web/app/theme/viewport journeys, real components and synthetic local APIs');
}finally{await browser.close()}
