import test from 'node:test';import assert from 'node:assert/strict';import{changeConfirmedPassword}from'../src/lib/confirmedPasswordChange.ts';
const input={owner:'A',email:'fixture-a@example.invalid',currentPassword:'fixture-old',newPassword:'fixture-new'};
const jwt=(session:string,tag:string)=>tag+'.'+Buffer.from(JSON.stringify({session_id:session})).toString('base64url')+'.fixture';
test('delayed isolated verification after switch to B cannot update B or restore A',async()=>{let current=true,actor='A',release!:(id:string)=>void,updates=0,cleanups=0;const run=changeConfirmedPassword(input,()=>current,{readSession:async()=>({data:{session:{user:{id:actor},access_token:'fixture-'+actor}}}),verify:()=>new Promise(r=>{release=r}),update:async()=>{updates++},cleanup:async()=>{cleanups++}});await Promise.resolve();await Promise.resolve();actor='B';current=false;release('A');await assert.rejects(run,/계정/);assert.equal(updates,0);assert.equal(actor,'B');assert.equal(cleanups,1)});
test('password PUT uses original main-session bearer, never temporary verification bearer',async()=>{const original=jwt('main-session','initial'),refreshed=jwt('main-session','refreshed');let reads=0,updated='',cleanups=0;await changeConfirmedPassword(input,()=>true,{readSession:async()=>({data:{session:{user:{id:'A'},access_token:++reads===1?original:refreshed}}}),verify:async()=> 'A',update:async token=>{updated=token},cleanup:async()=>{cleanups++}});assert.equal(updated,original);assert.equal(cleanups,1)});
test('a different same-account login session cannot reuse an old password confirmation',async()=>{let reads=0,updates=0;await assert.rejects(changeConfirmedPassword(input,()=>true,{readSession:async()=>({data:{session:{user:{id:'A'},access_token:jwt(++reads===1?'first-session':'new-login','fixture')}}}),verify:async()=> 'A',update:async()=>{updates++},cleanup:async()=>{}}),/세션/);assert.equal(updates,0)});
test('a stalled verification reaches its deadline and cannot perform a late password PUT',async()=>{let release!:(id:string)=>void,updates=0;const run=changeConfirmedPassword(input,()=>true,{readSession:async()=>({data:{session:{user:{id:'A'},access_token:'fixture-A'}}}),verify:()=>new Promise(r=>{release=r}),update:async()=>{updates++},cleanup:async()=>{}},10);await assert.rejects(run,/응답/);release('A');await new Promise(r=>setTimeout(r,0));assert.equal(updates,0)});
