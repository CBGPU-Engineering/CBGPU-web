import test from 'node:test';import assert from 'node:assert/strict';import fs from 'node:fs';import vm from 'node:vm';import ts from 'typescript';
function load(name:string):Record<string,any>{const exports={};const code=ts.transpileModule(fs.readFileSync(new URL('../src/lib/'+name+'.ts',import.meta.url),'utf8'),{compilerOptions:{module:ts.ModuleKind.CommonJS,target:ts.ScriptTarget.ES2022}}).outputText;vm.runInNewContext(code,{exports,URL,Error,Map,JSON,Array,Number,AbortController,setTimeout,clearTimeout,TextDecoder,Uint8Array,require:(n:string)=>load(n.slice(2))});return exports;}
const {adminAccountAffiliations}=load('adminAccountAffiliations');
function member(user:string,school:string,status='ACTIVE'){return{user_id:user,school_id:school,status,membership_type:'STUDENT',student_number:'1234',verified:status==='ACTIVE'}}
test('admin projection preserves multiple schools and every membership state with actual caller token',async()=>{const seen:string[]=[];const fetcher=async(url:URL,init:RequestInit)=>{assert.equal((init.headers as Record<string,string>).Authorization,'Bearer synthetic-admin');assert.equal(init.cache,'no-store');assert.equal(init.redirect,'error');seen.push(url.pathname+url.search);if(url.pathname==='/v1/admin/schools')return Response.json({items:url.searchParams.get('status')==='APPROVED'?[{id:'a',display_name:'School A'}]:[{id:'b',display_name:'School B'}],total:1});return Response.json({items:url.pathname.includes('/a/')?[member('one','a'),member('two','a','PENDING_VERIFICATION')]:[member('one','b','SUSPENDED'),member('three','b','REVERIFICATION_REQUIRED')],total:2})};const r=await adminAccountAffiliations('Bearer synthetic-admin',{endpoint:'http://127.0.0.1:3546',fetcher});assert.equal(r.affiliations.get('one').length,2);assert.equal(r.affiliations.get('two')[0].status,'PENDING_VERIFICATION');assert.equal(r.affiliations.get('three')[0].status,'REVERIFICATION_REQUIRED');assert.equal(r.affiliations.has('external-without-school'),false);assert.equal(seen.length,4);assert.ok(seen.every(p=>!p.includes('members?')))});
test('authority denial, malformed pages and school mismatch fail instead of showing unassigned accounts',async()=>{for(const kind of ['denied','html','mismatch','truncated']){const fetcher=async(url:URL)=>{if(kind==='denied')return Response.json({error:'denied'},{status:403});if(kind==='html')return new Response('<!DOCTYPE html>');if(url.pathname==='/v1/admin/schools')return Response.json({items:[{id:'a',display_name:'School A'}],total:kind==='truncated'?2:1});return Response.json({items:[member('one','wrong-school')],total:1})};await assert.rejects(()=>adminAccountAffiliations('Bearer synthetic-admin',{endpoint:'http://127.0.0.1:3546',fetcher}));}});
test('configured endpoint cannot exfiltrate an administrator token to a public host',async()=>{let calls=0;await assert.rejects(()=>adminAccountAffiliations('Bearer synthetic-admin',{endpoint:'https://example.com',fetcher:async()=>{calls++;return Response.json({})}}));assert.equal(calls,0)});
