import test from'node:test';import assert from'node:assert/strict';import fs from'node:fs/promises';import os from'node:os';import path from'node:path';import vm from'node:vm';import ts from'typescript';import{androidRelease}from'../src/lib/appUpdates.ts';
const source=await fs.readFile(new URL('../src/app/api/app-release/route.ts',import.meta.url),'utf8');
function route(cwd:string,configured?:string){const api:any={};vm.runInNewContext(ts.transpileModule(source,{compilerOptions:{module:ts.ModuleKind.CommonJS,target:ts.ScriptTarget.ES2022}}).outputText,{exports:api,Response,process:{env:{CBGPU_ANDROID_RELEASE_PATH:configured},cwd:()=>cwd},require:(name:string)=>{if(name==='node:fs/promises')return{readFile:fs.readFile};if(name==='node:path')return path;if(name==='@/lib/appUpdates')return{androidRelease};throw Error(name)}});return api.GET;}
test('same updater artifact reads configured or mounted metadata without host-specific paths',async()=>{const root=await fs.mkdtemp(path.join(os.tmpdir(),'cbgpu-app-manifest-'));try{const directory=path.join(root,'public/downloads');await fs.mkdir(directory,{recursive:true});await fs.writeFile(path.join(directory,'android-release.json'),JSON.stringify({version:'1.0.12',buildNumber:13,downloadUrl:'https://untrusted.example/app.apk'}));let response=await route(root)();assert.equal(response.status,200);assert.equal((await response.json()).downloadUrl,'/downloads/cbgpu.apk?build=13');assert.equal(response.headers.get('cache-control'),'no-store');const selected=path.join(root,'published.json');await fs.writeFile(selected,JSON.stringify({version:'1.0.13',buildNumber:14}));response=await route(root,selected)();assert.equal((await response.json()).buildNumber,14)}finally{await fs.rm(root,{recursive:true,force:true})}});
test('missing or malformed update metadata fails closed without exposing paths',async()=>{const root=await fs.mkdtemp(path.join(os.tmpdir(),'cbgpu-bad-manifest-'));try{const configured=path.join(root,'private-name.json');for(const content of ['{','{"version":"bad","buildNumber":1}']){await fs.writeFile(configured,content);const response=await route(root,configured)();assert.equal(response.status,503);assert.doesNotMatch(await response.text(),/private-name|\/tmp\//)}assert.equal((await route(root)()).status,503)}finally{await fs.rm(root,{recursive:true,force:true})}});
