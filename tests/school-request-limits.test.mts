import test from'node:test';import assert from'node:assert/strict';import vm from'node:vm';import{createRequire}from'node:module';import{buildSync}from'esbuild';
const require=createRequire(import.meta.url);
const context:any={module:{exports:{}},require};vm.runInNewContext(buildSync({entryPoints:['src/lib/schoolRequestLimits.ts'],bundle:true,platform:'node',format:'cjs',write:false}).outputFiles[0].text,context);const{SchoolRequestLimits}=context.module.exports;
test('users sharing a school network have separate credential buckets',()=>{const rate=new SchoolRequestLimits({perToken:2,coarsePerIp:10});for(let i=0;i<2;i++)assert.equal(rate.check('school-nat','Bearer first-user',false,0),'ALLOW');assert.equal(rate.check('school-nat','Bearer first-user',false,0),'RATE_LIMITED');assert.equal(rate.check('school-nat','Bearer second-user',false,0),'ALLOW');assert.equal(rate.check('school-nat','Bearer first-user',false,60001),'ALLOW')});
test('anonymous catalog requests cannot evade their bucket by rotating unverified headers',()=>{const rate=new SchoolRequestLimits({anonymousPerIp:2,coarsePerIp:10});assert.equal(rate.check('school-nat',null,true,0),'ALLOW');assert.equal(rate.check('school-nat','Bearer made-up',true,0),'ALLOW');assert.equal(rate.check('school-nat','Bearer another',true,0),'RATE_LIMITED')});
test('coarse protection bounds rotating tokens and malformed private requests never pass admission',()=>{const rate=new SchoolRequestLimits({coarsePerIp:2});for(const header of [null,'Basic secret','Bearer token extra','Bearer '+ 'x'.repeat(8193)])assert.equal(rate.check('ip',header,false,0),'AUTH_REQUIRED');assert.equal(rate.check('ip','Bearer one',false,0),'ALLOW');assert.equal(rate.check('ip','Bearer two',false,0),'ALLOW');assert.equal(rate.check('ip','Bearer three',false,0),'RATE_LIMITED')});
