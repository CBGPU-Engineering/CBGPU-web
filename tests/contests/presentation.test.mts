import test from'node:test';import assert from'node:assert/strict';import {build}from'esbuild';import {createRequire}from'node:module';import vm from'node:vm';import React from'react';import {renderToStaticMarkup}from'react-dom/server';
test('contest Markdown renders images and GFM without executing raw HTML or script URLs',async()=>{
 const compiled=await build({entryPoints:[new URL('../../src/components/contests/ContestMarkdown.tsx',import.meta.url).pathname],bundle:true,platform:'node',format:'cjs',external:['react'],write:false});const module={exports:{}}as{exports:Record<string,any>};vm.runInNewContext(compiled.outputFiles[0].text,{module,exports:module.exports,require:createRequire(import.meta.url),console,URL,TextDecoder,TextEncoder,process});
 const html=renderToStaticMarkup(React.createElement(module.exports.default,{children:'# 제목\n\n**강조**\n\n| 항목 | 내용 |\n| --- | --- |\n| A | B |\n\n![사진](https://example.invalid/image.png)\n\n<script>alert(1)</script>\n\n[bad](javascript:alert(1))'}));assert(html.includes('<h1>제목</h1>'));assert(html.includes('<strong>강조</strong>'));assert(html.includes('<table>'));assert(html.includes('loading="lazy"'));assert(html.includes('noopener noreferrer'));assert(!html.includes('<script'));assert(!html.includes('javascript:'));
});
