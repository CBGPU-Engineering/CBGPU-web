import test from 'node:test';
import assert from 'node:assert/strict';
import {build} from 'esbuild';
import {createRequire} from 'node:module';
import vm from 'node:vm';
import React from 'react';
import {renderToStaticMarkup} from 'react-dom/server';
async function load(path:string,stub=false){const compiled=await build({entryPoints:[new URL(path,import.meta.url).pathname],bundle:true,platform:'node',format:'cjs',external:['react'],write:false,plugins:stub?[{name:'local-auth-fixture',setup(build){build.onResolve({filter:/lib\/supabase$/},()=>({path:'supabase',namespace:'fixture'}));build.onLoad({filter:/.*/,namespace:'fixture'},()=>({contents:'export const supabase = {};',loader:'js'}))}}]:[]});const module={exports:{}} as {exports:Record<string,any>};vm.runInNewContext(compiled.outputFiles[0].text,{module,exports:module.exports,require:createRequire(import.meta.url),Date,URL,process,setTimeout});return module.exports}
const {contestSubmissionPhase,contestRegistrationPhase,contestPeriodError}=await load('../../src/lib/contests.ts');
const start='2027-01-01T00:00:00Z',end='2027-01-01T01:00:00Z',at=new Date(start).getTime();
test('submission periods enforce exact start inclusive and deadline exclusive; absent starts preserve legacy',()=>{const event={is_open:true,starts_at:start,ends_at:end};assert.equal(contestSubmissionPhase(event,null),'checking');assert.equal(contestSubmissionPhase(event,at-1),'pending');assert.equal(contestSubmissionPhase(event,at),'open');assert.equal(contestSubmissionPhase(event,new Date(end).getTime()),'closed');assert.equal(contestSubmissionPhase({...event,starts_at:null},at-1),'open');assert.equal(contestSubmissionPhase({...event,is_open:false},at-1),'closed');assert.equal(contestSubmissionPhase({...event,ends_at:null},at),'open')});
test('registration uses its own open/close interval and event-start fallback, independent from submission',()=>{const event={registration_open:true,lifecycle_status:'published',registration_opens_at:start,registration_closes_at:end,event_start_at:'2027-01-01T02:00:00Z'};assert.equal(contestRegistrationPhase(event,at-1),'pending');assert.equal(contestRegistrationPhase(event,at),'open');assert.equal(contestRegistrationPhase(event,new Date(end).getTime()),'closed');assert.equal(contestRegistrationPhase({...event,registration_opens_at:null},at-1),'open');assert.equal(contestRegistrationPhase({...event,registration_closes_at:null},new Date(end).getTime()),'open');assert.equal(contestRegistrationPhase({...event,lifecycle_status:'cancelled'},at),'closed');assert.equal(contestRegistrationPhase({...event,registration_open:false},at),'closed')});
test('start/end validation rejects equal, reversed and invalid times while accepting optional unbounded sides',()=>{assert.equal(contestPeriodError(start,end,'제출'),null);assert(contestPeriodError(start,start,'제출'));assert(contestPeriodError(end,start,'제출'));assert(contestPeriodError('not a date',end,'제출'));assert.equal(contestPeriodError(null,end,'제출'),null);assert.equal(contestPeriodError(start,null,'제출'),null)});
const {default:ContestClock}=await load('../../src/components/contests/ContestClock.tsx',true);
test('countdown names the opening boundary and displays both submission dates before opening',()=>{const html=renderToStaticMarkup(React.createElement(ContestClock,{startsAt:start,endsAt:end,isOpen:true,now:at-10000,syncError:false}));assert(html.includes('제출 시작까지 남은 시간'));assert(html.includes('제출 시작'));assert(html.includes('제출 마감'));assert(html.includes('role="timer"'));const opened=renderToStaticMarkup(React.createElement(ContestClock,{startsAt:start,endsAt:end,isOpen:true,now:at,syncError:false}));assert(opened.includes('제출 마감까지 남은 시간'))});
