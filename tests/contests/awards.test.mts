import test from 'node:test';import assert from 'node:assert/strict';import {build} from 'esbuild';import vm from 'node:vm';
const compiled=await build({entryPoints:[new URL('../../src/lib/contestAwards.ts',import.meta.url).pathname],bundle:true,platform:'node',format:'cjs',write:false});const module={exports:{}} as {exports:Record<string,any>};vm.runInNewContext(compiled.outputFiles[0].text,{module,exports:module.exports,URL,Date,Map});const {DEFAULT_AWARD_CATEGORIES,awardVotingPhase,rankedAwardEntries,safeShowcaseUrl,awardsServerMillis}=module.exports;
test('default award categories preserve exact four requested names and descriptions',()=>{assert.equal(JSON.stringify(DEFAULT_AWARD_CATEGORIES),JSON.stringify([{name:'Best Vibe Build',description:'가장 뛰어난 서비스'},{name:'Best Agentic Connection',description:'서비스 간 연결과 협업'},{name:'Most Creative Idea',description:'가장 창의적인 아이디어'},{name:"People's Choice",description:'참가자 인기상'}]))});
test('award voting observes server start inclusive and end exclusive including manual close disabling votes',()=>{const settings={enabled:true,starts_at:'2027-01-01T00:00:00Z',closes_at:'2027-01-01T01:00:00Z',results_published:false};const start=new Date(settings.starts_at).getTime(),end=new Date(settings.closes_at).getTime();assert.equal(awardVotingPhase(settings,null),'checking');assert.equal(awardVotingPhase(settings,start-1),'pending');assert.equal(awardVotingPhase(settings,start),'open');assert.equal(awardVotingPhase(settings,end),'closed');assert.equal(awardVotingPhase({...settings,enabled:false},end),'closed');assert.equal(awardVotingPhase({...settings,enabled:false},start),'disabled')});
test('equal vote totals receive shared competition rank and input entries remain unchanged',()=>{const entries=[{showcase_id:'c',title:'C',votes:1,is_winner:false},{showcase_id:'a',title:'A',votes:5,is_winner:true},{showcase_id:'b',title:'B',votes:5,is_winner:true}];const result=rankedAwardEntries(entries);assert.equal(JSON.stringify(result.map((entry:any)=>({id:entry.showcase_id,rank:entry.rank,tied:entry.tied}))),JSON.stringify([{id:'a',rank:1,tied:true},{id:'b',rank:1,tied:true},{id:'c',rank:3,tied:false}]));assert.equal(entries[0].showcase_id,'c')});
test('public demo URLs reject scripts, credentials and non-web protocols',()=>{assert.equal(safeShowcaseUrl('https://example.org/demo'),'https://example.org/demo');for(const url of ['javascript:alert(1)','data:text/html,test','file:///etc/passwd','https://user:secret@example.org','not a URL'])assert.equal(safeShowcaseUrl(url),null);assert.equal(safeShowcaseUrl(null),null)});
test('server timestamp conversion supports native ISO and epoch seconds without device time fallback',()=>{assert.equal(awardsServerMillis('2027-01-01T00:00:00Z'),1798761600000);assert.equal(awardsServerMillis(1798761600),1798761600000);assert.equal(awardsServerMillis('invalid'),null)});
