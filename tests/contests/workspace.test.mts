import test from 'node:test';import assert from 'node:assert/strict';
import{contestWorkspaceSections,contestManagementHref,contestParticipantHref,contestEventSection}from'../../src/lib/contestWorkspace.ts';
test('organizer workspace is distinct from the participant URL used by invitations',()=>{const id='11111111-1111-4111-8111-111111111111';assert.equal(contestParticipantHref(id),'/contests/'+id);assert.equal(contestManagementHref(id),'/contests/'+id+'/manage');assert.notEqual(contestManagementHref(id),contestParticipantHref(id))});
test('check-in operators only receive check-in tasks, and lifecycle remains owner only',()=>{assert.deepEqual(contestWorkspaceSections(false,false).map(x=>x.id),['guests']);assert.equal(contestWorkspaceSections(true,false).some(x=>x.id==='lifecycle'),false);assert.equal(contestWorkspaceSections(true,true).some(x=>x.id==='lifecycle'),true);assert.equal(new Set(contestWorkspaceSections(true,true).map(x=>x.id)).size,11)});
test('participant forms and management tasks do not share ambiguous nested sections',()=>{assert.equal(contestEventSection('submissions'),false);assert.equal(contestEventSection('presentation'),false);assert.equal(contestEventSection('awards'),false);for(const id of ['overview','guests','teams','schedule','updates','settings','operators','lifecycle']as const)assert.equal(contestEventSection(id),true)});
