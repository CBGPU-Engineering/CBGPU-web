import test from'node:test';import assert from'node:assert/strict';import{contestDuplicatePolicy}from'../../src/lib/contestDuplicatePolicy.ts';import type{Contest}from'../../src/lib/contests.ts';
const source={school_id:'school-b',access_scope:'MULTI_SCHOOL',allowed_school_ids:['school-c'],participant_policy:'HIGH_SCHOOL_STUDENTS',registration_opens_at:'2026-11-01T00:00:00Z',registration_closes_at:'2026-11-02T00:00:00Z',starts_at:'2026-11-03T00:00:00Z',ends_at:'2026-11-04T00:00:00Z'} as Contest;
test('duplicate retains exact school and joint audience instead of database tenant defaults',()=>{const result=contestDuplicatePolicy(source,86400000,true);assert.equal(result.school_id,'school-b');assert.equal(result.access_scope,'MULTI_SCHOOL');assert.deepEqual(result.allowed_school_ids,['school-c']);assert.notEqual(result.allowed_school_ids,source.allowed_school_ids);assert.equal(result.participant_policy,'HIGH_SCHOOL_STUDENTS')});
test('duplicate shifts both registration and submission boundaries by identical interval',()=>{const result=contestDuplicatePolicy(source,86400000,true);for(const field of['registration_opens_at','registration_closes_at','starts_at','ends_at']as const)assert.equal(new Date(result[field]!).getTime()-new Date(source[field]!).getTime(),86400000)});
test('optional unbounded dates remain optional and legacy schema receives no school fields',()=>{const result=contestDuplicatePolicy({...source,ends_at:null,registration_closes_at:null},0,false);assert.equal(result.ends_at,null);assert.equal(result.registration_closes_at,null);assert.equal('school_id'in result,false);assert.throws(()=>contestDuplicatePolicy(source,NaN,true))});
