import test from 'node:test';import assert from 'node:assert/strict';
import {contestRegistrationFeedback} from '../../src/lib/contestRegistrationFeedback.ts';
test('reports actual changed rows instead of selected rows and separates partial email failure',()=>{const result=contestRegistrationFeedback({changed:2,emailed:1,warning:'상태는 저장했지만 일부 이메일을 보내지 못했어요.'});assert.equal(result.message,'2명의 참가자 상태를 변경했어요. 1명에게 이메일을 보냈어요.');assert.match(result.warning,/일부 이메일/)});
test('does not claim email delivery when disabled or unavailable',()=>{const result=contestRegistrationFeedback({changed:1,emailed:0});assert.equal(result.message,'1명의 참가자 상태를 변경했어요.');assert.match(result.warning,/이메일은 보내지 않았어요/)});
test('zero changed rows and unknown legacy counts never invent successful email delivery',()=>{assert.deepEqual(contestRegistrationFeedback({changed:0,emailed:0}),{message:'변경된 참가자가 없어요.',warning:''});const result=contestRegistrationFeedback({changed:NaN,emailed:-1});assert.equal(result.message,'상태 변경 요청을 처리했어요.');assert.equal(result.warning,'')});
