import test from 'node:test';import assert from 'node:assert/strict';import fs from 'node:fs';import vm from 'node:vm';import ts from 'typescript';
const exports:Record<string,any>={};vm.runInNewContext(ts.transpileModule(fs.readFileSync(new URL('../../src/lib/contests.ts',import.meta.url),'utf8'),{compilerOptions:{module:ts.ModuleKind.CommonJS,target:ts.ScriptTarget.ES2022}}).outputText,{exports,Date});
const {contestRegistrationPhase,contestEventPhase,contestCalendarPeriod}=exports;
const now=Date.parse('2026-11-18T00:00:00Z');
const ended={lifecycle_status:'published',registration_open:true,registration_closes_at:null,event_start_at:null,event_end_at:null,ends_at:'2026-10-18T09:00:59Z'};
test('published event with stale open flags and old submission deadline is ended, never open registration',()=>{assert.equal(contestEventPhase(ended,now),'ended');assert.equal(contestRegistrationPhase(ended,now),'closed');assert.equal(contestRegistrationPhase({...ended,registration_closes_at:'2026-12-01T00:00:00Z'},now),'closed');assert.equal(contestEventPhase(ended,Date.parse(ended.ends_at)),'ended')});
test('real event end takes precedence over earlier submission deadline and explicit late joining remains valid',()=>{const event={...ended,event_start_at:'2026-11-17T00:00:00Z',event_end_at:'2026-11-20T00:00:00Z',registration_closes_at:'2026-11-19T00:00:00Z'};assert.equal(contestEventPhase(event,now),'ongoing');assert.equal(contestRegistrationPhase(event,now),'open');assert.equal(contestRegistrationPhase({...event,registration_closes_at:null},now),'closed');assert.equal(contestRegistrationPhase({...event,registration_closes_at:'2026-12-01T00:00:00Z'},Date.parse(event.event_end_at)),'closed')});
test('cancelled/archived/unscheduled states are not inferred ongoing from publication',()=>{assert.equal(contestEventPhase({...ended,lifecycle_status:'cancelled'},null),'cancelled');assert.equal(contestEventPhase({...ended,lifecycle_status:'archived'},now),'archived');assert.equal(contestEventPhase({...ended,ends_at:null},now),'unscheduled');assert.equal(contestEventPhase({...ended,event_start_at:'2026-12-01',event_end_at:'2026-12-02'},now),'upcoming');assert.equal(contestEventPhase(ended,null),'checking')});
test('calendar period rejects invalid/reversed dates without throwing and preserves valid defaults',()=>{for(const event of [{event_start_at:null,event_end_at:null},{event_start_at:'invalid',event_end_at:null},{event_start_at:'2026-11-20',event_end_at:'invalid'},{event_start_at:'2026-11-20',event_end_at:'2026-11-19'}])assert.equal(contestCalendarPeriod(event),null);const period=contestCalendarPeriod({event_start_at:'2026-11-20T10:00:00Z',event_end_at:null});assert.equal(period.ends_at,'2026-11-20T11:00:00.000Z')});
