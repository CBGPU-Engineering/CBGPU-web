// Requires an explicitly started isolated CBGPU demo; all contest data/auth are synthetic.
import puppeteer from 'puppeteer-core';import chromium from '@sparticuz/chromium';import fs from'node:fs';import{createRequire}from'node:module';
const require=createRequire(import.meta.url);const fixtures=require('../../demo/fixtures.cts');const session=fixtures.session(fixtures.users[0]);
if(process.env.CBGPU_CONTEST_UI_TEST!=='1')throw Error('Explicit CBGPU_CONTEST_UI_TEST=1 and local demo required');
const origin=process.env.CBGPU_CONTEST_UI_ORIGIN||'http://localhost:3114';const parsedOrigin=new URL(origin);if(!['localhost','127.0.0.1'].includes(parsedOrigin.hostname)||parsedOrigin.protocol!=='http:')throw Error('Only local synthetic demo origins allowed');
const base={host_id:fixtures.users[1].id,description:'## 새로운 가능성을 만드는 시간\n학교의 작은 불편함을 발견하고, 우리만의 아이디어로 바꿔 보세요. 팀과 함께 만드는 경험이 시작됩니다.',ends_at:'2027-01-28T09:00:00Z',starts_at:null,logo_path:null,banner_path:null,is_open:true,fields:[{id:'idea',type:'text',label:'아이디어 소개',description:'어떤 문제를 해결하고 싶은지 자유롭게 들려주세요.',required:true,extensions:'',max_size_mb:20}],created_at:'2026-11-16T00:00:00Z',event_start_at:'2027-01-25T00:00:00Z',event_end_at:'2027-01-25T09:00:00Z',location_type:'offline',location_name:'창의융합실',address:'본관 2층',visibility:'public',capacity:40,waitlist_enabled:true,approval_required:false,registration_open:true,registration_closes_at:'2027-01-24T00:00:00Z',registration_questions:[{id:'goal',label:'이번 도전에서 만들고 싶은 것은 무엇인가요?',type:'paragraph',required:true,options:[]}],lifecycle_status:'published',cancellation_message:'',updated_at:'2026-11-16T00:00:00Z',participation_mode:'individual',team_min_size:2,team_max_size:4,allow_individual_entries:true};
const contests=[{...base,id:'10000000-0000-4000-8000-000000000001',title:'우리 학교를 바꾸는 아이디어 챌린지'},{...base,id:'10000000-0000-4000-8000-000000000002',title:'함께 만드는 AI 해커톤',participation_mode:'team'},{...base,id:'10000000-0000-4000-8000-000000000003',title:'나만의 시선으로, 과학 사진전',registration_open:false}];let registration:any=null;let posts=0;
const browser=await puppeteer.launch({executablePath:await chromium.executablePath(),args:chromium.args.filter(arg=>arg!=='--disable-web-security'),headless:true});const page=await browser.newPage();await page.setViewport({width:1440,height:1100,deviceScaleFactor:1});
const errors:string[]=[];page.on('console',msg=>{if(msg.type()==='error')console.log('browser-error',msg.text())});page.on('pageerror',error=>{errors.push(String(error));console.log('page-error-stack',(error as Error).stack)});await page.setRequestInterception(true);page.on('request',async req=>{const url=new URL(req.url());if(url.pathname.startsWith('/backend/')){let result:any=[];const path=url.pathname.replace('/backend','');if(path.startsWith('/auth/v1'))result=path.includes('/user')?session.user:session;else if(path.includes('/rpc/contest_server_time'))result=new Date().toISOString();else if(path.endsWith('/rpc/register_contest_entry')){posts++;const body=JSON.parse(req.postData()||'{}');registration={id:'30000000-0000-4000-8000-000000000001',contest_id:body.p_contest_id,user_id:session.user.id,attendee_name:body.p_attendee_name,answers:body.p_answers,status:'confirmed',participation_kind:'individual',ticket_code:'fixture-ticket',created_at:new Date().toISOString(),checked_in_at:null};result=registration;}else if(path.endsWith('/rpc/contest_awards_api'))result={settings:{enabled:false,starts_at:null,closes_at:null,results_published:false},categories:[],showcases:[],my_showcases:[],my_votes:[],can_vote:false,can_manage:false,server_time:new Date().toISOString(),results_available:false};else if(path.endsWith('/profiles'))result=fixtures.tables().profiles[0];else if(path.endsWith('/contests')){const id=url.searchParams.get('id')?.replace('eq.','');result=id?contests.find(c=>c.id===id):contests;}else if(path.endsWith('/event_registrations'))result=registration?[registration]:[];else if(path.endsWith('/event_access_details')||path.endsWith('/event_hosts'))result=null;else result=[];
 const accept=req.headers().accept||'';if(accept.includes('vnd.pgrst.object')&&Array.isArray(result))result=result[0]||null;
 await req.respond({status:200,contentType:'application/json',headers:{'access-control-allow-origin':'*'},body:JSON.stringify(result)});return;}await req.continue();});
await page.evaluateOnNewDocument((value)=>{localStorage.setItem('sb-localhost-auth-token',JSON.stringify(value));localStorage.setItem('sb-cbgpu-auth-token',JSON.stringify(value));localStorage.setItem('theme','light');},session);
await page.goto(`${origin}/contests`,{waitUntil:'domcontentloaded',timeout:120000});await page.waitForFunction(()=>document.body.innerText.includes('LOCAL DEMO'),{timeout:10000});await page.waitForSelector('.contest-discovery-card',{timeout:60000});await new Promise(r=>setTimeout(r,900));await page.screenshot({path:'/tmp/cbgpu-contests-desktop.png',fullPage:true});
const sourceWidth=await page.$eval('.contest-card-visual',el=>el.getBoundingClientRect().width);
await page.click('a.contest-discovery-card');await page.waitForSelector('.contest-shared-flight',{timeout:5000});await page.waitForSelector('[data-contest-detail-art]',{timeout:60000});await new Promise(r=>setTimeout(r,60));
const flight=await page.evaluate(()=>{const a=document.querySelector('.contest-shared-flight')?.getBoundingClientRect(),b=document.querySelector('[data-contest-detail-art]')?.getBoundingClientRect();return{width:a?.width,target:b?.width};});if(!flight.width||flight.width<=sourceWidth+10)throw Error('Cross-route artwork did not animate toward real detail bounds');
await page.screenshot({path:'/tmp/cbgpu-contests-transition.png'});await new Promise(r=>setTimeout(r,700));
await page.screenshot({path:'/tmp/cbgpu-contest-detail-desktop.png',fullPage:true});console.log('detail rendered');
await page.$eval('form:has(.contest-registration-progress) button[type=submit]',el=>(el as HTMLButtonElement).click());await page.waitForSelector('.contest-registration-summary');
const textarea=await page.$('form:has(.contest-registration-progress) textarea');await textarea!.type('학교 생활의 불편함을 해결하는 연구 플랫폼을 만들고 싶어요.');
await page.$eval('.contest-registration-actions button[type=button]',el=>(el as HTMLButtonElement).click());await page.waitForSelector('.contest-registration-summary',{hidden:true});await page.$eval('form:has(.contest-registration-progress) button[type=submit]',el=>(el as HTMLButtonElement).click());await page.waitForSelector('.contest-registration-summary');
const answer=await page.$eval('form:has(.contest-registration-progress) textarea',el=>(el as HTMLTextAreaElement).value);if(!answer.includes('연구 플랫폼'))throw Error('Back navigation lost registration answer');
if(posts!==0)throw Error('Funnel advanced by submitting prematurely');
await page.$eval('form:has(.contest-registration-progress) button[type=submit]',el=>(el as HTMLButtonElement).click());await page.waitForSelector('.contest-ticket-panel',{timeout:10000});if(Number(posts)!==1)throw Error('Expected exactly one server registration');if(errors.length)throw Error('Unexpected browser runtime error: '+errors.join(';'));
await page.screenshot({path:'/tmp/cbgpu-contest-confirmed-desktop.png',fullPage:true});
await page.setViewport({width:390,height:844,deviceScaleFactor:1});await page.goto(`${origin}/contests`,{waitUntil:'domcontentloaded'});await page.waitForSelector('.contest-discovery-card');await new Promise(r=>setTimeout(r,900));await page.screenshot({path:'/tmp/cbgpu-contests-mobile.png',fullPage:true});
const overflow=await page.evaluate(()=>document.documentElement.scrollWidth>innerWidth+1);if(overflow)throw Error('Mobile page horizontally overflows');
await page.emulateMediaFeatures([{name:'prefers-reduced-motion',value:'reduce'}]);await page.click('a.contest-discovery-card');await page.waitForSelector('[data-contest-detail-art]');if(await page.$('.contest-shared-flight'))throw Error('Shared flight ignored reduced motion');await page.screenshot({path:'/tmp/cbgpu-contest-detail-mobile.png',fullPage:true});
await page.evaluate(()=>document.documentElement.classList.add('dark'));await page.screenshot({path:'/tmp/cbgpu-contest-detail-mobile-dark.png',fullPage:true});
fs.writeFileSync('/tmp/cbgpu-contests-preview-results.json',JSON.stringify({posts,flight,sourceWidth,answerPreserved:true,mobileOverflow:overflow,reducedMotion:true,pageErrors:errors},null,2));await browser.close();console.log('Contest synthetic browser flow passed');
