import test from'node:test';import assert from'node:assert/strict';
import{comciganTargetFromSources,comciganTargetKey,selectComciganSchool,timetableChoices}from'../src/lib/comciganSchool.ts';
const a={id:'school-a',name:'동일고등학교',region:'서울'},b={id:'school-b',name:'동일고등학교',region:'충북'};
test('exact school name AND normalized region disambiguate the fixed provider',()=>{const rows=[{name:'동일고등학교',region:'서울',code:111},{name:'동일고등학교',region:'충북',code:222}];assert.equal(selectComciganSchool(rows,a),111);assert.equal(selectComciganSchool(rows,b),222);assert.equal(selectComciganSchool(rows,{...a,region:'서울특별시'}),111);assert.throws(()=>selectComciganSchool(rows,{...a,region:'경기도'}));assert.throws(()=>selectComciganSchool([...rows,{...rows[0],code:333}],a));assert.equal(selectComciganSchool([],{...a,code:444}),444)});
test('school identity and reviewed provider config bind independent cache namespaces',()=>{assert.notEqual(comciganTargetKey(a),comciganTargetKey(b));assert.notEqual(comciganTargetKey(a),comciganTargetKey({...a,id:'school-other'}));assert.notEqual(comciganTargetKey(a),comciganTargetKey({...a,code:333}));assert.equal(comciganTargetKey(a),comciganTargetKey({...a,region:'서울특별시'}));assert.match(comciganTargetKey(a),/^[a-f0-9]{64}$/)});
test('only verified matching school source DTOs produce targets; disabled never falls back',()=>{const dto={school_id:a.id,status:'NOT_CONFIGURED',comcigan:{status:'LOOKUP_REQUIRED',school_code:null,school_name:a.name,region:a.region}};assert.deepEqual(comciganTargetFromSources(a.id,dto),a);assert.throws(()=>comciganTargetFromSources(b.id,dto));assert.throws(()=>comciganTargetFromSources(a.id,{...dto,status:'DISABLED'}));assert.throws(()=>comciganTargetFromSources(a.id,{...dto,comcigan:{...dto.comcigan,status:'NOT_CONFIGURED'}}));assert.throws(()=>comciganTargetFromSources(a.id,{...dto,comcigan:{...dto.comcigan,school_code:1.5}}))});
test('real class counts replace the previous twenty-class bound without unbounded allocation',()=>{assert.equal(timetableChoices([0,25,6,1],1,25).classes.length,25);assert.deepEqual(timetableChoices([0,25,6,1],2,6).classes,[1,2,3,4,5,6]);assert.throws(()=>timetableChoices([0,25,6,1],2,25));assert.throws(()=>timetableChoices([0,10000000],1,1));assert.throws(()=>timetableChoices([0,NaN],1,1));assert.throws(()=>timetableChoices(Array(10000).fill(1),1,1))});
