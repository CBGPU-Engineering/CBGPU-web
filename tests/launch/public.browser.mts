/** Read-only anonymous production smoke. No credentials; writes and third-party traffic blocked. */
import {chromium} from 'playwright';
import fs from 'node:fs';
const root=process.env.CBGPU_LAUNCH_ARTIFACTS||'artifacts/launch-readiness';fs.mkdirSync(root,{recursive:true,mode:0o700});
const browser=await chromium.launch({headless:true,args:['--no-sandbox']});const results:Record<string,any>[]=[];
try{for(const width of [390,1280]){const context=await browser.newContext({viewport:{width,height:900}});await context.route('**/*',route=>{const request=route.request(),url=new URL(request.url());if(!['GET','HEAD'].includes(request.method())||!['cbgpu.com','docs.cbgpu.com','admin.cbgpu.com','developers.cbgpu.com'].includes(url.hostname)||/analytics|beacon|adfit|kas\//.test(url.pathname))return route.abort();return route.continue()});
for(const path of ['/','/schools','/docs','/explore/contests','/explore/schools','/auth/login','/auth/signup','/auth/forgot-password','/download','/privacy','/contact']){const page=await context.newPage(),errors:string[]=[];page.on('pageerror',error=>errors.push(error.message.slice(0,180)));try{const response=await page.goto('https://cbgpu.com'+path,{waitUntil:'networkidle',timeout:30000});await page.waitForTimeout(500);const metrics=await page.evaluate(()=>({overflow:document.documentElement.scrollWidth>innerWidth+1,headings:[...document.querySelectorAll('h1')].map(x=>x.textContent),fatal:/Application error:|Internal Server Error/.test(document.body.innerText),horizontal:document.documentElement.scrollWidth,viewport:innerWidth}));results.push({width,path,status:response!.status(),finalPath:new URL(page.url()).pathname,errors,...metrics});if(metrics.overflow||metrics.fatal||errors.length||response!.status()>=500)await page.screenshot({path:root+'/issue-'+width+'-'+path.replaceAll('/','_')+'.png',fullPage:true});}catch(e){results.push({width,path,error:e instanceof Error?e.message:String(e)})}finally{await page.close()}}
await context.close()}}finally{await browser.close()};fs.writeFileSync(root+'/PUBLIC-BROWSER.json',JSON.stringify(results,null,2));console.log(JSON.stringify(results.filter(r=>r.error||r.overflow||r.fatal||r.errors?.length||r.status>=400),null,2));console.log('Checked '+results.length+' anonymous route/viewport combinations; third-party/mutation traffic blocked.');
