/** Local anonymous demo only. Every non-GET request is blocked; contrast uses rendered CSS colors. */
import{chromium}from'playwright';import fs from'node:fs';import assert from'node:assert/strict';
const origin=process.env.CBGPU_CONTRAST_ORIGIN||'http://localhost:14010',output=process.env.CBGPU_CONTRAST_OUTPUT||'/tmp/cbgpu-services-contrast-review/local-after';assert.match(origin,/^http:\/\/(localhost|127\.0\.0\.1):\d+$/);fs.mkdirSync(output,{recursive:true});
const browser=await chromium.launch({executablePath:process.env.CBGPU_BROWSER_EXECUTABLE||undefined,args:['--no-sandbox','--disable-dev-shm-usage']});const results:unknown[]=[];
try{for(const width of[320,390,1280])for(const dark of[false,true]){
 const context=await browser.newContext({viewport:{width,height:900},colorScheme:dark?'dark':'light',reducedMotion:'no-preference'});await context.addInitScript(d=>localStorage.setItem('theme',d?'dark':'light'),dark);let blockedWrites=0;await context.route('**/*',r=>{if(!['GET','HEAD'].includes(r.request().method())){blockedWrites++;return r.abort()}if(!['localhost','127.0.0.1'].includes(new URL(r.request().url()).hostname))return r.abort();return r.continue()});const page=await context.newPage();const errors:string[]=[];page.on('pageerror',e=>errors.push(e.message));await page.goto(origin+'/services?demo-frame=web',{waitUntil:'networkidle'});await page.locator('.cb-directory-filter-count').first().waitFor();
 const measure=async(state:string)=>{
  await page.waitForTimeout(200);
  const nodes=await page.evaluate(()=>{
   const canvas=document.createElement('canvas');canvas.width=canvas.height=1;const ctx=canvas.getContext('2d')!;
   const rgb=(value:string)=>{ctx.clearRect(0,0,1,1);ctx.fillStyle=value;ctx.fillRect(0,0,1,1);return [...ctx.getImageData(0,0,1,1).data]};
   const luminance=(color:number[])=>color.slice(0,3).map(v=>v/255).reduce((sum,v,i)=>sum+[.2126,.7152,.0722][i]*(v<=.04045?v/12.92:((v+.055)/1.055)**2.4),0);
   const ratio=(a:number[],b:number[])=>{const x=luminance(a),y=luminance(b);return (Math.max(x,y)+.05)/(Math.min(x,y)+.05)};
   return [...document.querySelectorAll('.cb-directory-filter-count,.cb-bottom-nav a.active>span')].filter(e=>e.getBoundingClientRect().width>0).map(e=>{const css=getComputedStyle(e),rect=e.getBoundingClientRect(),control=e.closest('button,a')!,controlCss=getComputedStyle(control);let surface:number[]|undefined;for(let p:Element|null=e;p;p=p.parentElement){const color=rgb(getComputedStyle(p).backgroundColor);if(color[3]===255){surface=color;break}}if(!surface)throw Error('No opaque surface');let outsideSurface:number[]|undefined;for(let p=control.parentElement;p;p=p.parentElement){const color=rgb(getComputedStyle(p).backgroundColor);if(color[3]===255){outsideSurface=color;break}}if(!outsideSurface)throw Error('No outline backdrop');const backgrounds=[surface];const pseudo=getComputedStyle(control,'::before');if(pseudo.content!=='none'){const bg=rgb(pseudo.backgroundColor);if(bg[3]===255)backgrounds.push(bg);else if(bg[3]!==0)throw Error('Translucent selected surface')}let opacity=1;for(let p:Element|null=e;p;p=p.parentElement)opacity*=Number(getComputedStyle(p).opacity);const fg=rgb(css.color);const contrasts=backgrounds.map(bg=>ratio(fg.slice(0,3).map((v,i)=>v*opacity+bg[i]*(1-opacity)),bg));return{text:e.textContent!.trim(),kind:e.matches('.cb-directory-filter-count')?'count':'active-navigation',color:css.color,opacity,surfaces:backgrounds,contrasts,minRatio:Math.min(...contrasts),selected:control.getAttribute('aria-pressed'),hovered:control.matches(':hover'),focusVisible:control.matches(':focus-visible'),outline:controlCss.outline,focusRingContrast:control.matches(':focus-visible')?ratio(rgb(controlCss.outlineColor),outsideSurface):null,focusRingSurface:outsideSurface,rect:{x:rect.x,y:rect.y,width:rect.width,height:rect.height}}});
  });assert.ok(nodes.length>0);for(const node of nodes){assert.ok(node.minRatio>=4.5,`${width}/${dark}/${state}/${node.text}: ${node.minRatio}`);if(node.focusVisible)assert.ok(node.focusRingContrast!==null&&node.focusRingContrast>=3)}assert.equal(await page.evaluate(()=>document.documentElement.scrollWidth>innerWidth+1),false);results.push({width,dark,state,nodes});await page.screenshot({path:`${output}/${width}-${dark?'dark':'light'}-${state}.png`,fullPage:true});
 };
 await measure('default');const filter=page.locator('.cb-directory-filters button[aria-pressed="false"]').first();await filter.hover();await measure('filter-hover');await page.keyboard.press('Tab');await filter.focus();assert.equal(await filter.evaluate(e=>e.matches(':focus-visible')),true);await measure('filter-focus');await filter.click();await measure('filter-selected');
 const active=page.locator('.cb-bottom-nav a.active');if(await active.isVisible()){await active.hover();await measure('navigation-hover');await page.keyboard.press('Tab');await active.focus();assert.equal(await active.evaluate(e=>e.matches(':focus-visible')),true);await measure('navigation-focus')}
 await page.addScriptTag({content:fs.readFileSync('node_modules/axe-core/axe.min.js','utf8')});const axe=await page.evaluate(async()=>await(window as any).axe.run(document,{runOnly:{type:'rule',values:['color-contrast']}}));assert.equal(axe.violations.length,0);fs.writeFileSync(`${output}/axe-${width}-${dark?'dark':'light'}.json`,JSON.stringify({violations:axe.violations,incomplete:axe.incomplete},null,2));assert.deepEqual(errors,[]);results.push({width,dark,blockedWrites,axeViolations:0,incomplete:axe.incomplete.map((r:any)=>({id:r.id,nodes:r.nodes.length})),runtimeErrors:0});await context.close();
}fs.writeFileSync(output+'/PASSED.json',JSON.stringify(results,null,2));console.log(JSON.stringify({cases:results.length,allPassed:true,output}));}finally{await browser.close()}
