import test from 'node:test';import assert from 'node:assert/strict';
import {emptySchoolDraft,SCHOOL_STEPS,schoolStepError}from'../src/lib/schoolOnboarding.ts';
import {boundedSchoolBody,schoolRequestOriginAllowed}from'../src/lib/schoolsProxySecurity.ts';
test('safe school defaults never enable GPU or automatic admin admission',()=>{const d=emptySchoolDraft();assert.equal(d.gpu.choice,'CONNECT_LATER');assert.equal(d.configuration.join_policy,'APPROVAL_REQUIRED');assert.equal(d.configuration.teacher_policy,'MANUAL_REVIEW');assert.equal(d.features.includes('gpu_compute'),false);assert.equal(d.confirmed,false);assert.equal(SCHOOL_STEPS.length,6)});
test('GPU omission never blocks either GPU onboarding path',()=>{for(const choice of ['NONE','CONNECT_LATER','CONNECT_NOW']as const){const d=emptySchoolDraft();d.gpu.choice=choice;assert.equal(schoolStepError('gpu',d),'')}});
test('review requires explicit confirmation and preserves independent draft values',()=>{const a=emptySchoolDraft(),b=emptySchoolDraft();a.school.official_name='Synthetic';assert.equal(b.school.official_name,'');assert.match(schoolStepError('review',a),/확인/);a.confirmed=true;assert.equal(schoolStepError('review',a),'')});
test('school mutation origin must match fixed approved host, never suffix or arbitrary origin',()=>{assert.equal(schoolRequestOriginAllowed('cbgpu.com','https://cbgpu.com'),true);for(const [host,origin]of [['cbgpu.com','https://evil.invalid'],['evil.cbgpu.com','https://evil.cbgpu.com'],['cbgpu.com.evil.invalid','https://cbgpu.com.evil.invalid'],['cbgpu.com',null]])assert.equal(schoolRequestOriginAllowed(host,origin),false)});
test('untrusted missing-length request body is bounded while streaming',async()=>{const body=new ReadableStream({start(c){c.enqueue(new Uint8Array(10));c.enqueue(new Uint8Array(11));c.close()}});await assert.rejects(()=>boundedSchoolBody(body,20),/BODY_TOO_LARGE/);assert.equal(await boundedSchoolBody(new ReadableStream({start(c){c.enqueue(new TextEncoder().encode('{"step":1}'));c.close()}})),'{"step":1}')});
import {schoolSignupMetadata,schoolSignupValidation}from'../src/lib/schoolSignup.ts';
test('CBsh student metadata keeps the exact existing identity flow',()=>{const choice={path:'existing' as const,school_id:'cbsh',kind:'STUDENT' as const,student_number:'2309',department:''};assert.deepEqual(schoolSignupMetadata(' Student ',choice),{full_name:'Student',student_id:'2309'});assert.equal(schoolSignupValidation({...choice,student_number:'OTHER-123'}).length>0,true)});
test('other-school students use their own identifier and never claim verified school roles',()=>{const choice={path:'existing' as const,school_id:'other-school',kind:'STUDENT' as const,student_number:'AB-2026-100',department:''};assert.equal(schoolSignupValidation(choice),'');assert.deepEqual(schoolSignupMetadata('Student',choice),{full_name:'Student',account_type_request:'EXTERNAL',school_join_request:{school_id:'other-school',type:'STUDENT',student_number:'AB-2026-100'}})});
test('teacher and new-school applicant requests never imply administrator rights',()=>{assert.deepEqual(schoolSignupMetadata('Teacher',{path:'existing',school_id:'cbsh',kind:'TEACHER',student_number:'',department:'Science'}),{full_name:'Teacher',account_type_request:'EXTERNAL',school_join_request:{school_id:'cbsh',type:'TEACHER',department:'Science'}});assert.deepEqual(schoolSignupMetadata('Applicant',{path:'new',school_id:'',kind:'STUDENT',student_number:'',department:''}),{full_name:'Applicant',account_type_request:'EXTERNAL',school_setup_request:true})});

test('nonlegacy metadata uses the exact trusted backend discriminator and no global alias',()=>{const metadata=schoolSignupMetadata('Applicant',{path:'new',school_id:'',kind:'EXTERNAL',student_number:'',department:''});assert.equal(metadata.account_type_request,'EXTERNAL');assert.equal(Object.hasOwn(metadata,'globalaccount_type_request'),false)});
test('a personal external identity needs no school or silent CBsh affiliation',()=>{const choice={path:'existing' as const,school_id:'',kind:'EXTERNAL' as const,student_number:'',department:''};assert.equal(schoolSignupValidation(choice),'');assert.deepEqual(schoolSignupMetadata('Personal',choice),{full_name:'Personal',account_type_request:'EXTERNAL'})});
