import test from'node:test';import assert from'node:assert/strict';import{build}from'esbuild';const compiled=await build({entryPoints:['src/app/api/compute/[[...path]]/route.ts'],bundle:true,write:false,platform:'node',format:'esm'});const{GET}=await import('data:text/javascript;base64,'+Buffer.from(compiled.outputFiles[0].text).toString('base64'));
const before={...process.env},realFetch=globalThis.fetch;test.after(()=>{process.env=before;globalThis.fetch=realFetch});
const read=(headers:Record<string,string>={})=>GET(new Request('https://admin.cbgpu.com/api/compute/capabilities',{headers}),{params:Promise.resolve({path:['capabilities']})});
test('setup metadata requires a fresh authenticated account and never returns the identity response',async()=>{process.env.NEXT_PUBLIC_SUPABASE_ANON_KEY='synthetic-public-key';process.env.SUPABASE_INTERNAL_URL='http://127.0.0.1:54321';process.env.CBGPU_GPU_REGISTRY_ENABLED='0';delete process.env.CBGPU_GPU_AGENT_MANIFEST;let calls=0;globalThis.fetch=(async(url:any,options:any)=>{calls++;assert.equal(String(url),'http://127.0.0.1:54321/auth/v1/user');assert.equal(options.headers.Authorization,'Bearer fixture');assert.equal(options.headers.cookie,undefined);return Response.json({id:'synthetic-user',email:'private@example.invalid'})})as typeof fetch;let response=await read();assert.equal(response.status,401);assert.equal(calls,0);response=await read({authorization:'Bearer fixture',cookie:'private'});assert.equal(response.status,200);const value=await response.json();assert.equal(value.enabled,false);assert.deepEqual(value.artifacts,[]);assert.equal(value.execution_ready,false);assert.equal(value.sharing_enabled,false);assert.ok(!JSON.stringify(value).includes('private@example.invalid'));assert.ok(!JSON.stringify(value).includes('synthetic-user'));assert.equal(response.headers.get('cache-control'),'private, no-store')});
test('revoked sessions and invalid upstream bodies cannot turn into setup availability',async()=>{globalThis.fetch=(async()=>Response.json({error:'denied'},{status:403}))as typeof fetch;let response=await read({authorization:'Bearer fixture'});assert.equal(response.status,401);globalThis.fetch=(async()=>new Response('<!DOCTYPE html>'))as typeof fetch;response=await read({authorization:'Bearer fixture'});assert.equal(response.status,503)});
test('enabled metadata reports inventory only and does not send user credentials to the health probe',async()=>{process.env.CBGPU_GPU_REGISTRY_ENABLED='1';process.env.CBGPU_GPU_REGISTRY_URL='http://127.0.0.1:3548';let calls=0;globalThis.fetch=(async(url:any,options:any)=>{calls++;if(String(url).endsWith('/auth/v1/user'))return Response.json({id:'synthetic-user'});assert.equal(String(url),'http://127.0.0.1:3548/health');assert.equal(options.headers,undefined);return Response.json({enabled:true,execution_ready:false,sharing:false})})as typeof fetch;const response=await read({authorization:'Bearer fixture'});assert.equal(response.status,200);const value=await response.json();assert.equal(value.enabled,true);assert.equal(value.execution_ready,false);assert.equal(value.sharing_enabled,false);assert.equal(calls,2)});
