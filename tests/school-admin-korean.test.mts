import test from'node:test';import assert from'node:assert/strict';import{schoolRoleLabel,schoolStatusLabel,schoolActionLabel,schoolResourceLabel,schoolAdminError}from'../src/lib/schoolAdminKorean.ts';
test('school presentation localizes role/status/action without changing identifiers',()=>{const roles=['STUDENT','TEACHER','SCHOOL_OWNER','GPU_ADMIN'];assert.deepEqual(roles.map(schoolRoleLabel),['학생','교사','학교 대표 관리자','GPU 관리자']);assert.deepEqual(roles,['STUDENT','TEACHER','SCHOOL_OWNER','GPU_ADMIN']);assert.equal(schoolStatusLabel('REVERIFICATION_REQUIRED'),'학번 재인증 필요');assert.equal(schoolActionLabel('SET_ROLES'),'학교 권한 변경');assert.equal(schoolResourceLabel('school_compute'),'서버·웹 배포')});
test('school errors explain next step and never expose unknown backend keys',()=>{assert.match(schoolAdminError(Error('ACADEMIC_PREVIEW_CHANGED')),/새 미리보기/);assert.match(schoolAdminError(Error('DUPLICATE_STUDENT_NUMBER')),/이미 등록/);assert.match(schoolAdminError(Error('SOURCE_VERSION_CONFLICT')),/현재 입력은 유지/);const failure=schoolAdminError(Error('private_schema.unexpected_backend_key secret-value'));assert.equal(failure.includes('private_schema'),false);assert.equal(failure.includes('secret-value'),false);assert.match(schoolAdminError({status:403}),/권한/)});
