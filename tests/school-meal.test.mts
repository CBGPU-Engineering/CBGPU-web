import test from'node:test';import assert from'node:assert/strict';import{createServer,request}from'node:http';import{once}from'node:events';
import{publicSchoolText,publicSchoolUrl,isPublicSchoolAddress}from'../src/lib/publicSchoolFetch.ts';import{schoolMealTarget,parseNeisMeals,parseMealPage,validMealDate}from'../src/lib/schoolMeal.ts';
const base={school_id:'school-b',status:'READY',meal_provider:'NEIS',official_id:'1234567',education_office_code:'M10',version:2};
test('meal configuration never substitutes another school or fabricates missing providers',()=>{assert.throws(()=>schoolMealTarget('school-c',base));assert.throws(()=>schoolMealTarget('school-b',{...base,meal_provider:null}));assert.throws(()=>schoolMealTarget('school-b',{...base,status:'DISABLED'}));assert.equal(schoolMealTarget('school-b',base).officialId,'1234567');assert.equal(validMealDate('20260230'),false);assert.equal(validMealDate('20261117'),true)});
test('NEIS rows are exact school/date matched and retain allergen information',()=>{const target=schoolMealTarget('school-b',base),row={ATPT_OFCDC_SC_CODE:'M10',SD_SCHUL_CODE:'1234567',MLSV_YMD:'20261117',MMEAL_SC_CODE:'2',DDISH_NM:'밥<br/>계란 (1)',CAL_INFO:'600 Kcal'};assert.deepEqual(parseNeisMeals({mealServiceDietInfo:[{row:[row,{...row,SD_SCHUL_CODE:'7654321'},{...row,MLSV_YMD:'20261118'}]}]},target,'20261117'),[{type:'중식',items:['밥','계란 (1)'],calories:'600 Kcal'}]);assert.deepEqual(parseNeisMeals({RESULT:{CODE:'INFO-200'}},target,'20261117'),[]);assert.throws(()=>parseNeisMeals({RESULT:{CODE:'ERROR-300'}},target,'20261117'))});
test('legacy reviewed website parser retains date/meal-type boundaries',()=>{const html='<a href="?ymd=20261117"><dl><dt>중식</dt><dd><li>쌀밥</li><li>국</li></dd></dl></a>';assert.equal(parseMealPage(html,'20261117')[0].items[0],'쌀밥');assert.deepEqual(parseMealPage(html,'20261118'),[])});
test('public HTTPS gate rejects private, local, IP, userinfo, port and unknown hosts',()=>{for(const value of['http://school.example.com/','https://school.example.com:444/','https://user:pass@school.example.com/','https://127.0.0.1/','https://localhost/','https://other.example.com/'])assert.throws(()=>publicSchoolUrl(value,['school.example.com']));for(const ip of['127.0.0.1','10.0.0.1','172.16.1.1','169.254.169.254','100.64.0.1','192.168.0.1','::1','::ffff:127.0.0.1','fc00::1','fe80::1','2001:db8::1'])assert.equal(isPublicSchoolAddress(ip),false,ip);assert.equal(isPublicSchoolAddress('8.8.8.8'),true)});
test('real local HTTP fixture verifies pinned transport, body bounds, timeout and no redirects',async()=>{const server=createServer((req,res)=>{if(req.url==='/redirect'){res.writeHead(302,{Location:'http://127.0.0.1/private'});res.end()}else if(req.url==='/slow'){setTimeout(()=>res.end('late'),100)}else res.end('Synthetic upstream response')});server.listen(0,'127.0.0.1');await once(server,'listening');const port=(server.address()as{port:number}).port,host='school.example.com';let calls=0;const deps:any={lookup:async()=>[{address:'8.8.8.8',family:4}],request:(options:any,callback:any)=>{calls++;assert.equal(options.hostname,host);assert.equal(options.servername,host);options.lookup(host,{},(error:any,address:string)=>{assert.equal(error,null);assert.equal(address,'8.8.8.8')});assert.equal(options.headers.Authorization,undefined);return request({hostname:'127.0.0.1',port,path:options.path,method:'GET'},callback)}};try{assert.equal(await publicSchoolText('https://'+host+'/',[host],{},deps),'Synthetic upstream response');await assert.rejects(publicSchoolText('https://'+host+'/redirect',[host],{},deps),/HTTP_ERROR/);await assert.rejects(publicSchoolText('https://'+host+'/',[host],{maxBytes:8},deps),/TOO_LARGE/);await assert.rejects(publicSchoolText('https://'+host+'/slow',[host],{timeoutMs:20},deps),/TIMEOUT/);const before=calls;await assert.rejects(publicSchoolText('https://'+host+'/',[host],{}, {...deps,lookup:async()=>[{address:'8.8.8.8',family:4},{address:'10.0.0.1',family:4}]}),/DNS_DENIED/);assert.equal(calls,before);await assert.rejects(publicSchoolText('https://'+host+'/',[host],{headers:{Authorization:'never-forward'}},deps),/HEADER_DENIED/);assert.equal(calls,before)}finally{server.closeAllConnections();await new Promise<void>(resolve=>server.close(()=>resolve()))}});
