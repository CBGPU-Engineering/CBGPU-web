import test from'node:test';import assert from'node:assert/strict';import fs from'node:fs';import vm from'node:vm';import ts from'typescript';
function load(path:string,imports:Record<string,unknown>){const exports:Record<string,any>={};vm.runInNewContext(ts.transpileModule(fs.readFileSync(new URL('../src/lib/'+path,import.meta.url),'utf8'),{compilerOptions:{module:ts.ModuleKind.CommonJS}}).outputText,{exports,require:(name:string)=>imports[name]||new Proxy({},{get:()=>()=>null})});return exports}
const nav=load('serviceNavigation.ts',{}),spaces=load('workspaces.ts',{'./siteHref':{siteHref:(v:string)=>v},'./authReturn':{safeAuthReturn:(v:string)=>v}});
test('community is a single shared service in both user spaces; old saved links normalize without removing the compatibility route',()=>{const entries=nav.serviceGroups.flatMap((g:any)=>g.services);assert.equal(entries.filter((e:any)=>e.href==='/community').length,1);assert.equal(entries.filter((e:any)=>e.href==='/messages').length,0);assert.equal(entries.find((e:any)=>e.href==='/community').label,'커뮤니티');for(const mode of['student','researcher']){assert.equal(spaces.workspaces[mode].primary.filter((p:string)=>p==='/community').length,1);assert.equal(spaces.workspaceServicePaths[mode].filter((p:string)=>p==='/community').length,1)}assert.equal(nav.canonicalServicePath('/messages'),'/community');assert.equal(nav.canonicalServicePath('/messages?tab=direct'),'/messages?tab=direct','do not discard existing DM navigation/query context');assert.equal(nav.canonicalServicePath('/notes'),'/notes')});
