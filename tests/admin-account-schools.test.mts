import test from 'node:test';import assert from 'node:assert/strict';
import {accountSchools,accountSchoolOptions,accountMatchesSchool,accountSchoolSearch,accountSchoolState} from '../src/lib/adminAccountSchools.ts';
const a={school_id:'cbsh',school_name:'충북과학고등학교',status:'ACTIVE',membership_type:'STUDENT',student_number:'1101',verified:true};
const b={...a,school_id:'other-school',school_name:'다른고등학교',status:'PENDING_VERIFICATION',student_number:'2103',verified:false};
test('one account belongs to every actual school, preserving pending affiliations and school-specific student IDs',()=>{const account={school_id:'cbsh',primary_school_name:a.school_name,school_affiliations:[a,b]};assert.equal(accountSchools(account).length,2);assert.equal(accountMatchesSchool(account,'cbsh'),true);assert.equal(accountMatchesSchool(account,'other-school'),true);assert.equal(accountMatchesSchool(account,'none'),false);assert.deepEqual(new Set(accountSchoolSearch(account)),new Set([a.school_name,'1101',b.school_name,'2103']));assert.equal(accountSchoolState(b),'Verification pending');assert.deepEqual(accountSchoolOptions([account,{school_affiliations:[a]}]).map(x=>x.id).sort(),['cbsh','other-school'])});
test('an unlinked external account is not assigned to the original school, and unresolved metadata is not no affiliation',()=>{assert.deepEqual(accountSchools({}),[]);assert.equal(accountMatchesSchool({},'none'),true);assert.equal(accountMatchesSchool({},'cbsh'),false);assert.equal(accountMatchesSchool({school_id:'unresolved'},'none'),false);assert.equal(accountMatchesSchool({school_id:'unresolved'},'unavailable'),true)});
test('a real known primary school remains visible without fabricating verified membership or duplicates',()=>{const account={school_id:'cbsh',primary_school_name:a.school_name};const schools=accountSchools(account);assert.equal(schools[0].status,'PRIMARY');assert.equal(schools[0].verified,false);assert.equal(accountMatchesSchool(account,'cbsh'),true);assert.equal(accountSchools({...account,school_affiliations:[a]}).length,1);assert.equal(accountSchoolState({...b,status:'REVERIFICATION_REQUIRED'}),'Reverification required');assert.equal(accountSchoolState({...b,status:'SUSPENDED'}),'Suspended membership')});
