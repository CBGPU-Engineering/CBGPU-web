import test from'node:test';import assert from'node:assert/strict';import{aiResourceRequired}from'../src/lib/aiRouteAccess.ts';
const id='10000000-0000-4000-8000-000000000001';
test('own history, cleanup, key management and existing local robotics do not require compute permission',()=>{for(const [method,path]of [['GET','jobs'],['GET',`chats/${id}`],['DELETE',`keys/${id}`],['POST','keys'],['POST',`jobs/${id}/cancel`],['POST',`jobs/${id}/download`],['GET',`jobs/${id}/artifact`],['DELETE',`projects/${id}/files/${id}`],['POST',`v1/robotics/devices/${id}/stop`],['POST',`v1/robotics/devices/${id}/goal`],['DELETE',`v1/robotics/plans/${id}`]])assert.equal(aiResourceRequired(path.split('/'),method),false,method+' '+path)});
test('all actual compute paths, retries, infrastructure and unknown reads remain gated',()=>{for(const [method,path]of [['POST','jobs'],['POST',`chats/${id}/messages`],['POST',`jobs/${id}/retry`],['POST','site-ask'],['POST','search'],['POST',`materials/${id}/summarize`],['POST',`uploads/${id}/prepare`],['POST','v1/chat/completions'],['POST','v1/embeddings'],['POST','v1/robotics/plans'],['POST','v1/web/read'],['POST','v1/web/search'],['GET','status'],['GET','v1/models'],['GET','unknown'],['GET',`jobs/${id}/internal`],['GET','jobs/../../admin']])assert.equal(aiResourceRequired(path.split('/'),method),true,method+' '+path)});
