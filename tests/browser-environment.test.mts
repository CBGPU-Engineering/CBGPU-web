import test from'node:test';import assert from'node:assert/strict';import{browserEnvironment}from'../src/lib/browserEnvironment.ts';
test('browser subprocess keeps required rendering configuration without inheriting application secrets',()=>{const result=browserEnvironment({PATH:'/usr/bin',FONTCONFIG_PATH:'/opt/browser',LD_LIBRARY_PATH:'/opt/browser/lib',TMPDIR:'/tmp',SUPABASE_SERVICE_ROLE_KEY:'platform-key',RESEND_API_KEY:'mail-key',EDUSET_USERNAME:'school-user',EDUSET_PASSWORD:'school-password',CBGPU_TRAFFIC_SECRET:'traffic-key',DATABASE_URL:'postgresql://private'});assert.deepEqual(result,{PATH:'/usr/bin',TMPDIR:'/tmp',FONTCONFIG_PATH:'/opt/browser',LD_LIBRARY_PATH:'/opt/browser/lib'});assert.doesNotMatch(JSON.stringify(result),/platform-key|mail-key|school-user|school-password|postgresql/)});
