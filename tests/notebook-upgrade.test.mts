import test from'node:test';import assert from'node:assert/strict';import http from'node:http';import{mkdtemp,writeFile,rm}from'node:fs/promises';import{tmpdir}from'node:os';import{join}from'node:path';import{once}from'node:events';import{notebookUpgrade}from'../src/lib/notebookUpgrade.ts';
const env={...process.env},folder=await mkdtemp(join(tmpdir(),'cbgpu-upgrade-'));const key='f'.repeat(64),job='11111111-1111-4111-8111-111111111111';await writeFile(join(folder,'key'),key,{mode:0o600});test.after(async()=>{process.env=env;await rm(folder,{recursive:true,force:true})});
async function listen(server:http.Server){server.listen(0,'127.0.0.1');await once(server,'listening');return(server.address()as{port:number}).port}
function client(port:number,path:string,headers:Record<string,string>={}){return http.request({host:'127.0.0.1',port,path,headers:{host:'cbgpu.com',connection:'Upgrade',upgrade:'websocket',...headers},agent:false})}
test('disabled and forged edge upgrades fail without forwarding a browser identity',async()=>{process.env.CBGPU_GPU_NOTEBOOKS_ENABLED='0';let unhandled=0;const server=http.createServer();server.on('upgrade',(r,s,h)=>{if(!notebookUpgrade(r,s,h)){unhandled++;s.end('HTTP/1.1 404 Not Found\r\nContent-Length: 0\r\n\r\n')}});const port=await listen(server);try{for(const path of['/v1/gpu/relay','/__notebook_gateway/notebooks/'+job+'/api/kernels']){const req=client(port,path);const response=new Promise<number>((resolve,reject)=>{req.on('response',r=>{r.resume();resolve(r.statusCode!)});req.on('error',reject)});req.end();assert.equal(await response,404)}assert.equal(unhandled,0)}finally{server.closeAllConnections();server.close()}});
test('real TCP upgrade uses a fixed relay and strips browser/edge credentials with byte-exact bidirectional data',async()=>{process.env.CBGPU_GPU_NOTEBOOKS_ENABLED='1';process.env.CBGPU_NOTEBOOK_EDGE_KEY_FILE=join(folder,'key');const seen:http.IncomingHttpHeaders[]=[];const sockets=new Set<import('node:stream').Duplex>();const backend=http.createServer();backend.on('upgrade',(r,s)=>{sockets.add(s);seen.push(r.headers);s.write('HTTP/1.1 101 Switching Protocols\r\nConnection: Upgrade\r\nUpgrade: websocket\r\n\r\n');s.on('data',b=>s.write(b))});const backendPort=await listen(backend);process.env.CBGPU_NOTEBOOK_RELAY_URL='http://127.0.0.1:'+backendPort;const server=http.createServer();server.on('upgrade',(r,s,h)=>{sockets.add(s);assert.equal(notebookUpgrade(r,s,h),true)});const port=await listen(server);try{for(const [path,headers]of[['/v1/gpu/relay',{}],['/__notebook_gateway/notebooks/'+job+'/api/kernels/channels',{'x-cbgpu-note-edge':key,origin:'https://notebooks.cbgpu.com'}]]as const){const req=client(port,path,{...headers,authorization:'Bearer never-forward',cookie:'cbgpu-shared=never-forward; __Secure-cbgpu-notebook=job-only; _xsrf=xsrf-only'});const upgraded=new Promise<import('node:stream').Duplex>((resolve,reject)=>{req.once('upgrade',(_r,s)=>resolve(s));req.once('error',reject);req.once('response',r=>reject(Error('Unexpected status '+r.statusCode)))});req.end();const socket=await upgraded;sockets.add(socket);const echoed=once(socket,'data');socket.write('byte-exact-fixture');assert.equal(String((await echoed)[0]),'byte-exact-fixture');socket.destroy()}assert.equal(seen.length,2);assert.equal(seen[0].host,'cbgpu.com');assert.equal(seen[0].cookie,undefined);assert.equal(seen[1].host,'notebooks.cbgpu.com');assert.equal(seen[1]['x-cbgpu-public-host'],'notebooks.cbgpu.com');assert.equal(seen[1].cookie,'__Secure-cbgpu-notebook=job-only; _xsrf=xsrf-only');for(const h of seen){assert.equal(h.authorization,undefined);assert.equal(h['x-cbgpu-note-edge'],undefined)}}finally{for(const s of sockets)s.destroy();server.closeAllConnections();backend.closeAllConnections();server.close();backend.close()}});
test('public node handshake bursts are bounded before reaching private authority',async()=>{process.env.CBGPU_GPU_NOTEBOOKS_ENABLED='1';let requests=0;const sockets=new Set<import('node:stream').Duplex>();const backend=http.createServer();backend.on('upgrade',(_r,s)=>{requests++;sockets.add(s);s.write('HTTP/1.1 101 Switching Protocols\r\nConnection: Upgrade\r\nUpgrade: websocket\r\n\r\n')});const upstream=await listen(backend);process.env.CBGPU_NOTEBOOK_RELAY_URL='http://127.0.0.1:'+upstream;const server=http.createServer();server.on('upgrade',(r,s,h)=>{sockets.add(s);notebookUpgrade(r,s,h)});const port=await listen(server);try{for(let i=0;i<61;i++){const req=client(port,'/v1/gpu/relay',{'cf-connecting-ip':'synthetic-handshake-burst'});const status=new Promise<number>((resolve,reject)=>{req.once('upgrade',(r,s)=>{sockets.add(s);s.destroy();resolve(r.statusCode!)});req.once('response',r=>{r.resume();resolve(r.statusCode!)});req.once('error',reject)});req.end();assert.equal(await status,i<60?101:429)}assert.equal(requests,60)}finally{for(const s of sockets)s.destroy();server.closeAllConnections();backend.closeAllConnections();server.close();backend.close()}});
