/** Actual public handler + real loopback upstream; no external requests or credentials. */
import test from 'node:test';import assert from 'node:assert/strict';import http from 'node:http';import {once} from 'node:events';import fs from 'node:fs';import vm from 'node:vm';import ts from 'typescript';
const compile=(file:string)=>ts.transpileModule(fs.readFileSync(new URL(file,import.meta.url),'utf8'),{compilerOptions:{module:ts.ModuleKind.CommonJS,target:ts.ScriptTarget.ES2022}}).outputText;
const routeCode=compile('../src/app/api/news/route.ts'),bodyCode=compile('../src/lib/schoolsProxySecurity.ts');
const rss='<?xml version="1.0"?><rss version="2.0"><channel><title>Fixture</title><item><title><![CDATA[A useful discovery - Fixture Source]]></title><link>https://example.invalid/news</link><pubDate>Mon, 23 Nov 2026 12:00:00 GMT</pubDate><source>Fixture Source</source></item></channel></rss>';
async function fixture(mode:string){
 let hits=0,redirectHits=0;const requests:URL[]=[];const options:any[]=[];const deadlines:number[]=[];
 const server=http.createServer((req,res)=>{hits++;requests.push(new URL(req.url!,'http://fixture.invalid'));if(req.url?.startsWith('/trap')){redirectHits++;res.writeHead(200,{'content-type':'application/rss+xml'});res.end(rss);return}
  if(mode==='redirect'){res.writeHead(302,{location:'/trap'});res.end();return}
  if(mode==='slow-headers')return;
  if(mode==='slow-body'){res.writeHead(200,{'content-type':'application/rss+xml'});res.write('<?xml version="1.0"?><rss><channel>');return}
  if(mode==='oversized'){res.writeHead(200,{'content-type':'application/rss+xml'});res.end('<rss><channel>'+ 'x'.repeat(1_048_577)+'</channel></rss>');return}
  if(mode==='html'){res.writeHead(200,{'content-type':'text/html'});res.end('<!doctype html><html>synthetic upstream challenge</html>');return}
  if(mode==='truncated'){res.writeHead(200,{'content-type':'application/rss+xml'});res.end('<rss><channel><item><title>unfinished');return}
  if(mode==='error'){res.writeHead(503,{'content-type':'text/html'});res.end('synthetic internal failure detail');return}
  res.writeHead(200,{'content-type':'application/rss+xml'});res.end(mode==='empty'?'<rss version="2.0"><channel><title>No matches</title></channel></rss>':rss);
 });server.listen(0,'127.0.0.1');await once(server,'listening');const port=(server.address()as any).port;
 const context:any={exports:{},URL,URLSearchParams,Response,Request,TextDecoder,Uint8Array,AbortSignal:{timeout(ms:number){deadlines.push(ms);return AbortSignal.timeout(mode.startsWith('slow-')?100:ms)}},console:{error(){}},fetch:async(input:URL|string,init:any)=>{const original=new URL(String(input));assert.equal(original.origin,'https://news.google.com');options.push(init);return fetch('http://127.0.0.1:'+port+original.pathname+original.search,init)}};
 const helperExports:any={};vm.runInNewContext(bodyCode,{...context,exports:helperExports});context.require=(name:string)=>{if(name==='next/server')return{NextResponse:{json:(body:unknown,init?:ResponseInit)=>Response.json(body,init)}};assert.equal(name,'@/lib/schoolsProxySecurity');return helperExports};vm.runInNewContext(routeCode,context);
 return{get:(query='')=>context.exports.GET(new Request('http://localhost/api/news'+query)),options,deadlines,requests,stats:()=>({hits,redirectHits}),close:async()=>{server.closeAllConnections();await new Promise<void>(resolve=>server.close(()=>resolve()))}};
}
test('public news rejects HTML/truncated/oversized upstream replies instead of claiming an empty feed',async()=>{for(const mode of['html','truncated','oversized','error']){const f=await fixture(mode);try{const response=await f.get();assert.equal(response.status,502,mode);assert.equal(f.stats().hits,1);const body=await response.json();assert.deepEqual(body.items,[]);assert.equal(typeof body.error,'string');assert.doesNotMatch(JSON.stringify(body),/synthetic|RSS 503|Unexpected|SyntaxError/);assert.match(response.headers.get('cache-control')||'',/no-store/)}finally{await f.close()}}});
test('valid public news keeps item fields, a legitimate empty feed, query values and five-minute upstream cache',async()=>{for(const mode of['valid','empty']){const f=await fixture(mode);try{const language='ko&num=1&extra=injected',query='AI & 연구';const response=await f.get('?'+new URLSearchParams({q:query,hl:language}));assert.equal(response.status,200);const body=await response.json();assert.deepEqual(body.items,mode==='empty'?[]:[{title:'A useful discovery',link:'https://example.invalid/news',pubDate:'Mon, 23 Nov 2026 12:00:00 GMT',source:'Fixture Source'}]);assert.equal(f.requests[0].searchParams.get('hl'),language);assert.equal(f.requests[0].searchParams.get('q'),query);assert.equal(f.requests[0].searchParams.get('num'),'50');assert.equal(f.requests[0].searchParams.has('extra'),false);assert.equal(f.options[0].next.revalidate,300);assert.equal(f.deadlines[0],8000)}finally{await f.close()}}});
test('public news rejects redirects and bounds both response headers and response bodies',async()=>{for(const mode of['redirect','slow-headers','slow-body']){const f=await fixture(mode);try{const start=Date.now(),response=await f.get();assert.equal(response.status,502,mode);assert.equal(f.stats().redirectHits,0);assert.equal(f.stats().hits,1);if(mode.startsWith('slow-'))assert.ok(Date.now()-start<1500,mode+' stayed bounded');assert.equal(f.deadlines[0],8000)}finally{await f.close()}}});
