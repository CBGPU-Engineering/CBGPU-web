import test from 'node:test';
import assert from 'node:assert/strict';
import {extensionEndError,gpuExtensionPreview,requestGpuExtension,type GpuExtensionPreview} from '../src/lib/gpuReservationExtension.ts';
import {gpuRegistryPath} from '../src/lib/gpuRegistryRoutes.ts';
const id='11111111-1111-4111-8111-111111111111',base='/api/compute/legacy/reservations/'+id;
const preview:GpuExtensionPreview={reservation_id:id,current_end:'2026-11-22T10:00:00Z',max_end:'2026-11-22T11:00:00Z',server_now:'2026-11-22T09:00:00Z',can_extend:true,reason:null};
const session=async()=>({data:{session:{user:{id:'owner-A'},access_token:'synthetic-not-a-real-token'}}});
const args={base,id,owner:'owner-A',current:()=>true,session};
test('only explicit extension paths and methods pass the fixed registry mapper',()=>{assert.equal(gpuRegistryPath(['legacy','reservations',id,'extension'],'GET'),'/v1/gpu/legacy/reservations/'+id+'/extension');assert.equal(gpuRegistryPath(['legacy','reservations',id,'extend'],'POST'),'/v1/gpu/legacy/reservations/'+id+'/extend');assert.equal(gpuRegistryPath(['legacy','reservations',id,'extend'],'GET'),null);assert.equal(gpuRegistryPath(['legacy','reservations',id,'extension'],'POST'),null);assert.equal(gpuRegistryPath(['schools','cbsh','gpu','reservations',id,'extend'],'POST'),'/v1/schools/cbsh/gpu/reservations/'+id+'/extend');assert.equal(gpuRegistryPath(['legacy','reservations','../admin','extend'],'POST'),null)});
test('server limit permits ending exactly at the next booking start but rejects overlap and shortening',()=>{assert.equal(extensionEndError('2026-11-22T11:00:00Z',preview),null);assert.match(extensionEndError('2026-11-22T11:00:01Z',preview)!,/넘었/);assert.match(extensionEndError(preview.current_end,preview)!,/늦은/)});
test('read does not mutate, and a confirmed write sends the absolute end plus exact previous value',async()=>{const calls:RequestInit[]=[];const send:typeof fetch=async(_url,init)=>{calls.push(init!);return Response.json(calls.length===1?preview:{...preview,updated:true,current_end:'2026-11-22T11:00:00Z'})};assert.equal((await requestGpuExtension(args,send)).current_end,preview.current_end);assert.equal((await requestGpuExtension({...args,endsAt:'2026-11-22T11:00:00Z',expectedEnd:preview.current_end},send)).updated,true);assert.equal(calls[0].method,'GET');assert.equal(calls[0].body,undefined);assert.deepEqual(JSON.parse(calls[1].body as string),{ends_at:'2026-11-22T11:00:00Z',expected_ends_at:preview.current_end});assert.equal(calls[1].redirect,'error')});
test('account switch during SDK preparation or cancellation sends no request',async()=>{let resolve!:(value:Awaited<ReturnType<typeof session>>)=>void;const held=new Promise<Awaited<ReturnType<typeof session>>>(r=>resolve=r);let count=0,active=true;const send:typeof fetch=async()=>{count++;return Response.json(preview)};const work=requestGpuExtension({...args,current:()=>active,session:()=>held},send);await Promise.resolve();active=false;resolve(await session());await assert.rejects(work,/계정/);assert.equal(count,0);const controller=new AbortController();controller.abort();await assert.rejects(requestGpuExtension({...args,signal:controller.signal},send));assert.equal(count,0)});
test('changed account after response cannot report success',async()=>{let reads=0;const other=async()=>({data:{session:{user:{id:++reads===1?'owner-A':'owner-B'},access_token:'synthetic'}}});await assert.rejects(requestGpuExtension({...args,session:other},async()=>Response.json(preview)),/계정/)});
test('conflict or ambiguous network failure is never automatically retried',async()=>{let writes=0;const input={...args,endsAt:'2026-11-22T11:00:00Z',expectedEnd:preview.current_end};await assert.rejects(requestGpuExtension(input,async()=>{writes++;return Response.json({error:'RESERVATION_CONFLICT'},{status:409})}),/다른 예약/);assert.equal(writes,1);await assert.rejects(requestGpuExtension(input,async()=>{writes++;throw Error('lost response')}),/종료 시각을 확인/);assert.equal(writes,2)});
test('wrong identity, HTML, malformed dates, and unconfirmed updates cannot report success',async()=>{assert.throws(()=>gpuExtensionPreview({...preview,reservation_id:'other'},id));assert.throws(()=>gpuExtensionPreview({...preview,current_end:null},id));await assert.rejects(requestGpuExtension(args,async()=>new Response('<html>',{headers:{'content-type':'text/html'}})));await assert.rejects(requestGpuExtension({...args,endsAt:'2026-11-22T11:00:00Z',expectedEnd:preview.current_end},async()=>Response.json({...preview,updated:true})));let calls=0;await assert.rejects(requestGpuExtension({...args,endsAt:'2026-11-22T11:00:00Z',expectedEnd:'invalid'},async()=>{calls++;return Response.json(preview)}));assert.equal(calls,0)});
