import test from'node:test';import assert from'node:assert/strict';import fs from'node:fs';import vm from'node:vm';import ts from'typescript';import{NextRequest,NextResponse}from'next/server.js';
import * as schoolsProxySecurity from '../src/lib/schoolsProxySecurity.ts';
const code=ts.transpileModule(fs.readFileSync(new URL('../src/app/api/latex/[action]/route.ts',import.meta.url),'utf8'),{compilerOptions:{module:ts.ModuleKind.CommonJS,target:ts.ScriptTarget.ES2022}}).outputText;
function fixture({identity=true,upstreamStatus=200}={}){const exports:any={},calls:any[]=[];let reads=0;const owner='11111111-1111-4111-8111-111111111111',session='22222222-2222-4222-8222-222222222222',jwt='header.'+Buffer.from(JSON.stringify({session_id:session})).toString('base64url')+'.signature';vm.runInNewContext(code,{exports,Buffer,Date,Map,AbortSignal,console:{error(){}},fetch:async(url,options)=>{calls.push({url,options});return Response.json(upstreamStatus===404?{error:'not found'}:{projects:[{id:'own-project'}]},{status:upstreamStatus})},require(name){if(name==='@/lib/schoolsProxySecurity')return schoolsProxySecurity;if(name==='next/server')return{NextResponse};if(name==='node:fs/promises')return{readFile:async()=>{reads++;return'private-bridge-key'}};if(name==='@/lib/preprintsServer')return{personalProjectUser:async()=>identity?{id:owner,email:'owner@example.invalid',user_metadata:{}}:null};throw Error(name)}});return{calls,get reads(){return reads},owner,session,request(action='projects',method='GET',host='app.cbgpu.com',origin='https://app.cbgpu.com'){const headers={host,origin,authorization:'Bearer '+jwt,'X-CBGPU-Identity':'forged-other-owner','X-CBGPU-Key':'forged-key'};return exports[method](new NextRequest('https://'+host+'/api/latex/'+action,{method,headers}),{params:Promise.resolve({action})})}};}
test('LaTex own-project bridge derives owner/session only from fresh identity, never caller bridge headers',async()=>{const f=fixture();const response=await f.request();assert.equal(response.status,200);assert.equal(f.calls.length,1);assert.equal(f.calls[0].url,'http://127.0.0.1:3520/_api/projects');const identity=JSON.parse(Buffer.from(f.calls[0].options.headers['X-CBGPU-Identity'],'base64').toString());assert.equal(identity.id,f.owner);assert.equal(identity.session,f.session);assert.equal(f.calls[0].options.headers['X-CBGPU-Key'],'private-bridge-key');assert.equal(JSON.stringify(await response.json()).includes('private-bridge-key'),false);});
test('invalid personal identity and tenant hosts never reach owned project bridge',async()=>{const f=fixture({identity:false});assert.equal((await f.request()).status,401);assert.equal(f.reads,0);assert.equal(f.calls.length,0);const tenant=fixture();assert.equal((await tenant.request('projects','GET','tenant.front.cbgpu.com')).status,404);assert.equal(tenant.calls.length,0);assert.equal((await tenant.request('trash','POST','app.cbgpu.com','https://tenant.front.cbgpu.com')).status,403);assert.equal(tenant.calls.length,0);});
test('foreign or missing native projects stay denied rather than bypassing owner checks',async()=>{const f=fixture({upstreamStatus:404});assert.equal((await f.request('open')).status,404);assert.deepEqual(await(await f.request('trash','POST')).json(),{error:'Project or upload not found'});});
