import test from 'node:test';import assert from 'node:assert/strict';import{readFileSync}from'node:fs';import vm from'node:vm';import ts from'typescript';
const code=ts.transpileModule(readFileSync(new URL('../src/lib/adRevenue.ts',import.meta.url),'utf8'),{compilerOptions:{module:ts.ModuleKind.CommonJS,target:ts.ScriptTarget.ES2022}}).outputText,exports:Record<string,any>={};vm.runInNewContext(code,{exports,TextEncoder,Intl});
test('CSV preview handles official quoted cells, BOM and CRLF without evaluating formulas',()=>{const p=exports.csvPreview('\uFEFFdate,device,note\r\n2026-11-17,MOBILE,"quoted, field"\r\n2026-11-18,DESKTOP,"=HYPERLINK(""https://example.com"")"');assert.equal(p.rowCount,2);assert.equal(p.rows[0][2],'quoted, field');assert.equal(p.rows[1][2],'=HYPERLINK("https://example.com")');});
test('CSV preview refuses malformed, ambiguous and overlarge reports',()=>{for(const text of ['a,a\n1,2','a,b\n1','a,b\n"unfinished,2','a,b\n"quoted"trailing,2','a,b\n'+ 'x'.repeat(1024*1024)])assert.throws(()=>exports.csvPreview(text));});
test('missing and zero denominators remain N/A rather than invented performance',()=>{assert.equal(exports.ratio(null,100),null);assert.equal(exports.ratio(12,0),null);assert.equal(exports.ratio(2,100,100),2);assert.equal(exports.displayMetric(null),'N/A');assert.equal(exports.displayMetric(0),'0');assert.equal(exports.displayMetric(Infinity),'N/A');});
test('mapping only exact supported fields and device metrics do not infer placement performance',()=>{const p=exports.initialRevenueMapping(['date','device','clicks','placement_revenue']);assert.equal(p.clicks,'clicks');assert.equal(p.placement_revenue,undefined);assert.equal(p.estimated_revenue,undefined);});
test('large official count strings remain exact and no precision is invented',()=>{assert.equal(exports.reportedMetric('90071992547409931234'),'90,071,992,547,409,931,234');assert.equal(exports.reportedMetric(null,'money'),'N/A');});
test('admin BFF is independently disabled, requires current Bearer and same-origin writes, sends no cookies',async()=>{let flags:Record<string,string>={},calls:any[]=[];const route=ts.transpileModule(readFileSync(new URL('../src/app/api/admin/ad-revenue/[[...path]]/route.ts',import.meta.url),'utf8'),{compilerOptions:{module:ts.ModuleKind.CommonJS,target:ts.ScriptTarget.ES2022}}).outputText,out:Record<string,any>={};class NextResponse extends Response{static json(value:unknown,init?:ResponseInit){return new NextResponse(JSON.stringify(value),init)}}vm.runInNewContext(route,{exports:out,process:{env:flags},URL,AbortSignal,JSON,fetch:async(url:URL,init:any)=>{calls.push({url:String(url),init});return new Response('{"devices":[]}',{status:200})},require:(name:string)=>name==='next/server'?{NextResponse}:name.includes('internalServiceUrl')?{trustedInternalServiceUrl:(value:string)=>new URL(value)}:{boundedSchoolBody:async(body:ReadableStream)=>new Response(body).text(),schoolRequestOriginAllowed:(host:string,origin:string)=>origin==='https://admin.cbgpu.com'&&host==='admin.cbgpu.com'}});const req=(method='GET',authorization?:string,origin?:string)=>{const r=new Request('https://admin.cbgpu.com/api/admin/ad-revenue/preview',{method,headers:{host:'admin.cbgpu.com',...(authorization?{authorization}:{}),...(origin?{origin}:{}),cookie:'must-not-forward'},...(['POST','PATCH'].includes(method)?{body:'{}'}:{})});Object.assign(r,{nextUrl:new URL(r.url)});return r};const ctx={params:Promise.resolve({path:['preview']})};assert.equal((await out.GET(req(),ctx)).status,404);flags.CBGPU_AD_REVENUE_ENABLED='1';assert.equal((await out.GET(req(),{params:Promise.resolve({path:['analytics']})})).status,401);assert.equal((await out.POST(req('POST','Bearer synthetic.jwt.token','https://evil.example'),ctx)).status,403);assert.equal(calls.length,0);const response=await out.POST(req('POST','Bearer synthetic.jwt.token','https://admin.cbgpu.com'),ctx);assert.equal(response.status,200);assert.match(response.headers.get('cache-control')||'',/no-store/);assert.equal(calls[0].init.headers.Cookie,undefined);assert.equal(calls[0].init.headers.Authorization,'Bearer synthetic.jwt.token');assert.equal(calls[0].url,'http://127.0.0.1:3549/v1/admin/ad-revenue/preview');assert.equal((await out.PATCH(req('PATCH','Bearer synthetic.jwt.token','https://admin.cbgpu.com'),{params:Promise.resolve({path:['experiments','not-a-uuid']})})).status,404);assert.equal((await out.PATCH(req('PATCH','Bearer synthetic.jwt.token','https://admin.cbgpu.com'),{params:Promise.resolve({path:['experiments','11111111-1111-4111-8111-111111111111']})})).status,200);assert.equal(calls[1].init.method,'PATCH');assert.equal(calls[1].url,'http://127.0.0.1:3549/v1/admin/ad-revenue/experiments/11111111-1111-4111-8111-111111111111');});

test('annual report previews stay practical and stop at 5,000 data rows',()=>{const annual='date,unit,revenue\n'+Array.from({length:730},()=> '2026-11-17,DAN-vpZNfcj3tj0jMkhV,1').join('\n');assert.equal(exports.csvPreview(annual).rowCount,730);assert.equal(exports.csvPreview('a\n'+Array.from({length:5000},()=> '1').join('\n')).rowCount,5000);assert.throws(()=>exports.csvPreview('a\n'+Array.from({length:5001},()=> '1').join('\n')));});

test('report device keys label ad-unit formats and do not claim physical visitor attribution',()=>{assert.equal(exports.adFormatLabel('MOBILE'),'Mobile banner format');assert.equal(exports.adFormatLabel('DESKTOP'),'Desktop banner format');assert.equal(exports.adFormatLabel('UNKNOWN'),'Unmapped banner units');const text=readFileSync(new URL('../src/components/admin/revenue/AdRevenueDashboard.tsx',import.meta.url),'utf8');assert.match(text,/Actual physical-device revenue: N\/A/);assert.match(text,/narrow desktop window can use the mobile-format unit/);for(const path of ['AdRevenueTrends.tsx','AdRevenueExperiments.tsx']){const source=readFileSync(new URL('../src/components/admin/revenue/'+path,import.meta.url),'utf8');assert.match(source,/adFormatLabel/);assert.match(source,/Banner format/);}});
