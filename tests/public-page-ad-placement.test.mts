import test from'node:test';import assert from'node:assert/strict';import{adFitEligible,kakaoAdUnits}from'../src/lib/adPlacement.ts';
const id='11111111-1111-4111-8111-111111111111',base={hostname:'cbgpu.com',path:'/',search:'',audience:'anonymous' as const,placement:'platform' as const,contentReady:true};
test('public school, legal, contact and paper pages allow the existing unit for settled readers only',()=>{for(const audience of['anonymous','authenticated']as const){for(const path of['/schools','/privacy','/contact','/docs','/docs/getting-started','/arxiv','/arxiv/'+id])assert.equal(adFitEligible({...base,path,audience}),true,path);for(const path of['/','/arxiv','/'+id,'/arxiv/'+id])assert.equal(adFitEligible({...base,hostname:'arxiv.cbgpu.com',path,audience}),true,path)}for(const path of['/submit','/arxiv/submit','/my','/drafts','/auth/login','/auth/signup','/admin','/papers/'+id,'/'+id+'/edit','/arxiv/'+id+'/edit','/docs','/privacy'])assert.equal(adFitEligible({...base,hostname:'arxiv.cbgpu.com',path}),false,path);for(const path of['/schools/new','/schools/school-b/admin','/schools/school-b/verification','/arxiv/submit','/messages','/ai/chat'])assert.equal(adFitEligible({...base,path}),false,path);for(const hostname of['admin.cbgpu.com','developers.cbgpu.com','tenant.server.cbgpu.com','other-arxiv.invalid'])assert.equal(adFitEligible({...base,hostname,path:'/privacy'}),false);assert.deepEqual([kakaoAdUnits.desktop.width,kakaoAdUnits.desktop.height,kakaoAdUnits.mobile.width,kakaoAdUnits.mobile.height],[728,90,320,50])});
test('public additions do not bypass loading, content, school policy or sensitive URL safeguards',()=>{for(const path of['/schools','/privacy','/contact','/arxiv/'+id]){assert.equal(adFitEligible({...base,path,audience:'loading'}),false);assert.equal(adFitEligible({...base,path,contentReady:false}),false);for(const search of['?token=private','?code=private','?email=person@example.invalid','?q=private-search'])assert.equal(adFitEligible({...base,path,search}),false);assert.equal(adFitEligible({...base,path,hash:'#access_token=private'}),false);assert.equal(adFitEligible({...base,path,placement:'school',schoolAdsEnabled:false}),false)}assert.equal(adFitEligible({...base,hostname:'arxiv.cbgpu.com',path:'/'+id,search:'?page=2'}),true)});
