import test from'node:test';import assert from'node:assert/strict';import{build}from'esbuild';import vm from'node:vm';
const source=await build({entryPoints:['src/lib/centralCPU.ts'],bundle:true,write:false,platform:'node',format:'cjs',define:{'process.env.NEXT_PUBLIC_CBGPU_CENTRAL_CPU_V1':'"1"'},plugins:[{name:'api-boundary',setup(b){b.onResolve({filter:/schoolsClient$/},()=>({path:'api',namespace:'fixture'}));b.onLoad({filter:/.*/,namespace:'fixture'},()=>({loader:'js',contents:'export const schoolsRequest=globalThis.__request'}))}}]});
const zero={cpu_millis:0,memory_bytes:0,storage_bytes:0,max_projects:0,max_builds:0,max_compiles:0},usage={cpu_millis:0,memory_bytes:0,storage_bytes:0,active_projects:0,active_builds:0,active_compiles:0,unreconciled_leases:0};const allocation={school_id:'school-b',revision:0,status:'DISABLED',enabled:false,enabled_purposes:[],limits:zero,usage,expires_at:null,updated_at:null};const access={school_id:'school-b',purpose:'frontend',allowed:false,reason:'NO_ALLOCATION',allocation_revision:null,limits:null,usage:null,server_time:'2026-11-18T00:00:00Z'};
function fixture(){const m={exports:{}}as{exports:Record<string,any>},calls:any[]=[];vm.runInNewContext(source.outputFiles[0].text,{module:m,exports:m.exports,__request:async(...args:any[])=>{calls.push(args);return access},Error,Number,Date});return{api:m.exports,calls}}
test('absent allocation is explicitly disabled, with exact requested school binding',()=>{const f=fixture();assert.equal(f.api.parseCPUAllocation(allocation,'school-b').enabled,false);assert.equal(f.api.parseCPUAllocation({...allocation,usage:{...usage,private_metadata:'do-not-render'}},'school-b').usage.private_metadata,undefined);assert.throws(()=>f.api.parseCPUAllocation(allocation,'school-a'));assert.throws(()=>f.api.parseCPUAllocation({...allocation,limits:{...zero,memory_bytes:-1}},'school-b'));assert.throws(()=>f.api.parseCPUAllocation({...allocation,enabled_purposes:['gpu']},'school-b'))});
test('malformed or contradictory access cannot authorize an execution UI',()=>{const f=fixture();assert.throws(()=>f.api.parseCPUAccess({...access,purpose:'latex'},'frontend'));assert.throws(()=>f.api.parseCPUAccess({...access,allowed:true},'frontend'));assert.throws(()=>f.api.parseCPUAccess({...access,server_time:'invalid'},'frontend'));assert.equal(f.api.parseCPUAccess(access,'frontend').allowed,false)});
test('fresh access derives selected school server-side, never sends a browser school or identity payload',async()=>{const f=fixture();await f.api.readCPUAccess('frontend','owner');assert.equal(f.calls.length,1);assert.equal(f.calls[0][0],'central-cpu-access?purpose=frontend');assert.equal(f.calls[0][1],'GET');assert.equal(f.calls[0][2],undefined);assert.equal(f.calls[0][4],'owner')});

test('host pool is a separate disabled-by-default projection without school or purpose authority',()=>{const f=fixture();const pool=f.api.parseCPUPool({revision:0,status:'DISABLED',enabled:false,limits:zero,usage,updated_at:null,school_id:'not-a-school-grant'});assert.equal(pool.enabled,false);assert.equal(pool.school_id,undefined);assert.equal(pool.enabled_purposes,undefined);assert.throws(()=>f.api.parseCPUPool({...pool,limits:{...zero,max_projects:-1}}))});
