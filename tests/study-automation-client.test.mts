import test from'node:test';import assert from'node:assert/strict';
import{requestStudyAutomation,readStudyAutomationReply}from'../src/lib/studyAutomationClient.ts';
const settings={enabled:true,run_time:'07:30',room_id:'room',seat_id:'202',teacher_id:'teacher',reason:'자율학습',periods:[1,2,3],starts_on:'2026-11-19'};
const reply={settings,runs:[]};const session=(id='owner')=>Promise.resolve({data:{session:{user:{id},access_token:'synthetic-'+id}}});
test('automation requests bind session identity before mutation and never borrow a switched account token',async()=>{let calls=0;await assert.rejects(requestStudyAutomation('owner',settings,{getSession:()=>session('other'),isCurrent:()=>true,fetcher:async()=>{calls++;return Response.json(reply)}}),/다시 로그인/);assert.equal(calls,0);let release:any,current=true;const pending=requestStudyAutomation('owner',settings,{getSession:()=>new Promise(resolve=>{release=resolve}),isCurrent:()=>current,fetcher:async()=>{calls++;return Response.json(reply)}});current=false;release(await session());await assert.rejects(pending,/계정|다시 열어/);assert.equal(calls,0)});
test('late owner responses are rejected before another account can see old settings or run history',async()=>{let current=true,release:any;const pending=requestStudyAutomation('owner',undefined,{getSession:()=>session(),isCurrent:()=>current,fetcher:()=>new Promise(resolve=>{release=resolve})});await new Promise(resolve=>setTimeout(resolve,0));current=false;release(Response.json(reply));await assert.rejects(pending,/계정|다시 열어/)});
test('HTML, malformed or oversized JSON never leak parser errors or trigger mutation retries',async()=>{for(const response of[new Response('<!DOCTYPE html><secret>',{status:502,headers:{'Content-Type':'text/html'}}),new Response('{bad',{headers:{'Content-Type':'application/json'}}),new Response('x'.repeat(262145),{headers:{'Content-Type':'application/json'}})]){let calls=0;await assert.rejects(requestStudyAutomation('owner',settings,{getSession:()=>session(),isCurrent:()=>true,fetcher:async()=>{calls++;return response}}),error=>error instanceof Error&&!error.message.includes('Unexpected')&&!error.message.includes('secret')&&error.message.includes('저장'));assert.equal(calls,1)}});
test('one deadline covers stuck session, headers and response bodies without retrying writes',async()=>{let calls=0;await assert.rejects(requestStudyAutomation('owner',undefined,{getSession:()=>new Promise(()=>{}),isCurrent:()=>true,timeoutMs:15,fetcher:async()=>{calls++;return Response.json(reply)}}),/불러오지/);assert.equal(calls,0);for(const fetcher of[()=>new Promise<Response>(()=>{}),async()=>new Response(new ReadableStream({start(c){c.enqueue(new TextEncoder().encode('{"settings":'))}}),{headers:{'Content-Type':'application/json'}})]){await assert.rejects(requestStudyAutomation('owner',settings,{getSession:()=>session(),isCurrent:()=>true,timeoutMs:15,fetcher:async()=>{calls++;return fetcher()}}),/저장/)}assert.equal(calls,2)});
test('successful read/save/disable retain confirmed server state and sorted periods',async()=>{const result=await requestStudyAutomation('owner',settings,{getSession:()=>session(),isCurrent:()=>true,fetcher:async(url,init)=>{assert.equal(url,'/api/study/automation');assert.equal(init?.method,'POST');assert.equal(init?.redirect,'error');assert.equal(new Headers(init?.headers).get('authorization'),'Bearer synthetic-owner');assert.equal((JSON.parse(String(init?.body))).starts_on,undefined);return Response.json({...reply,settings:{...settings,enabled:false}})}});assert.equal(result.settings?.enabled,false);assert.deepEqual(readStudyAutomationReply({settings:null,runs:[{study_date:'2026-11-19',period:1,status:'running',message:null}]}).runs[0].message,'');await assert.rejects(requestStudyAutomation('owner',{...settings,periods:[]},{getSession:()=>session(),isCurrent:()=>true}),/교시/)});
