import test from 'node:test';
import assert from 'node:assert/strict';
import fs from 'node:fs';
import vm from 'node:vm';
import ts from 'typescript';
import {NextResponse} from 'next/server.js';
import {scopedAccountMode} from '../src/lib/deployAccess.ts';
const code=ts.transpileModule(fs.readFileSync(new URL('../src/app/api/manufacturing/access/route.ts',import.meta.url),'utf8'),{compilerOptions:{module:ts.ModuleKind.CommonJS,target:ts.ScriptTarget.ES2022}}).outputText;
function fixture(options:{mode?:string;identity?:boolean;approved?:boolean;laser?:boolean;printers?:number[];proof?:Record<string,unknown>;oracleError?:boolean;active?:boolean}={}){
 const user={id:'11111111-1111-4111-8111-111111111111'},env={CBGPU_MULTISCHOOL_V1:options.mode??'1',NEXT_PUBLIC_SUPABASE_ANON_KEY:'synthetic-public-key'};
 let laser=options.laser??false;const calls:string[]=[];const exports:any={};
 const client={rpc:async(rpc:string,args:any)=>{calls.push(rpc);assert.equal(rpc,'cbgpu_is_laser_manager');assert.equal(args.p_user,user.id);return{data:laser,error:null}},from(table:string){calls.push(table);return{select(){return{eq(key:string,id:string){assert.equal(id,user.id);return table==='profiles'?{single:async()=>({data:{is_approved:options.approved??false,is_laser_cut_manager:laser,is_admin:true},error:null})}:Promise.resolve({data:(options.printers||[]).map(printer_id=>({printer_id})),error:null})}}}}}};
 vm.runInNewContext(code,{exports,process:{env},console:{error(){}},require(name:string){if(name==='next/server')return{NextResponse};if(name==='@/lib/deployAccess')return{scopedAccountMode:()=>scopedAccountMode(env)};if(name==='@/lib/deployAuth')return{activeDeploymentSession:async()=>{calls.push('legacy-session');return options.active!==false}};if(name==='@/lib/preprintsServer')return{preprintsClient:()=>client,personalProjectUser:async()=>{calls.push('fresh-identity');return options.identity===false?null:user},publicationUser:async()=>{calls.push('legacy-identity');return options.identity===false?null:user}};if(name==='@supabase/supabase-js')return{createClient(_url:string,key:string,config:any){assert.equal(key,'synthetic-public-key');assert.equal(config.global.headers.Authorization,'Bearer synthetic-caller');return{rpc:async(rpc:string,args:any)=>{calls.push(rpc);assert.equal(rpc,'cbgpu_self_resource_access');assert.equal(args.target_school,'cbsh');return{data:options.proof??{school_id:'cbsh',context_type:'MEMBERSHIP',legacy_cbsh_access:true,resources:{fabrication:true}},error:options.oracleError?{message:'unavailable'}:null}}}}};throw Error(name)}});
 return{calls,setLaser(value:boolean){laser=value},get(host='laser.cbgpu.com'){return exports.GET(new Request('https://'+host+'/api/manufacturing/access',{headers:{host,Authorization:'Bearer synthetic-caller'}})) as Promise<Response>}};
}
test('assigned verified manager can enter despite historical profile approval false',async()=>{const f=fixture({mode:'true',laser:true});const response=await f.get();assert.equal(response.status,200);assert.deepEqual(await response.json(),{print:false,laser:true,printer_ids:[]});assert.equal(f.calls.includes('legacy-session'),false);assert.equal(f.calls.includes('legacy-identity'),false)});
test('platform administrator and fabrication guest are not equipment manager roles',async()=>{assert.equal((await fixture().get()).status,403);const f=fixture({laser:true,proof:{school_id:'cbsh',context_type:'GUEST',legacy_cbsh_access:false,resources:{fabrication:true}}});assert.equal((await f.get()).status,403);assert.equal(f.calls.includes('profiles'),false)});
test('foreign affiliation, disabled equipment and revoked sessions fail closed before role lookup',async()=>{for(const proof of [{school_id:'other',context_type:'MEMBERSHIP',legacy_cbsh_access:true,resources:{fabrication:true}},{school_id:'cbsh',context_type:'MEMBERSHIP',legacy_cbsh_access:true,resources:{fabrication:false}}]){const f=fixture({laser:true,proof});assert.equal((await f.get()).status,403);assert.equal(f.calls.includes('profiles'),false)}const revoked=fixture({identity:false,laser:true});assert.equal((await revoked.get()).status,401);assert.equal(revoked.calls.includes('profiles'),false)});
test('roles are reread and printer assignments never imply laser access',async()=>{const f=fixture({laser:true});assert.equal((await f.get()).status,200);f.setLaser(false);assert.equal((await f.get()).status,403);const print=fixture({printers:[1]});assert.equal((await print.get()).status,403);const response=await print.get('print.cbgpu.com');assert.equal(response.status,200);assert.deepEqual((await response.json()).printer_ids,[1]);assert.equal((await print.get('cbgpu.com')).status,404)});
test('unavailable or malformed scoped authority cannot fall back to legacy approval',async()=>{for(const options of [{oracleError:true},{mode:'TRUE'}]){const f=fixture({approved:true,laser:true,...options});assert.equal((await f.get()).status,503);assert.equal(f.calls.includes('legacy-identity'),false)}});
test('disabled rollout preserves historical approval and session checks',async()=>{assert.equal((await fixture({mode:'0',approved:false,laser:true}).get()).status,403);assert.equal((await fixture({mode:'0',approved:true,laser:true,active:false}).get()).status,401);const f=fixture({mode:'0',approved:true,laser:true});assert.equal((await f.get()).status,200);assert.equal(f.calls.includes('cbgpu_self_resource_access'),false);assert.equal(f.calls.includes('legacy-session'),true)});
