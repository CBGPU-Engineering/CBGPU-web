/** Existing production pages through a loopback Next preview. Synthetic SDK/auth only. */
import assert from 'node:assert/strict';
import{chromium}from'playwright';
const port=Number(process.env.CBGPU_AD_PREVIEW_PORT||3002),origin='https://cbgpu.com',sdk='https://t1.kakaocdn.net/kas/static/ba.min.js';
const browser=await chromium.launch({headless:true,executablePath:process.env.CBGPU_CHROMIUM||'/tmp/chromium',args:['--no-sandbox','--disable-dev-shm-usage','--disable-gpu']});
let fakeSdkResponses=0,blockedExternal=0;const proof:unknown[]=[];
try{
 for(const sample of [{path:'/',width:320,ad:true},{path:'/',width:1280,ad:true},{path:'/',width:1920,ad:true},{path:'/services',width:390,ad:true},{path:'/download',width:390,ad:true},{path:'/auth/login',width:390,ad:false},{path:'/ai',width:390,ad:false},{path:'/',width:390,ad:false,native:true}]){
  const context=await browser.newContext({viewport:{width:sample.width,height:900},serviceWorkers:'block',...(sample.native?{userAgent:'Mozilla/5.0 (Linux; Android 14) AppleWebKit/537.36 CBGPU/1.0 NativeAndroid'}:{})}),page=await context.newPage(),errors:string[]=[];page.on('pageerror',error=>errors.push(error.message));
  await context.route('**/*',async route=>{const request=route.request(),url=new URL(request.url());
   if(request.url()===sdk){fakeSdkResponses++;assert.equal(request.headers().referer,undefined);return route.fulfill({contentType:'application/javascript',body:`window.__fixtureAdLoads=(window.__fixtureAdLoads||0)+1;for(const n of document.querySelectorAll('ins.kakao_ad_area')){n.style.display='block';n.style.width=n.dataset.adWidth+'px';n.style.height=n.dataset.adHeight+'px';n.textContent='Synthetic unit: no provider impression';}`})}
   if(url.origin!==origin){blockedExternal++;return route.abort()}
   if(url.pathname==='/api/auth/shared-session')return route.fulfill({contentType:'application/json',body:'{"state":"signed-out","value":null}'});
   if(url.pathname.startsWith('/backend/'))return route.fulfill({status:403,contentType:'application/json',body:'{"error":"Synthetic private upstream denied"}'});
   if(url.pathname.startsWith('/api/'))return route.fulfill({status:403,contentType:'application/json',body:'{"error":"Synthetic private API denied"}'});
   const headers:Record<string,string>={host:'cbgpu.com','x-cbgpu-public-host':'cbgpu.com','x-forwarded-proto':'https'};for(const key of ['accept','content-type','rsc','next-router-state-tree','next-url','next-router-prefetch'])if(request.headers()[key])headers[key]=request.headers()[key];
   const response=await fetch('http://127.0.0.1:'+port+url.pathname+url.search,{method:request.method(),headers,redirect:'manual',...(['GET','HEAD'].includes(request.method())?{}:{body:request.postData()||undefined})});const output:Record<string,string>={};response.headers.forEach((v,k)=>{if(!['content-encoding','content-length','transfer-encoding'].includes(k))output[k]=v});return route.fulfill({status:response.status,headers:output,body:Buffer.from(await response.arrayBuffer())});
  });
  console.log('Checking',JSON.stringify(sample));await page.goto(origin+sample.path,{waitUntil:'domcontentloaded'});
  if(sample.ad){await page.locator('.cb-kakao-page-ad').waitFor({state:'visible',timeout:10000}).catch(async error=>{console.log('Layout failure',JSON.stringify(await page.evaluate(()=>{const el=document.querySelector('.cb-kakao-page-ad');return{url:location.href,width:innerWidth,sdk:(window as any).__fixtureAdLoads,aside:el?{rect:el.getBoundingClientRect().toJSON(),style:getComputedStyle(el).visibility,display:getComputedStyle(el).display,slot:el.querySelector('.cb-kakao-ad-slot')?.getAttribute('data-ad-format')}:null}})));throw error});if(sample.path!=='/')await page.locator('.cb-kakao-page-ad').scrollIntoViewIfNeeded();await page.waitForFunction(()=>(window as any).__fixtureAdLoads===1);if(sample.width===1920)console.log('Desktop ancestors',JSON.stringify(await page.locator('ins.kakao_ad_area').evaluate(el=>{const rows=[];let node:HTMLElement|null=el as HTMLElement;while(node){const s=getComputedStyle(node),r=node.getBoundingClientRect();rows.push({tag:node.tagName,className:node.className,width:r.width,left:r.left,right:r.right,maxWidth:s.maxWidth,display:s.display,gridTemplateColumns:s.gridTemplateColumns,gridColumn:s.gridColumn,overflowX:s.overflowX,transform:s.transform});node=node.parentElement;}return rows})));const geometry=await page.locator('ins.kakao_ad_area').evaluate(el=>{const r=el.getBoundingClientRect(),clips=[];let parent=el.parentElement;while(parent){const style=getComputedStyle(parent),box=parent.getBoundingClientRect();if(['hidden','clip','scroll','auto'].includes(style.overflowX))clips.push({tag:parent.tagName,className:parent.className,left:box.left,right:box.right,overflow:style.overflowX});parent=parent.parentElement;}return{clips,availableWidth:document.querySelector('.cb-kakao-page-ad')!.getBoundingClientRect().width,width:r.width,height:r.height,top:r.top,bottom:r.bottom,left:r.left,right:r.right,id:(el as HTMLElement).dataset.adUnit,viewport:innerWidth,loads:(window as any).__fixtureAdLoads}});assert.equal(geometry.loads,1);for(const ancestor of geometry.clips)assert.ok(geometry.left>=ancestor.left-.01&&geometry.right<=ancestor.right+.01,'unit must not be cropped by '+JSON.stringify(ancestor));assert.ok(geometry.left>=-.01&&geometry.right<=sample.width+.01);assert.equal(geometry.width,geometry.availableWidth>=728?728:320);assert.equal(geometry.height,geometry.availableWidth>=728?90:50);assert.equal(await page.locator('ins.kakao_ad_area').count(),1);const overflow=await page.evaluate(()=>{const aside=document.querySelector('.cb-kakao-page-ad') as HTMLElement,withAd=document.documentElement.scrollWidth;const display=aside.style.display;aside.style.display='none';const withoutAd=document.documentElement.scrollWidth;aside.style.display=display;return{viewport:innerWidth,withAd,withoutAd}});assert.ok(overflow.withAd<=Math.max(overflow.viewport,overflow.withoutAd),'the ad must not add horizontal overflow');if(overflow.withAd>overflow.viewport)console.log('Existing layout overflow unchanged by ad',JSON.stringify(overflow));if(sample.path==='/'){assert.ok(geometry.top>=0&&geometry.bottom<=900,'home banner must be visible in the first viewport');assert.ok(await page.evaluate(()=>{const ad=document.querySelector('.cb-kakao-page-ad'),hero=document.querySelector('.cb-home-hero');return !!ad&&!!hero&&hero.nextElementSibling===ad}),'single home ad belongs immediately after hero');}if(sample.width===320)await page.screenshot({path:'/tmp/cbgpu-live-ad320.png'});proof.push({path:sample.path,viewport:sample.width,unit:geometry.id,availableWidth:geometry.availableWidth,unitWidth:geometry.width,unitHeight:geometry.height,top:geometry.top});}
  else{await page.waitForTimeout(500);assert.equal(await page.evaluate(()=>(window as any).__fixtureAdLoads||0),0);assert.equal(await page.locator('ins.kakao_ad_area').count(),0);proof.push({...sample,sdk:0})}
  assert.deepEqual(errors,[]);await context.close();
 }
 console.log('PASS actual Next legacy release: '+JSON.stringify(proof)+'; '+fakeSdkResponses+' FAKE SDK responses; '+blockedExternal+' blocked externals; 0 real provider requests; 0 private upstream actions.');
}finally{await browser.close()}
