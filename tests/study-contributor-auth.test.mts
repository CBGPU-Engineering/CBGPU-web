import test from 'node:test';import assert from 'node:assert/strict';import fs from 'node:fs';import vm from 'node:vm';import ts from 'typescript';import crypto from 'node:crypto';
import {NextResponse} from 'next/server.js';
const compile=(path:string)=>ts.transpileModule(fs.readFileSync(new URL('../src/'+path,import.meta.url),'utf8'),{compilerOptions:{module:ts.ModuleKind.CommonJS,target:ts.ScriptTarget.ES2022}}).outputText;
class StudyFailure extends Error{status:number;constructor(message:string,status=400){super(message);this.status=status}}
function fixture({scoped=true,eligible=true,valid=true,modeError=false}={}){
 const uid='11111111-1111-4111-8111-111111111111';let allowed=eligible,session=valid,unavailable=false,providerCalls=0,writes=0,stored=0,revokedDuringVerify=false;const seen:any[]=[];
 const caller={auth:{getUser:async()=>({data:{user:{id:uid}},error:null})},rpc:async(name:string,args:any)=>{seen.push({name,args});if(unavailable)return{data:null,error:{code:'unavailable'}};return{error:null,data:name==='cbgpu_self_session_status'?{valid:session}:allowed}},from:()=>{throw Error('Caller eligibility may not use approval/profile bits')}};
 const service={rpc:async(name:string,args:any)=>{seen.push({name,args});if(unavailable)return{data:null,error:{code:'unavailable'}};if(name==='accept_eduset_contribution'){if(allowed)stored++;return{data:allowed,error:null}}assert.equal(name,'cbgpu_eduset_device_source_allowed');return{data:allowed,error:null}}};
 const userClient={...caller,from(table:string){const query={select(){return this},eq(){return this},single:async()=>({data:table==='profiles'?{is_approved:true}:{id:'new-device'},error:null}),upsert:async(value:any)=>{assert.equal(value.user_id,uid);writes++;return{error:null}},insert(value:any){assert.equal(value.user_id,uid);assert.ok(!('owner' in value));writes++;return this}};return query}};
 const env={NEXT_PUBLIC_SUPABASE_URL:'http://fixture-public',NEXT_PUBLIC_SUPABASE_ANON_KEY:'public-anon',SUPABASE_SERVICE_ROLE_KEY:'synthetic-private-service'};
 const helper:Record<string,any>={};vm.runInNewContext(compile('lib/studyContributorAuth.ts'),{exports:helper,process:{env},AbortSignal,fetch,require(name:string){if(name==='./edusetStudent')return{StudyFailure};if(name==='./studyAuth')return{studyScopedMode:()=>{if(modeError)throw new StudyFailure('Invalid server authorization flags',503);return scoped}};if(name==='./internalServiceUrl')return{trustedInternalServiceUrl:(value:string)=>new URL(value)};if(name==='@supabase/supabase-js')return{createClient:(_url:string,key:string,options:any)=>{assert.equal(key,'public-anon');assert.equal(options.global.headers.Authorization,'Bearer fixture-caller');return caller}};throw Error(name)}});
 const device:Record<string,any>={};vm.runInNewContext(compile('app/api/study/contributor/device/route.ts'),{exports:device,process:{env},require(name:string){if(name==='crypto')return{default:crypto};if(name==='next/server')return{NextResponse};if(name==='@/lib/studyContributorAuth')return{...helper,requireStudyContributor:async(req:Request)=>{const proof=await helper.requireStudyContributor(req);return{...proof,client:userClient}}};if(name==='@supabase/supabase-js')return{createClient:()=>userClient};throw Error(name)}});
 const sync:Record<string,any>={};vm.runInNewContext(compile('app/api/study/contributor/sync/route.ts'),{exports:sync,process:{env},Buffer,Date,AbortSignal,fetch:async()=>{providerCalls++;if(revokedDuringVerify)allowed=false;return Response.json([])},require(name:string){if(name==='crypto')return{default:crypto};if(name==='next/server')return{NextResponse};if(name==='@/lib/studyContributorAuth')return helper;if(name==='@/lib/edusetTokenCrypto')return{encryptToken:()=> 'synthetic-encrypted-token'};if(name==='@supabase/supabase-js')return{createClient:(_url:string,key:string)=>{assert.equal(key,'synthetic-private-service');return service}};throw Error(name)}});
 const request=()=>new Request('https://cbgpu.com/api/study/contributor/device',{method:'POST',headers:{authorization:'Bearer fixture-caller','content-type':'application/json'},body:JSON.stringify({name:'fixture',user_id:'forged-owner'})});
 const schoolToken='fixture.'+Buffer.from(JSON.stringify({exp:Date.now()/1000+3600})).toString('base64url')+'.fixture';
 return{uid,helper,device,sync,request,syncRequest:()=>new Request('https://cbgpu.com/api/study/contributor/sync',{method:'POST',headers:{'x-cbgpu-device':'cbgpu_'+('A'.repeat(43))},body:JSON.stringify({accessToken:schoolToken})}),deny:()=>allowed=false,expire:()=>session=false,fail:()=>unavailable=true,revokeDuringVerify:()=>revokedDuringVerify=true,counts:()=>({providerCalls,writes,stored}),seen};
}
test('fresh verified CBsh member profile-independent eligibility is read-only; guest and expired session cannot enroll',async()=>{
 const f=fixture();const eligibility=await f.device.GET(f.request());assert.equal(eligibility.status,200);assert.deepEqual(await eligibility.json(),{allowed:true});assert.deepEqual(f.counts(),{providerCalls:0,writes:0,stored:0});
 const enrolled=await f.device.POST(f.request());assert.equal(enrolled.status,200);assert.equal(f.counts().writes,2);f.deny();assert.equal((await f.device.POST(f.request())).status,403);assert.equal(f.counts().writes,2);
 const expired=fixture({valid:false});assert.equal((await expired.device.POST(expired.request())).status,401);assert.equal(expired.counts().writes,0);const guest=fixture({eligible:false});assert.equal((await guest.device.GET(guest.request())).status,403);assert.equal(guest.counts().writes,0);
});
test('shared sync refuses ineligible device BEFORE provider access and rechecks final acceptance after revocation',async()=>{
 const denied=fixture({eligible:false});assert.equal((await denied.sync.POST(denied.syncRequest())).status,403);assert.deepEqual(denied.counts(),{providerCalls:0,writes:0,stored:0});
 const changing=fixture();changing.revokeDuringVerify();assert.equal((await changing.sync.POST(changing.syncRequest())).status,403);assert.deepEqual(changing.counts(),{providerCalls:1,writes:0,stored:0});
 const offline=fixture();offline.fail();assert.equal((await offline.sync.POST(offline.syncRequest())).status,503);assert.equal(offline.counts().providerCalls,0);
});
test('flag-off preserves legacy enrollment/sync and never calls the new eligibility RPC',async()=>{
 const f=fixture({scoped:false});assert.equal((await f.device.GET(f.request())).status,404);assert.equal((await f.device.POST(f.request())).status,200);assert.equal((await f.sync.POST(f.syncRequest())).status,200);assert.deepEqual(f.seen.map(v=>v.name),['accept_eduset_contribution']);
});

test('malformed scoped configuration fails closed and valid device contribution never returns private credentials',async()=>{const bad=fixture({modeError:true});assert.equal((await bad.device.POST(bad.request())).status,503);assert.equal((await bad.sync.POST(bad.syncRequest())).status,503);assert.deepEqual(bad.counts(),{providerCalls:0,writes:0,stored:0});const good=fixture();const response=await good.sync.POST(good.syncRequest());assert.equal(response.status,200);const value=await response.json();assert.equal(value.ok,true);assert.deepEqual(Object.keys(value).sort(),['expiresAt','ok']);assert.deepEqual(good.counts(),{providerCalls:1,writes:0,stored:1});assert.deepEqual(Object.keys(good.seen[0].args),['p_key_hash'])});
