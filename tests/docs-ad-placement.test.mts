import test from'node:test';import assert from'node:assert/strict';import fs from'node:fs';import{publicDocSlugs,publicDocsPath}from'../src/lib/publicDocsPaths.ts';import{adFitEligible,kakaoAdUnits}from'../src/lib/adPlacement.ts';
const base={hostname:'docs.cbgpu.com',path:'/',search:'',audience:'anonymous' as const,placement:'platform' as const,contentReady:true};
test('documentation ads are limited to actual public guides and preserve provider formats',()=>{const source=fs.readFileSync(new URL('../src/components/publications/docs.ts',import.meta.url),'utf8'),actual=[...source.matchAll(/(?:slug:\s*'([^']+)'|"slug":\s*"([^"]+)")/g)].map(m=>m[1]||m[2]);assert.deepEqual([...publicDocSlugs],actual,'keep route-only registry synchronized with actual guide content');for(const slug of publicDocSlugs){assert.equal(publicDocsPath('/'+slug),true);assert.equal(adFitEligible({...base,path:'/'+slug}),true);assert.equal(adFitEligible({...base,path:'/docs/'+slug,audience:'authenticated'}),true)}assert.equal(adFitEligible(base),true);for(const path of['/admin','/auth/login','/messages','/not-a-real-guide','/docs/not-a-real-guide','/arxiv/submit'])assert.equal(adFitEligible({...base,path}),false,path);assert.equal(adFitEligible({...base,audience:'loading'}),false);assert.equal(adFitEligible({...base,contentReady:false}),false);for(const search of['?token=private','?query=my-question','?email=person@example.invalid'])assert.equal(adFitEligible({...base,search}),false);assert.equal(adFitEligible({...base,hash:'#private'}),false);assert.deepEqual([kakaoAdUnits.desktop.width,kakaoAdUnits.desktop.height,kakaoAdUnits.mobile.width,kakaoAdUnits.mobile.height],[728,90,320,50])});
