import test from'node:test';import assert from'node:assert/strict';import fs from'node:fs';import vm from'node:vm';import{transformSync}from'esbuild';
import{trustedInternalServiceUrl}from'../src/lib/internalServiceUrl.ts';import{publicContestBannerPath,publicItem}from'../src/lib/publicContentModel.ts';
const ID='10000000-0000-4000-8000-000000000001',OTHER='10000000-0000-4000-8000-000000000002';
const png=Uint8Array.from([137,80,78,71,13,10,26,10,0,0,0,13,73,72,68,82,0,0,0,1,0,0,0,1]);
function load(reply:()=>Response,enabled=true){const calls:any[]=[],exports:any={};const code=transformSync(fs.readFileSync(new URL('../src/lib/publicAssetsServer.ts',import.meta.url),'utf8'),{loader:'ts',format:'cjs'}).code;const module={exports};vm.runInNewContext(code,{module,exports,require:(name:string)=>{if(name==='server-only')return{};if(name==='./internalServiceUrl')return{trustedInternalServiceUrl};if(name==='./publicContentModel')return{publicContestBannerPath};throw Error(name)},process:{env:{NEXT_PUBLIC_CBGPU_PUBLIC_BROWSING_V1:enabled?'1':'0',CBGPU_PUBLIC_BROWSING_V1:enabled?'1':'0'}},Response,URL,Headers,AbortSignal,Uint8Array,TextDecoder,ReadableStream,fetch:async(url:URL,options:any)=>{calls.push({url:String(url),options});return reply()}});return{api:module.exports as any,calls}}
test('only exact same-content opaque alias survives public DTO',()=>{const path=publicContestBannerPath(ID);assert.equal(publicItem('contests',{id:ID,banner_url:path,banner_path:'private-owner/file.png'})?.banner_url,path);for(const banner_url of ['https://attacker.invalid/image.png',publicContestBannerPath(OTHER),'/backend/storage/private.png','//attacker.invalid/a','/api/public-assets/contests/'+ID+'/banner?source=private'])assert.equal(publicItem('contests',{id:ID,banner_url})?.banner_url,undefined);assert.equal(publicItem('projects',{id:ID,banner_url:path})?.banner_url,undefined)});
test('opaque banner proxy preserves original bytes and forwards no visitor identity',async()=>{const h=load(()=>new Response(png,{headers:{'content-type':'image/png','content-length':String(png.length),'set-cookie':'must-not-forward=1','location':'/private'}}));const response=await h.api.fetchPublicBanner(ID);assert.equal(response.status,200);assert.deepEqual(new Uint8Array(await response.arrayBuffer()),png);assert.equal(h.calls[0].url,'http://127.0.0.1:3547/v1/assets/contests/'+ID+'/banner');assert.equal(h.calls[0].options.redirect,'error');assert.equal(h.calls[0].options.cache,'no-store');assert.deepEqual(Object.keys(h.calls[0].options.headers),['Accept']);assert.equal(response.headers.get('set-cookie'),null);assert.equal(response.headers.get('location'),null);assert.match(response.headers.get('cache-control')!,/private, no-store/);assert.equal(response.headers.get('cross-origin-resource-policy'),'same-origin');assert.match(response.headers.get('content-security-policy')!,/^sandbox;/)});
test('inactive feature and invalid ids never contact native API',async()=>{const h=load(()=>{throw Error('not reached')},false);assert.equal((await h.api.fetchPublicBanner(ID)).status,404);assert.equal(h.calls.length,0);const active=load(()=>{throw Error('not reached')});for(const id of ['../../secret','not-a-uuid',ID+'?url=evil'])assert.equal((await active.api.fetchPublicBanner(id)).status,404);assert.equal(active.calls.length,0)});
test('private, revoked, active content, oversized and malformed upstream images fail closed',async()=>{for(const make of [()=>new Response('private-path',{status:404}),()=>new Response(null,{status:302,headers:{location:'https://attacker.invalid'}}),()=>new Response('<svg/>',{headers:{'content-type':'image/svg+xml'}}),()=>new Response('<html/>',{headers:{'content-type':'image/png'}}),()=>new Response(png,{headers:{'content-type':'image/png','content-length':String(10*1024*1024+1)}}),()=>new Response(png,{headers:{'content-type':'image/png','content-length':'2'}})]){const h=load(make);const response=await h.api.fetchPublicBanner(ID);assert.notEqual(response.status,200);assert.equal(await response.text(),'');assert.equal(response.headers.get('location'),null)}});
test('public asset BFF independently rejects management tenant and forged-host requests',async()=>{
 const exports:any={},module={exports},calls:any[]=[];const file=new URL('../src/app/api/public-assets/contests/[id]/banner/route.ts',import.meta.url);const code=transformSync(fs.readFileSync(file,'utf8'),{loader:'ts',format:'cjs'}).code;
 vm.runInNewContext(code,{module,exports,Response,process:{env:{}},require:(name:string)=>{if(name==='@/lib/publicAssetsServer')return{publicImageHeaders:{'Cache-Control':'private, no-store'},fetchPublicBanner:async(id:string)=>{calls.push(id);return new Response(null)}};if(name==='@/lib/requestSecurity')return{WindowRateLimiter:class{allow(){return true}}};throw Error(name)}});
 const get=module.exports.GET;const request=(host:string,forwarded?:string,query='')=>({headers:new Headers({host,...(forwarded?{'x-cbgpu-public-host':forwarded}:{})}),nextUrl:new URL('http://'+host+'/api/public-assets/contests/'+ID+'/banner'+query)});
 for(const host of ['cbgpu.com','www.cbgpu.com','app.cbgpu.com','student.cbgpu.com','researcher.cbgpu.com','developer.cbgpu.com'])assert.equal((await get(request(host),{params:Promise.resolve({id:ID})})).status,200);
 const expected=calls.length;
 for(const host of ['admin.cbgpu.com','developers.cbgpu.com','docs.cbgpu.com','arxiv.cbgpu.com','gpu.cbgpu.com','latex.cbgpu.com','x.front.cbgpu.com','unknown.invalid'])assert.equal((await get(request(host,'cbgpu.com'),{params:Promise.resolve({id:ID})})).status,404);
 assert.equal((await get(request('cbgpu.com',undefined,'?url=https://attacker.invalid'),{params:Promise.resolve({id:ID})})).status,404);assert.equal(calls.length,expected);
});
test('slow unread image responses are bounded and cancelled streams release transfer slots',async()=>{
 const h=load(()=>new Response(png,{headers:{'content-type':'image/png'}}));const held:Response[]=[];
 for(let i=0;i<8;i++){const response=await h.api.fetchPublicBanner(ID);assert.equal(response.status,200);held.push(response)}
 assert.equal((await h.api.fetchPublicBanner(ID)).status,429);assert.equal(h.calls.length,8);
 for(const response of held)await response.body!.cancel();
 const resumed=await h.api.fetchPublicBanner(ID);assert.equal(resumed.status,200);await resumed.arrayBuffer();
});
