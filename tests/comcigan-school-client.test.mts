 const empty={read:async()=>null,write:async()=>{}},exports:any={};vm.runInNewContext(compiled,{exports,Buffer,URL,AbortSignal,Date,console,fetch,require(n:string){if(n==='iconv-lite')return iconv;if(n==='./comciganSource')return source;if(n==='./comciganPayload')return payload;if(n==='./timetableCache')return cache;if(n==='./comciganSchool')return school;if(n==='./timetableStore')return{fileTimetableStore:()=>empty,schoolTimetableStore:(key:string)=>({read:async()=>stored.get(key),write:async(v:unknown)=>{stored.set(key,v)}})};throw Error(n)}});
