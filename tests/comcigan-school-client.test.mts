import test from'node:test';import assert from'node:assert/strict';import fs from'node:fs';import vm from'node:vm';import ts from'typescript';import iconv from'iconv-lite';import{createCipheriv,createHash,createHmac}from'node:crypto';import*as source from'../src/lib/comciganSource.ts';import*as payload from'../src/lib/comciganPayload.ts';import*as cache from'../src/lib/timetableCache.ts';import*as school from'../src/lib/comciganSchool.ts';
