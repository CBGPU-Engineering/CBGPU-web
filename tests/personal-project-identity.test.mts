import test from'node:test';import assert from'node:assert/strict';import fs from'node:fs';import vm from'node:vm';import ts from'typescript';
const code=ts.transpileModule(fs.readFileSync(new URL('../src/lib/preprintsServer.ts',import.meta.url),'utf8'),{compilerOptions:{module:ts.ModuleKind.CommonJS,target:ts.ScriptTarget.ES2022}}).outputText;
function fixture({scoped=true,approved=false,valid=true,rpcError=false,active=true,deleted=false}={}){
 const calls:any[]=[];const exports:any={};const user={id:'11111111-1111-4111-8111-111111111111',email:'synthetic@example.invalid',...(deleted?{deleted_at:'2026-01-01'}:{})};
 const env={SUPABASE_SERVICE_ROLE_KEY:'private-service-fixture',NEXT_PUBLIC_SUPABASE_ANON_KEY:'public-anon-fixture',...(scoped?{CBGPU_MULTISCHOOL_V1:'1'}:{})};
 vm.runInNewContext(code,{exports,process:{env},require(name){if(name==='server-only')return{};if(name==='@/lib/deployAuth')return{activeDeploymentSession:async()=>active};if(name==='@supabase/supabase-js')return{createClient(url,key,options){calls.push({url,key,options});return{auth:{getUser:async token=>{assert.equal(token,'synthetic-user-jwt');return{data:{user},error:null}}},from:()=>({select:()=>({eq:()=>({maybeSingle:async()=>({data:{id:user.id,is_approved:approved}})})})}),rpc:async name=>{calls.push({rpc:name});return{data:{valid,approved:false,school_id:null},error:rpcError?{message:'missing or unavailable'}:null}}}}};throw Error(name)}});
 return{exports,calls,request:()=>new Request('https://app.cbgpu.com/api/latex/projects',{headers:{authorization:'Bearer synthetic-user-jwt'}})};
}
test('external, graduate and reverification identity can retain owned projects without school approval',async()=>{const f=fixture();assert.ok(await f.exports.personalProjectUser(f.request()));assert.equal(f.calls[1].key,'public-anon-fixture');assert.equal(f.calls[1].options.global.headers.Authorization,'Bearer synthetic-user-jwt');assert.equal(f.calls[2].rpc,'cbgpu_self_session_status');assert.equal(await f.exports.publicationUser(f.request()),null,'school/publication legacy approval is not widened');});
test('revoked, expired, banned or suspended identity proof fails closed',async()=>{const f=fixture({valid:false});assert.equal(await f.exports.personalProjectUser(f.request()),null);assert.equal(await fixture({deleted:true}).exports.personalProjectUser(f.request()),null);await assert.rejects(()=>fixture({rpcError:true}).exports.personalProjectUser(f.request()),/unavailable/);});
test('flags-off project policy preserves approval and active-session behavior',async()=>{for(const config of[{approved:false,active:true},{approved:true,active:false}]){const f=fixture({scoped:false,...config});assert.equal(await f.exports.personalProjectUser(f.request()),null)}const f=fixture({scoped:false,approved:true});assert.ok(await f.exports.personalProjectUser(f.request()));assert.equal(f.calls.some(c=>c.rpc),false);});
