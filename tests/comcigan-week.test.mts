import test from'node:test';import assert from'node:assert/strict';import{extractComciganWeekField}from'../src/lib/comciganSource.ts';import{validateComciganWeek}from'../src/lib/comciganSchool.ts';
test('sanitized real renderer shape extracts rotating field without evaluating upstream code',()=>{const fixture="p+=요일출력하기(QnmsbChange(자료.자료130));var 시작일=new Date(QnmsbChange(자료.자료130));var 제한일=new Date(자료.열람제한일);globalThis.UPSTREAM_EXECUTED=true;";assert.equal(extractComciganWeekField(fixture),'자료130');assert.equal(extractComciganWeekField(fixture.replaceAll('자료130','자료907')),'자료907');assert.equal(extractComciganWeekField('var 시작일=new Date(자료.시작일);'),'시작일');assert.equal(extractComciganWeekField('var semester=new Date(자료.학기시작일자);'),null);assert.throws(()=>extractComciganWeekField('var 시작일=new Date(자료.자료101);요일출력하기(자료.자료102);'));assert.equal((globalThis as any).UPSTREAM_EXECUTED,undefined)});
test('only real ISO Mondays in the supported current/weekend-next school week are cacheable',()=>{const tuesday=Date.parse('2026-11-17T03:00:00Z');assert.equal(validateComciganWeek('2026-11-16',tuesday),'2026-11-16');for(const date of ['2026-08-01','2026-11-17','2026-11-23','2026-02-30','2026-11-9'])assert.throws(()=>validateComciganWeek(date,tuesday));assert.throws(()=>validateComciganWeek(null,tuesday));assert.equal(validateComciganWeek('2026-11-23',Date.parse('2026-11-21T03:00:00Z')),'2026-11-23')});
