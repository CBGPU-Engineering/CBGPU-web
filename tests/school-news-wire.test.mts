import test from'node:test';import assert from'node:assert/strict';import{readSchoolNewsResponse,schoolNewsHttps,SchoolNewsWireError}from'../src/lib/schoolNewsWire.ts';
const dto={items:[{title:'안내',link:'https://school.example/notice/1',pubDate:'2026-11-18',author:'학교'}],school:{id:'school-b',name:'학교 B'},sourceUrl:'https://school.example/notice',month:'2026-11'};
test('valid school news binds school and month without borrowing another school',async()=>{assert.deepEqual(await readSchoolNewsResponse(Response.json(dto),'school-b','2026-11'),dto);for(const value of[{...dto,school:{id:'cbsh',name:'다른 학교'}},{...dto,month:'2026-10'},{...dto,items:[{...dto.items[0],link:'javascript:alert(1)'}]}])await assert.rejects(readSchoolNewsResponse(Response.json(value),'school-b','2026-11'),/학교 소식 응답/);assert.equal(schoolNewsHttps('https://user:secret@school.example/'),null)});
test('HTML, malformed JSON and redirects never expose parser errors or HTML',async()=>{for(const status of[200,500]){await assert.rejects(readSchoolNewsResponse(new Response('<!DOCTYPE html><title>private proxy message</title>',{status,headers:{'Content-Type':'text/html'}}),'school-b','2026-11'),(e:unknown)=>e instanceof SchoolNewsWireError&&!e.message.includes('<')&&!e.message.includes('Unexpected token'));}await assert.rejects(readSchoolNewsResponse(new Response('{broken',{headers:{'Content-Type':'application/json'}}),'school-b','2026-11'),/학교 소식 응답/);const redirect=Response.json(dto);Object.defineProperty(redirect,'redirected',{value:true});await assert.rejects(readSchoolNewsResponse(redirect,'school-b','2026-11'),/학교 소식 응답/)});
test('401/403 remain distinct and never accept an error DTO as successful empty news',async()=>{for(const status of[401,403])await assert.rejects(readSchoolNewsResponse(Response.json({error:'<!DOCTYPE raw internal error>'},{status}),'school-b','2026-11'),(e:unknown)=>e instanceof SchoolNewsWireError&&e.status===status&&!e.message.includes('<'));await assert.rejects(readSchoolNewsResponse(Response.json({items:[]}), 'school-b','2026-11'),/학교 소식 응답/)});
test('wire bounds reject oversized bodies and error status JSON without accepting stale data',async()=>{await assert.rejects(readSchoolNewsResponse(new Response(' '.repeat(262145),{headers:{'Content-Type':'application/json'}}),'school-b','2026-11'),(e:unknown)=>e instanceof SchoolNewsWireError&&e.code==='INVALID_JSON_RESPONSE');await assert.rejects(readSchoolNewsResponse(Response.json(dto,{status:500}),'school-b','2026-11'),(e:unknown)=>e instanceof SchoolNewsWireError&&e.status===500)});
