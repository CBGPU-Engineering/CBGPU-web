import test from'node:test';import assert from'node:assert/strict';
import{parseSchoolRSS,schoolFeedLink}from'../src/lib/schoolNewsFeed.ts';
import{isGyo6CalendarSource,parseGyo6SchoolCalendar}from'../src/lib/schoolCalendarGyo6.ts';
import{schoolNewsSource}from'../src/lib/schoolNewsSource.ts';
const feed='https://school.gyo6.net/gbdhs/na/ntt/selectRssFeed.do?mi=108794&bbsId=29988&maxSn=20';
const source='https://school.gyo6.net/gbdhs/schl/sv/schdulView/schdulCalendarView.do?mi=108774&selectYearMonth=202611';
const calendar=(body:string,month='202611')=>`<input type="hidden" name="selectYearMonth" value="${month}"><table>${body}</table>`;
test('official Gyo6 malformed RSS article paths normalize to the same school only',()=>{const xml='<rss><channel><item><title><![CDATA[학교 안내]]></title><link><![CDATA[school.gyo6.net/gbdhs/gbdhs/na/ntt/selectNttInfo.do?nttSn=123&mi=108794]]></link><pubDate><![CDATA[2026-11-13 15:04:08.0]]></pubDate></item></channel></rss>';const items=parseSchoolRSS(xml,feed);assert.equal(items.length,1);assert.equal(items[0].link,'https://school.gyo6.net/gbdhs/na/ntt/selectNttInfo.do?nttSn=123&mi=108794');assert.equal(items[0].title,'학교 안내');assert.equal(items[0].pubDate,'2026-11-13 15:04:08.0')});
test('Gyo6 links cannot escape reviewed origin or school; normalization does not affect other feeds',()=>{for(const link of['https://school.gyo6.net/other/na/ntt/selectNttInfo.do','school.gyo6.net/other/na/ntt/selectNttInfo.do','https://evil.invalid/gbdhs/a','https://user:password@school.gyo6.net/gbdhs/a','javascript:alert(1)','//evil.invalid/a','https://school.gyo6.net/gbdhs/../other/a'])assert.equal(schoolFeedLink(link,feed),null,link);assert.equal(schoolFeedLink('https://school.cbe.go.kr/cbs-h/a','https://school.cbe.go.kr/rss/cbs-h/M010401'),'https://school.cbe.go.kr/cbs-h/a');assert.equal(schoolFeedLink('/gbdhs/na/ntt/view.do',feed),'https://school.gyo6.net/gbdhs/na/ntt/view.do');assert.equal(schoolFeedLink('https://school.gyo6.net/gbdhs/a','https://school.gyo6.net/gbdhs/na/ntt/selectRssFeed.do'),'https://school.gyo6.net/gbdhs/a')});
test('ordinary RSS and GUID links keep working; HTML error pages never become empty successful feeds',()=>{const items=parseSchoolRSS('<rss><channel><item><title>일반 안내</title><guid>/notice/1</guid><author>운영팀</author></item></channel></rss>','https://school.example.org/feed');assert.deepEqual(items,[{title:'일반 안내',link:'https://school.example.org/notice/1',pubDate:'',author:'운영팀'}]);assert.throws(()=>parseSchoolRSS('<!doctype html><title>홈페이지 오류 알림</title>',feed),/UNSUPPORTED/)});
test('calendar selects the requested official month and returns dated, readable events only',()=>{const html=calendar('<td class="selectDay" id="20261113"><p class="calLink btnInfo" data-schdulTitle="학교 &amp; 학부모 공개수업" data-seq="123"></p><p data-schdulTitle="추가 일정"></p></td><td class="selectDay" id="20261114"></td>');assert.equal(isGyo6CalendarSource(source),true);const items=parseGyo6SchoolCalendar(html,source);assert.deepEqual(items.map(i=>({title:i.title,date:i.pubDate})),[{title:'학교 & 학부모 공개수업',date:'2026-11-13T00:00:00+09:00'},{title:'추가 일정',date:'2026-11-13T00:00:00+09:00'}]);assert.ok(items.every(i=>i.link===source&&i.author===''));assert.deepEqual(parseGyo6SchoolCalendar(calendar('<td class="selectDay" id="20261101"></td>'),source),[])});
test('calendar rejects stale months, invalid dates, error HTML, and unreviewed provider shapes',()=>{assert.throws(()=>parseGyo6SchoolCalendar(calendar('<td class="selectDay" id="20261113"></td>','202610'),source),/MONTH_MISMATCH/);assert.throws(()=>parseGyo6SchoolCalendar(calendar('<td class="selectDay" id="20261131"><p data-schdulTitle="bad"></p></td>'),source),/DATE_INVALID/);assert.throws(()=>parseGyo6SchoolCalendar('<!doctype html><h1>Error</h1>',source),/MONTH_MISMATCH/);assert.equal(isGyo6CalendarSource(source.replace('school.gyo6.net','evil.invalid')),false);assert.throws(()=>parseGyo6SchoolCalendar(calendar('<td class="selectDay" id="20261101"></td>'),source.replace('school.gyo6.net','evil.invalid')),/SOURCE_INVALID/)});
test('school source mapping uses verified Gyo6 month parameter and preserves CBE behavior',()=>{const dto={school_id:'gbdhs-test',school_name:'경북드론고등학교',status:'READY',calendar_url:source,allowed_hosts:['school.gyo6.net']};const result=schoolNewsSource('gbdhs-test',dto,'schedule','2026-10');assert.equal(new URL(result.url).searchParams.get('selectYearMonth'),'202610');assert.equal(result.name,'경북드론고등학교');const cbe=schoolNewsSource('gbdhs-test',{...dto,calendar_url:'https://school.cbe.go.kr/cbs-h/M010407/list',allowed_hosts:['school.cbe.go.kr']},'schedule','2026-10');assert.equal(new URL(cbe.url).searchParams.get('y'),'2026');assert.equal(new URL(cbe.url).searchParams.get('m'),'10');assert.throws(()=>schoolNewsSource('other',dto,'schedule','2026-10'),/NOT_CONFIGURED/)});

test('official calendar preserves quotation marks inside double- or single-quoted attributes',()=>{const html=calendar(`<td class="selectDay" id="20261113"><p data-schdulTitle="학교 '토론' 수업"></p><p data-schdulTitle='School &quot;open&quot; day'></p></td>`);assert.deepEqual(parseGyo6SchoolCalendar(html,source).map(i=>i.title),["학교 '토론' 수업",'School "open" day'])});
test('ordinary XML-escaped RSS link separators remain real query parameters',()=>{const result=parseSchoolRSS('<rss><channel><item><title>안내</title><link>https://school.example.org/view?id=1&amp;page=2</link></item></channel></rss>','https://school.example.org/rss');const url=new URL(result[0].link);assert.equal(url.searchParams.get('page'),'2');assert.equal(url.searchParams.has('amp;page'),false)});
