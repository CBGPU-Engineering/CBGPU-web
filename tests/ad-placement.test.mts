import test from 'node:test';
import assert from 'node:assert/strict';
import {adFitEligible,kakaoAdUnits} from '../src/lib/adPlacement.ts';
const base={hostname:'cbgpu.com',path:'/',search:'',audience:'anonymous' as const,placement:'platform' as const,contentReady:true};
test('public browsing expands beyond home without exposing protected or chat pages',()=>{for(const path of ['/','/services','/download','/projects','/projects/11111111-1111-4111-8111-111111111111','/explore/contests','/explore/schools','/explore/services/ai','/explore/services/gpu'])assert.equal(adFitEligible({...base,path}),true,path);for(const path of ['/admin','/admin/accounts','/ai','/ai/chat','/messages','/study','/notes','/server','/deploy','/auth/login','/auth/signup','/schools/new'])assert.equal(adFitEligible({...base,path}),false,path)});
test('settled signed-in public readers retain ads while loading and private routes stay denied',()=>{for(const audience of ['anonymous','authenticated'] as const){for(const path of ['/','/services','/download'])assert.equal(adFitEligible({...base,audience,path}),true);for(const path of ['/ai','/study','/admin','/server','/auth/login'])assert.equal(adFitEligible({...base,audience,path}),false);}assert.equal(adFitEligible({...base,audience:'loading'}),false);assert.equal(adFitEligible({...base,contentReady:false}),false);for(const schoolAdsEnabled of [undefined,false,'true',1,null])assert.equal(adFitEligible({...base,placement:'school',schoolAdsEnabled:schoolAdsEnabled as boolean}),false);assert.equal(adFitEligible({...base,placement:'school',schoolAdsEnabled:true}),true)});
test('internal consoles and unregistered hosts never receive AdFit requests',()=>{for(const hostname of ['admin.cbgpu.com','developers.cbgpu.com','print.cbgpu.com','laser.cbgpu.com','gpu.cbgpu.com','some.front.cbgpu.com','unknown.invalid','localhost'])assert.equal(adFitEligible({...base,hostname}),false,hostname)});
test('provider context cannot include credentials, search terms or arbitrary navigation data',()=>{for(const search of ['?token=private','?code=private','?email=person@example.invalid','?query=school','?mode=student&secret=value','?redirect=/auth'])assert.equal(adFitEligible({...base,search}),false);assert.equal(adFitEligible({...base,search:'?mode=student&page=2'}),true);assert.equal(adFitEligible({...base,hash:'#access_token=private'}),false)});
test('provider-issued units and dimensions stay exact',()=>{assert.deepEqual(kakaoAdUnits,{desktop:{id:'DAN-kVpBmlPRbOvGb6oi',width:728,height:90},mobile:{id:'DAN-vpZNfcj3tj0jMkhV',width:320,height:50}})});

test("native bridge contexts cannot run a web advertising SDK",()=>{assert.equal(adFitEligible({...base,nativeApp:true}),false);assert.equal(adFitEligible({...base,search:"?native=1"}),false)});
