import test from 'node:test';import assert from 'node:assert/strict';import {collectAnnouncementRecipients,resolveAnnouncementEmails} from '../src/lib/contestAnnouncementRecipients.ts';
const rows=Array.from({length:1001},(_,i)=>({id:String(i).padStart(4,'0'),user_id:'synthetic-'+i}));
test('announcement recipients include page 1001 with contiguous stable page boundaries',async()=>{const calls:number[][]=[];const users=await collectAnnouncementRecipients(async(from,to,signal)=>{calls.push([from,to]);assert.equal(signal.aborted,false);return{data:rows.slice(from,to+1),error:null}});assert.equal(users.length,1001);assert.equal(users[1000],'synthetic-1000');assert.deepEqual(calls,[[0,999],[1000,1999]])});
test('later page failures reject the complete collection and never silently return its first thousand',async()=>{await assert.rejects(()=>collectAnnouncementRecipients(async(from,to)=>from?{data:null,error:Error('synthetic failure')}:{data:rows.slice(from,to+1),error:null}),/UNAVAILABLE/)});
test('private email resolution is bounded to four workers and deduplicates addresses',async()=>{let active=0,peak=0;const result=await resolveAnnouncementEmails(rows.slice(0,17).map(r=>r.user_id),async user=>{active++;peak=Math.max(peak,active);await new Promise(r=>setTimeout(r,1));active--;return user==='synthetic-0'?null:'same@example.invalid'});assert.equal(peak,4);assert.deepEqual(result,{emails:['same@example.invalid'],missing:1})});
test('email lookup failure prevents a complete address result and stops additional scheduling',async()=>{let calls=0;await assert.rejects(()=>resolveAnnouncementEmails(rows.map(r=>r.user_id),async()=>{calls++;throw Error('lookup denied')}));assert.ok(calls<=4)});
test('email lookup deadline rejects rather than returning partial completion',async()=>{let calls=0;await assert.rejects(()=>resolveAnnouncementEmails(rows.map(r=>r.user_id),async()=>{calls++;return new Promise(()=>{})},10),/UNAVAILABLE/);assert.equal(calls,4)});
