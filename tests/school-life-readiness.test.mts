import test from'node:test';import assert from'node:assert/strict';import{readFileSync}from'node:fs';import vm from'node:vm';import ts from'typescript';
const exports:Record<string,any>={};vm.runInNewContext(ts.transpileModule(readFileSync(new URL('../src/lib/schoolLifeReadiness.ts',import.meta.url),'utf8'),{compilerOptions:{module:ts.ModuleKind.CommonJS}}).outputText,{exports,URL});const base={school_id:'school-b',status:'READY',school_name:'Synthetic School',region:'충북',version:0,homepage_url:null,news_url:null,letter_url:null,calendar_url:null,meal_url:null,meal_provider:null,allowed_hosts:[],comcigan:{status:'LOOKUP_REQUIRED',school_code:null,school_name:'Synthetic School',region:'충북'}};
test('official catalog meal codes and exact timetable lookup describe configuration, not a successful provider call',()=>{const r=exports.schoolLifeReadiness({...base,official_id:'1234567',education_office_code:'M10',meal_provider:'NEIS'});assert.equal(r.meal.state,'CATALOG_LINKED');assert.equal(r.meal.canOpen,true);assert.equal(r.timetable.state,'EXACT_LOOKUP_REQUIRED');assert.match(r.timetable.detail,/ambiguous matches stop/);assert.doesNotMatch(r.meal.title,/healthy|verified/i);});
test('missing metadata is never labeled ready; disabled features take precedence over old configuration',()=>{assert.equal(exports.schoolLifeReadiness(base).meal.canOpen,false);assert.equal(exports.schoolLifeReadiness({...base,comcigan:{...base.comcigan,status:'NOT_CONFIGURED'}}).timetable.canOpen,false);const r=exports.schoolLifeReadiness({...base,status:'DISABLED',official_id:'1234567',education_office_code:'M10',meal_provider:'NEIS'});assert.equal(r.meal.state,'DISABLED');assert.equal(r.timetable.canOpen,false);});
test('curated website status requires exact approved public host and HTTPS shape',()=>{const source={...base,meal_provider:'SCHOOL_WEBSITE',allowed_hosts:['school.example.edu'],meal_url:'https://school.example.edu/meals'};assert.equal(exports.schoolLifeReadiness(source).meal.state,'CONFIGURED');for(const meal_url of ['http://school.example.edu/meals','https://user:password@school.example.edu/meals','https://school.example.edu:444/meals','https://foreign.example/meals'])assert.equal(exports.schoolLifeReadiness({...source,meal_url}).meal.canOpen,false);});
test('wizard offers common school life and next actions select the account school before fixed local routes',()=>{const wizard=readFileSync(new URL('../src/components/schools/SchoolSetupWizard.tsx',import.meta.url),'utf8');assert.doesNotMatch(wizard,/filter\(feature=>feature\.id!=='school_life'\)/);const action=readFileSync(new URL('../src/components/schools/SchoolLifeReadiness.tsx',import.meta.url),'utf8');assert.match(action,/await selectAccountSchool\(source.school_id,user.id\)/);assert.match(action,/path:'\/meal'/);assert.match(action,/path:'\/timetable'/);assert.doesNotMatch(action,/fetch\(|localStorage|service_role/);});
