try{for(const width of[320,390,1280])for(const dark of[false,true]){
 const page=await browser.newPage({viewport:{width,height:900},reducedMotion:'reduce'});let denied=false;const errors:string[]=[];page.on('pageerror',e=>errors.push(e.message));await page.route('**/*',route=>{const r=route.request(),u=new URL(r.url());assert.equal(u.origin,'https://fixture.local');assert.equal(r.method(),'GET');if(u.pathname==='/')return route.fulfill({contentType:'text/html; charset=utf-8',body:`<html class="${dark?'dark':''}"><meta charset="utf-8"><style>${css}</style><body><div id="root"></div><script src="/fixture.js"></script></body></html>`});if(u.pathname==='/fixture.js')return route.fulfill({contentType:'application/javascript; charset=utf-8',body:script});assert.equal(u.pathname,'/api/admin/careers');return denied?route.fulfill({status:403,json:{error:'합성 서버 내부 오류 문구'}}):route.fulfill({json:{applications:[{id:'synthetic',created:1795402800,role:'frontend',name:'Synthetic applicant',email:'applicant@example.invalid',affiliation:'Synthetic school',motivation:'Synthetic motivation',experience:'Synthetic experience',portfolio:'Synthetic portfolio',status:'received'}]}})});
 await page.goto('https://fixture.local/');await page.getByRole('heading',{name:'Career applications'}).waitFor();await page.getByText('Synthetic applicant',{exact:true}).waitFor();await page.locator('summary').click();await page.getByRole('heading',{name:'Motivation',exact:true}).waitFor();assert.equal(await page.evaluate(()=>document.documentElement.scrollWidth>innerWidth+1),false);await page.screenshot({path:`${shots}/${width}-${dark?'dark':'light'}.png`,fullPage:true});await page.getByRole('textbox',{name:'Search applications'}).fill('no match');await page.getByText('No applications match. Try another name, email, or role.',{exact:true}).waitFor();denied=true;await page.getByRole('button',{name:'Refresh',exact:true}).click();await page.getByRole('alert').waitFor();assert.equal(await page.getByRole('alert').innerText(),'Could not load applications. Refresh and try again.');assert.equal(await page.getByText('합성 서버 내부 오류 문구').count(),0);assert.deepEqual(errors,[]);await page.close();
}console.log(JSON.stringify({actualGlobalCareerInbox:true,widths:[320,390,1280],lightDark:true,englishPreserved:true,noProviderErrorLeak:true,noWrites:true}));}finally{await browser.close()}
