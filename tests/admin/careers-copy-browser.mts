const bundled=await build({stdin:{contents:`import React from'react';import{createRoot}from'react-dom/client';import Careers from'./src/app/admin/careers/page';import'./src/components/admin/developer-shell.css';window.__careerAllowed=true;const root=createRoot(document.getElementById('root'));window.__careerRender=()=>root.render(<main className="admin-developer-shell p-4" data-theme={document.documentElement.classList.contains('dark')?'dark':'light'}><p className="text-sm">LOCAL SYNTHETIC FIXTURE · No real applicants</p><Careers/></main>);window.__careerRender();`,resolveDir:process.cwd(),loader:'tsx'},bundle:true,write:false,outfile:'fixture.js',jsx:'automatic',platform:'browser',define:{'process.env.NODE_ENV':'"production"'},plugins:[{name:'synthetic-auth',setup(b){b.onResolve({filter:/\/(useAuth|supabase)$/},a=>({path:a.path,namespace:'fixture'}));b.onLoad({filter:/.*/,namespace:'fixture'},a=>({loader:'js',contents:a.path.endsWith('useAuth')?`export const useAuth=()=>({isAdmin:window.__careerAllowed,isLoading:false})`:`export const supabase={auth:{getSession:async()=>({data:{session:{access_token:'synthetic-fixture-token'}}})}}`}))}}]});
const script=bundled.outputFiles.find(f=>f.path.endsWith('.js'))!.text,css=(await postcss([tailwind()]).process(fs.readFileSync('src/app/globals.css','utf8'),{from:path.resolve('src/app/globals.css')})).css+'\n'+bundled.outputFiles.filter(f=>f.path.endsWith('.css')).map(f=>f.text).join('\n');const shots=process.env.CBGPU_CAREER_COPY_SCREENSHOTS||'/tmp/cbgpu-ux-domain-proof/global-careers';fs.mkdirSync(shots,{recursive:true});
