import test from'node:test';import assert from'node:assert/strict';import fs from'node:fs';import vm from'node:vm';import ts from'typescript';
const code=ts.transpileModule(fs.readFileSync(new URL('../src/lib/schoolsClient.ts',import.meta.url),'utf8'),{compilerOptions:{module:ts.ModuleKind.CommonJS,target:ts.ScriptTarget.ES2022}}).outputText;
test('an account change during session acquisition never submits the previous resource selection as another user',async()=>{let writes=0;const exports:any={};vm.runInNewContext(code,{exports,process:{env:{NEXT_PUBLIC_CBGPU_MULTISCHOOL_V1:'1'}},fetch:async()=>{writes++;return Response.json({ok:true})},require(name){if(name==='@/lib/supabase')return{supabase:{auth:{getSession:async()=>({data:{session:{user:{id:'new-owner'},access_token:'new-owner-token'}}})}}};throw Error(name)}});await assert.rejects(()=>exports.schoolsRequest('current-school','POST',{school_id:'old-school'},false,'old-owner'),/계정이 바뀌었어요/);assert.equal(writes,0);await exports.schoolsRequest('current-school','POST',{school_id:'new-school'},false,'new-owner');assert.equal(writes,1);});
