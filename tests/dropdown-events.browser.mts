/** Actual Dropdown/Radix form integration. Synthetic options only; no network or account state. */
import{build}from'esbuild';import postcss from'postcss';import tailwind from'@tailwindcss/postcss';import fs from'node:fs';import path from'node:path';import assert from'node:assert/strict';import{chromium}from'playwright';
const fixture=`import React,{useState}from'react';import{createRoot}from'react-dom/client';import{Dropdown}from'./src/components/ui/dropdown';window.__changes=[];window.__nativeChanges=[];function App(){const[school,setSchool]=useState('teacher-only'),[kind,setKind]=useState('TEACHER'),[empty,setEmpty]=useState('alpha'),[disabled,setDisabled]=useState(false);return <main className="p-5 space-y-5 max-w-xl"><form onSubmit={e=>e.preventDefault()} onChange={e=>{if(e.target instanceof HTMLSelectElement)window.__nativeChanges.push({name:e.target.name,value:e.target.value})}} className="space-y-5"><button type="button" onClick={()=>{setSchool('cbsh');setKind('STUDENT')}}>합성 학교 전환</button><label className="block">학교 구성원 유형<Dropdown id="kind" name="kind" aria-label="학교 구성원 유형" value={kind} onChange={e=>{window.__changes.push({name:'kind',value:e.target.value});setKind(e.target.value)}}>{school==='teacher-only'?<option value="TEACHER">교사</option>:<><option value="STUDENT">학생</option><option value="TEACHER">교사</option><option value="ALUMNI" disabled>졸업생 (선택 불가)</option><option value="">선택 안 함</option></>}</Dropdown></label><output data-kind>{kind||'(empty)'}</output><label className="block">범위<Dropdown id="scope" name="scope" aria-label="범위" value={empty} disabled={disabled} onChange={e=>{window.__changes.push({name:'scope',value:e.target.value});setEmpty(e.target.value)}}><option value="">모든 항목</option><option value="alpha">활성 항목</option><option value="blocked" disabled>사용 불가</option></Dropdown></label><output data-scope>{empty||'(empty)'}</output><button type="button" onClick={()=>setDisabled(value=>!value)}>전체 비활성 전환</button></form></main>}createRoot(document.getElementById('root')).render(<App/>);`;
const built=await build({stdin:{contents:fixture,resolveDir:process.cwd(),loader:'tsx'},bundle:true,write:false,outfile:'dropdown-fixture.js',platform:'browser',jsx:'automatic',define:{'process.env.NODE_ENV':'"production"','process.env':'{}'}}),js=built.outputFiles.find(f=>f.path.endsWith('.js'))!.text,css=(await postcss([tailwind()]).process(fs.readFileSync('src/app/globals.css','utf8'),{from:path.resolve('src/app/globals.css')})).css;
const out=process.env.CBGPU_DROPDOWN_PROOF_DIR||'/tmp/cbgpu-dropdown-events';fs.mkdirSync(out,{recursive:true});
const browser=await chromium.launch({headless:true,...(process.env.CBGPU_BROWSER_EXECUTABLE?{executablePath:process.env.CBGPU_BROWSER_EXECUTABLE}:{}),args:['--no-sandbox','--disable-dev-shm-usage']});
try{for(const config of[{width:390,dark:false,app:false},{width:390,dark:true,app:false},{width:1280,dark:false,app:false},{width:1280,dark:true,app:false},{width:393,dark:true,app:true}]){
 const context=await browser.newContext({viewport:{width:config.width,height:900},colorScheme:config.dark?'dark':'light',reducedMotion:'reduce',...(config.app?{userAgent:'Mozilla/5.0 (Linux; Android 14; wv) AppleWebKit/537.36 Version/4.0 Chrome/131.0.0.0 Mobile Safari/537.36'}:{})}),page=await context.newPage(),errors:string[]=[];page.on('pageerror',e=>errors.push(e.message));await page.route('**/*',r=>{const u=new URL(r.request().url());assert.equal(u.origin,'https://fixture.local');if(u.pathname==='/')return r.fulfill({contentType:'text/html',body:`<html class="${config.dark?'dark':''}"><meta charset="utf-8"><style>${css}</style><body><div id="root"></div><script src="/fixture.js"></script></body></html>`});if(u.pathname==='/fixture.js')return r.fulfill({contentType:'application/javascript',body:js});throw Error('Network forbidden')});
 await page.goto('https://fixture.local/');await page.getByRole('combobox',{name:'학교 구성원 유형',exact:true}).waitFor();await page.getByRole('button',{name:'합성 학교 전환',exact:true}).click();await page.waitForTimeout(180);const dynamic=await page.evaluate(()=>({changes:(window as any).__changes,native:(window as any).__nativeChanges,value:document.querySelector('[data-kind]')?.textContent}));fs.writeFileSync(out+'/dynamic-observation.json',JSON.stringify(dynamic,null,2));await page.screenshot({path:`${out}/${config.width}-${config.dark?'dark':'light'}-${config.app?'app':'web'}-dynamic.png`,fullPage:true});assert.equal(dynamic.value,'STUDENT','Hidden native empty event replaced the parent-selected dynamic value');assert.equal(dynamic.changes.some((e:any)=>e.name==='kind'&&e.value===''),false);
 // Native bridge events can be stale or disabled; these are not list selections.
 const nativeChange=async(value:string,append=false)=>page.locator('select[name="scope"]').evaluate((select:HTMLSelectElement,{value,append})=>{if(append)select.add(new Option('Removed stale item',value));Object.getOwnPropertyDescriptor(HTMLSelectElement.prototype,'value')!.set!.call(select,value);select.dispatchEvent(new Event('change',{bubbles:true}));},{value,append});
 const count=await page.evaluate(()=>(window as any).__changes.length);await nativeChange('blocked');await page.waitForTimeout(50);assert.equal(await page.locator('[data-scope]').innerText(),'alpha');assert.equal(await page.evaluate(()=>(window as any).__changes.length),count,'Disabled option reached callback');await nativeChange('removed',true);await page.waitForTimeout(50);assert.equal(await page.locator('[data-scope]').innerText(),'alpha');assert.equal(await page.evaluate(()=>(window as any).__changes.length),count,'Removed option reached callback');
 // An explicit empty option still uses its encoded sentinel and decodes to ''.
 await page.getByRole('combobox',{name:'범위',exact:true}).click();await page.getByRole('option',{name:'모든 항목',exact:true}).click();await page.waitForTimeout(50);assert.equal(await page.locator('[data-scope]').innerText(),'(empty)');assert.equal(await page.locator('select[name="scope"]').inputValue(),'__empty__');assert.equal(await page.evaluate(()=>(window as any).__changes.some((e:any)=>e.name==='scope'&&e.value==='')),true);
 await page.getByRole('combobox',{name:'범위',exact:true}).focus();await page.keyboard.press('ArrowDown');await page.getByRole('option',{name:'활성 항목',exact:true}).press('Enter');await page.waitForTimeout(50);assert.equal(await page.locator('[data-scope]').innerText(),'alpha');
 await page.getByRole('button',{name:'전체 비활성 전환',exact:true}).click();const disabledCount=await page.evaluate(()=>(window as any).__changes.length);await nativeChange('__empty__');await page.waitForTimeout(50);assert.equal(await page.locator('[data-scope]').innerText(),'alpha');assert.equal(await page.evaluate(()=>(window as any).__changes.length),disabledCount);assert.equal(await page.getByRole('combobox',{name:'범위',exact:true}).isDisabled(),true);
 assert.deepEqual(errors,[]);assert.equal(await page.evaluate(()=>document.documentElement.scrollWidth>innerWidth),false);console.log(JSON.stringify({...config,dynamicValueRetained:true,invalidAndDisabledIgnored:true,explicitEmptySupported:true,keyboardSupported:true}));await context.close();
}}finally{await browser.close()}
