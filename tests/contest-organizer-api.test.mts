import test from 'node:test';
import assert from 'node:assert/strict';
import {build} from 'esbuild';
import vm from 'node:vm';
const event='10000000-0000-4000-8000-000000000001',entry='20000000-0000-4000-8000-000000000001';
const bundles=await Promise.all(['registrations','announce'].map(async route=>(await build({entryPoints:[new URL(`../src/app/api/contests/[id]/${route}/route.ts`,import.meta.url).pathname],bundle:true,platform:'node',format:'cjs',write:false,plugins:[{name:'isolated-contest-dependencies',setup(b){b.onResolve({filter:/^@supabase\/supabase-js$/},()=>({path:'auth',namespace:'fixture'}));b.onResolve({filter:/^resend$/},()=>({path:'mail',namespace:'fixture'}));b.onResolve({filter:/^@\/lib\/email$/},()=>({path:'email',namespace:'fixture'}));b.onLoad({filter:/.*/,namespace:'fixture'},a=>({contents:a.path==='auth'?'export const createClient=()=>globalThis.__fixture.client;':a.path==='email'?"export const emailSender=()=> 'test@example.invalid';export const SITE_URL='https://cbgpu.com';export const renderEmail=()=> 'synthetic template';":"export class Resend {batch={send:async()=>globalThis.__fixture.mail()}}",loader:'js'}))}}]})).outputFiles[0].text));
type Options={role?:string;owner?:boolean;invalid?:boolean;deleted?:boolean;authFailure?:boolean;authorityFailure?:boolean;mailThrow?:boolean;dbFailure?:boolean};
function fixture(route:0|1,options:Options={}){
 const calls={writes:0,recipients:0,mail:0,auth:0};
 const query=(table:string)=>{const q:any={select(){return q},eq(){return q},in(){return q},not(){return q},update(){calls.writes++;return q},insert(){calls.writes++;return q},maybeSingle:async()=>({data:table==='contests'?{id:event,title:'Fixture',host_id:options.owner?'actor':'owner'}:options.role?{role:options.role}:null,error:options.authorityFailure?Error('private database details'):null}),then(resolve:any){resolve({data:table==='event_registrations'?[{user_id:'recipient'}]:null,error:options.dbFailure?Error('private database details'):null})}};return q};
 const client={auth:{getUser:async()=>{calls.auth++;if(options.authFailure)throw Error('private auth error');return{data:{user:options.invalid?null:{id:'actor',...(options.deleted?{deleted_at:'2026-11-18'}:{})}},error:null}},admin:{getUserById:async()=>{calls.recipients++;if(options.mailThrow)throw Error('private mail error');return{data:{user:{email:'recipient@example.invalid'}}}}}},from:query};
 const module={exports:{}}as{exports:any};
 vm.runInNewContext(bundles[route],{module,exports:module.exports,Response,Request,Headers,URL,AbortSignal,TextDecoder,Uint8Array,Set,Map,process:{env:{NEXT_PUBLIC_SUPABASE_URL:'https://auth.example.invalid',NEXT_PUBLIC_SUPABASE_ANON_KEY:'synthetic-public',SUPABASE_SERVICE_ROLE_KEY:'synthetic-private',RESEND_API_KEY:'synthetic-mail'}},__fixture:{client,mail:()=>{calls.mail++;return{error:null}}},fetch:()=>{throw Error('Real network forbidden')}});
 const send=(body:unknown,token='Bearer synthetic-token')=>module.exports[route===0?'PATCH':'POST'](new Request(`https://cbgpu.com/api/contests/${event}/${route===0?'registrations':'announce'}`,{method:route===0?'PATCH':'POST',headers:token?{authorization:token}:{},body:JSON.stringify(body)}),{params:Promise.resolve({id:event})}) as Promise<Response>;
 return{calls,send};
}
const bodies=[{ids:[entry],status:'confirmed'},{title:'공지',content:'안내 내용',audience:'all'}];
function privateResponse(r:Response){assert.equal(r.headers.get('cache-control'),'private, no-store')}
test('missing, malformed, invalid and deleted callers cannot mutate or resolve email addresses',async()=>{for(const route of[0,1]as const)for(const kind of['missing','malformed','invalid','deleted']as const){const f=fixture(route,{invalid:kind==='invalid',deleted:kind==='deleted'}),r=await f.send(bodies[route],kind==='missing'?'':kind==='malformed'?'synthetic-token':undefined);assert.equal(r.status,401);privateResponse(r);assert.equal(f.calls.writes,0);assert.equal(f.calls.recipients,0)}});
test('participants, another contest host and checkin-only staff cannot perform organizer mutations',async()=>{for(const route of[0,1]as const)for(const role of[undefined,'checkin','owner']){const f=fixture(route,{role}),r=await f.send(bodies[route]);assert.equal(r.status,403);privateResponse(r);assert.equal(f.calls.writes,0);assert.equal(f.calls.recipients,0)}});
test('owner and actual contest manager can perform existing operations',async()=>{for(const route of[0,1]as const)for(const actor of[{owner:true},{role:'manager'}]){const f=fixture(route,actor),r=await f.send(bodies[route]);assert.equal(r.status,200);privateResponse(r);assert.equal(f.calls.writes,1);assert.equal(f.calls.mail,1)}});
test('unavailable auth or authority fails closed without internal diagnostics',async()=>{for(const route of[0,1]as const)for(const options of[{authFailure:true},{authorityFailure:true}]){const f=fixture(route,{owner:true,...options}),r=await f.send(bodies[route]);assert.equal(r.status,503);privateResponse(r);assert.equal(f.calls.writes,0);assert.equal(JSON.stringify(await r.json()).includes('private'),false)}});
test('null, array and oversized JSON fail before mutations',async()=>{for(const route of[0,1]as const)for(const body of[null,[],{content:'x'.repeat(65536)}]){const f=fixture(route,{owner:true}),r=await f.send(body);assert.equal(r.status,body&&'content'in body?413:400);privateResponse(r);assert.equal(f.calls.writes,0)}});
test('invalid status, prototype status, invalid IDs and overlarge batches are rejected rather than truncated',async()=>{for(const body of[{ids:[entry],status:'constructor'},{ids:['forged'],status:'confirmed'},{ids:Array.from({length:201},(_,i)=>`${i.toString(16).padStart(8,'0')}-0000-4000-8000-000000000001`),status:'confirmed'}]){const f=fixture(0,{owner:true}),r=await f.send(body);assert.equal(r.status,400);assert.equal(f.calls.writes,0)}});
test('email transport failure after a successful mutation returns saved state and recovery warning',async()=>{for(const route of[0,1]as const){const f=fixture(route,{owner:true,mailThrow:true}),r=await f.send(bodies[route]);assert.equal(r.status,200);privateResponse(r);const body=await r.json();assert.equal(body.ok,true);assert.equal(typeof body.warning,'string');assert.equal(JSON.stringify(body).includes('private mail error'),false);assert.equal(f.calls.writes,1)}});
test('invalid announcement audiences cannot accidentally broadcast to everyone',async()=>{const f=fixture(1,{owner:true}),r=await f.send({...bodies[1],audience:'not-a-status'});assert.equal(r.status,400);assert.equal(f.calls.writes,0);assert.equal(f.calls.mail,0)});
test('database errors never trigger recipient lookup or leak private diagnostics',async()=>{for(const route of[0,1]as const){const f=fixture(route,{owner:true,dbFailure:true}),r=await f.send(bodies[route]);assert.equal(r.status,route===0?403:500);assert.equal(f.calls.recipients,0);assert.equal(f.calls.mail,0);assert.equal(JSON.stringify(await r.json()).includes('private database details'),false)}});
