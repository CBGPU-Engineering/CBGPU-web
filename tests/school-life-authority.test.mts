import test from'node:test';import assert from'node:assert/strict';import fs from'node:fs';import vm from'node:vm';import ts from'typescript';
import{schoolLifeAuthorityJson}from'../src/lib/schoolLifeAuthority.ts';import*as meal from'../src/lib/schoolMeal.ts';import{trustedInternalServiceUrl}from'../src/lib/internalServiceUrl.ts';
test('school authority accepts JSON only and never reads proxy HTML or redirects',async()=>{assert.deepEqual(await schoolLifeAuthorityJson(Response.json({school_id:'a'})),{school_id:'a'});for(const response of[new Response('<!DOCTYPE html>'),new Response('{}',{headers:{'content-type':'text/html'}}),Response.json({},{status:503})])await assert.rejects(schoolLifeAuthorityJson(response));const redirected=Response.json({});Object.defineProperty(redirected,'redirected',{value:true});await assert.rejects(schoolLifeAuthorityJson(redirected));await assert.rejects(schoolLifeAuthorityJson(new Response('{broken',{headers:{'content-type':'application/json'}})))});
test('school authority cancels oversized streams before buffering the remaining body',async()=>{let cancelled=false;const stream=new ReadableStream({pull(controller){controller.enqueue(new Uint8Array(32769))},cancel(){cancelled=true}});await assert.rejects(schoolLifeAuthorityJson(new Response(stream,{headers:{'content-type':'application/json'}})),/BODY_TOO_LARGE/);assert.equal(cancelled,true)});
const code=ts.transpileModule(fs.readFileSync(new URL('../src/app/api/meal/route.ts',import.meta.url),'utf8'),{compilerOptions:{module:ts.ModuleKind.CommonJS,target:ts.ScriptTarget.ES2022}}).outputText;
function fixture(response:()=>Response|Promise<Response>){let providerCalls=0;const exports:any={};vm.runInNewContext(code,{exports,URL,URLSearchParams,Date,AbortSignal,process:{env:{CBGPU_MULTISCHOOL_V1:'1'}},fetch:async(_url:URL,options:any)=>{assert.equal(options.redirect,'error');assert.equal(options.headers.Authorization,'Bearer synthetic');return response()},require(name:string){if(name==='next/server')return{NextResponse:{json:(body:unknown,options:any)=>Response.json(body,options)}};if(name==='@/lib/schoolLifeAuthority')return{schoolLifeAuthorityJson};if(name==='@/lib/schoolMeal')return meal;if(name==='@/lib/internalServiceUrl')return{trustedInternalServiceUrl};if(name==='@/lib/publicSchoolFetch')return{publicSchoolText:async()=>{providerCalls++;return JSON.stringify({RESULT:{CODE:'INFO-200'}})}};throw Error(name)}});return{get:(auth=true)=>exports.GET({nextUrl:new URL('https://cbgpu.com/api/meal?school_id=school-b&date=20261118'),headers:new Headers(auth?{Authorization:'Bearer synthetic'}:{})}),calls:()=>providerCalls}}
test('meal authority outages are retryable503, not false school configuration409',async()=>{for(const response of[()=>new Response('<!DOCTYPE html>',{headers:{'Content-Type':'text/html'}}),()=>new Response('{broken',{headers:{'Content-Type':'application/json'}}),()=>{throw Error('network unavailable')}]){const app=fixture(response),r=await app.get();assert.equal(r.status,503);assert.equal((await r.json()).code,'SCHOOL_AUTHORITY_UNAVAILABLE');assert.equal(app.calls(),0)}});
test('meal preserves exact school scope and distinct authentication/configuration states',async()=>{for(const status of[401,403]){const app=fixture(()=>Response.json({error:'denied'},{status}));assert.equal((await app.get()).status,status);assert.equal(app.calls(),0)}for(const dto of[{school_id:'school-b',status:'UNCONFIGURED'},{school_id:'another-school',status:'READY',meal_provider:'NEIS',official_id:'1234567',education_office_code:'M10'}]){const app=fixture(()=>Response.json(dto));assert.equal((await app.get()).status,409);assert.equal(app.calls(),0)}const app=fixture(()=>Response.json({school_id:'school-b',status:'READY',meal_provider:'NEIS',official_id:'1234567',education_office_code:'M10'}));assert.equal((await app.get(false)).status,401);assert.equal(app.calls(),0);assert.equal((await app.get()).status,200);assert.equal(app.calls(),1)});
