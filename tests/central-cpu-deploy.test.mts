import test from'node:test';import assert from'node:assert/strict';import{centralCPUEnabled,deploymentActorSession,selectedCentralAllocation}from'../src/lib/centralCpuDeploy.ts';
test('central CPU feature is default-off and actor session is explicit rather than device or CBsh fallback',()=>{assert.equal(centralCPUEnabled({}),false);assert.equal(centralCPUEnabled({CBGPU_CENTRAL_CPU_V1:'true'}),true);assert.throws(()=>centralCPUEnabled({CBGPU_CENTRAL_CPU_V1:'yes'}));assert.throws(()=>deploymentActorSession(new Request('https://cbgpu.com')));const session='11111111-1111-4111-8111-111111111111',token='a.'+Buffer.from(JSON.stringify({session_id:session})).toString('base64url')+'.s';assert.equal(deploymentActorSession(new Request('https://cbgpu.com',{headers:{Authorization:'Bearer '+token}})),session)});
test('fresh server preference and grant must match confirmed target; revocation has no CBsh fallback',async()=>{const oldFetch=globalThis.fetch,old=process.env.CBGPU_CENTRAL_CPU_V1;process.env.CBGPU_CENTRAL_CPU_V1='1';let selected='school-b',allowed=true,calls=0;try{globalThis.fetch=async(input:any,options:any)=>{calls++;assert.equal(String(input),'http://127.0.0.1:3546/v1/central-cpu-access?purpose=frontend');assert.equal(options.headers.Authorization,'Bearer fixture');assert.equal(options.cache,'no-store');assert.equal(options.redirect,'error');return Response.json({school_id:selected,allowed})};const req=new Request('https://cbgpu.com',{headers:{Authorization:'Bearer fixture'}});assert.equal(await selectedCentralAllocation(req,'school-b','frontend'),'school-b');selected='cbsh';await assert.rejects(selectedCentralAllocation(req,'school-b','frontend'));selected='school-b';allowed=false;await assert.rejects(selectedCentralAllocation(req,'school-b','frontend'));assert.equal(calls,3);await assert.rejects(selectedCentralAllocation(new Request('https://cbgpu.com'),'school-b','frontend'));assert.equal(calls,3)}finally{globalThis.fetch=oldFetch;if(old===undefined)delete process.env.CBGPU_CENTRAL_CPU_V1;else process.env.CBGPU_CENTRAL_CPU_V1=old}});
