/** Real Next public download route; all API and external requests intercepted, APK never fetched. */
import {chromium}from'playwright';import{request as httpRequest}from'node:http';import fs from'node:fs/promises';import assert from'node:assert/strict';
const port=Number(process.env.CBGPU_UX_PREVIEW_PORT||13977),out=process.env.CBGPU_DOWNLOAD_COPY_SCREENSHOTS||'/tmp/cbgpu-ux-domain-proof/download';await fs.mkdir(out,{recursive:true});
const browser=await chromium.launch({executablePath:process.env.CBGPU_CHROMIUM||undefined,args:['--no-sandbox','--disable-dev-shm-usage']});
try{for(const width of[320,390,1280])for(const dark of[false,true]){
 const page=await browser.newPage({viewport:{width,height:950},colorScheme:dark?'dark':'light',reducedMotion:'reduce'});let realWrites=0,apkRequests=0;
 await page.route('**/*',async route=>{const r=route.request(),u=new URL(r.url());if(u.hostname!=='cbgpu.com')return route.abort();if(u.pathname==='/api/traffic')return route.fulfill({status:204});if(u.pathname.startsWith('/downloads/')){apkRequests++;return route.abort()};if(u.pathname==='/api/app-release')return route.fulfill({json:{version:'1.2.3',buildNumber:999,notes:'Synthetic fixture'}});if(u.pathname==='/api/auth/shared-session')return route.fulfill({json:{value:null,state:'empty'}});if(u.pathname.startsWith('/api/')||u.pathname.startsWith('/backend/')){if(!['GET','HEAD'].includes(r.method()))realWrites++;return route.fulfill({status:403,json:{error:'Synthetic denied'}})}assert.equal(r.method(),'GET');const headers:Record<string,string>={host:'cbgpu.com','x-cbgpu-public-host':'cbgpu.com','x-forwarded-proto':'https','accept-encoding':'identity'};for(const key of['accept','user-agent','rsc','next-router-state-tree','next-url','next-router-prefetch'])if(r.headers()[key])headers[key]=r.headers()[key];const result=await new Promise<{status:number;headers:Record<string,string>;body:Buffer}>((resolve,reject)=>{const q=httpRequest({hostname:'127.0.0.1',port,path:u.pathname+u.search,headers},res=>{const chunks:Buffer[]=[];res.on('data',c=>chunks.push(Buffer.from(c)));res.on('end',()=>resolve({status:res.statusCode||502,headers:Object.fromEntries(Object.entries(res.headers).filter(([key])=>!['content-length','transfer-encoding'].includes(key)).map(([key,v])=>[key,Array.isArray(v)?v.join(','):v||''])),body:Buffer.concat(chunks)}))});q.on('error',reject);q.end()});return route.fulfill(result)});
 await page.goto('https://cbgpu.com/download');await page.getByText('학교마다 제공하는 기능과 이용 권한이 달라요.',{exact:true}).waitFor();assert.equal(await page.getByText('충북과학고등학교 학생 전용 서비스입니다.',{exact:true}).count(),0);await page.locator('a[href="/downloads/cbgpu.apk?build=999"]').waitFor();assert.equal(await page.locator('a[href="/downloads/cbgpu.apk?build=999"]').count(),1);assert.equal(await page.evaluate(()=>document.documentElement.scrollWidth>innerWidth+1),false);await page.evaluate(()=>{const p=document.createElement('p');p.textContent='LOCAL SYNTHETIC RELEASE · No APK downloaded';p.style.cssText='position:fixed;bottom:8px;right:8px;z-index:99999;background:#eee;color:#111;padding:8px;font-size:14px';document.body.append(p)});await page.screenshot({path:`${out}/${width}-${dark?'dark':'light'}.png`,fullPage:true});assert.equal(realWrites,0);assert.equal(apkRequests,0);await page.close();
}console.log(JSON.stringify({realNextDownload:true,widths:[320,390,1280],lightDark:true,notCbshOnlyClaim:true,releaseLinkOnly:true,noAPKFetch:true,noRealWrites:true}));}finally{await browser.close()}
