import test from'node:test';import assert from'node:assert/strict';import fs from'node:fs/promises';import path from'node:path';import os from'node:os';import{createHash}from'node:crypto';import{publicGpuInstallerManifest,gpuSetupArtifactDownload}from'../src/lib/gpuAgentArtifacts.ts';
const prior={...process.env},dir=await fs.mkdtemp(path.join(os.tmpdir(),'cbgpu-gui-artifacts-')),rev='a'.repeat(40),setupRev='b'.repeat(40),node=path.join(dir,'node'),gui=path.join(dir,'gui'),manifest=path.join(dir,'manifest');test.after(async()=>{process.env=prior;await fs.rm(dir,{recursive:true,force:true})});const data=Buffer.from('synthetic-setup-artifact'),sha=createHash('sha256').update(data).digest('hex');await fs.writeFile(node,data);await fs.writeFile(gui,data);const m={version:1,current:rev,releases:[{revision:rev,artifacts:[{platform:'linux-x86_64',filename:'cbgpu-node-linux-x86_64',path:node,sha256:sha,size:data.length}]}],setup_current:setupRev,setup_releases:[{revision:setupRev,artifacts:[{platform:'linux-x86_64',filename:'CBGPU-GPU-Setup-x86_64.AppImage',path:gui,sha256:sha,size:data.length}]}]};await fs.writeFile(manifest,JSON.stringify(m),{mode:0o600});process.env.CBGPU_GPU_AGENT_MANIFEST=manifest;
test('GUI downloads publish only verified metadata and immutable public bytes',async()=>{const dto=await publicGpuInstallerManifest();assert.equal(dto.revision,rev);assert.equal(dto.setup_revision,setupRev);assert.equal(dto.setup_artifacts[0].url,'https://cbgpu.com/api/compute/setup-downloads/'+setupRev+'/CBGPU-GPU-Setup-x86_64.AppImage');assert.ok(!JSON.stringify(dto).includes(dir));const response=await gpuSetupArtifactDownload(setupRev,'CBGPU-GPU-Setup-x86_64.AppImage');assert.ok(response);assert.equal(response.headers.get('x-content-sha256'),sha);assert.equal(response.headers.get('cache-control'),'public, max-age=31536000, immutable');assert.deepEqual(Buffer.from(await response.arrayBuffer()),data);assert.equal(await gpuSetupArtifactDownload(setupRev,'../../private'),null);assert.equal(await gpuSetupArtifactDownload(rev,'CBGPU-GPU-Setup-x86_64.exe'),null)});
test('platform/name confusion, malformed paths and changed executable bytes fail closed',async()=>{const bad=structuredClone(m);bad.setup_releases[0].artifacts[0].platform='windows-x86_64';await fs.writeFile(manifest,JSON.stringify(bad));await assert.rejects(()=>publicGpuInstallerManifest());bad.setup_releases[0].artifacts[0].platform='linux-x86_64';bad.setup_releases[0].artifacts[0].path='../private';await fs.writeFile(manifest,JSON.stringify(bad));await assert.rejects(()=>publicGpuInstallerManifest());await fs.writeFile(manifest,JSON.stringify(m));await fs.writeFile(gui,'different-size-content');await assert.rejects(()=>gpuSetupArtifactDownload(setupRev,'CBGPU-GPU-Setup-x86_64.AppImage'))});
