import test from'node:test';import assert from'node:assert/strict';import{mkdtemp,writeFile,rm}from'node:fs/promises';import{tmpdir}from'node:os';import{join}from'node:path';import{notebookBootstrap}from'../src/lib/notebookBootstrap.ts';import{notebookEdgeAllowed}from'../src/lib/notebookEdge.ts';
const saved={...process.env},job='11111111-1111-4111-8111-111111111111';const dir=await mkdtemp(join(tmpdir(),'cbgpu-notebook-test-'));const key='a'.repeat(64);await writeFile(join(dir,'key'),key,{mode:0o600});test.after(async()=>{process.env=saved;await rm(dir,{recursive:true,force:true})});
function req(origin='https://cbgpu.com',auth='Bearer synthetic'){return new Request('https://cbgpu.com/api/compute/notebooks/'+job+'/bootstrap',{method:'POST',headers:{host:'cbgpu.com',origin,authorization:auth,'content-type':'application/json',cookie:'cbgpu-private-never-forward'},body:'{}'})}
test('untrusted parent, missing account and disabled feature never reach private authority',async()=>{let calls=0;const send=(async()=>{calls++;return Response.json({})})as typeof fetch;assert.equal((await notebookBootstrap(req('https://other.front.cbgpu.com'),job,send)).status,403);assert.equal((await notebookBootstrap(req('https://cbgpu.com',''),job,send)).status,401);process.env.CBGPU_GPU_NOTEBOOKS_ENABLED='0';assert.equal((await notebookBootstrap(req(),job,send)).status,503);assert.equal(calls,0)});
test('fresh owner job session exchanged privately, only one-use bootstrap reaches client',async()=>{process.env.CBGPU_GPU_REGISTRY_ENABLED='1';process.env.CBGPU_GPU_NOTEBOOKS_ENABLED='1';process.env.CBGPU_NOTEBOOK_BOOTSTRAP_KEY_FILE=join(dir,'key');const token='b'.repeat(64),code='c'.repeat(64);let calls=0;const send=(async(url:any,options:any)=>{calls++;assert.equal(options.headers.cookie,undefined);assert.equal(options.redirect,'error');if(calls===1){assert.equal(String(url),'http://127.0.0.1:3548/v1/gpu/notebooks/'+job+'/session');assert.equal(options.headers.Authorization,'Bearer synthetic');return Response.json({job_id:job,cookie_token:token})}assert.equal(String(url),'http://127.0.0.1:3557/internal/bootstrap');assert.equal(options.headers.Authorization,'Bearer '+key);assert.deepEqual(JSON.parse(options.body),{job_id:job,cookie_token:token,parent_origin:'https://cbgpu.com'});return Response.json({bootstrap_token:code,expires_at:Math.floor(Date.now()/1000)+60,notebook_origin:'https://notebooks.cbgpu.com'})})as typeof fetch;const response=await notebookBootstrap(req(),job,send);assert.equal(response.status,200);const text=await response.text();assert.ok(text.includes(code));assert.ok(!text.includes(token));assert.ok(!text.includes(key));assert.equal(response.headers.get('set-cookie'),null);assert.equal(response.headers.get('cache-control'),'private, no-store')});
test('foreign job and downstream outage cannot mint a notebook bootstrap',async()=>{let calls=0;let response=await notebookBootstrap(req(),job,(async()=>{calls++;return Response.json({error:'denied'},{status:403})})as typeof fetch);assert.equal(response.status,403);assert.equal(calls,1);response=await notebookBootstrap(req(),job,(async()=>Response.json({job_id:'other',cookie_token:'d'.repeat(64)}))as typeof fetch);assert.equal(response.status,503)});
test('isolated edge proof requires private regular file and exact secret, never a browser Host',async()=>{process.env.CBGPU_NOTEBOOK_EDGE_KEY_FILE=join(dir,'key');assert.equal(notebookEdgeAllowed(key),true);assert.equal(notebookEdgeAllowed('cbgpu.com'),false);assert.equal(notebookEdgeAllowed('d'.repeat(64)),false);assert.equal(notebookEdgeAllowed(null),false);await writeFile(join(dir,'public-key'),key,{mode:0o644});process.env.CBGPU_NOTEBOOK_EDGE_KEY_FILE=join(dir,'public-key');assert.equal(notebookEdgeAllowed(key),false)});
