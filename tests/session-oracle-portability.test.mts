import test from'node:test';import assert from'node:assert/strict';import vm from'node:vm';import fs from'node:fs';import ts from'typescript';import{boundedSchoolBody}from'../src/lib/schoolsProxySecurity.ts';import{trustedInternalServiceUrl}from'../src/lib/internalServiceUrl.ts';
const uid='11111111-1111-4111-8111-111111111111',sid='22222222-2222-4222-8222-222222222222';
const token='header.'+Buffer.from(JSON.stringify({sub:uid,session_id:sid})).toString('base64url')+'.signature';
const request=new Request('https://app.cbgpu.com/api/private',{headers:{Authorization:'Bearer '+token}});
function fixture(env:Record<string,string>={}){let docker=0,calls=0,valid=true,status=200;const exports:any={};vm.runInNewContext(ts.transpileModule(fs.readFileSync(new URL('../src/lib/deployAuth.ts',import.meta.url),'utf8'),{compilerOptions:{module:ts.ModuleKind.CommonJS,target:ts.ScriptTarget.ES2022}}).outputText,{exports,URL,Buffer,AbortSignal,process:{env:{NEXT_PUBLIC_SUPABASE_ANON_KEY:'public',...env}},fetch:async(url:URL,options:any)=>{calls++;assert.equal(url.pathname,'/rest/v1/rpc/cbgpu_self_session_status');assert.equal(options.headers.Authorization,'Bearer '+token);assert.equal(options.headers.apikey,'public');assert.equal(options.body,'{}');assert.equal(options.redirect,'error');assert.equal(options.cache,'no-store');return Response.json({valid,approved:false},{status})},require:(name:string)=>{if(name==='server-only')return{};if(name==='node:child_process')return{execFile:async()=>{docker++;return{stdout:'t'}}};if(name==='node:util')return{promisify:(fn:any)=>fn};if(name==='./schoolsProxySecurity')return{boundedSchoolBody};if(name==='./internalServiceUrl')return{trustedInternalServiceUrl};throw Error(name)}});return{check:(id=uid)=>exports.activeDeploymentSession(request,id),revoke:()=>valid=false,fail:(value:number)=>status=value,counts:()=>({docker,calls})}}
test('portable caller-bound session oracle is fresh and independent of school approval',async()=>{const f=fixture({CBGPU_SESSION_ORACLE_MODE:'rpc',SUPABASE_INTERNAL_URL:'https://kong.internal',CBGPU_INTERNAL_NETWORK_MODE:'private-container'});assert.equal(await f.check(),true);f.revoke();assert.equal(await f.check(),false);assert.deepEqual(f.counts(),{docker:0,calls:2});assert.equal(await f.check(sid),false);assert.equal(f.counts().calls,2)});
test('scoped mode cannot fall back to Docker after missing or failed RPC',async()=>{for(const status of [404,500]){const f=fixture({CBGPU_MULTISCHOOL_V1:'1',CBGPU_SESSION_ORACLE_MODE:'legacy-docker'});f.fail(status);await assert.rejects(f.check());assert.equal(f.counts().docker,0)}const unknown=fixture({CBGPU_SESSION_ORACLE_MODE:'unsupported'});await assert.rejects(unknown.check());assert.deepEqual(unknown.counts(),{docker:0,calls:0})});
test('explicit unchanged legacy configuration retains its original host verifier',async()=>{const f=fixture();assert.equal(await f.check(),true);assert.deepEqual(f.counts(),{docker:1,calls:0})});
