import test from'node:test';import assert from'node:assert/strict';import fs from'node:fs';import vm from'node:vm';import ts from'typescript';
const code=ts.transpileModule(fs.readFileSync(new URL('../src/lib/schoolsClient.ts',import.meta.url),'utf8'),{compilerOptions:{module:ts.ModuleKind.CommonJS,target:ts.ScriptTarget.ES2022}}).outputText.replace('const schoolAccountResponse_1 = require("./schoolAccountResponse");','const schoolAccountResponse_1 = {schoolAccountResponse:async(url,init)=>{const response=await fetch(url,init);return{response,data:await response.json()}}};');
function fixture(){const saved=new Map<string,string>(),calls:any[]=[];let hold=false,release:()=>void=()=>{};const gate=()=>new Promise<void>(r=>release=r);let pending:Promise<void>|undefined;
 function device(owner:string){let identity:string|null=owner;const exports:any={};vm.runInNewContext(code,{exports,process:{env:{NEXT_PUBLIC_CBGPU_MULTISCHOOL_V1:'1'}},Error,Response,JSON,require:(name:string)=>{assert.equal(name,'@/lib/supabase');return{supabase:{auth:{getSession:async()=>({data:{session:identity?{user:{id:identity},access_token:'token-'+identity}:null}})}}}},fetch:async(url:string,options:any)=>{const actor=options.headers.Authorization.slice('Bearer token-'.length);calls.push({actor,url,method:options.method,body:options.body});if(url.endsWith('/current-school')){const school=JSON.parse(options.body).school_id;if(!['school-a','school-b'].includes(school))return Response.json({error:'ACTIVE_RESOURCE_CONTEXT_REQUIRED'},{status:403});saved.set(actor,school);if(hold)await pending;return Response.json({ok:true,current_school_id:school})}return Response.json({items:[],current_school_id:saved.get(actor)||null})},localStorage:{getItem(){throw Error('Device preference must never decide the selected school')},setItem(){throw Error('No device preference writes')}}});return{api:exports,identity:(next:string|null)=>identity=next}}
 return{device,saved,calls,hold(){hold=true;pending=gate()},release(){hold=false;release()}}}
test('account preference is read from one server across independent devices and never localStorage',async()=>{const f=fixture(),a=f.device('owner'),b=f.device('owner'),other=f.device('other');await a.api.selectAccountSchool('school-a','owner');assert.equal((await b.api.schoolsRequest('memberships','GET',undefined,false,'owner')).current_school_id,'school-a');await b.api.selectAccountSchool('school-b','owner');assert.equal((await a.api.schoolsRequest('memberships','GET',undefined,false,'owner')).current_school_id,'school-b');assert.equal((await other.api.schoolsRequest('memberships','GET',undefined,false,'other')).current_school_id,null);assert.equal(f.saved.get('owner'),'school-b');assert.equal(f.saved.has('other'),false)});
test('account changes before a write deny it and changes during the response cannot update new-account UI',async()=>{const f=fixture(),a=f.device('owner');a.identity('other');await assert.rejects(a.api.selectAccountSchool('school-a','owner'),/계정이 바뀌/);assert.equal(f.calls.length,0);a.identity('owner');f.hold();const pending=a.api.selectAccountSchool('school-b','owner');await new Promise(r=>setImmediate(r));a.identity('other');f.release();await assert.rejects(pending,/계정이 바뀌/);assert.equal(f.saved.get('owner'),'school-b','the already-authorized original account write is preserved');assert.equal(f.saved.has('other'),false,'the new account preference is never borrowed')});
test('server authorization denial, missing owner and invalid IDs never create a device fallback or grant',async()=>{const f=fixture(),a=f.device('owner');await assert.rejects(a.api.selectAccountSchool('school-a',undefined),/로그인/);await assert.rejects(a.api.selectAccountSchool('../school-a','owner'),/학교/);assert.equal(f.calls.length,0);await assert.rejects(a.api.selectAccountSchool('unverified-school','owner'),/ACTIVE_RESOURCE_CONTEXT_REQUIRED/);assert.equal(f.saved.size,0);assert.equal(f.calls.length,1)});
