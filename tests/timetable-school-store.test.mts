import test from'node:test';import assert from'node:assert/strict';import fs from'node:fs/promises';import os from'node:os';import path from'node:path';import{fileTimetableStore,schoolTimetableStore}from'../src/lib/timetableStore.ts';
test('scoped snapshots cannot read another school or modify the existing CBsh cache',async()=>{const dir=await fs.mkdtemp(path.join(os.tmpdir(),'cbgpu-school-cache-'));try{const base=path.join(dir,'latest.json'),a='a'.repeat(64),b='b'.repeat(64),legacy=fileTimetableStore(base),one=schoolTimetableStore(a,base),two=schoolTimetableStore(b,base);await legacy.write({version:1,at:1,raw:{school:'legacy'}});await one.write({version:1,at:2,raw:{school:'a'}});assert.equal(((await one.read())as any).raw.school,'a');await assert.rejects(two.read());await fs.copyFile(path.join(dir,'schools',a+'.json'),path.join(dir,'schools',b+'.json'));await assert.rejects(two.read(),/school mismatch/);assert.equal(((await legacy.read())as any).raw.school,'legacy');assert.equal((await fs.stat(path.join(dir,'schools',a+'.json'))).mode&0o777,0o600);assert.throws(()=>schoolTimetableStore('../latest.json',base))}finally{await fs.rm(dir,{recursive:true,force:true})}});
