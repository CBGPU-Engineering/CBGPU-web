import test from'node:test';import assert from'node:assert/strict';import fs from'node:fs/promises';import os from'node:os';import path from'node:path';import{createHash}from'node:crypto';import{publicGpuArtifacts,gpuArtifactDownload}from'../src/lib/gpuAgentArtifacts.ts';
test('versioned downloads verify pinned files, exclude private paths and refuse tampering or symlinks',async()=>{const dir=await fs.mkdtemp(path.join(os.tmpdir(),'cbgpu-gpu-artifact-')),before={...process.env};try{const file=path.join(dir,'agent'),manifest=path.join(dir,'manifest.json'),revision='a'.repeat(40),body=Buffer.from('synthetic installer bytes'),sha256=createHash('sha256').update(body).digest('hex');await fs.writeFile(file,body,{mode:0o600});await fs.writeFile(manifest,JSON.stringify({version:1,current:revision,releases:[{revision,artifacts:[{platform:'linux-x86_64',filename:'cbgpu-node-linux-x86_64',path:file,sha256,size:body.length}]}]}),{mode:0o600});process.env.CBGPU_GPU_AGENT_MANIFEST=manifest;process.env.CBGPU_GPU_CONTROL_PLANE_ORIGIN='https://cbgpu.com';const publicItems=await publicGpuArtifacts();assert.equal(publicItems.length,1);assert.ok(!JSON.stringify(publicItems).includes(dir));assert.equal(publicItems[0].url,'https://cbgpu.com/api/compute/downloads/'+revision+'/cbgpu-node-linux-x86_64');let response=await gpuArtifactDownload(revision,'cbgpu-node-linux-x86_64');assert.equal(response?.headers.get('x-content-sha256'),sha256);assert.deepEqual(Buffer.from(await response!.arrayBuffer()),body);assert.equal(await gpuArtifactDownload('../secrets','x'),null);assert.equal(await gpuArtifactDownload('b'.repeat(40),'cbgpu-node-linux-x86_64'),null);await fs.writeFile(file,'changed artifact');await assert.rejects(()=>publicGpuArtifacts());await fs.unlink(file);await fs.symlink(manifest,file);await assert.rejects(()=>publicGpuArtifacts());await fs.chmod(manifest,0o644);await assert.rejects(()=>publicGpuArtifacts())}finally{process.env=before;await fs.rm(dir,{recursive:true,force:true})}});
