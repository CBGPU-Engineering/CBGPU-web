import test from'node:test';import assert from'node:assert/strict';import{build}from'esbuild';import vm from'node:vm';import{createRequire}from'node:module';
const bundle=(await build({entryPoints:[new URL('../src/lib/aiServer.ts',import.meta.url).pathname],bundle:true,platform:'node',format:'cjs',write:false,plugins:[{name:'synthetic-ai-authority',setup(b){b.onResolve({filter:/^(server-only|@supabase\/supabase-js|node:fs\/promises)$|\.\/(preprintsServer|deployAuth|aiUpstream)$/},a=>({path:a.path,namespace:'fixture'}));b.onLoad({filter:/.*/,namespace:'fixture'},a=>({loader:'js',contents:a.path==='server-only'?'':a.path==='node:fs/promises'?"export const readFile=async()=> 'synthetic-private-key';":a.path==='@supabase/supabase-js'?"export const createClient=()=>globalThis.__f.userClient;":a.path==='./preprintsServer'?"export const preprintsClient=()=>globalThis.__f.admin;export const publicationUser=async()=>globalThis.__f.legacyUser;":a.path==='./deployAuth'?"export const activeDeploymentSession=async()=>globalThis.__f.session;":"export const aiUpstreamOrigin=async()=> 'http://fixture.invalid';"}))}}]})).outputFiles[0].text;
const owner='10000000-0000-4000-8000-000000000001';
function fixture(options:{keyRevoked?:boolean;session?:boolean;allowed?:boolean;school?:string;status?:string;userId?:string;authorityError?:boolean;legacy?:boolean}={}){
 const calls:{rpc:string;args?:Record<string,unknown>}[]=[];const user={id:options.userId??owner,email_confirmed_at:'2026-01-01'},profile={id:owner,account_status:options.status??'ACTIVE',is_approved:false,account_type:'EXTERNAL'};
 const rpc=async(name:string,args?:Record<string,unknown>)=>{calls.push({rpc:name,args});if(options.authorityError)return{data:null,error:Error('private error')};if(name==='cbgpu_school_resource_contexts')return{data:{current_school_id:options.school??'school-b',items:[{school_id:options.school??'school-b',type:'MEMBERSHIP',resources:['ai']}]},error:null};return{data:options.allowed??true,error:null}};
 const q:any={select(){return q},eq(){return q},maybeSingle:async()=>({data:profile,error:null})};const admin={from:()=>q,auth:{getUser:async()=>({data:{user},error:null}),admin:{getUserById:async()=>({data:{user},error:null})}},rpc};
 const module={exports:{}}as{exports:any};vm.runInNewContext(bundle,{module,exports:module.exports,require:createRequire(import.meta.url),process:{env:{CBGPU_MULTISCHOOL_V1:options.legacy?'0':'1'}},Request,Response,Headers,URL,AbortSignal,Buffer,setTimeout,clearTimeout,Date,__f:{admin,userClient:{rpc},session:options.session??true,legacyUser:null},fetch:async()=>Response.json(options.keyRevoked?{message:'Key revoked'}:{owner},{status:options.keyRevoked?401:200})});
 return{calls,identity:(key=false,schoolHeader?:string)=>module.exports.aiIdentity(new Request('https://cbgpu.com/api/ai/jobs',{headers:{authorization:'Bearer '+(key?'cbgpu_ai_synthetic':'synthetic-jwt'),...(schoolHeader?{'x-cbgpu-school-id':schoolHeader}:{})}}))};
}
test('actual AI identity JWT flow admits entitled globally unapproved school member via fresh context and self oracle',async()=>{const f=fixture();assert.equal((await f.identity()).owner,owner);assert.deepEqual(f.calls.map(x=>x.rpc),['cbgpu_school_resource_contexts','cbgpu_can_use_resource']);assert.equal(f.calls[1].args?.target_school,'school-b')});
test('JWT logout, suspended account and unavailable resource authority fail closed',async()=>{for(const options of[{session:false},{status:'SUSPENDED'},{allowed:false},{authorityError:true}]){const f=fixture(options);await assert.rejects(()=>f.identity());}const old=fixture({legacy:true});await assert.rejects(()=>old.identity());assert.equal(old.calls.length,0)});
test('actual API-key flow verifies registry revocation and binds resource query to current owner and exact header school',async()=>{const f=fixture();assert.equal((await f.identity(true,'school-b')).isKey,true);assert.equal(f.calls[0].rpc,'cbgpu_service_can_use_resource');assert.equal(f.calls[0].args?.user_id,owner);assert.equal(f.calls[0].args?.target_school,'school-b');const revoked=fixture({keyRevoked:true});await assert.rejects(()=>revoked.identity(true,'school-b'));assert.equal(revoked.calls.length,0);const mismatch=fixture({userId:'20000000-0000-4000-8000-000000000002'});await assert.rejects(()=>mismatch.identity(true,'school-b'));assert.equal(mismatch.calls.length,0)});
test('CBsh entitlement needs no active reservation and keys cannot use denied school/default',async()=>{const c=fixture({school:'cbsh'});assert.equal((await c.identity()).owner,owner);assert.equal(c.calls[1].args?.target_school,'cbsh');for(const school of[undefined,'foreign'])await assert.rejects(()=>fixture({allowed:false}).identity(true,school),e=>(e as any).status===403)});
