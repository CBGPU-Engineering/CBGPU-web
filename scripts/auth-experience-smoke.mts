import {createRequire}from'node:module';import fs from'node:fs';import assert from'node:assert/strict';
const require=createRequire(import.meta.url),p=require('puppeteer-core'),chrome=require('@sparticuz/chromium').default,base=process.env.DEMO_BASE||'http://localhost:13781';
const browser=await p.launch({executablePath:await chrome.executablePath(),headless:true,args:chrome.args.filter((value:string)=>value!=='--disable-web-security')});
const results:any[]=[];try{
 const page=await browser.newPage();const errors:string[]=[];page.on('pageerror',(error:any)=>errors.push(error.message));await page.setRequestInterception(true);page.on('request',(r:any)=>{const u=new URL(r.url());if(['http:','https:'].includes(u.protocol)&&!['localhost','127.0.0.1'].includes(u.hostname))return r.abort();r.continue()});
 for(const width of[320,390,768,1440]){await page.setViewport({width,height:900});for(const route of['login','signup','forgot-password','reset-password']){await page.goto(base+'/auth/'+route,{waitUntil:'networkidle2'});assert.ok(await page.evaluate(()=>document.documentElement.scrollWidth<=innerWidth+1),'No overflow '+route+width);assert.ok(await page.$('h1'));const controls=await page.$$eval('.cb-auth-panel input:not([type=hidden])',(inputs:any[])=>inputs.map(input=>({id:input.id,label:!!document.querySelector('label[for="'+input.id+'"]')})));assert.ok(controls.every((input:any)=>input.label),'Every input has a label');if(width===390||width===1440)await page.screenshot({path:`/tmp/cbgpu-auth-after-${route}-${width}.png`,fullPage:true});results.push({route,width,overflow:false,labeled:controls.length})}}
 await page.setViewport({width:390,height:844});await page.goto(base+'/auth/login',{waitUntil:'networkidle2'});await page.type('#login-email','student@example.invalid');await page.type('#login-password','wrong-password');await page.click('button[type=submit]');await page.waitForSelector('[role=alert]');assert.equal(await page.$eval('#login-email',(e:any)=>e.value),'student@example.invalid');assert.equal(await page.$eval('#login-password',(e:any)=>e.value),'wrong-password');assert.equal(await page.$eval('button[type=submit]',(e:any)=>e.disabled),false);await page.click('[aria-label="비밀번호 표시"]');assert.equal(await page.$eval('#login-password',(e:any)=>e.type),'text');await page.click('[aria-label="비밀번호 숨기기"]');await page.$eval('#login-password',(e:any)=>{e.value='';e.dispatchEvent(new Event('input',{bubbles:true}))});await page.click('#login-password',{clickCount:3});await page.type('#login-password','demo-only');await page.click('button[type=submit]');await page.waitForFunction(()=>location.pathname!=='/auth/login');await page.waitForSelector('[role=status].cb-feedback-toast');assert.ok(await page.$('[aria-label="알림 닫기"]'));await page.click('[aria-label="알림 닫기"]');await page.waitForSelector('.cb-feedback-toast',{hidden:true});
 await page.goto(base+'/auth/signup',{waitUntil:'networkidle2'});await page.type('#signup-student','9999');await page.focus('#signup-email');assert.equal(await page.$eval('#signup-student',(e:any)=>e.getAttribute('aria-invalid')),'true');await page.emulateMediaFeatures([{name:'prefers-reduced-motion',value:'reduce'}]);await page.goto(base+'/auth/login',{waitUntil:'networkidle2'});const before=await page.$eval('button[type=submit]',(e:any)=>getComputedStyle(e).transform);const box=await page.$eval('button[type=submit]',(e:any)=>{const b=e.getBoundingClientRect();return{x:b.x+b.width/2,y:b.y+b.height/2}});await page.mouse.move(box.x,box.y);await page.mouse.down();const after=await page.$eval('button[type=submit]',(e:any)=>getComputedStyle(e).transform);await page.mouse.up();assert.equal(after,before,'Reduced motion has no physical press movement');
 const axe=require.resolve('axe-core/axe.min.js');{for(const theme of['light','dark']){await page.evaluate((theme:string)=>{document.documentElement.classList.toggle('dark',theme==='dark')},theme);await page.addScriptTag({path:axe});const a=await page.evaluate(async()=>{const a=await (window as any).axe.run('.cb-auth-panel',{runOnly:{type:'tag',values:['wcag2a','wcag2aa','wcag21aa','wcag22aa']}});return a.violations.map((v:any)=>({id:v.id,impact:v.impact,targets:v.nodes.map((n:any)=>n.target)}))});results.push({accessibility:theme,violations:a});fs.writeFileSync('/tmp/cbgpu-auth-experience-results.json',JSON.stringify(results,null,2));assert.equal(a.filter((v:any)=>['critical','serious'].includes(v.impact)).length,0,'No serious auth accessibility violations '+theme)}}
 assert.deepEqual(errors,[]);fs.writeFileSync('/tmp/cbgpu-auth-experience-results.json',JSON.stringify(results,null,2));console.log('PASS auth flows:16 responsive screens, real demo invalid/valid login, preserved fields, student validation, actual success toast/dismiss, reduced motion, axe light/dark. No real mail or registrations.');
}finally{await browser.close()}
