 await page.goto(base+'/auth/login',{waitUntil:'networkidle2'});await page.type('#login-email','student@example.invalid');await page.type('#login-password','demo-only');await page.click('button[type=submit]');await page.waitForFunction(()=>location.pathname!=='/auth/login');
 await page.goto(base+'/contests/api',{waitUntil:'networkidle2'});await page.waitForFunction(()=>document.body.textContent?.includes('Synthetic contest'));
