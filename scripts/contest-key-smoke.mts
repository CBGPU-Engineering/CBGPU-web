const base=process.env.DEMO_BASE||'http://localhost:13791',id='60000000-0000-4000-8000-000000000001',tokenId='70000000-0000-4000-8000-000000000001',secret='cbgpu_ct_'+'A'.repeat(43),records:any[]=[],writes:any[]=[];
