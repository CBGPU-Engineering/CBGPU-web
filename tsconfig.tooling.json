{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "strict": false,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "types": [
      "node"
    ],
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "jsx": "react-jsx"
  },
  "include": [
    "scripts/**/*.mts",
    "scripts/**/*.cts",
    "demo/**/*.mts",
    "demo/**/*.cts",
    "tests/**/*.mts",
    "operations/**/*.mts",
    "eslint.config.mts",
    "tests/**/*.d.ts"
  ]
}
